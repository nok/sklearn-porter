// The buffer of the printed line (see `printValues`):
var valuesLine []byte

// Print the values of a sample (e.g. the transformed features) in one line,
// separated by spaces, so the output can be passed to a ported estimator:
func printValues(values []float64) {
	line := valuesLine[:0]
	for i, value := range values {
		if i > 0 {
			line = append(line, ' ')
		}
		switch {
		case value == 0 && !math.Signbit(value):
			line = append(line, '0')
		case math.IsInf(value, 1):
			line = append(line, "Infinity"...)
		case math.IsInf(value, -1):
			line = append(line, "-Infinity"...)
		default:
			line = strconv.AppendFloat(line, value, 'g', -1, 64)
		}
	}
	line = append(line, '\n')
	os.Stdout.Write(line)
	valuesLine = line
}
