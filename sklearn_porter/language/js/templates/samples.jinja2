// Parse a feature, also `nan`, `inf` and `-inf` (e.g. of Python) and `NaN`,
// `Infinity` and `-Infinity` (e.g. of a ported transformer):
var parseFeature = function (value) {
    var last = value.charCodeAt(value.length - 1);
    if ((last >= 48 && last <= 57) || last === 46) {
        return parseFloat(value);  // faster for numbers
    }
    var name = value.toLowerCase().replace(/^[+-]/, '');
    if (name === 'inf' || name === 'infinity') {
        return value.charAt(0) === '-' ? -Infinity : Infinity;
    }
    return name === 'nan' ? NaN : parseFloat(value);
};

// Read the features of one sample from the arguments or of several samples
// (one per line) from the standard input:
var readSamples = function (args) {
    var lines = args.length > 0 ? [args.join(' ')] : require('fs').readFileSync(0, 'utf8').split('\n');
    var samples = [];
    for (var i = 0; i < lines.length; i++) {
        var line = lines[i].trim();
        if (line.length === 0) {
            continue;
        }
        var values = line.split(/\s+/);
        if (values.length !== {{ pipeline_n_features or n_features }}) {
            throw new Error("You have to pass {{ pipeline_n_features or n_features }} features per sample.");
        }
        samples.push(values.map(parseFeature));
    }
    return samples;
};
