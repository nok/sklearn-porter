/* Read the features of the next sample, either of one sample from the
   arguments or of several samples (one per line) from the standard input: */
{% set n = pipeline_n_features or 'N_FEATURES' %}
int {{ 'pipeline_read_features' if pipeline else 'read_features' }}(double features[], int argc, const char *argv[], int offset) {
    static int n_read = 0;
    if (argc > offset) {
        if (n_read++ > 0) {
            return 0;
        }
        if (argc - offset != {{ n }}) {
            fprintf(stderr, "You have to pass %d features per sample.\n", {{ n }});
            exit(1);
        }
        for (int i = 0; i < {{ n }}; i++) {
            features[i] = atof(argv[offset + i]);
        }
        return 1;
    }
    int c, i = 0;
    while (1) {
        do {
            c = getchar();
        } while (c == ' ' || c == '\t' || c == '\r');
        if (c == '\n' || c == EOF) {
            if (i == {{ n }}) {
                return 1;
            }
            if (i == 0) {
                if (c == EOF) {
                    return 0;
                }
                continue;  /* empty line */
            }
        } else if (i < {{ n }} && ungetc(c, stdin) != EOF && scanf("%lf", &features[i]) == 1) {
            i++;
            continue;
        }
        fprintf(stderr, "You have to pass %d features per sample.\n", {{ n }});
        exit(1);
    }
}
