{% if not pipeline and not composite %}
    {{ step }}. Use it in your code (define `SKLEARN_PORTER_NO_MAIN` to remove `main`):
        #define SKLEARN_PORTER_NO_MAIN
        #include "{{ class_name }}.c"
{% if tpl == 'exported' %}
        load("{{ class_name }}.json");
{% endif %}
{% if kind == 'Transformer' %}
        transform(values, {{ 'document' if text_input else 'features' }});
{% elif predict_values %}
        predict(values, features);
{% else %}
        predict(features);
{% endif %}
{% endif %}
