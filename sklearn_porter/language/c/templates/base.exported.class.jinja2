            } else {
                json_append(value, key, json_parse_value(s));
            }
            json_skip(s);
            if (**s == ',') {
                (*s)++;
                json_skip(s);
            } else if (**s != close) {
                json_fail("expected ',' or the end of a container");
            }
        }
        (*s)++;
    } else if (**s == '"') {
        value = json_new(JSON_STRING);
        value->string = json_parse_string(s);
    } else if (strncmp(*s, "true", 4) == 0 || strncmp(*s, "false", 5) == 0) {
