        value = json_new(JSON_NULL);
        *s += 4;
    } else {
        value = json_new(JSON_NUMBER);
        if (!json_parse_number(s, &value->number)) {
            json_fail("unexpected character");
        }
    }
    return value;
}

JsonValue *json_read(const char *path) {
    FILE *file = fopen(path, "rb");
    if (file == NULL) {
        fprintf(stderr, "Unable to open the model data: %s\n", path);
        exit(1);
    }
    fseek(file, 0, SEEK_END);
    long size = ftell(file);
    fseek(file, 0, SEEK_SET);
    char *content = malloc(size + 1);
    if (content == NULL || fread(content, 1, size, file) != (size_t) size) {
        json_fail("unable to read the file");
    }
    content[size] = '\0';
    fclose(file);
    const char *s = content;
    JsonValue *value = json_parse_value(&s);
    free(content);
    return value;
}

JsonValue *json_get(JsonValue *object, const char *key) {
    for (int i = 0; object->type == JSON_OBJECT && i < object->length; i++) {
        if (strcmp(object->keys[i], key) == 0) {
            return object->items[i];
        }
    }
    fprintf(stderr, "Invalid model data: missing key `%s`\n", key);
    exit(1);
}

double *json_numbers(JsonValue *array) {
    if (array->type != JSON_ARRAY || (array->length > 0 && array->numbers == NULL)) {
        json_fail("expected an array of numbers");
    }
    return array->numbers;
}

