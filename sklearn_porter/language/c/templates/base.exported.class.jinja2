void json_free(JsonValue *value) {
    for (int i = 0; value->items != NULL && i < value->length; i++) {
        if (value->keys != NULL) {
            free(value->keys[i]);
        }
        json_free(value->items[i]);
    }
    free(value->keys);
    free(value->items);
    free(value->numbers);
    free(value->string);
    free(value);
