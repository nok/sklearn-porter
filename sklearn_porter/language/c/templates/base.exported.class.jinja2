/* Minimal JSON parser to read the exported model data: */

enum JsonType { JSON_NULL, JSON_BOOL, JSON_NUMBER, JSON_STRING, JSON_ARRAY, JSON_OBJECT };

typedef struct JsonValue {
    enum JsonType type;
    double number;
    char *string;
    int length;
    int capacity;
    char **keys; /* the keys of an object */
    struct JsonValue **items; /* the items of an object or array */
    double *numbers; /* the items of an array of numbers (without a value per number) */
} JsonValue;

static JsonValue *json_parse_value(const char **s);

static void json_fail(const char *msg) {
    fprintf(stderr, "Invalid model data: %s\n", msg);
    exit(1);
}

static void json_skip(const char **s) {
    while (isspace((unsigned char) **s)) {
        (*s)++;
    }
}

static JsonValue *json_new(enum JsonType type) {
    JsonValue *value = calloc(1, sizeof(JsonValue));
    if (value == NULL) {
        json_fail("out of memory");
    }
    value->type = type;
    return value;
}

static void *json_resize(void *items, int capacity, size_t size) {
    items = realloc(items, capacity * size);
    if (items == NULL) {
        json_fail("out of memory");
    }
    return items;
}

/* Grow the items of a container geometrically: */
static int json_grow(JsonValue *parent) {
    if (parent->length == parent->capacity) {
        parent->capacity = parent->capacity > 0 ? 2 * parent->capacity : 8;
        return 1;
    }
    return 0;
}

static void json_append(JsonValue *parent, char *key, JsonValue *item) {
    if (json_grow(parent)) {
        parent->items = json_resize(parent->items, parent->capacity, sizeof(JsonValue *));
        if (parent->type == JSON_OBJECT) {
            parent->keys = json_resize(parent->keys, parent->capacity, sizeof(char *));
        }
    }
    parent->items[parent->length] = item;
    if (parent->type == JSON_OBJECT) {
        parent->keys[parent->length] = key;
    }
    parent->length++;
}

static void json_append_number(JsonValue *array, double number) {
    if (json_grow(array)) {
        array->numbers = json_resize(array->numbers, array->capacity, sizeof(double));
    }
    array->numbers[array->length++] = number;
}

/* strtod also parses `Infinity`, `-Infinity` and `NaN` of Python: */
static int json_parse_number(const char **s, double *number) {
    char *end;
    *number = strtod(*s, &end);
    if (end == *s) {
        return 0;
    }
    *s = end;
    return 1;
}

static char *json_parse_string(const char **s) {
    const char *start = ++(*s);
    while (**s != '"') {
        if (**s == '\0') {
            json_fail("unterminated string");
        }
        if (**s == '\\' && *(*s + 1) != '\0') {
            (*s)++;
        }
        (*s)++;
    }
    size_t length = *s - start;
    char *string = malloc(length + 1);
    if (string == NULL) {
        json_fail("out of memory");
    }
    memcpy(string, start, length);
    string[length] = '\0';
    (*s)++;
    return string;
}

static JsonValue *json_parse_value(const char **s) {
    JsonValue *value;
    json_skip(s);
    if (**s == '{' || **s == '[') {
        char close = **s == '{' ? '}' : ']';
        value = json_new(**s == '{' ? JSON_OBJECT : JSON_ARRAY);
