/* Print the values of a sample (e.g. the transformed features) in one line,
   separated by spaces, so the output can be passed to a ported estimator: */
void print_values(const double *values, int n_values) {
    for (int i = 0; i < n_values; i++) {
        if (i > 0) {
            putchar(' ');
        }
        if (values[i] == 0.0 && !signbit(values[i])) {
            putchar('0');  /* faster than printf, e.g. for sparse features */
        } else if (values[i] == 1.0) {
            putchar('1');
        } else if (isnan(values[i])) {
            printf("NaN");
        } else if (isinf(values[i])) {
            printf(values[i] > 0 ? "Infinity" : "-Infinity");
        } else {
            printf("%.17g", values[i]);
        }
    }
    putchar('\n');
}
