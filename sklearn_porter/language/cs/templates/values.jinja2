    // Print the values of a sample (e.g. the transformed features) in one
    // line, separated by spaces, so the output can be passed to a ported
    // estimator:
    private static void PrintValues(double[] values) {
        System.Text.StringBuilder line = new System.Text.StringBuilder();
        for (int i = 0; i < values.Length; i++) {
            if (i > 0) {
                line.Append(' ');
            }
            if (System.BitConverter.DoubleToInt64Bits(values[i]) == 0L) {
                line.Append('0');  // faster, e.g. for sparse features
            } else {
                line.Append(values[i].ToString("R", System.Globalization.CultureInfo.InvariantCulture));
            }
        }
        System.Console.WriteLine(line.ToString());
    }
