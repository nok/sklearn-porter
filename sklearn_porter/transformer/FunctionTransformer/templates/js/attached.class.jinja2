{% extends 'base.attached.class' %}

{% block content %}
{% block class %}
var {{ class_name }} = function() {

    this.transform = function(features) {
        var values = new Array(features.length);
        for (var i = 0, l = features.length; i < l; i++) {
            values[i] = {% if func == 'abs' %}Math.abs(features[i]){% elif func == 'sqrt' %}Math.sqrt(features[i]){% elif func == 'exp' %}Math.exp(features[i]){% elif func == 'expm1' %}Math.expm1(features[i]){% elif func == 'log' %}Math.log(features[i]){% elif func == 'log1p' %}Math.log1p(features[i]){% elif func == 'floor' %}Math.floor(features[i]){% elif func == 'ceil' %}Math.ceil(features[i]){% elif func == 'negative' %}-features[i]{% elif func == 'reciprocal' %}1.0 / features[i]{% elif func == 'sign' %}(features[i] > 0 ? 1.0 : (features[i] < 0 ? -1.0 : features[i] + 0.0)){% elif func == 'clip' %}{% if clip_min is not none and clip_max is not none %}(features[i] < {{ clip_min }} ? {{ clip_min }} : (features[i] > {{ clip_max }} ? {{ clip_max }} : features[i])){% elif clip_min is not none %}(features[i] <= {{ clip_min }} ? {{ clip_min }} : features[i]){% else %}(features[i] > {{ clip_max }} ? {{ clip_max }} : features[i]){% endif %}{% elif func == 'square' %}features[i] * features[i]{% else %}features[i]{% endif %};
        }
        return values;
    };

};
{% endblock %}

{% include 'samples' %}

{% include 'values' %}

// Create the transformer with the model data of this file:
var createTransformer = function () {
    {% block create %}
    // Transformer:
    var {{ instance|default('transformer') }} = new {{ class_name }}();
    {% endblock %}

    return transformer;
};

var main = function () {
    // Transformer:
    var transformer = createTransformer();

    // Features of one sample (arguments) or several samples (standard input):
    readSamples(process.argv.slice(2)).forEach(function (features) {
        printValues(transformer.transform(features));
    });
}
{% endblock %}
