{% extends 'base.attached.class' %}

{% block content %}
{% block class %}
public class {{ class_name }} {

    public double[] Transform(double[] features) {
        double[] values = new double[features.Length];
        for (int i = 0; i < features.Length; i++) {
            values[i] = {% if func == 'abs' %}System.Math.Abs(features[i]){% elif func == 'sqrt' %}System.Math.Sqrt(features[i]){% elif func == 'exp' %}System.Math.Exp(features[i]){% elif func == 'expm1' %}Expm1(features[i]){% elif func == 'log' %}System.Math.Log(features[i]){% elif func == 'log1p' %}Log1p(features[i]){% elif func == 'square' %}features[i] * features[i]{% else %}features[i]{% endif %};
        }
        return values;
    }
{% if func == 'log1p' %}

    // log(1 + x), also accurate for small values of x:
    private static double Log1p(double x) {
        double u = 1.0 + x;
        if (u == 1.0) {
            return x;
        }
        if (x > 1.0) {
            return System.Math.Log(u);
        }
        return System.Math.Log(u) * x / (u - 1.0);
    }
{% elif func == 'expm1' %}

    // exp(x) - 1, also accurate for small values of x:
    private static double Expm1(double x) {
        double u = System.Math.Exp(x);
        if (u == 1.0) {
            return x;
        }
        if (System.Math.Abs(x) > 1.0) {
            return u - 1.0;
        }
        return (u - 1.0) * x / System.Math.Log(u);
    }
{% endif %}
{% if not _blocks %}

{% include 'samples' %}

{% include 'values' %}


    public static void Main(string[] args) {
        {% block create %}
        // Transformer:
        {{ class_name }} {{ instance|default('transformer') }} = new {{ class_name }}();
        {% endblock %}

        // Features of one sample (arguments) or several samples (standard input):
        foreach (double[] features in ReadSamples(args, 0)) {
            PrintValues(transformer.Transform(features));
        }
    }
{% endif %}
}
{% endblock %}
{% endblock %}
