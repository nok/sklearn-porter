{% extends 'base.combined.class' %}

{% block content %}
{% block class %}
class {{ class_name }} {

    public function transform($features) {
        return array(
            {% for i in range(n_features) %}
            {% if func == 'abs' %}abs($features[{{ i }}]){% elif func == 'sqrt' %}sqrt($features[{{ i }}]){% elif func == 'exp' %}exp($features[{{ i }}]){% elif func == 'expm1' %}expm1($features[{{ i }}]){% elif func == 'log' %}log($features[{{ i }}]){% elif func == 'log1p' %}log1p($features[{{ i }}]){% elif func == 'square' %}$features[{{ i }}] * $features[{{ i }}]{% else %}$features[{{ i }}]{% endif %},
            {% endfor %}
        );
    }

}
{% endblock %}

if (PHP_SAPI === 'cli' && realpath($argv[0]) === __FILE__) {
    {% filter indent(4, True) %}
    {% include 'samples' %}

    {% include 'values' %}
    {% endfilter %}

    array_shift($argv);

    {% block create %}
    // Transformer:
    ${{ instance|default('transformer') }} = new {{ class_name }}();
    {% endblock %}

    // Features of one sample (arguments) or several samples (standard input):
    foreach (readSamples($argv) as $features) {
        printValues($transformer->transform($features));
    }

}
{% endblock %}
