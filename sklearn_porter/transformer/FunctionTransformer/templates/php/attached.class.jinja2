{% extends 'base.attached.class' %}

{% block content %}
{% block class %}
class {{ class_name }} {

    public function transform($features) {
        $values = array();
        for ($i = 0, $l = count($features); $i < $l; $i++) {
            $values[$i] = {% if func == 'abs' %}abs($features[$i]){% elif func == 'sqrt' %}sqrt($features[$i]){% elif func == 'exp' %}exp($features[$i]){% elif func == 'expm1' %}expm1($features[$i]){% elif func == 'log' %}log($features[$i]){% elif func == 'log1p' %}log1p($features[$i]){% elif func == 'floor' %}floor($features[$i]){% elif func == 'ceil' %}ceil($features[$i]){% elif func == 'negative' %}-$features[$i]{% elif func == 'reciprocal' %}fdiv(1.0, $features[$i]){% elif func == 'sign' %}($features[$i] > 0 ? 1.0 : ($features[$i] < 0 ? -1.0 : $features[$i] + 0.0)){% elif func == 'clip' %}{% if clip_min is not none and clip_max is not none %}($features[$i] < {{ clip_min }} ? {{ clip_min }} : ($features[$i] > {{ clip_max }} ? {{ clip_max }} : $features[$i])){% elif clip_min is not none %}($features[$i] <= {{ clip_min }} ? {{ clip_min }} : $features[$i]){% else %}($features[$i] > {{ clip_max }} ? {{ clip_max }} : $features[$i]){% endif %}{% elif func == 'square' %}$features[$i] * $features[$i]{% else %}$features[$i]{% endif %};
        }
        return $values;
    }

}
{% endblock %}

if (PHP_SAPI === 'cli' && realpath($argv[0]) === __FILE__) {
    {% filter indent(4, True) %}
    {% include 'samples' %}

    {% include 'values' %}
    {% endfilter %}

    array_shift($argv);

    {% block create %}
    // Transformer:
    ${{ instance|default('transformer') }} = new {{ class_name }}();
    {% endblock %}

    // Features of one sample (arguments) or several samples (standard input):
    foreach (readSamples($argv) as $features) {
        printValues($transformer->transform($features));
    }

}
{% endblock %}
