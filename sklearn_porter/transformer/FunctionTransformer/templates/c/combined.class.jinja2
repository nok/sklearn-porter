{% extends 'base.combined.class' %}

{% block content %}
#include <math.h>
#include <stdio.h>
#include <stdlib.h>

{% block class %}
#define {{ prefix }}N_FEATURES {{ n_features }}
#define {{ prefix }}N_FEATURES_OUT {{ n_features_out }}


/* Write the transformed features to `values`: */
void {{ prefix }}transform(double *values, double features[{{ prefix }}N_FEATURES]) {
    {% for i in range(n_features) %}
    values[{{ i }}] = {% if func == 'abs' %}fabs(features[{{ i }}]){% elif func == 'sqrt' %}sqrt(features[{{ i }}]){% elif func == 'exp' %}exp(features[{{ i }}]){% elif func == 'expm1' %}expm1(features[{{ i }}]){% elif func == 'log' %}log(features[{{ i }}]){% elif func == 'log1p' %}log1p(features[{{ i }}]){% elif func == 'floor' %}floor(features[{{ i }}]){% elif func == 'ceil' %}ceil(features[{{ i }}]){% elif func == 'negative' %}-features[{{ i }}]{% elif func == 'reciprocal' %}1.0 / features[{{ i }}]{% elif func == 'sign' %}(features[{{ i }}] > 0 ? 1.0 : (features[{{ i }}] < 0 ? -1.0 : features[{{ i }}] + 0.0)){% elif func == 'clip' %}{% if clip_min is not none and clip_max is not none %}(features[{{ i }}] < {{ clip_min }} ? {{ clip_min }} : (features[{{ i }}] > {{ clip_max }} ? {{ clip_max }} : features[{{ i }}])){% elif clip_min is not none %}(features[{{ i }}] <= {{ clip_min }} ? {{ clip_min }} : features[{{ i }}]){% else %}(features[{{ i }}] > {{ clip_max }} ? {{ clip_max }} : features[{{ i }}]){% endif %}{% elif func == 'square' %}features[{{ i }}] * features[{{ i }}]{% else %}features[{{ i }}]{% endif %};
    {% endfor %}
}
{% endblock %}

{% include 'samples' %}

{% include 'values' %}

int main(int argc, const char *argv[]) {
    /* Features of one sample (arguments) or several samples (standard input): */
    double features[N_FEATURES];
    while (read_features(features, argc, argv, 1)) {
        double values[N_FEATURES_OUT];
        transform(values, features);
        print_values(values, N_FEATURES_OUT);
    }

    return 0;
}
{% endblock %}
