{% extends 'base.exported.class' %}

{% block content %}
package main

import (
	"bufio"
	"encoding/json"
	"fmt"
	"math"
	"os"
	"strconv"
	"strings"
)

{% block class %}
type {{ class_name }} struct{}

func (transformer {{ class_name }}) Transform(features []float64) []float64 {
	values := make([]float64, len(features))
	for i := range features {
		{% if func == 'sign' %}
		switch {
		case features[i] > 0:
			values[i] = 1
		case features[i] < 0:
			values[i] = -1
		default:
			values[i] = features[i] + 0
		}
		{% elif func == 'clip' %}
		values[i] = features[i]
		{% if clip_min is not none and clip_max is not none %}
		if values[i] < {{ clip_min }} {
			values[i] = {{ clip_min }}
		} else if values[i] > {{ clip_max }} {
			values[i] = {{ clip_max }}
		}
		{% elif clip_min is not none %}
		if values[i] <= {{ clip_min }} {
			values[i] = {{ clip_min }}
		}
		{% else %}
		if values[i] > {{ clip_max }} {
			values[i] = {{ clip_max }}
		}
		{% endif %}
		{% else %}
		values[i] = {% if func == 'abs' %}math.Abs(features[i]){% elif func == 'sqrt' %}math.Sqrt(features[i]){% elif func == 'exp' %}math.Exp(features[i]){% elif func == 'expm1' %}math.Expm1(features[i]){% elif func == 'log' %}math.Log(features[i]){% elif func == 'log1p' %}math.Log1p(features[i]){% elif func == 'floor' %}math.Floor(features[i]){% elif func == 'ceil' %}math.Ceil(features[i]){% elif func == 'negative' %}-features[i]{% elif func == 'reciprocal' %}1 / features[i]{% elif func == 'square' %}features[i] * features[i]{% else %}features[i]{% endif +%}
		{% endif %}
	}
	return values
}
{% endblock %}

{% include 'samples' %}

{% include 'values' %}

func main() {
	if len(os.Args) < 2 {
		fmt.Fprintln(os.Stderr, "You have to pass the path to the model data.")
		os.Exit(1)
	}

	// Model data:
	byteValue, err := os.ReadFile(os.Args[1])
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}

	{% block create %}
	// Transformer:
	var {{ instance|default('transformer') }} {{ class_name }}
	if err := json.Unmarshal({{ data|default('byteValue') }}, &{{ instance|default('transformer') }}); err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
	{% endblock %}

	// Features of one sample (arguments) or several samples (standard input):
	readSamples(os.Args[2:], func(features []float64) {
		printValues(transformer.Transform(features))
	})
}
{% endblock %}
