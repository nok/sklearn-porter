{% extends 'base.combined.class' %}

{% block content %}
{% block class %}
class {{ class_name }}

	def transform(features)
		[
			{% for i in range(n_features) %}
			{% if func == 'abs' %}features[{{ i }}].abs{% elif func == 'sqrt' %}sqrt(features[{{ i }}]){% elif func == 'exp' %}Math.exp(features[{{ i }}]){% elif func == 'expm1' %}expm1(features[{{ i }}]){% elif func == 'log' %}log(features[{{ i }}]){% elif func == 'log1p' %}log1p(features[{{ i }}]){% elif func == 'floor' %}floor(features[{{ i }}]){% elif func == 'ceil' %}ceil(features[{{ i }}]){% elif func == 'negative' %}-features[{{ i }}]{% elif func == 'reciprocal' %}1.0 / features[{{ i }}]{% elif func == 'sign' %}(features[{{ i }}] > 0 ? 1.0 : (features[{{ i }}] < 0 ? -1.0 : features[{{ i }}] + 0.0)){% elif func == 'clip' %}{% if clip_min is not none and clip_max is not none %}(features[{{ i }}] < {{ clip_min }} ? {{ clip_min }} : (features[{{ i }}] > {{ clip_max }} ? {{ clip_max }} : features[{{ i }}])){% elif clip_min is not none %}(features[{{ i }}] <= {{ clip_min }} ? {{ clip_min }} : features[{{ i }}]){% else %}(features[{{ i }}] > {{ clip_max }} ? {{ clip_max }} : features[{{ i }}]){% endif %}{% elif func == 'square' %}features[{{ i }}] * features[{{ i }}]{% else %}features[{{ i }}]{% endif %},
			{% endfor %}
		]
	end
{% if func == 'sqrt' %}

	# Math.sqrt raises an error for negative numbers and returns 0.0 for -0.0:
	def sqrt(x)
		x < 0 ? Float::NAN : (x == 0 ? x : Math.sqrt(x))
	end
{% elif func == 'log' %}

	# Math.log raises an error for negative numbers:
	def log(x)
		x < 0 ? Float::NAN : Math.log(x)
	end
{% elif func == 'log1p' %}

	# log(1 + x), also accurate for small values of x:
	def log1p(x)
		return Float::NAN if x < -1
		u = 1.0 + x
		return x if u == 1.0
		return Math.log(u) if x > 1
		Math.log(u) * x / (u - 1.0)
	end
{% elif func == 'expm1' %}

	# exp(x) - 1, also accurate for small values of x:
	def expm1(x)
		u = Math.exp(x)
		return x if u == 1.0
		return u - 1.0 if x.abs > 1
		(u - 1.0) * x / Math.log(u)
	end
{% elif func == 'floor' %}

	# Float#floor returns an integer (and raises an error for NaN):
	def floor(x)
		x.nan? || x.infinite? || x.zero? ? x : x.floor.to_f
	end
{% elif func == 'ceil' %}

	# Float#ceil returns an integer (and raises an error for NaN):
	def ceil(x)
		return x if x.nan? || x.infinite? || x.zero?
		value = x.ceil.to_f
		value.zero? && x < 0 ? -0.0 : value
	end
{% endif %}

end
{% endblock %}

if __FILE__ == $0
	{% filter indent('\t', True) %}
	{% include 'samples' %}

	{% include 'values' %}
	{% endfilter %}

	{% block create %}
	# Transformer:
	{{ instance|default('transformer') }} = {{ class_name }}.new
	{% endblock %}

	# Features of one sample (arguments) or several samples (standard input):
	read_samples(ARGV) do |features|
		print_values transformer.transform(features)
	end
end
{% endblock %}
