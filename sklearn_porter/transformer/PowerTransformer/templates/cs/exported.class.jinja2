{% extends 'base.exported.class' %}

{% block content %}
using System;
using System.IO;
using System.Text.Json;


{% block class %}
public class {{ class_name }} {

    private class ModelData {
        public double[] Lambdas { get; set; }
        public double[] Mean { get; set; }
        public double[] Scale { get; set; }
    }

    private ModelData data;

{% if _blocks %}
    public {{ class_name }}(System.Text.Json.JsonElement data) {
        System.Text.Json.JsonSerializerOptions options = new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.SnakeCaseLower };
        this.data = System.Text.Json.JsonSerializer.Deserialize<ModelData>(data, options);
    }
{% else %}
    public {{ class_name }}(string file) {
        JsonSerializerOptions options = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.SnakeCaseLower };
        this.data = JsonSerializer.Deserialize<ModelData>(File.ReadAllText(file), options);
    }
{% endif %}

    public double[] Transform(double[] features) {
        double[] values = new double[features.Length];
        for (int i = 0; i < features.Length; i++) {
            double x = features[i];
            double l = this.data.Lambdas[i];
            double y;
        {% if method == 'box-cox' %}
            if (System.Math.Abs(l) < 1e-19) {
                y = System.Math.Log(x);
            } else if (l * System.Math.Log(x) < 709.78) {
                y = Expm1(l * System.Math.Log(x)) / l;
            } else {
                y = (l > 0 ? 1.0 : -1.0) * System.Math.Exp(l * System.Math.Log(x) - System.Math.Log(System.Math.Abs(l))) - 1.0 / l;
            }
        {% else %}
            if (x >= 0) {
                y = System.Math.Abs(l) < {{ eps }} ? Log1p(x) : Expm1(l * Log1p(x)) / l;
            } else {
                y = System.Math.Abs(l - 2.0) > {{ eps }} ? -Expm1((2.0 - l) * Log1p(-x)) / (2.0 - l) : -Log1p(-x);
            }
        {% endif %}
            values[i] = (y - this.data.Mean[i]) / this.data.Scale[i];
        }
        return values;
    }


    // log(1 + x), also accurate for small values of x:
    private static double Log1p(double x) {
        double u = 1.0 + x;
        if (u == 1.0) {
            return x;
        }
        if (x > 1.0) {
            return System.Math.Log(u);
        }
        return System.Math.Log(u) * x / (u - 1.0);
    }

    // exp(x) - 1, also accurate for small values of x:
    private static double Expm1(double x) {
        double u = System.Math.Exp(x);
        if (u == 1.0) {
            return x;
        }
        if (System.Math.Abs(x) > 1.0) {
            return u - 1.0;
        }
        return (u - 1.0) * x / System.Math.Log(u);
    }
{% if not _blocks %}

{% include 'samples' %}

{% include 'values' %}


    public static void Main(string[] args) {
        if (args.Length < 1 || !args[0].EndsWith(".json")) {
            throw new ArgumentException("You have to pass the path to the exported model data.");
        }

        {% block create %}
        // Transformer:
        {{ class_name }} {{ instance|default('transformer') }} = new {{ class_name }}({{ data|default('args[0]') }});
        {% endblock %}

        // Features of one sample (arguments) or several samples (standard input):
        foreach (double[] features in ReadSamples(args, 1)) {
            PrintValues(transformer.Transform(features));
        }
    }
{% endif %}
}
{% endblock %}
{% endblock %}
