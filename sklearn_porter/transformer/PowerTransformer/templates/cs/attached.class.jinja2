{% extends 'base.attached.class' %}

{% block content %}
{% block class %}
public class {{ class_name }} {

    private double[] lambdas;
    private double[] mean;
    private double[] scale;

    public {{ class_name }}(double[] lambdas, double[] mean, double[] scale) {
        this.lambdas = lambdas;
        this.mean = mean;
        this.scale = scale;
    }

    public double[] Transform(double[] features) {
        double[] values = new double[features.Length];
        for (int i = 0; i < features.Length; i++) {
            double x = features[i];
            double l = this.lambdas[i];
            double y;
        {% if method == 'box-cox' %}
            if (System.Math.Abs(l) < 1e-19) {
                y = System.Math.Log(x);
            } else if (l * System.Math.Log(x) < 709.78) {
                y = Expm1(l * System.Math.Log(x)) / l;
            } else {
                y = (l > 0 ? 1.0 : -1.0) * System.Math.Exp(l * System.Math.Log(x) - System.Math.Log(System.Math.Abs(l))) - 1.0 / l;
            }
        {% else %}
            if (x >= 0) {
                y = System.Math.Abs(l) < {{ eps }} ? Log1p(x) : Expm1(l * Log1p(x)) / l;
            } else {
                y = System.Math.Abs(l - 2.0) > {{ eps }} ? -Expm1((2.0 - l) * Log1p(-x)) / (2.0 - l) : -Log1p(-x);
            }
        {% endif %}
            values[i] = (y - this.mean[i]) / this.scale[i];
        }
        return values;
    }


    // log(1 + x), also accurate for small values of x:
    private static double Log1p(double x) {
        double u = 1.0 + x;
        if (u == 1.0) {
            return x;
        }
        if (x > 1.0) {
            return System.Math.Log(u);
        }
        return System.Math.Log(u) * x / (u - 1.0);
    }

    // exp(x) - 1, also accurate for small values of x:
    private static double Expm1(double x) {
        double u = System.Math.Exp(x);
        if (u == 1.0) {
            return x;
        }
        if (System.Math.Abs(x) > 1.0) {
            return u - 1.0;
        }
        return (u - 1.0) * x / System.Math.Log(u);
    }
{% if not _blocks %}

{% include 'samples' %}

{% include 'values' %}


    public static void Main(string[] args) {
        {% block create %}
        // Model data:
        {{ lambdas }}
        {{ mean }}
        {{ scale }}

        // Transformer:
        {{ class_name }} {{ instance|default('transformer') }} = new {{ class_name }}({{ prefix }}lambdas, {{ prefix }}mean, {{ prefix }}scale);
        {% endblock %}

        // Features of one sample (arguments) or several samples (standard input):
        foreach (double[] features in ReadSamples(args, 0)) {
            PrintValues(transformer.Transform(features));
        }
    }
{% endif %}
}
{% endblock %}
{% endblock %}
