{% extends 'base.exported.class' %}

{% block content %}
package main

import (
	"bufio"
	"encoding/json"
	"fmt"
	"math"
	"os"
	"strconv"
	"strings"
)

{% block class %}
type {{ class_name }} struct {
	Lambdas []float64 `json:"lambdas"`
	Mean    []float64 `json:"mean"`
	Scale   []float64 `json:"scale"`
}

func (transformer {{ class_name }}) Transform(features []float64) []float64 {
	values := make([]float64, len(features))
	for i := range features {
		x, l := features[i], transformer.Lambdas[i]
		var y float64
	{% if method == 'box-cox' %}
		if math.Abs(l) < 1e-19 {
			y = math.Log(x)
		} else if t := float64(l * math.Log(x)); t < 709.78 {
			y = math.Expm1(t) / l
		} else {
			s := 1.0
			if l < 0 {
				s = -1.0
			}
			y = float64(s*math.Exp(t-math.Log(math.Abs(l)))) - 1/l
		}
	{% else %}
		if x >= 0 {
			if math.Abs(l) < {{ eps }} {
				y = math.Log1p(x)
			} else {
				y = math.Expm1(l*math.Log1p(x)) / l
			}
		} else if math.Abs(l-2) > {{ eps }} {
			y = -math.Expm1((2-l)*math.Log1p(-x)) / (2 - l)
		} else {
			y = -math.Log1p(-x)
		}
	{% endif %}
		values[i] = (y - transformer.Mean[i]) / transformer.Scale[i]
	}
	return values
}
{% endblock %}

{% include 'samples' %}

{% include 'values' %}

func main() {
	if len(os.Args) < 2 {
		fmt.Fprintln(os.Stderr, "You have to pass the path to the model data.")
		os.Exit(1)
	}

	// Model data:
	byteValue, err := os.ReadFile(os.Args[1])
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}

	{% block create %}
	// Transformer:
	var {{ instance|default('transformer') }} {{ class_name }}
	if err := json.Unmarshal({{ data|default('byteValue') }}, &{{ instance|default('transformer') }}); err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
	{% endblock %}

	// Features of one sample (arguments) or several samples (standard input):
	readSamples(os.Args[2:], func(features []float64) {
		printValues(transformer.Transform(features))
	})
}
{% endblock %}
