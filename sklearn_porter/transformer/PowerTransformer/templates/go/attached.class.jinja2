{% extends 'base.attached.class' %}

{% block content %}
package main

import (
	"bufio"
	"fmt"
	"math"
	"os"
	"strconv"
	"strings"
)

{% block class %}
type {{ class_name }} struct {
	Lambdas []float64
	Mean    []float64
	Scale   []float64
}

func (transformer {{ class_name }}) Transform(features []float64) []float64 {
	values := make([]float64, len(features))
	for i := range features {
		x, l := features[i], transformer.Lambdas[i]
		var y float64
	{% if method == 'box-cox' %}
		if math.Abs(l) < 1e-19 {
			y = math.Log(x)
		} else if t := float64(l * math.Log(x)); t < 709.78 {
			y = math.Expm1(t) / l
		} else {
			s := 1.0
			if l < 0 {
				s = -1.0
			}
			y = float64(s*math.Exp(t-math.Log(math.Abs(l)))) - 1/l
		}
	{% else %}
		if x >= 0 {
			if math.Abs(l) < {{ eps }} {
				y = math.Log1p(x)
			} else {
				y = math.Expm1(l*math.Log1p(x)) / l
			}
		} else if math.Abs(l-2) > {{ eps }} {
			y = -math.Expm1((2-l)*math.Log1p(-x)) / (2 - l)
		} else {
			y = -math.Log1p(-x)
		}
	{% endif %}
		values[i] = (y - transformer.Mean[i]) / transformer.Scale[i]
	}
	return values
}
{% endblock %}

{% include 'samples' %}

{% include 'values' %}

{% block data %}
// Model data:
{{ lambdas }}
{{ mean }}
{{ scale }}
{% endblock %}

func main() {
	{% block create %}
	// Transformer:
	{{ instance|default('transformer') }} := {{ class_name ~ '{' }}{{ prefix }}lambdas, {{ prefix }}mean, {{ prefix }}scale}
	{% endblock %}

	// Features of one sample (arguments) or several samples (standard input):
	readSamples(os.Args[1:], func(features []float64) {
		printValues(transformer.Transform(features))
	})
}
{% endblock %}
