{% extends 'base.attached.class' %}

{% block content %}
{% block class %}
var {{ class_name }} = function(lambdas, mean, scale) {

    this.lambdas = lambdas;
    this.mean = mean;
    this.scale = scale;

    this.transform = function(features) {
        var values = new Array(features.length);
        for (var i = 0; i < features.length; i++) {
            var x = features[i];
            var l = this.lambdas[i];
            var y;
        {% if method == 'box-cox' %}
            if (Math.abs(l) < 1e-19) {
                y = Math.log(x);
            } else if (l * Math.log(x) < 709.78) {
                y = Math.expm1(l * Math.log(x)) / l;
            } else {
                y = (l > 0 ? 1.0 : -1.0) * Math.exp(l * Math.log(x) - Math.log(Math.abs(l))) - 1.0 / l;
            }
        {% else %}
            if (x >= 0) {
                y = Math.abs(l) < {{ eps }} ? Math.log1p(x) : Math.expm1(l * Math.log1p(x)) / l;
            } else {
                y = Math.abs(l - 2.0) > {{ eps }} ? -Math.expm1((2.0 - l) * Math.log1p(-x)) / (2.0 - l) : -Math.log1p(-x);
            }
        {% endif %}
            values[i] = (y - this.mean[i]) / this.scale[i];
        }
        return values;
    };

};
{% endblock %}

{% include 'samples' %}

{% include 'values' %}

var main = function () {
    {% block create %}
    // Model data:
    {{ lambdas }}
    {{ mean }}
    {{ scale }}

    // Transformer:
    var {{ instance|default('transformer') }} = new {{ class_name }}({{ prefix }}lambdas, {{ prefix }}mean, {{ prefix }}scale);
    {% endblock %}

    // Features of one sample (arguments) or several samples (standard input):
    readSamples(process.argv.slice(2)).forEach(function (features) {
        printValues(transformer.transform(features));
    });
}

if (require.main === module) {
    main();
}
{% endblock %}
