{% extends 'base.exported.class' %}

{% block content %}
var fs = require('fs');


{% block class %}
{% if _blocks %}
var {{ class_name }} = function(data) {
    this.data = data;
{% else %}
var {{ class_name }} = function(jsonFile) {
    this.data = JSON.parse(fs.readFileSync(jsonFile));
{% endif %}

    this.transform = function(features) {
        var values = new Array(features.length);
        for (var i = 0; i < features.length; i++) {
            var x = features[i];
            var l = this.data.lambdas[i];
            var y;
        {% if method == 'box-cox' %}
            if (Math.abs(l) < 1e-19) {
                y = Math.log(x);
            } else if (l * Math.log(x) < 709.78) {
                y = Math.expm1(l * Math.log(x)) / l;
            } else {
                y = (l > 0 ? 1.0 : -1.0) * Math.exp(l * Math.log(x) - Math.log(Math.abs(l))) - 1.0 / l;
            }
        {% else %}
            if (x >= 0) {
                y = Math.abs(l) < {{ eps }} ? Math.log1p(x) : Math.expm1(l * Math.log1p(x)) / l;
            } else {
                y = Math.abs(l - 2.0) > {{ eps }} ? -Math.expm1((2.0 - l) * Math.log1p(-x)) / (2.0 - l) : -Math.log1p(-x);
            }
        {% endif %}
            values[i] = (y - this.data.mean[i]) / this.data.scale[i];
        }
        return values;
    };
};
{% endblock %}

{% include 'samples' %}

{% include 'values' %}

var main = function () {
    if (process.argv.length < 3) {
        throw new Error("You have to pass the path to the model data.");
    }

    {% block create %}
    // Transformer:
    var {{ instance|default('transformer') }} = new {{ class_name }}({{ data|default('process.argv[2]') }});
    {% endblock %}

    // Features of one sample (arguments) or several samples (standard input):
    readSamples(process.argv.slice(3)).forEach(function (features) {
        printValues(transformer.transform(features));
    });
}

if (require.main === module) {
    main();
}
{% endblock %}
