{% extends 'base.exported.class' %}

{% block content %}
package main

import (
	"bufio"
	"encoding/json"
	"fmt"
	"math"
	"os"
	"strconv"
	"strings"
)

{% block class %}
type {{ class_name }} struct {
	Inputs     []int `json:"inputs"`
	Statistics []float64 `json:"statistics"`
	Indicators []int `json:"indicators"`
}

func (transformer {{ class_name }}) Transform(features []float64) []float64 {
	values := make([]float64, len(transformer.Inputs))
	for i := range transformer.Inputs {
		if x := features[transformer.Inputs[i]]; {% if missing_values_nan %}math.IsNaN(x){% else %}x == {{ missing_values }}{% endif %} {
			if transformer.Indicators[i] == 1 {
				values[i] = 1
			} else {
				values[i] = transformer.Statistics[i]
			}
		} else if transformer.Indicators[i] == 0 {
			values[i] = x
		}
	}
	return values
}
{% endblock %}

{% include 'samples' %}

{% include 'values' %}

func main() {
	if len(os.Args) < 2 {
		fmt.Fprintln(os.Stderr, "You have to pass the path to the model data.")
		os.Exit(1)
	}

	// Model data:
	byteValue, err := os.ReadFile(os.Args[1])
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}

	{% block create %}
	// Transformer:
	var {{ instance|default('transformer') }} {{ class_name }}
	if err := json.Unmarshal({{ data|default('byteValue') }}, &{{ instance|default('transformer') }}); err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
	{% endblock %}

	// Features of one sample (arguments) or several samples (standard input):
	readSamples(os.Args[2:], func(features []float64) {
		printValues(transformer.Transform(features))
	})
}
{% endblock %}
