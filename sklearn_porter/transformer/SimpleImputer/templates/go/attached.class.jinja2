{% extends 'base.attached.class' %}

{% block content %}
package main

import (
	"bufio"
	"fmt"
	"math"
	"os"
	"strconv"
	"strings"
)

{% block class %}
type {{ class_name }} struct {
	Statistics []float64
}

func (transformer {{ class_name }}) Transform(features []float64) []float64 {
	values := make([]float64, len(transformer.Statistics))
	for i := range transformer.Statistics {
		values[i] = features[i]
		if {% if missing_values_nan %}math.IsNaN(features[i]){% else %}features[i] == {{ missing_values }}{% endif %} {
			values[i] = transformer.Statistics[i]
		}
	}
	return values
}
{% endblock %}

{% include 'samples' %}

{% include 'values' %}

{% block data %}
// Model data:
{{ statistics }}
{% endblock %}

func main() {
	{% block create %}
	// Transformer:
	{{ instance|default('transformer') }} := {{ class_name ~ '{' }}{{ prefix }}statistics}
	{% endblock %}

	// Features of one sample (arguments) or several samples (standard input):
	readSamples(os.Args[1:], func(features []float64) {
		printValues(transformer.Transform(features))
	})
}
{% endblock %}
