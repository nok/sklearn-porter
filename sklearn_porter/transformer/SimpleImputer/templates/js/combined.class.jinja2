{% extends 'base.combined.class' %}

{% block content %}
{% block class %}
var {{ class_name }} = function() {

    this.transform = function(features) {
        return [
            {% for i in range(n_features_out) %}
            {% if indicators[i] == '1' %}({% if missing_values_nan %}isNaN(features[{{ inputs[i] }}]){% else %}features[{{ inputs[i] }}] == {{ missing_values }}{% endif %} ? 1.0 : 0.0){% else %}({% if missing_values_nan %}isNaN(features[{{ inputs[i] }}]){% else %}features[{{ inputs[i] }}] == {{ missing_values }}{% endif %} ? {{ statistics[i] }} : features[{{ inputs[i] }}]){% endif %}{{ ',' if not loop.last }}
            {% endfor %}
        ];
    };

};
{% endblock %}

{% include 'samples' %}

{% include 'values' %}

var main = function () {
    {% block create %}
    // Transformer:
    var {{ instance|default('transformer') }} = new {{ class_name }}();
    {% endblock %}

    // Features of one sample (arguments) or several samples (standard input):
    readSamples(process.argv.slice(2)).forEach(function (features) {
        printValues(transformer.transform(features));
    });
}

if (require.main === module) {
    main();
}
{% endblock %}
