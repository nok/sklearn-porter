{% extends 'base.attached.class' %}

{% block content %}
{% block class %}
var {{ class_name }} = function(statistics) {

    this.statistics = statistics;

    this.transform = function(features) {
        var values = new Array(this.statistics.length);
        for (var i = 0, l = this.statistics.length; i < l; i++) {
            values[i] = {% if missing_values_nan %}isNaN(features[i]){% else %}features[i] == {{ missing_values }}{% endif %} ? this.statistics[i] : features[i];
        }
        return values;
    };

};
{% endblock %}

{% include 'samples' %}

{% include 'values' %}

var main = function () {
    {% block create %}
    // Model data:
    {{ statistics }}

    // Transformer:
    var {{ instance|default('transformer') }} = new {{ class_name }}({{ prefix }}statistics);
    {% endblock %}

    // Features of one sample (arguments) or several samples (standard input):
    readSamples(process.argv.slice(2)).forEach(function (features) {
        printValues(transformer.transform(features));
    });
}

if (require.main === module) {
    main();
}
{% endblock %}
