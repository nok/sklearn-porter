{% extends 'base.combined.class' %}

{% block content %}
{% block class %}
public class {{ class_name }} {

    public double[] Transform(double[] features) {
        double[] values = new double[{{ n_features_out }}];
        {% for i in range(n_features_out) %}
        values[{{ i }}] = {% if indicators[i] == '1' %}({% if missing_values_nan %}double.IsNaN(features[{{ inputs[i] }}]){% else %}features[{{ inputs[i] }}] == {{ missing_values }}{% endif %} ? 1.0 : 0.0){% else %}({% if missing_values_nan %}double.IsNaN(features[{{ inputs[i] }}]){% else %}features[{{ inputs[i] }}] == {{ missing_values }}{% endif %} ? {{ statistics[i] }} : features[{{ inputs[i] }}]){% endif %};
        {% endfor %}
        return values;
    }
{% if not _blocks %}

{% include 'samples' %}

{% include 'values' %}


    public static void Main(string[] args) {
        {% block create %}
        // Transformer:
        {{ class_name }} {{ instance|default('transformer') }} = new {{ class_name }}();
        {% endblock %}

        // Features of one sample (arguments) or several samples (standard input):
        foreach (double[] features in ReadSamples(args, 0)) {
            PrintValues(transformer.Transform(features));
        }
    }
{% endif %}
}
{% endblock %}
{% endblock %}
