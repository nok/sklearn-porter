public class {{ class_name }} {

    private double[] statistics;

    public {{ class_name }}(double[] statistics) {
        this.statistics = statistics;
    }

    public double[] Transform(double[] features) {
        double[] values = new double[this.statistics.Length];
        for (int i = 0; i < this.statistics.Length; i++) {
            values[i] = {% if missing_values_nan %}double.IsNaN(features[i]){% else %}features[i] == {{ missing_values }}{% endif %} ? this.statistics[i] : features[i];
        }
        return values;
    }
