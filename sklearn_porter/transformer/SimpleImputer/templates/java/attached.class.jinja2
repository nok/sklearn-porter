{% block class %}
class {{ class_name }} {

    private int[] inputs;
    private double[] statistics;
    private int[] indicators;

    public {{ class_name }}(int[] inputs, double[] statistics, int[] indicators) {
        this.inputs = inputs;
        this.statistics = statistics;
        this.indicators = indicators;
    }

    public double[] transform(double[] features) {
        double[] values = new double[this.inputs.length];
        for (int i = 0; i < this.inputs.length; i++) {
            values[i] = {% if missing_values_nan %}Double.isNaN(features[this.inputs[i]]){% else %}features[this.inputs[i]] == {{ missing_values }}{% endif %} ? (this.indicators[i] == 1 ? 1.0 : this.statistics[i]) : (this.indicators[i] == 1 ? 0.0 : features[this.inputs[i]]);
        }
        return values;
    }
{% if not _blocks %}

{% include 'samples' %}

{% include 'values' %}

    public static void main(String[] args) {
        {% block create %}
        // Model data:
        {{ inputs }}
        {{ statistics }}
        {{ indicators }}

        // Transformer:
        {{ class_name }} {{ instance|default('transformer') }} = new {{ class_name }}({{ prefix }}inputs, {{ prefix }}statistics, {{ prefix }}indicators);
        {% endblock %}

        // Features of one sample (arguments) or several samples (standard input):
        for (double[] features : readSamples(args, 0)) {
            printValues(transformer.transform(features));
        }
    }
{% endif %}
}
