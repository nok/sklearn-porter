{% extends 'base.exported.class' %}

{% block content %}
#include <math.h>

{% block class %}
#define {{ prefix }}N_FEATURES {{ n_features }}
#define {{ prefix }}N_FEATURES_OUT {{ n_features_out }}


int *{{ prefix }}inputs;
double *{{ prefix }}statistics;
int *{{ prefix }}indicators;

void {{ prefix }}load({{ 'JsonValue *data' if _blocks else 'const char *path' }}) {
{% if not _blocks %}
    JsonValue *data = json_read(path);
{% endif %}
    {{ prefix }}inputs = json_ints(json_get(data, "inputs"));
    {{ prefix }}statistics = json_doubles(json_get(data, "statistics"));
    {{ prefix }}indicators = json_ints(json_get(data, "indicators"));
{% if not _blocks %}
    json_free(data);
{% endif %}
}

/* Write the transformed features to `values`: */
void {{ prefix }}transform(double *values, double features[{{ prefix }}N_FEATURES]) {
    for (int i = 0; i < {{ prefix }}N_FEATURES_OUT; i++) {
        values[i] = {% if missing_values_nan %}isnan(features[{{ prefix }}inputs[i]]){% else %}features[{{ prefix }}inputs[i]] == {{ missing_values }}{% endif %} ? ({{ prefix }}indicators[i] ? 1.0 : {{ prefix }}statistics[i]) : ({{ prefix }}indicators[i] ? 0.0 : features[{{ prefix }}inputs[i]]);
    }
}
{% endblock %}

{% include 'samples' %}

{% include 'values' %}

int main(int argc, const char *argv[]) {
    if (argc < 2) {
        fprintf(stderr, "You have to pass the path to the model data.\n");
        return 1;
    }

    {% block create %}
    /* Model data: */
    {{ prefix }}load({{ data|default('argv[1]') }});
    {% endblock %}

    /* Features of one sample (arguments) or several samples (standard input): */
    double features[N_FEATURES];
    while (read_features(features, argc, argv, 2)) {
        double values[N_FEATURES_OUT];
        transform(values, features);
        print_values(values, N_FEATURES_OUT);
    }

    return 0;
}
{% endblock %}
