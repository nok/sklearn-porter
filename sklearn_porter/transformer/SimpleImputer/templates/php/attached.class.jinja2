{% extends 'base.attached.class' %}

{% block content %}
{% block class %}
class {{ class_name }} {

    private $statistics;

    public function __construct($statistics) {
        $this->statistics = $statistics;
    }

    public function transform($features) {
        $values = array();
        for ($i = 0, $l = count($this->statistics); $i < $l; $i++) {
            $values[$i] = {% if missing_values_nan %}is_nan($features[$i]){% else %}$features[$i] == {{ missing_values }}{% endif %} ? $this->statistics[$i] : $features[$i];
        }
        return $values;
    }

}
{% endblock %}

if (PHP_SAPI === 'cli' && realpath($argv[0]) === __FILE__) {
    {% filter indent(4, True) %}
    {% include 'samples' %}

    {% include 'values' %}
    {% endfilter %}

    array_shift($argv);

    {% block create %}
    // Model data:
    {{ statistics }}

    // Transformer:
    ${{ instance|default('transformer') }} = new {{ class_name }}(${{ prefix }}statistics);
    {% endblock %}

    // Features of one sample (arguments) or several samples (standard input):
    foreach (readSamples($argv) as $features) {
        printValues($transformer->transform($features));
    }

}
{% endblock %}
