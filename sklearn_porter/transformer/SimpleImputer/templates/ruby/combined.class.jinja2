{% extends 'base.combined.class' %}

{% block content %}
{% block class %}
class {{ class_name }}

	def transform(features)
		[
			{% for i in range(n_features_out) %}
			{% if indicators[i] == '1' %}({% if missing_values_nan %}features[{{ inputs[i] }}].nan?{% else %}features[{{ inputs[i] }}] == {{ missing_values }}{% endif %} ? 1.0 : 0.0){% else %}({% if missing_values_nan %}features[{{ inputs[i] }}].nan?{% else %}features[{{ inputs[i] }}] == {{ missing_values }}{% endif %} ? {{ statistics[i] }} : features[{{ inputs[i] }}]){% endif %},
			{% endfor %}
		]
	end

end
{% endblock %}

if __FILE__ == $0
	{% filter indent('\t', True) %}
	{% include 'samples' %}

	{% include 'values' %}
	{% endfilter %}

	{% block create %}
	# Transformer:
	{{ instance|default('transformer') }} = {{ class_name }}.new
	{% endblock %}

	# Features of one sample (arguments) or several samples (standard input):
	read_samples(ARGV) do |features|
		print_values transformer.transform(features)
	end
end
{% endblock %}
