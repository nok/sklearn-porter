{% extends 'base.exported.class' %}

{% block content %}
require 'json'


{% block class %}
class {{ class_name }}

{% if _blocks %}
	def initialize(data)
{% else %}
	def initialize(path)
		data = JSON.parse(File.read(path))
{% endif %}
		@inputs = data['inputs']
		@statistics = data['statistics']
		@indicators = data['indicators']
	end

	def transform(features)
		Array.new(@inputs.length) { |i| {% if missing_values_nan %}features[@inputs[i]].nan?{% else %}features[@inputs[i]] == {{ missing_values }}{% endif %} ? (@indicators[i] == 1 ? 1.0 : @statistics[i]) : (@indicators[i] == 1 ? 0.0 : features[@inputs[i]]) }
	end

end
{% endblock %}

if __FILE__ == $0
	{% filter indent('\t', True) %}
	{% include 'samples' %}

	{% include 'values' %}
	{% endfilter %}

	raise "You have to pass the path to the model data." if ARGV.empty?

	# Model data:
	path = ARGV.shift

	{% block create %}
	# Transformer:
	{{ instance|default('transformer') }} = {{ class_name }}.new {{ data|default('path') }}
	{% endblock %}

	# Features of one sample (arguments) or several samples (standard input):
	read_samples(ARGV) do |features|
		print_values transformer.transform(features)
	end
end
{% endblock %}
