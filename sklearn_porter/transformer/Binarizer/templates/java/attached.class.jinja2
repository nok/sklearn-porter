{% extends 'base.attached.class' %}

{% block content %}
{% block class %}
class {{ class_name }} {

    private double[] threshold;

    public {{ class_name }}(double[] threshold) {
        this.threshold = threshold;
    }

    public double[] transform(double[] features) {
        double[] values = new double[this.threshold.length];
        for (int i = 0; i < this.threshold.length; i++) {
            values[i] = features[i] > this.threshold[i] ? 1.0 : 0.0;
        }
        return values;
    }
{% if not _blocks %}

{% include 'samples' %}

{% include 'values' %}

    public static void main(String[] args) {
        {% block create %}
        // Model data:
        {{ threshold }}

        // Transformer:
        {{ class_name }} {{ instance|default('transformer') }} = new {{ class_name }}({{ prefix }}threshold);
        {% endblock %}

        // Features of one sample (arguments) or several samples (standard input):
        for (double[] features : readSamples(args, 0)) {
            printValues(transformer.transform(features));
        }
    }
{% endif %}
}
