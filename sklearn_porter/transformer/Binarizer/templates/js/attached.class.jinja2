{% extends 'base.attached.class' %}

{% block content %}
{% block class %}
var {{ class_name }} = function(threshold) {

    this.threshold = threshold;

    this.transform = function(features) {
        var values = new Array(this.threshold.length);
        for (var i = 0, l = this.threshold.length; i < l; i++) {
            values[i] = features[i] > this.threshold[i] ? 1.0 : 0.0;
        }
        return values;
    };

};
{% endblock %}

{% include 'samples' %}

{% include 'values' %}

// Create the transformer with the model data of this file:
var createTransformer = function () {
    {% block create %}
    // Model data:
    {{ threshold }}

    // Transformer:
    var {{ instance|default('transformer') }} = new {{ class_name }}({{ prefix }}threshold);
    {% endblock %}

    return transformer;
};

var main = function () {
    // Transformer:
    var transformer = createTransformer();

    // Features of one sample (arguments) or several samples (standard input):
    readSamples(process.argv.slice(2)).forEach(function (features) {
        printValues(transformer.transform(features));
    });
}
{% endblock %}
