{% extends 'base.attached.class' %}

{% block content %}
{% block class %}
class {{ class_name }}

	def initialize(factors, offsets)
		@factors = factors
		@offsets = offsets
	end

	def transform(features)
		Array.new({{ n_features_out }}) do |i|
			(@offsets[i]...@offsets[i + 1]).reduce(1.0) { |value, j| value * features[@factors[j]] }
		end
	end

end
{% endblock %}

if __FILE__ == $0
	{% filter indent('\t', True) %}
	{% include 'samples' %}

	{% include 'values' %}
	{% endfilter %}

	{% block create %}
	# Model data:
	{{ factors }}
	{{ offsets }}

	# Transformer:
	{{ instance|default('transformer') }} = {{ class_name }}.new {{ prefix }}factors, {{ prefix }}offsets
	{% endblock %}

	# Features of one sample (arguments) or several samples (standard input):
	read_samples(ARGV) do |features|
		print_values transformer.transform(features)
	end
end
{% endblock %}
