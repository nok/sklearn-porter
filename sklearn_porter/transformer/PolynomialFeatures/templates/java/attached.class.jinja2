{% extends 'base.attached.class' %}

{% block content %}
{% block class %}
class {{ class_name }} {

    private int[] factors;
    private int[] offsets;

    public {{ class_name }}(int[] factors, int[] offsets) {
        this.factors = factors;
        this.offsets = offsets;
    }

    public double[] transform(double[] features) {
        double[] values = new double[{{ n_features_out }}];
        for (int i = 0; i < values.length; i++) {
            values[i] = 1.0;
            for (int j = this.offsets[i]; j < this.offsets[i + 1]; j++) {
                values[i] *= features[this.factors[j]];
            }
        }
        return values;
    }
{% if not _blocks %}

{% include 'samples' %}

{% include 'values' %}

    public static void main(String[] args) {
        {% block create %}
        // Model data:
        {{ factors }}
        {{ offsets }}

        // Transformer:
        {{ class_name }} {{ instance|default('transformer') }} = new {{ class_name }}({{ prefix }}factors, {{ prefix }}offsets);
        {% endblock %}

        // Features of one sample (arguments) or several samples (standard input):
        for (double[] features : readSamples(args, 0)) {
            printValues(transformer.transform(features));
        }
    }
{% endif %}
}
{% endblock %}
{% endblock %}
