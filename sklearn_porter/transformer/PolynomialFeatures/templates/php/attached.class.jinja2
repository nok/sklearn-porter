{% extends 'base.attached.class' %}

{% block content %}
{% block class %}
class {{ class_name }} {

    private $factors;
    private $offsets;

    public function __construct($factors, $offsets) {
        $this->factors = $factors;
        $this->offsets = $offsets;
    }

    public function transform($features) {
        $values = array();
        for ($i = 0; $i < {{ n_features_out }}; $i++) {
            $values[$i] = 1.0;
            for ($j = $this->offsets[$i]; $j < $this->offsets[$i + 1]; $j++) {
                $values[$i] *= $features[$this->factors[$j]];
            }
        }
        return $values;
    }

}
{% endblock %}

if (PHP_SAPI === 'cli' && realpath($argv[0]) === __FILE__) {
    {% filter indent(4, True) %}
    {% include 'samples' %}

    {% include 'values' %}
    {% endfilter %}

    array_shift($argv);

    {% block create %}
    // Model data:
    {{ factors }}
    {{ offsets }}

    // Transformer:
    ${{ instance|default('transformer') }} = new {{ class_name }}(${{ prefix }}factors, ${{ prefix }}offsets);
    {% endblock %}

    // Features of one sample (arguments) or several samples (standard input):
    foreach (readSamples($argv) as $features) {
        printValues($transformer->transform($features));
    }

}
{% endblock %}
