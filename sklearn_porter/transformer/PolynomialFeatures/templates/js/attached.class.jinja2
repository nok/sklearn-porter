{% extends 'base.attached.class' %}

{% block content %}
{% block class %}
var {{ class_name }} = function(factors, offsets) {

    this.factors = factors;
    this.offsets = offsets;

    this.transform = function(features) {
        var values = new Array({{ n_features_out }});
        for (var i = 0, l = values.length; i < l; i++) {
            values[i] = 1.0;
            for (var j = this.offsets[i]; j < this.offsets[i + 1]; j++) {
                values[i] *= features[this.factors[j]];
            }
        }
        return values;
    };

};
{% endblock %}

{% include 'samples' %}

{% include 'values' %}

var main = function () {
    {% block create %}
    // Model data:
    {{ factors }}
    {{ offsets }}

    // Transformer:
    var {{ instance|default('transformer') }} = new {{ class_name }}({{ prefix }}factors, {{ prefix }}offsets);
    {% endblock %}

    // Features of one sample (arguments) or several samples (standard input):
    readSamples(process.argv.slice(2)).forEach(function (features) {
        printValues(transformer.transform(features));
    });
}

if (require.main === module) {
    main();
}
{% endblock %}
