{% extends 'base.attached.class' %}

{% block content %}
{% block class %}
class {{ class_name }}

	def initialize(edges, offsets)
		@edges = edges
		@offsets = offsets
	end

	def transform(features)
		{% if onehot %}
		values = Array.new({{ n_features_out }}, 0.0)
		features.each_with_index do |x, i|
			values[@offsets[i] + i + (@offsets[i]...@offsets[i + 1]).count { |j| x >= @edges[j] }] = 1.0
		end
		values
		{% else %}
		Array.new(features.length) do |i|
			(@offsets[i]...@offsets[i + 1]).count { |j| features[i] >= @edges[j] }.to_f
		end
		{% endif %}
	end

end
{% endblock %}

if __FILE__ == $0
	{% filter indent('\t', True) %}
	{% include 'samples' %}

	{% include 'values' %}
	{% endfilter %}

	{% block create %}
	# Model data:
	{{ edges }}
	{{ offsets }}

	# Transformer:
	{{ instance|default('transformer') }} = {{ class_name }}.new {{ prefix }}edges, {{ prefix }}offsets
	{% endblock %}

	# Features of one sample (arguments) or several samples (standard input):
	read_samples(ARGV) do |features|
		print_values transformer.transform(features)
	end
end
{% endblock %}
