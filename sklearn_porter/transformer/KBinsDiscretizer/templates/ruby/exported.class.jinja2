{% extends 'base.exported.class' %}

{% block content %}
require 'json'


{% block class %}
class {{ class_name }}

{% if _blocks %}
	def initialize(data)
{% else %}
	def initialize(path)
		data = JSON.parse(File.read(path))
{% endif %}
		@edges = data['edges']
		@offsets = data['offsets']
	end

	def transform(features)
		{% if onehot %}
		values = Array.new({{ n_features_out }}, 0.0)
		features.each_with_index do |x, i|
			# The number of edges <= x (binary search of the sorted edges):
			j = (@offsets[i]...@offsets[i + 1]).bsearch { |k| !(x >= @edges[k]) } || @offsets[i + 1]
			values[i + j] = 1.0
		end
		values
		{% else %}
		Array.new(features.length) do |i|
			# The number of edges <= x (binary search of the sorted edges):
			j = (@offsets[i]...@offsets[i + 1]).bsearch { |k| !(features[i] >= @edges[k]) } || @offsets[i + 1]
			(j - @offsets[i]).to_f
		end
		{% endif %}
	end

end
{% endblock %}

if __FILE__ == $0
	{% filter indent('\t', True) %}
	{% include 'samples' %}

	{% include 'values' %}
	{% endfilter %}

	raise "You have to pass the path to the model data." if ARGV.empty?

	# Model data:
	path = ARGV.shift

	{% block create %}
	# Transformer:
	{{ instance|default('transformer') }} = {{ class_name }}.new {{ data|default('path') }}
	{% endblock %}

	# Features of one sample (arguments) or several samples (standard input):
	read_samples(ARGV) do |features|
		print_values transformer.transform(features)
	end
end
{% endblock %}
