{% extends 'base.combined.class' %}

{% block content %}
#include <math.h>
#include <stdio.h>
#include <stdlib.h>

{% block class %}
#define {{ prefix }}N_FEATURES {{ n_features }}
#define {{ prefix }}N_FEATURES_OUT {{ n_features_out }}


/* Write the transformed features to `values`: */
void {{ prefix }}transform(double *values, double features[{{ prefix }}N_FEATURES]) {
    {% for i in range(n_features_out) %}
    values[{{ i }}] = {% if onehot %}{% if column_lower[i] is none and column_upper[i] is none %}1.0{% else %}({% if column_lower[i] is not none %}features[{{ column_inputs[i] }}] >= {{ column_lower[i] }}{% endif %}{% if column_lower[i] is not none and column_upper[i] is not none %} && {% endif %}{% if column_upper[i] is not none %}features[{{ column_inputs[i] }}] < {{ column_upper[i] }}{% endif %}) ? 1.0 : 0.0{% endif %}{% else %}{% for e in feature_edges[i] %}(features[{{ i }}] >= {{ e }} ? 1.0 : 0.0){{ ' + ' if not loop.last }}{% else %}0.0{% endfor %}{% endif %};
    {% endfor %}
}
{% endblock %}

{% include 'samples' %}

{% include 'values' %}

int main(int argc, const char *argv[]) {
    /* Features of one sample (arguments) or several samples (standard input): */
    double features[N_FEATURES];
    while (read_features(features, argc, argv, 1)) {
        double values[N_FEATURES_OUT];
        transform(values, features);
        print_values(values, N_FEATURES_OUT);
    }

    return 0;
}
{% endblock %}
