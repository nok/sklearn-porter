{% extends 'base.exported.class' %}

{% block content %}
#include <math.h>

{% block class %}
#define {{ prefix }}N_FEATURES {{ n_features }}
#define {{ prefix }}N_FEATURES_OUT {{ n_features_out }}


double *{{ prefix }}edges;
int *{{ prefix }}offsets;

void {{ prefix }}load({{ 'JsonValue *data' if _blocks else 'const char *path' }}) {
{% if not _blocks %}
    JsonValue *data = json_read(path);
{% endif %}
    {{ prefix }}edges = json_doubles(json_get(data, "edges"));
    {{ prefix }}offsets = json_ints(json_get(data, "offsets"));
{% if not _blocks %}
    json_free(data);
{% endif %}
}

/* Write the transformed features to `values`: */
void {{ prefix }}transform(double *values, double features[{{ prefix }}N_FEATURES]) {
    {% if onehot %}
    for (int i = 0; i < {{ prefix }}N_FEATURES_OUT; i++) {
        values[i] = 0.0;
    }
    for (int i = 0; i < {{ prefix }}N_FEATURES; i++) {
        /* The number of edges <= x (binary search of the sorted edges): */
        int lo = {{ prefix }}offsets[i];
        int hi = {{ prefix }}offsets[i + 1];
        while (lo < hi) {
            int mid = (lo + hi) / 2;
            if (features[i] >= {{ prefix }}edges[mid]) {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        int bin = lo - {{ prefix }}offsets[i];
        values[{{ prefix }}offsets[i] + i + bin] = 1.0;
    }
    {% else %}
    for (int i = 0; i < {{ prefix }}N_FEATURES; i++) {
        /* The number of edges <= x (binary search of the sorted edges): */
        int lo = {{ prefix }}offsets[i];
        int hi = {{ prefix }}offsets[i + 1];
        while (lo < hi) {
            int mid = (lo + hi) / 2;
            if (features[i] >= {{ prefix }}edges[mid]) {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        values[i] = lo - {{ prefix }}offsets[i];
    }
    {% endif %}
}
{% endblock %}

{% include 'samples' %}

{% include 'values' %}

int main(int argc, const char *argv[]) {
    if (argc < 2) {
        fprintf(stderr, "You have to pass the path to the model data.\n");
        return 1;
    }

    {% block create %}
    /* Model data: */
    {{ prefix }}load({{ data|default('argv[1]') }});
    {% endblock %}

    /* Features of one sample (arguments) or several samples (standard input): */
    double features[N_FEATURES];
    while (read_features(features, argc, argv, 2)) {
        double values[N_FEATURES_OUT];
        transform(values, features);
        print_values(values, N_FEATURES_OUT);
    }

    return 0;
}
{% endblock %}
