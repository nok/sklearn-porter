{% extends 'base.attached.class' %}

{% block content %}
{% block class %}
class {{ class_name }} {

    private double[] edges;
    private int[] offsets;

    public {{ class_name }}(double[] edges, int[] offsets) {
        this.edges = edges;
        this.offsets = offsets;
    }

    public double[] transform(double[] features) {
        double[] values = new double[{{ n_features_out }}];
        {% if onehot %}
        for (int i = 0; i < features.length; i++) {
            int bin = 0;
            for (int j = this.offsets[i]; j < this.offsets[i + 1]; j++) {
                if (features[i] >= this.edges[j]) {
                    bin++;
                }
            }
            values[this.offsets[i] + i + bin] = 1.0;
        }
        {% else %}
        for (int i = 0; i < features.length; i++) {
            for (int j = this.offsets[i]; j < this.offsets[i + 1]; j++) {
                if (features[i] >= this.edges[j]) {
                    values[i] += 1.0;
                }
            }
        }
        {% endif %}
        return values;
    }
{% if not _blocks %}

{% include 'samples' %}

{% include 'values' %}

    public static void main(String[] args) {
        {% block create %}
        // Model data:
        {{ edges }}
        {{ offsets }}

        // Transformer:
        {{ class_name }} {{ instance|default('transformer') }} = new {{ class_name }}({{ prefix }}edges, {{ prefix }}offsets);
        {% endblock %}

        // Features of one sample (arguments) or several samples (standard input):
        for (double[] features : readSamples(args, 0)) {
            printValues(transformer.transform(features));
        }
    }
{% endif %}
}
{% endblock %}
{% endblock %}
