{% extends 'base.attached.class' %}

{% block content %}
package main

import (
	"bufio"
	"fmt"
	"math"
	"os"
	"strconv"
	"strings"
)

{% block class %}
type {{ class_name }} struct {
	Edges   []float64
	Offsets []int
}

func (transformer {{ class_name }}) Transform(features []float64) []float64 {
	values := make([]float64, {{ n_features_out }})
	{% if onehot %}
	for i := range features {
		bin := 0
		for j := transformer.Offsets[i]; j < transformer.Offsets[i+1]; j++ {
			if features[i] >= transformer.Edges[j] {
				bin++
			}
		}
		values[transformer.Offsets[i]+i+bin] = 1
	}
	{% else %}
	for i := range features {
		for j := transformer.Offsets[i]; j < transformer.Offsets[i+1]; j++ {
			if features[i] >= transformer.Edges[j] {
				values[i]++
			}
		}
	}
	{% endif %}
	return values
}
{% endblock %}

{% include 'samples' %}

{% include 'values' %}

{% block data %}
// Model data:
{{ edges }}
{{ offsets }}
{% endblock %}

func main() {
	{% block create %}
	// Transformer:
	{{ instance|default('transformer') }} := {{ class_name ~ '{' }}{{ prefix }}edges, {{ prefix }}offsets}
	{% endblock %}

	// Features of one sample (arguments) or several samples (standard input):
	readSamples(os.Args[1:], func(features []float64) {
		printValues(transformer.Transform(features))
	})
}
{% endblock %}
