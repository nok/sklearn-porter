{% extends 'base.attached.class' %}

{% block content %}
package main

import (
	"bufio"
	"fmt"
	"math"
	"os"
	"strconv"
	"strings"
)

{% block class %}
type {{ class_name }} struct {
	Edges   []float64
	Offsets []int
}

func (transformer {{ class_name }}) Transform(features []float64) []float64 {
	values := make([]float64, {{ n_features_out }})
	{% if onehot %}
	for i := range features {
		// The number of edges <= x (binary search of the sorted edges):
		lo, hi := transformer.Offsets[i], transformer.Offsets[i+1]
		for lo < hi {
			mid := (lo + hi) / 2
			if features[i] >= transformer.Edges[mid] {
				lo = mid + 1
			} else {
				hi = mid
			}
		}
		bin := lo - transformer.Offsets[i]
		values[transformer.Offsets[i]+i+bin] = 1
	}
	{% else %}
	for i := range features {
		// The number of edges <= x (binary search of the sorted edges):
		lo, hi := transformer.Offsets[i], transformer.Offsets[i+1]
		for lo < hi {
			mid := (lo + hi) / 2
			if features[i] >= transformer.Edges[mid] {
				lo = mid + 1
			} else {
				hi = mid
			}
		}
		values[i] = float64(lo - transformer.Offsets[i])
	}
	{% endif %}
	return values
}
{% endblock %}

{% include 'samples' %}

{% include 'values' %}

{% block data %}
// Model data:
{{ edges }}
{{ offsets }}
{% endblock %}

func main() {
	{% block create %}
	// Transformer:
	{{ instance|default('transformer') }} := {{ class_name ~ '{' }}{{ prefix }}edges, {{ prefix }}offsets}
	{% endblock %}

	// Features of one sample (arguments) or several samples (standard input):
	readSamples(os.Args[1:], func(features []float64) {
		printValues(transformer.Transform(features))
	})
}
{% endblock %}
