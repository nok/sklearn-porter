{% extends 'base.attached.class' %}

{% block content %}
{% block class %}
class {{ class_name }} {

    private $edges;
    private $offsets;

    public function __construct($edges, $offsets) {
        $this->edges = $edges;
        $this->offsets = $offsets;
    }

    public function transform($features) {
        $values = array();
        for ($i = 0, $l = count($features); $i < $l; $i++) {
            $values[$i] = 0.0;
            for ($j = $this->offsets[$i]; $j < $this->offsets[$i + 1]; $j++) {
                if ($features[$i] >= $this->edges[$j]) {
                    $values[$i] += 1.0;
                }
            }
        }
        return $values;
    }

}
{% endblock %}

if (PHP_SAPI === 'cli' && realpath($argv[0]) === __FILE__) {
    {% filter indent(4, True) %}
    {% include 'samples' %}

    {% include 'values' %}
    {% endfilter %}

    array_shift($argv);

    {% block create %}
    // Model data:
    {{ edges }}
    {{ offsets }}

    // Transformer:
    ${{ instance|default('transformer') }} = new {{ class_name }}(${{ prefix }}edges, ${{ prefix }}offsets);
    {% endblock %}

    // Features of one sample (arguments) or several samples (standard input):
    foreach (readSamples($argv) as $features) {
        printValues($transformer->transform($features));
    }

}
{% endblock %}
