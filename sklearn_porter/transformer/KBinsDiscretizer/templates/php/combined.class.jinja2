{% extends 'base.combined.class' %}

{% block content %}
{% block class %}
class {{ class_name }} {

    public function transform($features) {
        return array(
            {% for i in range(n_features_out) %}
            {% if onehot %}{% if column_lower[i] is none and column_upper[i] is none %}1.0{% else %}({% if column_lower[i] is not none %}$features[{{ column_inputs[i] }}] >= {{ column_lower[i] }}{% endif %}{% if column_lower[i] is not none and column_upper[i] is not none %} && {% endif %}{% if column_upper[i] is not none %}$features[{{ column_inputs[i] }}] < {{ column_upper[i] }}{% endif %}) ? 1.0 : 0.0{% endif %}{% else %}{% for e in feature_edges[i] %}($features[{{ i }}] >= {{ e }} ? 1.0 : 0.0){{ ' + ' if not loop.last }}{% else %}0.0{% endfor %}{% endif %},
            {% endfor %}
        );
    }

}
{% endblock %}

if (PHP_SAPI === 'cli' && realpath($argv[0]) === __FILE__) {
    {% filter indent(4, True) %}
    {% include 'samples' %}

    {% include 'values' %}
    {% endfilter %}

    array_shift($argv);

    {% block create %}
    // Transformer:
    ${{ instance|default('transformer') }} = new {{ class_name }}();
    {% endblock %}

    // Features of one sample (arguments) or several samples (standard input):
    foreach (readSamples($argv) as $features) {
        printValues($transformer->transform($features));
    }

}
{% endblock %}
