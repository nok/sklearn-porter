{% extends 'base.exported.class' %}

{% block content %}
{% block class %}
var {{ class_name }} = function(data) {
    this.data = readModelData(data);

    this.transform = function(features) {
        var values = new Array({{ n_features_out }});
        {% if onehot %}
        values.fill(0.0);
        for (var i = 0, l = features.length; i < l; i++) {
            // The number of edges <= x (binary search of the sorted edges):
            var lo = this.data.offsets[i];
            var hi = this.data.offsets[i + 1];
            while (lo < hi) {
                var mid = (lo + hi) >> 1;
                if (features[i] >= this.data.edges[mid]) {
                    lo = mid + 1;
                } else {
                    hi = mid;
                }
            }
            var bin = lo - this.data.offsets[i];
            values[this.data.offsets[i] + i + bin] = 1.0;
        }
        {% else %}
        for (var i = 0, l = features.length; i < l; i++) {
            // The number of edges <= x (binary search of the sorted edges):
            var lo = this.data.offsets[i];
            var hi = this.data.offsets[i + 1];
            while (lo < hi) {
                var mid = (lo + hi) >> 1;
                if (features[i] >= this.data.edges[mid]) {
                    lo = mid + 1;
                } else {
                    hi = mid;
                }
            }
            values[i] = lo - this.data.offsets[i];
        }
        {% endif %}
        return values;
    };
};
{% endblock %}

{% include 'samples' %}

{% include 'values' %}

var main = function () {
    if (process.argv.length < 3) {
        throw new Error("You have to pass the path to the model data.");
    }

    {% block create %}
    // Transformer:
    var {{ instance|default('transformer') }} = new {{ class_name }}({{ data|default('process.argv[2]') }});
    {% endblock %}

    // Features of one sample (arguments) or several samples (standard input):
    readSamples(process.argv.slice(3)).forEach(function (features) {
        printValues(transformer.transform(features));
    });
}
{% endblock %}
