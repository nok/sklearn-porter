{% extends 'base.attached.class' %}

{% block content %}
{% block class %}
var {{ class_name }} = function(edges, offsets) {

    this.edges = edges;
    this.offsets = offsets;

    this.transform = function(features) {
        var values = new Array({{ n_features_out }});
        {% if onehot %}
        values.fill(0.0);
        for (var i = 0, l = features.length; i < l; i++) {
            // The number of edges <= x (binary search of the sorted edges):
            var lo = this.offsets[i];
            var hi = this.offsets[i + 1];
            while (lo < hi) {
                var mid = (lo + hi) >> 1;
                if (features[i] >= this.edges[mid]) {
                    lo = mid + 1;
                } else {
                    hi = mid;
                }
            }
            var bin = lo - this.offsets[i];
            values[this.offsets[i] + i + bin] = 1.0;
        }
        {% else %}
        for (var i = 0, l = features.length; i < l; i++) {
            // The number of edges <= x (binary search of the sorted edges):
            var lo = this.offsets[i];
            var hi = this.offsets[i + 1];
            while (lo < hi) {
                var mid = (lo + hi) >> 1;
                if (features[i] >= this.edges[mid]) {
                    lo = mid + 1;
                } else {
                    hi = mid;
                }
            }
            values[i] = lo - this.offsets[i];
        }
        {% endif %}
        return values;
    };

};
{% endblock %}

{% include 'samples' %}

{% include 'values' %}

var main = function () {
    {% block create %}
    // Model data:
    {{ edges }}
    {{ offsets }}

    // Transformer:
    var {{ instance|default('transformer') }} = new {{ class_name }}({{ prefix }}edges, {{ prefix }}offsets);
    {% endblock %}

    // Features of one sample (arguments) or several samples (standard input):
    readSamples(process.argv.slice(2)).forEach(function (features) {
        printValues(transformer.transform(features));
    });
}

if (require.main === module) {
    main();
}
{% endblock %}
