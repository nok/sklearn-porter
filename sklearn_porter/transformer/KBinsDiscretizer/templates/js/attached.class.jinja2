{% extends 'base.attached.class' %}

{% block content %}
{% block class %}
var {{ class_name }} = function(edges, offsets) {

    this.edges = edges;
    this.offsets = offsets;

    this.transform = function(features) {
        var values = new Array(features.length);
        for (var i = 0, l = features.length; i < l; i++) {
            values[i] = 0.0;
            for (var j = this.offsets[i]; j < this.offsets[i + 1]; j++) {
                if (features[i] >= this.edges[j]) {
                    values[i] += 1.0;
                }
            }
        }
        return values;
    };

};
{% endblock %}

{% include 'samples' %}

{% include 'values' %}

var main = function () {
    {% block create %}
    // Model data:
    {{ edges }}
    {{ offsets }}

    // Transformer:
    var {{ instance|default('transformer') }} = new {{ class_name }}({{ prefix }}edges, {{ prefix }}offsets);
    {% endblock %}

    // Features of one sample (arguments) or several samples (standard input):
    readSamples(process.argv.slice(2)).forEach(function (features) {
        printValues(transformer.transform(features));
    });
}

if (require.main === module) {
    main();
}
{% endblock %}
