{% extends 'base.attached.class' %}

{% block content %}
{% block class %}
var {{ class_name }} = function(inputs, categories, encodings, offsets, missing, nans, unknowns) {

    this.inputs = inputs;
    this.categories = categories;
    this.encodings = encodings;
    this.offsets = offsets;
    this.missing = missing;
    this.nans = nans;
    this.unknowns = unknowns;

    this.transform = function(features) {
        var values = new Array({{ n_features_out }});
        for (var i = 0, l = values.length; i < l; i++) {
            var x = features[this.inputs[i]];
            if (isNaN(x)) {
                values[i] = this.missing[i] === 1 ? this.nans[i] : this.unknowns[i];
                continue;
            }
            values[i] = this.unknowns[i];
            // The position of x (binary search of the sorted categories):
            var lo = this.offsets[i];
            var hi = this.offsets[i + 1];
            while (lo < hi) {
                var mid = (lo + hi) >> 1;
                if (this.categories[mid] < x) {
                    lo = mid + 1;
                } else {
                    hi = mid;
                }
            }
            if (lo < this.offsets[i + 1] && this.categories[lo] === x) {
                values[i] = this.encodings[lo];
            }
        }
        return values;
    };

};
{% endblock %}

{% include 'samples' %}

{% include 'values' %}

var main = function () {
    {% block create %}
    // Model data:
    {{ inputs }}
    {{ categories }}
    {{ encodings }}
    {{ offsets }}
    {{ missing }}
    {{ nans }}
    {{ unknowns }}

    // Transformer:
    var {{ instance|default('transformer') }} = new {{ class_name }}({{ prefix }}inputs, {{ prefix }}categories, {{ prefix }}encodings, {{ prefix }}offsets, {{ prefix }}missing, {{ prefix }}nans, {{ prefix }}unknowns);
    {% endblock %}

    // Features of one sample (arguments) or several samples (standard input):
    readSamples(process.argv.slice(2)).forEach(function (features) {
        printValues(transformer.transform(features));
    });
}

if (require.main === module) {
    main();
}
{% endblock %}
