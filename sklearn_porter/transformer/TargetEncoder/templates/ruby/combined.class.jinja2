{% extends 'base.combined.class' %}

{% block content %}
{% block class %}
class {{ class_name }}

	def transform(features)
		[
			{% for i in range(n_features_out) %}
			features[{{ inputs[i] }}].nan? ? {{ column_nan[i] }} : {% for c, e in column_pairs[i] %}(features[{{ inputs[i] }}] == {{ c }} ? {{ e }} : {% endfor %}{{ column_unknown[i] }}{{ ')' * column_pairs[i]|length }},
			{% endfor %}
		]
	end

end
{% endblock %}

if __FILE__ == $0
	{% filter indent('\t', True) %}
	{% include 'samples' %}

	{% include 'values' %}
	{% endfilter %}

	{% block create %}
	# Transformer:
	{{ instance|default('transformer') }} = {{ class_name }}.new
	{% endblock %}

	# Features of one sample (arguments) or several samples (standard input):
	read_samples(ARGV) do |features|
		print_values transformer.transform(features)
	end
end
{% endblock %}
