{% extends 'base.exported.class' %}

{% block content %}
require 'json'


{% block class %}
class {{ class_name }}

{% if _blocks %}
	def initialize(data)
{% else %}
	def initialize(path)
		data = JSON.parse(File.read(path))
{% endif %}
		@inputs = data['inputs']
		@categories = data['categories']
		@encodings = data['encodings']
		@offsets = data['offsets']
		@missing = data['missing']
		@nans = data['nans']
		@unknowns = data['unknowns']
	end

	def transform(features)
		Array.new({{ n_features_out }}) do |i|
			x = features[@inputs[i]]
			if x.nan?
				@missing[i] == 1 ? @nans[i] : @unknowns[i]
			else
				j = (@offsets[i]...@offsets[i + 1]).find { |k| x == @categories[k] }
				j.nil? ? @unknowns[i] : @encodings[j]
			end
		end
	end

end
{% endblock %}

if __FILE__ == $0
	{% filter indent('\t', True) %}
	{% include 'samples' %}

	{% include 'values' %}
	{% endfilter %}

	raise "You have to pass the path to the model data." if ARGV.empty?

	# Model data:
	path = ARGV.shift

	{% block create %}
	# Transformer:
	{{ instance|default('transformer') }} = {{ class_name }}.new {{ data|default('path') }}
	{% endblock %}

	# Features of one sample (arguments) or several samples (standard input):
	read_samples(ARGV) do |features|
		print_values transformer.transform(features)
	end
end
{% endblock %}
