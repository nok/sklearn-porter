{% extends 'base.attached.class' %}

{% block content %}
#include <math.h>
#include <stdio.h>
#include <stdlib.h>

{% block class %}
#define {{ prefix }}N_FEATURES {{ n_features }}
#define {{ prefix }}N_FEATURES_OUT {{ n_features_out }}


{{ inputs }}
{{ categories }}
{{ encodings }}
{{ offsets }}
{{ missing }}
{{ nans }}
{{ unknowns }}

/* Write the transformed features to `values`: */
void {{ prefix }}transform(double *values, double features[{{ prefix }}N_FEATURES]) {
    for (int i = 0; i < {{ prefix }}N_FEATURES_OUT; i++) {
        double x = features[{{ prefix }}inputs[i]];
        if (isnan(x)) {
            values[i] = {{ prefix }}missing[i] ? {{ prefix }}nans[i] : {{ prefix }}unknowns[i];
            continue;
        }
        values[i] = {{ prefix }}unknowns[i];
        /* The position of x (binary search of the sorted categories): */
        int lo = {{ prefix }}offsets[i];
        int hi = {{ prefix }}offsets[i + 1];
        while (lo < hi) {
            int mid = (lo + hi) / 2;
            if ({{ prefix }}categories[mid] < x) {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        if (lo < {{ prefix }}offsets[i + 1] && {{ prefix }}categories[lo] == x) {
            values[i] = {{ prefix }}encodings[lo];
        }
    }
}
{% endblock %}

{% include 'samples' %}

{% include 'values' %}

int main(int argc, const char *argv[]) {
    /* Features of one sample (arguments) or several samples (standard input): */
    double features[N_FEATURES];
    while (read_features(features, argc, argv, 1)) {
        double values[N_FEATURES_OUT];
        transform(values, features);
        print_values(values, N_FEATURES_OUT);
    }

    return 0;
}
{% endblock %}
