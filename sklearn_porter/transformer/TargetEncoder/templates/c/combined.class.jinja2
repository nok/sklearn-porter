{% extends 'base.combined.class' %}

{% block content %}
#include <math.h>
#include <stdio.h>
#include <stdlib.h>

{% block class %}
{# A balanced tree of comparisons of x with the sorted categories (the items, with their codes as pairs or with their positions as codes): #}
{% macro search(x, items, pairs, unknown, lo, hi) %}{% if hi <= lo %}{{ unknown }}{% elif hi - lo == 1 %}({{ x }} == {{ items[lo][0] if pairs else items[lo] }} ? {{ items[lo][1] if pairs else lo ~ '.0' }} : {{ unknown }}){% else %}{% set mid = (lo + hi) // 2 %}({{ x }} < {{ items[mid][0] if pairs else items[mid] }} ? {{ search(x, items, pairs, unknown, lo, mid) }} : {{ search(x, items, pairs, unknown, mid, hi) }}){% endif %}{% endmacro %}
#define {{ prefix }}N_FEATURES {{ n_features }}
#define {{ prefix }}N_FEATURES_OUT {{ n_features_out }}


/* Write the transformed features to `values`: */
void {{ prefix }}transform(double *values, double features[{{ prefix }}N_FEATURES]) {
    {% for i in range(n_features_out) %}
    values[{{ i }}] = isnan(features[{{ inputs[i] }}]) ? {{ column_nan[i] }} : {{ search('features[' ~ inputs[i] ~ ']', column_pairs[i], true, column_unknown[i], 0, column_pairs[i]|length) }};
    {% endfor %}
}
{% endblock %}

{% include 'samples' %}

{% include 'values' %}

int main(int argc, const char *argv[]) {
    /* Features of one sample (arguments) or several samples (standard input): */
    double features[N_FEATURES];
    while (read_features(features, argc, argv, 1)) {
        double values[N_FEATURES_OUT];
        transform(values, features);
        print_values(values, N_FEATURES_OUT);
    }

    return 0;
}
{% endblock %}
