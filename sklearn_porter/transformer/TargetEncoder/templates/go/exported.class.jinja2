{% extends 'base.exported.class' %}

{% block content %}
package main

import (
	"bufio"
	"encoding/json"
	"fmt"
	"math"
	"os"
	"strconv"
	"strings"
)

{% block class %}
type {{ class_name }} struct {
	Inputs     []int `json:"inputs"`
	Categories []float64 `json:"categories"`
	Encodings  []float64 `json:"encodings"`
	Offsets    []int `json:"offsets"`
	Missing    []int `json:"missing"`
	Nans       []float64 `json:"nans"`
	Unknowns   []float64 `json:"unknowns"`
}

func (transformer {{ class_name }}) Transform(features []float64) []float64 {
	values := make([]float64, {{ n_features_out }})
	for i := range values {
		x := features[transformer.Inputs[i]]
		if math.IsNaN(x) {
			if transformer.Missing[i] == 1 {
				values[i] = transformer.Nans[i]
			} else {
				values[i] = transformer.Unknowns[i]
			}
			continue
		}
		values[i] = transformer.Unknowns[i]
		for j := transformer.Offsets[i]; j < transformer.Offsets[i+1]; j++ {
			if x == transformer.Categories[j] {
				values[i] = transformer.Encodings[j]
				break
			}
		}
	}
	return values
}
{% endblock %}

{% include 'samples' %}

{% include 'values' %}

func main() {
	if len(os.Args) < 2 {
		fmt.Fprintln(os.Stderr, "You have to pass the path to the model data.")
		os.Exit(1)
	}

	// Model data:
	byteValue, err := os.ReadFile(os.Args[1])
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}

	{% block create %}
	// Transformer:
	var {{ instance|default('transformer') }} {{ class_name }}
	if err := json.Unmarshal({{ data|default('byteValue') }}, &{{ instance|default('transformer') }}); err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
	{% endblock %}

	// Features of one sample (arguments) or several samples (standard input):
	readSamples(os.Args[2:], func(features []float64) {
		printValues(transformer.Transform(features))
	})
}
{% endblock %}
