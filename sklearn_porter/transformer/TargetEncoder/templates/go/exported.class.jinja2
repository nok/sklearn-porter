{% extends 'base.exported.class' %}

{% block content %}
package main

import (
	"bufio"
	"encoding/json"
	"fmt"
	"math"
	"os"
	"strconv"
	"strings"
)

{% block class %}
type {{ class_name }} struct {
	Inputs     []int `json:"inputs"`
	Categories []float64 `json:"categories"`
	Encodings  []float64 `json:"encodings"`
	Offsets    []int `json:"offsets"`
	Missing    []int `json:"missing"`
	Nans       []float64 `json:"nans"`
	Unknowns   []float64 `json:"unknowns"`
}

func (transformer {{ class_name }}) Transform(features []float64) []float64 {
	values := make([]float64, {{ n_features_out }})
	for i := range values {
		x := features[transformer.Inputs[i]]
		if math.IsNaN(x) {
			if transformer.Missing[i] == 1 {
				values[i] = transformer.Nans[i]
			} else {
				values[i] = transformer.Unknowns[i]
			}
			continue
		}
		values[i] = transformer.Unknowns[i]
		// The position of x (binary search of the sorted categories):
		lo, hi := transformer.Offsets[i], transformer.Offsets[i+1]
		for lo < hi {
			mid := (lo + hi) / 2
			if transformer.Categories[mid] < x {
				lo = mid + 1
			} else {
				hi = mid
			}
		}
		if lo < transformer.Offsets[i+1] && transformer.Categories[lo] == x {
			values[i] = transformer.Encodings[lo]
		}
	}
	return values
}
{% endblock %}

{% include 'samples' %}

{% include 'values' %}

// Load the transformer with the model data of a JSON file:
func Load{{ class_name }}(path string) ({{ class_name }}, error) {
	// Model data:
	byteValue, err := os.ReadFile(path)
	if err != nil {
		return {{ class_name }}{}, err
	}

	{% with on_error = 'return ' ~ class_name ~ '{}, err' %}
	{% block create scoped %}
	// Transformer:
	var {{ instance|default('transformer') }} {{ class_name }}
	if err := json.Unmarshal({{ data|default('byteValue') }}, &{{ instance|default('transformer') }}); err != nil {
		{% if on_error %}
		{{ on_error }}
		{% else %}
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
		{% endif %}
	}
	{% endblock %}
	{% endwith %}

	return transformer, nil
}

func main() {
	if len(os.Args) < 2 {
		fmt.Fprintln(os.Stderr, "You have to pass the path to the model data.")
		os.Exit(1)
	}

	// Transformer:
	transformer, err := Load{{ class_name }}(os.Args[1])
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}

	// Features of one sample (arguments) or several samples (standard input):
	readSamples(os.Args[2:], func(features []float64) {
		printValues(transformer.Transform(features))
	})
}
{% endblock %}
