{% extends 'base.attached.class' %}

{% block content %}
package main

import (
	"bufio"
	"fmt"
	"math"
	"os"
	"strconv"
	"strings"
)

{% block class %}
type {{ class_name }} struct {
	Inputs     []int
	Categories []float64
	Encodings  []float64
	Offsets    []int
	Missing    []int
	Nans       []float64
	Unknowns   []float64
}

func (transformer {{ class_name }}) Transform(features []float64) []float64 {
	values := make([]float64, {{ n_features_out }})
	for i := range values {
		x := features[transformer.Inputs[i]]
		if math.IsNaN(x) {
			if transformer.Missing[i] == 1 {
				values[i] = transformer.Nans[i]
			} else {
				values[i] = transformer.Unknowns[i]
			}
			continue
		}
		values[i] = transformer.Unknowns[i]
		// The position of x (binary search of the sorted categories):
		lo, hi := transformer.Offsets[i], transformer.Offsets[i+1]
		for lo < hi {
			mid := (lo + hi) / 2
			if transformer.Categories[mid] < x {
				lo = mid + 1
			} else {
				hi = mid
			}
		}
		if lo < transformer.Offsets[i+1] && transformer.Categories[lo] == x {
			values[i] = transformer.Encodings[lo]
		}
	}
	return values
}
{% endblock %}

{% include 'samples' %}

{% include 'values' %}

{% block data %}
// Model data:
{{ inputs }}
{{ categories }}
{{ encodings }}
{{ offsets }}
{{ missing }}
{{ nans }}
{{ unknowns }}
{% endblock %}

func main() {
	{% block create %}
	// Transformer:
	{{ instance|default('transformer') }} := {{ class_name ~ '{' }}{{ prefix }}inputs, {{ prefix }}categories, {{ prefix }}encodings, {{ prefix }}offsets, {{ prefix }}missing, {{ prefix }}nans, {{ prefix }}unknowns}
	{% endblock %}

	// Features of one sample (arguments) or several samples (standard input):
	readSamples(os.Args[1:], func(features []float64) {
		printValues(transformer.Transform(features))
	})
}
{% endblock %}
