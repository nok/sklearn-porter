{% extends 'base.exported.class' %}

{% block content %}
{% block class %}
class {{ class_name }} {

    private $inputs;
    private $categories;
    private $encodings;
    private $offsets;
    private $missing;
    private $nans;
    private $unknowns;

{% if _blocks %}
    public function __construct($data) {
{% else %}
    public function __construct($path) {
        $data = json_decode(file_get_contents($path, true), true);
{% endif %}
        $this->inputs = $data['inputs'];
        $this->categories = $data['categories'];
        $this->encodings = $data['encodings'];
        $this->offsets = $data['offsets'];
        $this->missing = $data['missing'];
        $this->nans = $data['nans'];
        $this->unknowns = $data['unknowns'];
    }

    public function transform($features) {
        $values = array();
        for ($i = 0; $i < {{ n_features_out }}; $i++) {
            $x = $features[$this->inputs[$i]];
            if (is_nan($x)) {
                $values[$i] = $this->missing[$i] == 1 ? $this->nans[$i] : $this->unknowns[$i];
                continue;
            }
            $values[$i] = $this->unknowns[$i];
            // The position of x (binary search of the sorted categories):
            $lo = $this->offsets[$i];
            $hi = $this->offsets[$i + 1];
            while ($lo < $hi) {
                $mid = ($lo + $hi) >> 1;
                if ($this->categories[$mid] < $x) {
                    $lo = $mid + 1;
                } else {
                    $hi = $mid;
                }
            }
            if ($lo < $this->offsets[$i + 1] && $this->categories[$lo] == $x) {
                $values[$i] = $this->encodings[$lo];
            }
        }
        return $values;
    }

}
{% endblock %}

if (PHP_SAPI === 'cli' && realpath($argv[0]) === __FILE__) {
    {% filter indent(4, True) %}
    {% include 'samples' %}

    {% include 'values' %}
    {% endfilter %}

    if (count($argv) < 2) {
        fwrite(STDERR, "You have to pass the path to the model data.\n");
        exit(1);
    }

    array_shift($argv);

    {% block create %}
    // Transformer:
    ${{ instance|default('transformer') }} = new {{ class_name }}({{ data|default('array_shift($argv)') }});
    {% endblock %}

    // Features of one sample (arguments) or several samples (standard input):
    foreach (readSamples($argv) as $features) {
        printValues($transformer->transform($features));
    }

}
{% endblock %}
