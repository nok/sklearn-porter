{% extends 'base.attached.class' %}

{% block content %}
{% block class %}
public class {{ class_name }} {

    private int[] inputs;
    private double[] categories;
    private double[] encodings;
    private int[] offsets;
    private int[] missing;
    private double[] nans;
    private double[] unknowns;

    public {{ class_name }}(int[] inputs, double[] categories, double[] encodings, int[] offsets, int[] missing, double[] nans, double[] unknowns) {
        this.inputs = inputs;
        this.categories = categories;
        this.encodings = encodings;
        this.offsets = offsets;
        this.missing = missing;
        this.nans = nans;
        this.unknowns = unknowns;
    }

    public double[] Transform(double[] features) {
        double[] values = new double[{{ n_features_out }}];
        for (int i = 0; i < values.Length; i++) {
            double x = features[this.inputs[i]];
            if (double.IsNaN(x)) {
                values[i] = this.missing[i] == 1 ? this.nans[i] : this.unknowns[i];
                continue;
            }
            values[i] = this.unknowns[i];
            // The position of x (binary search of the sorted categories):
            int lo = this.offsets[i];
            int hi = this.offsets[i + 1];
            while (lo < hi) {
                int mid = (lo + hi) / 2;
                if (this.categories[mid] < x) {
                    lo = mid + 1;
                } else {
                    hi = mid;
                }
            }
            if (lo < this.offsets[i + 1] && this.categories[lo] == x) {
                values[i] = this.encodings[lo];
            }
        }
        return values;
    }
{% if not _blocks %}

{% include 'samples' %}

{% include 'values' %}


    public static void Main(string[] args) {
        {% block create %}
        // Model data:
        {{ inputs }}
        {{ categories }}
        {{ encodings }}
        {{ offsets }}
        {{ missing }}
        {{ nans }}
        {{ unknowns }}

        // Transformer:
        {{ class_name }} {{ instance|default('transformer') }} = new {{ class_name }}({{ prefix }}inputs, {{ prefix }}categories, {{ prefix }}encodings, {{ prefix }}offsets, {{ prefix }}missing, {{ prefix }}nans, {{ prefix }}unknowns);
        {% endblock %}

        // Features of one sample (arguments) or several samples (standard input):
        foreach (double[] features in ReadSamples(args, 0)) {
            PrintValues(transformer.Transform(features));
        }
    }
{% endif %}
}
