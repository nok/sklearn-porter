{% extends 'base.combined.class' %}

{% block content %}
{% block class %}
class {{ class_name }}

	def initialize
		@vocabulary = {
			{% for term in vocabulary %}
			{{ term }} => {{ loop.index0 }},
			{% endfor %}
		}
		{% if n_stop_words %}
		@stop_words = {
			{% for word in stop_words %}
			{{ word }} => true,
			{% endfor %}
		}
		{% endif %}
	end

	def transform(document)
		{% if lowercase %}
		document = document.downcase
		{% endif %}
		# The tokens are the runs of two or more word characters{% if n_stop_words %} (without the stop words){% endif %}:
		tokens = document.scan(/[\p{L}\p{N}_]{2,}/){% if n_stop_words %}.reject { |token| @stop_words.key?(token) }{% endif +%}
		# Count the n-grams of the tokens (joined by spaces):
		values = Array.new({{ n_features_out }}, 0.0)
		({{ min_n }}..[{{ max_n }}, tokens.length].min).each do |n|
			(0..tokens.length - n).each do |i|
				index = @vocabulary[tokens[i, n].join(' ')]
				values[index] {{ '= 1.0' if binary else '+= 1.0' }} unless index.nil?
			end
		end
		{% if tfidf %}
		# Weight the counts with the idf and normalize them (tf-idf):
		{% for i in range(n_features) %}
		values[{{ i }}] = values[{{ i }}] == 0 ? 0.0 : {% if sublinear_tf %}(Math.log(values[{{ i }}]) + 1.0){% else %}values[{{ i }}]{% endif %} * {{ idf[i] }}
		{% endfor %}
		{% if norm %}
		# Normalize the features, if their norm isn't zero:
		norm = 0.0
		values.each { |value| norm += {% if norm == 'l1' %}value.abs{% else %}value * value{% endif %} }
		unless norm == 0
			{% if norm == 'l2' %}
			norm = Math.sqrt(norm)
			{% endif %}
			values.map! { |value| value / norm }
		end
		{% endif %}
		{% endif %}
		values
	end

end
{% endblock %}

if __FILE__ == $0
	{% filter indent('\t', True) %}
	{% include 'documents' %}

	{% include 'values' %}
	{% endfilter %}

	{% block create %}
	# Transformer:
	{{ instance|default('transformer') }} = {{ class_name }}.new
	{% endblock %}

	# One document (arguments) or several documents (standard input):
	read_documents(ARGV) do |document|
		print_values transformer.transform(document)
	end
end
{% endblock %}
