{% extends 'base.exported.class' %}

{% block content %}
package main

import (
	"bufio"
	"encoding/json"
	"fmt"
	"math"
	"os"
	"regexp"
	"strconv"
	"strings"
)

{% block class %}
// The pattern of the tokens:
var {{ prefix }}tokenPattern = regexp.MustCompile(`[\p{L}\p{N}_]{2,}`)

type {{ class_name }} struct {
	Vocabulary map[string]int
	{% if n_stop_words %}
	StopWords  map[string]bool
	{% endif %}
	{% if tfidf %}
	Idf        []float64
	{% endif %}
}

func new{{ class_name }}(vocabulary []string{% if n_stop_words %}, stopWords []string{% endif %}{% if tfidf %}, idf []float64{% endif %}) {{ class_name }} {
	transformer := {{ class_name }}{Vocabulary: map[string]int{}{% if n_stop_words %}, StopWords: map[string]bool{}{% endif %}{% if tfidf %}, Idf: idf{% endif %}}
	for i, term := range vocabulary {
		transformer.Vocabulary[term] = i
	}
	{% if n_stop_words %}
	for _, word := range stopWords {
		transformer.StopWords[word] = true
	}
	{% endif %}
	return transformer
}

func (transformer {{ class_name }}) Transform(document string) []float64 {
	{% if lowercase %}
	document = strings.ToLower(document)
	{% endif %}
	// The tokens are the runs of two or more word characters{% if n_stop_words %} (without the stop words){% endif %}:
	var tokens []string
	for _, token := range {{ prefix }}tokenPattern.FindAllString(document, -1) {
		{% if n_stop_words %}
		if !transformer.StopWords[token] {
			tokens = append(tokens, token)
		}
		{% else %}
		tokens = append(tokens, token)
		{% endif %}
	}
	// Count the n-grams of the tokens (joined by spaces):
	values := make([]float64, {{ n_features_out }})
	for n := {{ min_n }}; n <= {{ max_n }} && n <= len(tokens); n++ {
		for i := 0; i+n <= len(tokens); i++ {
			if index, ok := transformer.Vocabulary[strings.Join(tokens[i:i+n], " ")]; ok {
				values[index] {{ '= 1.0' if binary else '+= 1.0' }}
			}
		}
	}
	{% if tfidf %}
	// Weight the counts with the idf and normalize them (tf-idf):
	for i := range values {
		if values[i] != 0 {
			values[i] = {% if sublinear_tf %}(math.Log(values[i]) + 1.0){% else %}values[i]{% endif %} * transformer.Idf[i]
		}
	}
	{% if norm %}
	// Normalize the features, if their norm isn't zero:
	norm := 0.0
	for _, value := range values {
		norm += {% if norm == 'l1' %}math.Abs(value){% else %}float64(value*value){% endif +%}
	}
	if norm != 0 {
		{% if norm == 'l2' %}
		norm = math.Sqrt(norm)
		{% endif %}
		for i := range values {
			values[i] /= norm
		}
	}
	{% endif %}
	{% endif %}
	return values
}
{% endblock %}

{% include 'documents' %}

{% include 'values' %}

func main() {
	if len(os.Args) < 2 {
		fmt.Fprintln(os.Stderr, "You have to pass the path to the model data.")
		os.Exit(1)
	}

	// Model data:
	byteValue, err := os.ReadFile(os.Args[1])
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}

	{% block create %}
	// Transformer:
	var {{ prefix }}data struct {
		Vocabulary []string `json:"vocabulary"`
		{% if n_stop_words %}
		StopWords  []string `json:"stop_words"`
		{% endif %}
		{% if tfidf %}
		Idf        []float64 `json:"idf"`
		{% endif %}
	}
	if err := json.Unmarshal({{ data|default('byteValue') }}, &{{ prefix }}data); err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
	{{ instance|default('transformer') }} := new{{ class_name }}({{ prefix }}data.Vocabulary{% if n_stop_words %}, {{ prefix }}data.StopWords{% endif %}{% if tfidf %}, {{ prefix }}data.Idf{% endif %})
	{% endblock %}

	// One document (arguments) or several documents (standard input):
	readDocuments(os.Args[2:], func(document string) {
		printValues(transformer.Transform(document))
	})
}
{% endblock %}
