{% extends 'base.attached.class' %}

{% block content %}
{% block class %}
class {{ class_name }}

	def initialize(scale, min)
		@scale = scale
		@min = min
	end

	def transform(features)
		values = Array.new(@scale.length) { |i| features[i] * @scale[i] + @min[i] }
{% if clip %}
		values = values.map { |value| value < {{ clip_min }} ? {{ clip_min }} : (value > {{ clip_max }} ? {{ clip_max }} : value) }
{% endif %}
		values
	end

end
{% endblock %}

if __FILE__ == $0
	{% filter indent('\t', True) %}
	{% include 'samples' %}

	{% include 'values' %}
	{% endfilter %}

	{% block create %}
	# Model data:
	{{ scale }}
	{{ min }}

	# Transformer:
	{{ instance|default('transformer') }} = {{ class_name }}.new {{ prefix }}scale, {{ prefix }}min
	{% endblock %}

	# Features of one sample (arguments) or several samples (standard input):
	read_samples(ARGV) do |features|
		print_values transformer.transform(features)
	end
end
{% endblock %}
