{% extends 'base.combined.class' %}

{% block content %}
#include <math.h>
#include <stdio.h>
#include <stdlib.h>

{% block class %}
#define {{ prefix }}N_FEATURES {{ n_features }}
#define {{ prefix }}N_FEATURES_OUT {{ n_features_out }}


/* Write the transformed features to `values`: */
void {{ prefix }}transform(double *values, double features[{{ prefix }}N_FEATURES]) {
    {% for i in range(n_features) %}
    values[{{ i }}] = features[{{ i }}] * {{ scale[i] }} + {{ min[i] }};
    {% endfor %}
{% if clip %}
    for (int i = 0; i < {{ prefix }}N_FEATURES_OUT; i++) {
        values[i] = values[i] < {{ clip_min }} ? {{ clip_min }} : (values[i] > {{ clip_max }} ? {{ clip_max }} : values[i]);
    }
{% endif %}
}
{% endblock %}

{% include 'samples' %}

{% include 'values' %}

int main(int argc, const char *argv[]) {
    /* Features of one sample (arguments) or several samples (standard input): */
    double features[N_FEATURES];
    while (read_features(features, argc, argv, 1)) {
        double values[N_FEATURES_OUT];
        transform(values, features);
        print_values(values, N_FEATURES_OUT);
    }

    return 0;
}
{% endblock %}
