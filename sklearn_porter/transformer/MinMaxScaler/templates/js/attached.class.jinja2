{% extends 'base.attached.class' %}

{% block content %}
{% block class %}
var {{ class_name }} = function(scale, min) {

    this.scale = scale;
    this.min = min;

    this.transform = function(features) {
        var values = new Array(this.scale.length);
        for (var i = 0, l = this.scale.length; i < l; i++) {
            values[i] = features[i] * this.scale[i] + this.min[i];
        }
{% if clip %}
        for (var i = 0, l = values.length; i < l; i++) {
            values[i] = values[i] < {{ clip_min }} ? {{ clip_min }} : (values[i] > {{ clip_max }} ? {{ clip_max }} : values[i]);
        }
{% endif %}
        return values;
    };

};
{% endblock %}

{% include 'samples' %}

{% include 'values' %}

var main = function () {
    {% block create %}
    // Model data:
    {{ scale }}
    {{ min }}

    // Transformer:
    var {{ instance|default('transformer') }} = new {{ class_name }}({{ prefix }}scale, {{ prefix }}min);
    {% endblock %}

    // Features of one sample (arguments) or several samples (standard input):
    readSamples(process.argv.slice(2)).forEach(function (features) {
        printValues(transformer.transform(features));
    });
}

if (require.main === module) {
    main();
}
{% endblock %}
