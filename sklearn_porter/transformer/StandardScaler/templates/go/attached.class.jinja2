{% block content %}
package main

import (
	"bufio"
	"fmt"
	"math"
	"os"
	"strconv"
	"strings"
)

type {{ class_name }} struct {
	Mean  []float64
	Scale []float64
}

func (transformer {{ class_name }}) Transform(features []float64) []float64 {
	values := make([]float64, len(transformer.Mean))
	for i := range transformer.Mean {
		values[i] = (features[i] - transformer.Mean[i]) / transformer.Scale[i]
	}
	return values
}

