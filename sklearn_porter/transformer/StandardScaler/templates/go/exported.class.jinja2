{% extends 'base.exported.class' %}

{% block content %}
package main

import (
	"bufio"
	"encoding/json"
	"fmt"
	"math"
	"os"
	"strconv"
	"strings"
)

type {{ class_name }} struct {
	Mean  []float64 `json:"mean"`
	Scale []float64 `json:"scale"`
}

func (transformer {{ class_name }}) Transform(features []float64) []float64 {
	values := make([]float64, len(transformer.Mean))
	for i := range transformer.Mean {
		values[i] = (features[i] - transformer.Mean[i]) / transformer.Scale[i]
	}
	return values
}

{% include 'samples' %}

{% include 'values' %}

func main() {
	if len(os.Args) < 2 {
		fmt.Fprintln(os.Stderr, "You have to pass the path to the model data.")
		os.Exit(1)
	}

	// Model data:
	byteValue, err := os.ReadFile(os.Args[1])
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}

	// Transformer:
	var transformer {{ class_name }}
	if err := json.Unmarshal(byteValue, &transformer); err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}

	// Features of one sample (arguments) or several samples (standard input):
	readSamples(os.Args[2:], func(features []float64) {
		printValues(transformer.Transform(features))
	})
}
{% endblock %}
