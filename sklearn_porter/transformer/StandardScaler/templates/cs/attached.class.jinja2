{% extends 'base.attached.class' %}

{% block content %}
public class {{ class_name }} {

    private double[] mean;
    private double[] scale;

    public {{ class_name }}(double[] mean, double[] scale) {
        this.mean = mean;
        this.scale = scale;
    }

    public double[] Transform(double[] features) {
        double[] values = new double[this.mean.Length];
        for (int i = 0; i < this.mean.Length; i++) {
            values[i] = (features[i] - this.mean[i]) / this.scale[i];
        }
        return values;
    }

