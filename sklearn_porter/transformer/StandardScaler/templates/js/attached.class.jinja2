{% extends 'base.attached.class' %}

{% block content %}
{% block class %}
var {{ class_name }} = function(mean, scale) {

    this.mean = mean;
    this.scale = scale;

    this.transform = function(features) {
        var values = new Array(this.mean.length);
        for (var i = 0, l = this.mean.length; i < l; i++) {
            values[i] = (features[i] - this.mean[i]) / this.scale[i];
        }
        return values;
    };

};
{% endblock %}

{% include 'samples' %}

{% include 'values' %}

var main = function () {
    {% block create %}
    // Model data:
    {{ mean }}
    {{ scale }}

    // Transformer:
    var {{ instance|default('transformer') }} = new {{ class_name }}({{ prefix }}mean, {{ prefix }}scale);
    {% endblock %}

    // Features of one sample (arguments) or several samples (standard input):
    readSamples(process.argv.slice(2)).forEach(function (features) {
        printValues(transformer.transform(features));
    });
}

if (require.main === module) {
    main();
}
{% endblock %}
