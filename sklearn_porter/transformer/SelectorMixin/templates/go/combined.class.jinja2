{% extends 'base.combined.class' %}

{% block content %}
package main

import (
	"bufio"
	"fmt"
	"math"
	"os"
	"strconv"
	"strings"
)

{% block class %}
type {{ class_name }} struct{}

func (transformer {{ class_name }}) Transform(features []float64) []float64 {
	{% if not allow_nan %}
	for _, feature := range features {
		if math.IsNaN(feature) || math.IsInf(feature, 0) {
			panic("The features contain NaN or infinity.")
		}
	}
	{% endif %}
	values := make([]float64, {{ n_features_out }})
	{% for i in range(n_features_out) %}
	values[{{ i }}] = features[{{ inputs[i] }}]
	{% endfor %}
	return values
}
{% endblock %}

{% include 'samples' %}

{% include 'values' %}

func main() {
	{% block create %}
	// Transformer:
	{{ instance|default('transformer') }} := {{ class_name }}{}
	{% endblock %}

	// Features of one sample (arguments) or several samples (standard input):
	readSamples(os.Args[1:], func(features []float64) {
		printValues(transformer.Transform(features))
	})
}
{% endblock %}
