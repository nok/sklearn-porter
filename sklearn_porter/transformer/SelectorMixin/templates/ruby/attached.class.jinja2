{% extends 'base.attached.class' %}

{% block content %}
{% block class %}
class {{ class_name }}

	def initialize(inputs)
		@inputs = inputs
	end

	def transform(features)
		{% if not allow_nan %}
		raise ArgumentError, "The features contain NaN or infinity." unless features.all?(&:finite?)
		{% endif %}
		Array.new(@inputs.length) { |i| features[@inputs[i]] }
	end

end
{% endblock %}

if __FILE__ == $0
	{% filter indent('\t', True) %}
	{% include 'samples' %}

	{% include 'values' %}
	{% endfilter %}

	{% block create %}
	# Model data:
	{{ inputs }}

	# Transformer:
	{{ instance|default('transformer') }} = {{ class_name }}.new {{ prefix }}inputs
	{% endblock %}

	# Features of one sample (arguments) or several samples (standard input):
	read_samples(ARGV) do |features|
		print_values transformer.transform(features)
	end
end
{% endblock %}
