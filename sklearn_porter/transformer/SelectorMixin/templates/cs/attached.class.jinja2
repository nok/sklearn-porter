{% extends 'base.attached.class' %}

{% block content %}
{% block class %}
public class {{ class_name }} {

    private int[] inputs;

    public {{ class_name }}(int[] inputs) {
        this.inputs = inputs;
    }

    public double[] Transform(double[] features) {
        {% if not allow_nan %}
        foreach (double feature in features) {
            if (double.IsNaN(feature) || double.IsInfinity(feature)) {
                throw new System.ArgumentException("The features contain NaN or infinity.");
            }
        }
        {% endif %}
        double[] values = new double[this.inputs.Length];
        for (int i = 0; i < this.inputs.Length; i++) {
            values[i] = features[this.inputs[i]];
        }
        return values;
    }
{% if not _blocks %}

{% include 'samples' %}

{% include 'values' %}


    public static void Main(string[] args) {
        {% block create %}
        // Model data:
        {{ inputs }}

        // Transformer:
        {{ class_name }} {{ instance|default('transformer') }} = new {{ class_name }}({{ prefix }}inputs);
        {% endblock %}

        // Features of one sample (arguments) or several samples (standard input):
        foreach (double[] features in ReadSamples(args, 0)) {
            PrintValues(transformer.Transform(features));
        }
    }
{% endif %}
}
{% endblock %}
{% endblock %}
