{% extends 'base.combined.class' %}

{% block content %}
{% block class %}
class {{ class_name }} {

    public double[] transform(double[] features) {
        {% if not allow_nan %}
        for (double feature : features) {
            if (Double.isNaN(feature) || Double.isInfinite(feature)) {
                throw new IllegalArgumentException("The features contain NaN or infinity.");
            }
        }
        {% endif %}
        double[] values = new double[{{ n_features_out }}];
        {% for i in range(n_features_out) %}
        values[{{ i }}] = features[{{ inputs[i] }}];
        {% endfor %}
        return values;
    }
{% if not _blocks %}

{% include 'samples' %}

{% include 'values' %}

    public static void main(String[] args) {
        {% block create %}
        // Transformer:
        {{ class_name }} {{ instance|default('transformer') }} = new {{ class_name }}();
        {% endblock %}

        // Features of one sample (arguments) or several samples (standard input):
        for (double[] features : readSamples(args, 0)) {
            printValues(transformer.transform(features));
        }
    }
{% endif %}
}
{% endblock %}
{% endblock %}
