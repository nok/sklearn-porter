{% extends 'base.combined.class' %}

{% block content %}
#include <math.h>
#include <stdio.h>
#include <stdlib.h>

{% block class %}
#define {{ prefix }}N_FEATURES {{ n_features }}
#define {{ prefix }}N_FEATURES_OUT {{ n_features_out }}


/* The quantile of x (np.interp of the quantiles q[o:o + n] and the
   references r in both directions like scikit-learn): */
static double {{ prefix }}interp(double x, const double *q, int o, const double *r, int n) {
    if (isnan(x)) {
        return x;
    }
    double a = 0.0;
    double b = 0.0;
    int lo = 0;
    int hi = n;
    int j = 0;
    /* np.interp(x, q, r): */
    if (x > q[o + n - 1]) {
        a = r[n - 1];
    } else if (x < q[o]) {
        a = r[0];
    } else {
        while (lo < hi) {
            int mid = (lo + hi) / 2;
            if (x >= q[o + mid]) {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        j = lo - 1;
        if (j == n - 1 || q[o + j] == x) {
            a = r[j];
        } else {
            double s = (r[j + 1] - r[j]) / (q[o + j + 1] - q[o + j]);
            a = s * (x - q[o + j]) + r[j];
            if (isnan(a)) {
                a = s * (x - q[o + j + 1]) + r[j + 1];
                if (isnan(a) && r[j] == r[j + 1]) {
                    a = r[j];
                }
            }
        }
    }
    /* np.interp(-x, -q[::-1], -r[::-1]) with the same operations: */
    if (x < q[o]) {
        b = -r[0];
    } else if (x > q[o + n - 1]) {
        b = -r[n - 1];
    } else {
        lo = 0;
        hi = n;
        while (lo < hi) {
            int mid = (lo + hi) / 2;
            if (q[o + mid] < x) {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        j = lo;
        if (j == 0 || q[o + j] == x) {
            b = -r[j];
        } else {
            double s = (r[j] - r[j - 1]) / (q[o + j] - q[o + j - 1]);
            b = s * (q[o + j] - x) - r[j];
            if (isnan(b)) {
                b = s * (q[o + j - 1] - x) - r[j - 1];
                if (isnan(b) && r[j - 1] == r[j]) {
                    b = -r[j];
                }
            }
        }
    }
    if (x == q[o]) {
        return 0.0;
    }
    if (x == q[o + n - 1]) {
        return 1.0;
    }
    return 0.5 * (a - b);
}

/* Write the transformed features to `values`: */
void {{ prefix }}transform(double *values, double features[{{ prefix }}N_FEATURES]) {
    /* The quantiles of each feature and the references (static, so the
       arrays aren't created at each call): */
    {% for i in range(n_features) %}
    static const double q{{ i }}[] = { {{ feature_quantiles[i]|join(', ') }} };
    {% endfor %}
    static const double r[] = { {{ references|join(', ') }} };
    {% for i in range(n_features) %}
    values[{{ i }}] = {{ prefix }}interp(features[{{ i }}], q{{ i }}, 0, r, {{ n_quantiles }});
    {% endfor %}
}
{% endblock %}

{% include 'samples' %}

{% include 'values' %}

int main(int argc, const char *argv[]) {
    /* Features of one sample (arguments) or several samples (standard input): */
    double features[N_FEATURES];
    while (read_features(features, argc, argv, 1)) {
        double values[N_FEATURES_OUT];
        transform(values, features);
        print_values(values, N_FEATURES_OUT);
    }

    return 0;
}
{% endblock %}
