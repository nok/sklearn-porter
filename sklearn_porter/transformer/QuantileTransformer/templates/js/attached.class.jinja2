{% extends 'base.attached.class' %}

{% block content %}
{% block class %}
var {{ class_name }} = function(quantiles, references) {

    this.quantiles = quantiles;
    this.references = references;

    this.transform = function(features) {
        var values = new Array(features.length);
        for (var i = 0; i < features.length; i++) {
            values[i] = this.interp(features[i], this.quantiles, i * {{ n_quantiles }}, this.references);
        }
        return values;
    };

    // The quantile of x (np.interp of the quantiles q[o:o + n] and the
    // references r in both directions like scikit-learn):
    this.interp = function (x, q, o, r) {
        var n = r.length;
        if (isNaN(x)) {
            return x;
        }
        var a = 0.0;
        var b = 0.0;
        var lo = 0;
        var hi = n;
        var j = 0;
        // np.interp(x, q, r):
        if (x > q[o + n - 1]) {
            a = r[n - 1];
        } else if (x < q[o]) {
            a = r[0];
        } else {
            while (lo < hi) {
                var mid = Math.floor((lo + hi) / 2);
                if (x >= q[o + mid]) {
                    lo = mid + 1;
                } else {
                    hi = mid;
                }
            }
            j = lo - 1;
            if (j == n - 1 || q[o + j] == x) {
                a = r[j];
            } else {
                var s = (r[j + 1] - r[j]) / (q[o + j + 1] - q[o + j]);
                a = s * (x - q[o + j]) + r[j];
                if (isNaN(a)) {
                    a = s * (x - q[o + j + 1]) + r[j + 1];
                    if (isNaN(a) && r[j] == r[j + 1]) {
                        a = r[j];
                    }
                }
            }
        }
        // np.interp(-x, -q[::-1], -r[::-1]) with the same operations:
        if (x < q[o]) {
            b = -r[0];
        } else if (x > q[o + n - 1]) {
            b = -r[n - 1];
        } else {
            lo = 0;
            hi = n;
            while (lo < hi) {
                var mid = Math.floor((lo + hi) / 2);
                if (q[o + mid] < x) {
                    lo = mid + 1;
                } else {
                    hi = mid;
                }
            }
            j = lo;
            if (j == 0 || q[o + j] == x) {
                b = -r[j];
            } else {
                var s = (r[j] - r[j - 1]) / (q[o + j] - q[o + j - 1]);
                b = s * (q[o + j] - x) - r[j];
                if (isNaN(b)) {
                    b = s * (q[o + j - 1] - x) - r[j - 1];
                    if (isNaN(b) && r[j - 1] == r[j]) {
                        b = -r[j];
                    }
                }
            }
        }
        if (x == q[o]) {
            return 0.0;
        }
        if (x == q[o + n - 1]) {
            return 1.0;
        }
        return 0.5 * (a - b);
    };

};
{% endblock %}

{% include 'samples' %}

{% include 'values' %}

var main = function () {
    {% block create %}
    // Model data:
    {{ quantiles }}
    {{ references }}

    // Transformer:
    var {{ instance|default('transformer') }} = new {{ class_name }}({{ prefix }}quantiles, {{ prefix }}references);
    {% endblock %}

    // Features of one sample (arguments) or several samples (standard input):
    readSamples(process.argv.slice(2)).forEach(function (features) {
        printValues(transformer.transform(features));
    });
}

if (require.main === module) {
    main();
}
{% endblock %}
