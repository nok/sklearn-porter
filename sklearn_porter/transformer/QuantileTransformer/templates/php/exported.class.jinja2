{% extends 'base.exported.class' %}

{% block content %}
{% block class %}
class {{ class_name }} {

    private $quantiles;
    private $references;

{% if _blocks %}
    public function __construct($data) {
{% else %}
    public function __construct($path) {
        $data = json_decode(file_get_contents($path, true), true);
{% endif %}
        $this->quantiles = $data['quantiles'];
        $this->references = $data['references'];
    }

    public function transform($features) {
        $values = array();
        for ($i = 0, $n = count($features); $i < $n; $i++) {
            $values[$i] = $this->interp($features[$i], $this->quantiles, $i * {{ n_quantiles }}, $this->references);
        }
        return $values;
    }

    // The quantile of x (np.interp of the quantiles q[o:o + n] and the
    // references r in both directions like scikit-learn):
    private function interp($x, $q, $o, $r) {
        $n = count($r);
        if (is_nan($x)) {
            return $x;
        }
        $a = 0.0;
        $b = 0.0;
        $lo = 0;
        $hi = $n;
        $j = 0;
        // np.interp(x, q, r):
        if ($x > $q[$o + $n - 1]) {
            $a = $r[$n - 1];
        } else if ($x < $q[$o]) {
            $a = $r[0];
        } else {
            while ($lo < $hi) {
                $mid = intdiv($lo + $hi, 2);
                if ($x >= $q[$o + $mid]) {
                    $lo = $mid + 1;
                } else {
                    $hi = $mid;
                }
            }
            $j = $lo - 1;
            if ($j == $n - 1 || $q[$o + $j] == $x) {
                $a = $r[$j];
            } else {
                $s = ($r[$j + 1] - $r[$j]) / ($q[$o + $j + 1] - $q[$o + $j]);
                $a = $s * ($x - $q[$o + $j]) + $r[$j];
                if (is_nan($a)) {
                    $a = $s * ($x - $q[$o + $j + 1]) + $r[$j + 1];
                    if (is_nan($a) && $r[$j] == $r[$j + 1]) {
                        $a = $r[$j];
                    }
                }
            }
        }
        // np.interp(-x, -q[::-1], -r[::-1]) with the same operations:
        if ($x < $q[$o]) {
            $b = -$r[0];
        } else if ($x > $q[$o + $n - 1]) {
            $b = -$r[$n - 1];
        } else {
            $lo = 0;
            $hi = $n;
            while ($lo < $hi) {
                $mid = intdiv($lo + $hi, 2);
                if ($q[$o + $mid] < $x) {
                    $lo = $mid + 1;
                } else {
                    $hi = $mid;
                }
            }
            $j = $lo;
            if ($j == 0 || $q[$o + $j] == $x) {
                $b = -$r[$j];
            } else {
                $s = ($r[$j] - $r[$j - 1]) / ($q[$o + $j] - $q[$o + $j - 1]);
                $b = $s * ($q[$o + $j] - $x) - $r[$j];
                if (is_nan($b)) {
                    $b = $s * ($q[$o + $j - 1] - $x) - $r[$j - 1];
                    if (is_nan($b) && $r[$j - 1] == $r[$j]) {
                        $b = -$r[$j];
                    }
                }
            }
        }
        if ($x == $q[$o]) {
            return 0.0;
        }
        if ($x == $q[$o + $n - 1]) {
            return 1.0;
        }
        return 0.5 * ($a - $b);
    }

}
{% endblock %}

if (PHP_SAPI === 'cli' && realpath($argv[0]) === __FILE__) {
    {% filter indent(4, True) %}
    {% include 'samples' %}

    {% include 'values' %}
    {% endfilter %}

    if (count($argv) < 2) {
        fwrite(STDERR, "You have to pass the path to the model data.\n");
        exit(1);
    }

    array_shift($argv);

    {% block create %}
    // Transformer:
    ${{ instance|default('transformer') }} = new {{ class_name }}({{ data|default('array_shift($argv)') }});
    {% endblock %}

    // Features of one sample (arguments) or several samples (standard input):
    foreach (readSamples($argv) as $features) {
        printValues($transformer->transform($features));
    }

}
{% endblock %}
