{% extends 'base.' ~ template ~ '.class' %}

{% block content %}
package main

import (
	"bufio"
{% if is_exported %}
	"encoding/json"
{% endif %}
	"fmt"
	"math"
	"os"
	"strconv"
	"strings"
)

{{ classes }}

{% include 'samples' %}

{% include 'values' %}

func main() {
{% if is_exported %}
	if len(os.Args) < 2 {
		fmt.Fprintln(os.Stderr, "You have to pass the path to the model data.")
		os.Exit(1)
	}

{% endif %}
	{{ create|indent('\t') }}

	// Features of one sample (arguments) or several samples (standard input):
	readSamples(os.Args[{{ 2 if is_exported else 1 }}:], func(features []float64) {
		printValues({{ instance }}.Transform(features))
	})
}
{% endblock %}
