{% extends 'base.' ~ template ~ '.class' %}

{% block content %}
{{ classes }}

{% include 'samples' %}

{% include 'values' %}

var main = function () {
{% if is_exported %}
    if (process.argv.length < 3) {
        throw new Error("You have to pass the path to the model data.");
    }

{% endif %}
    {{ create|indent('    ') }}

    // Features of one sample (arguments) or several samples (standard input):
    readSamples(process.argv.slice({{ 3 if is_exported else 2 }})).forEach(function (features) {
        printValues({{ instance }}.transform(features));
    });
}

if (require.main === module) {
    main();
}
{% endblock %}
