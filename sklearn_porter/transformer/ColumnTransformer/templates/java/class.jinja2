class {{ class_name }} {

{% for step in steps %}
    private {{ step.class_name }} {{ step.field }};
{% endfor %}

    public {{ class_name }}({% for step in steps %}{{ step.class_name }} {{ step.field }}{{ ', ' if not loop.last }}{% endfor %}) {
{% for step in steps %}
        this.{{ step.field }} = {{ step.field }};
{% endfor %}
    }

    public double[] transform(double[] features) {
        double[] values = new double[{{ n_features_out }}];
        double[] x;
{% for part in parts %}
        x = new double[] { {% for c in part.columns %}features[{{ c }}]{{ ', ' if not loop.last }}{% endfor %} };
{% for step in part.steps %}
        x = this.{{ step.field }}.transform(x);
{% endfor %}
        for (int i = 0; i < {{ part.n_out }}; i++) {
            values[{{ part.offset }} + i] = x[i]{% if part.weight is not none %} * {{ part.weight }}{% endif %};
        }
{% endfor %}
        return values;
    }
{% if not is_step %}

{% if is_exported %}
    // Load the transformer with the model data of a JSON file:
    public static {{ class_name }} load(String path) throws java.io.IOException {
{% else %}
    // Create the transformer with the model data of this file:
    public static {{ class_name }} create() {
{% endif %}
        {{ create|indent('        ') }}

        return {{ instance }};
    }

{% include 'samples' %}

{% include 'values' %}

    public static void main(String[] args) throws java.io.IOException {
{% if is_exported %}
        if (args.length < 1 || !args[0].endsWith(".json")) {
            throw new IllegalArgumentException("You have to pass the path to the exported model data.");
        }

{% endif %}
        // Transformer:
        {{ class_name }} {{ instance }} = {{ class_name }}.{{ 'load(args[0])' if is_exported else 'create()' }};

        // Features of one sample (arguments) or several samples (standard input):
        for (double[] features : readSamples(args, {{ 1 if is_exported else 0 }})) {
            printValues({{ instance }}.transform(features));
        }
    }
{% endif %}
}
