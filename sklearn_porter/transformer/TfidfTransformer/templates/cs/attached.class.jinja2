{% extends 'base.attached.class' %}

{% block content %}
{% block class %}
public class {{ class_name }} {

    private double[] idf;

    public {{ class_name }}(double[] idf) {
        this.idf = idf;
    }

    public double[] Transform(double[] features) {
        double[] values = new double[this.idf.Length];
        for (int i = 0; i < this.idf.Length; i++) {
            // Zeros remain zeros (also negative zeros) like in a sparse matrix:
            values[i] = features[i] == 0.0 ? 0.0 : {% if sublinear_tf %}(System.Math.Log(features[i]) + 1.0){% else %}features[i]{% endif %} * this.idf[i];
        }
        {% if norm %}
        // Normalize the features, if their norm isn't zero:
        double norm = 0.0;
        for (int i = 0; i < values.Length; i++) {
            norm += {% if norm == 'l1' %}System.Math.Abs(values[i]){% else %}values[i] * values[i]{% endif %};
        }
        if (norm != 0.0) {
            {% if norm == 'l2' %}
            norm = System.Math.Sqrt(norm);
            {% endif %}
            for (int i = 0; i < values.Length; i++) {
                values[i] /= norm;
            }
        }
        {% endif %}
        return values;
    }
{% if not _blocks %}

{% include 'samples' %}

{% include 'values' %}


    public static void Main(string[] args) {
        {% block create %}
        // Model data:
        {{ idf }}

        // Transformer:
        {{ class_name }} {{ instance|default('transformer') }} = new {{ class_name }}({{ prefix }}idf);
        {% endblock %}

        // Features of one sample (arguments) or several samples (standard input):
        foreach (double[] features in ReadSamples(args, 0)) {
            PrintValues(transformer.Transform(features));
        }
    }
{% endif %}
}
{% endblock %}
{% endblock %}
