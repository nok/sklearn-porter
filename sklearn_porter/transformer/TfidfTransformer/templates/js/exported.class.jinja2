{% extends 'base.exported.class' %}

{% block content %}
var fs = require('fs');


{% block class %}
{% if _blocks %}
var {{ class_name }} = function(data) {
    this.data = data;
{% else %}
var {{ class_name }} = function(jsonFile) {
    this.data = JSON.parse(fs.readFileSync(jsonFile));
{% endif %}

    this.transform = function(features) {
        var values = new Array(this.data.idf.length);
        for (var i = 0, l = this.data.idf.length; i < l; i++) {
            // Zeros remain zeros (also negative zeros) like in a sparse matrix:
            values[i] = features[i] === 0 ? 0 : {% if sublinear_tf %}(Math.log(features[i]) + 1.0){% else %}features[i]{% endif %} * this.data.idf[i];
        }
        {% if norm %}
        // Normalize the features, if their norm isn't zero:
        var norm = 0.0;
        for (var i = 0, l = values.length; i < l; i++) {
            norm += {% if norm == 'l1' %}Math.abs(values[i]){% else %}values[i] * values[i]{% endif %};
        }
        if (norm != 0.0) {
            {% if norm == 'l2' %}
            norm = Math.sqrt(norm);
            {% endif %}
            for (var i = 0, l = values.length; i < l; i++) {
                values[i] /= norm;
            }
        }
        {% endif %}
        return values;
    };
};
{% endblock %}

{% include 'samples' %}

{% include 'values' %}

var main = function () {
    if (process.argv.length < 3) {
        throw new Error("You have to pass the path to the model data.");
    }

    {% block create %}
    // Transformer:
    var {{ instance|default('transformer') }} = new {{ class_name }}({{ data|default('process.argv[2]') }});
    {% endblock %}

    // Features of one sample (arguments) or several samples (standard input):
    readSamples(process.argv.slice(3)).forEach(function (features) {
        printValues(transformer.transform(features));
    });
}

if (require.main === module) {
    main();
}
{% endblock %}
