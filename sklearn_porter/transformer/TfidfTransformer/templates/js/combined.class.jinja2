{% extends 'base.combined.class' %}

{% block content %}
{% block class %}
var {{ class_name }} = function() {

    this.transform = function(features) {
        // Zeros remain zeros (also negative zeros) like in a sparse matrix:
        var values = [
            {% for i in range(n_features) %}
            features[{{ i }}] === 0 ? 0 : {% if sublinear_tf %}(Math.log(features[{{ i }}]) + 1.0){% else %}features[{{ i }}]{% endif %} * {{ idf[i] }}{{ ',' if not loop.last }}
            {% endfor %}
        ];
        {% if norm %}
        // Normalize the features, if their norm isn't zero:
        var norm = 0.0;
        for (var i = 0, l = values.length; i < l; i++) {
            norm += {% if norm == 'l1' %}Math.abs(values[i]){% else %}values[i] * values[i]{% endif %};
        }
        if (norm != 0.0) {
            {% if norm == 'l2' %}
            norm = Math.sqrt(norm);
            {% endif %}
            for (var i = 0, l = values.length; i < l; i++) {
                values[i] /= norm;
            }
        }
        {% endif %}
        return values;
    };

};
{% endblock %}

{% include 'samples' %}

{% include 'values' %}

var main = function () {
    {% block create %}
    // Transformer:
    var {{ instance|default('transformer') }} = new {{ class_name }}();
    {% endblock %}

    // Features of one sample (arguments) or several samples (standard input):
    readSamples(process.argv.slice(2)).forEach(function (features) {
        printValues(transformer.transform(features));
    });
}

if (require.main === module) {
    main();
}
{% endblock %}
