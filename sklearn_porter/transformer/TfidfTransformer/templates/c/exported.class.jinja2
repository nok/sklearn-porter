{% extends 'base.exported.class' %}

{% block content %}
#include <math.h>

{% block class %}
#define {{ prefix }}N_FEATURES {{ n_features }}
#define {{ prefix }}N_FEATURES_OUT {{ n_features_out }}


double *{{ prefix }}idf;

void {{ prefix }}load({{ 'JsonValue *data' if _blocks else 'const char *path' }}) {
{% if not _blocks %}
    JsonValue *data = json_read(path);
{% endif %}
    {{ prefix }}idf = json_doubles(json_get(data, "idf"));
{% if not _blocks %}
    json_free(data);
{% endif %}
}

/* Write the transformed features to `values`: */
void {{ prefix }}transform(double *values, double features[{{ prefix }}N_FEATURES]) {
    for (int i = 0; i < {{ prefix }}N_FEATURES; i++) {
        /* Zeros remain zeros (also negative zeros) like in a sparse matrix: */
        values[i] = features[i] == 0.0 ? 0.0 : {% if sublinear_tf %}(log(features[i]) + 1.0){% else %}features[i]{% endif %} * {{ prefix }}idf[i];
    }
    {% if norm %}
    /* Normalize the features, if their norm isn't zero: */
    double norm = 0.0;
    for (int i = 0; i < {{ prefix }}N_FEATURES; i++) {
        norm += {% if norm == 'l1' %}fabs(values[i]){% else %}values[i] * values[i]{% endif %};
    }
    if (norm != 0.0) {
        {% if norm == 'l2' %}
        norm = sqrt(norm);
        {% endif %}
        for (int i = 0; i < {{ prefix }}N_FEATURES; i++) {
            values[i] /= norm;
        }
    }
    {% endif %}
}
{% endblock %}

{% include 'samples' %}

{% include 'values' %}

int main(int argc, const char *argv[]) {
    if (argc < 2) {
        fprintf(stderr, "You have to pass the path to the model data.\n");
        return 1;
    }

    {% block create %}
    /* Model data: */
    {{ prefix }}load({{ data|default('argv[1]') }});
    {% endblock %}

    /* Features of one sample (arguments) or several samples (standard input): */
    double features[N_FEATURES];
    while (read_features(features, argc, argv, 2)) {
        double values[N_FEATURES_OUT];
        transform(values, features);
        print_values(values, N_FEATURES_OUT);
    }

    return 0;
}
{% endblock %}
