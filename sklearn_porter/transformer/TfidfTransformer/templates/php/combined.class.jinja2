{% extends 'base.combined.class' %}

{% block content %}
{% block class %}
class {{ class_name }} {

    public function transform($features) {
        // Zeros remain zeros (also negative zeros) like in a sparse matrix:
        $values = array(
            {% for i in range(n_features) %}
            $features[{{ i }}] == 0 ? 0.0 : {% if sublinear_tf %}(log($features[{{ i }}]) + 1.0){% else %}$features[{{ i }}]{% endif %} * {{ idf[i] }},
            {% endfor %}
        );
        {% if norm %}
        // Normalize the features, if their norm isn't zero:
        $norm = 0.0;
        foreach ($values as $value) {
            $norm += {% if norm == 'l1' %}abs($value){% else %}$value * $value{% endif %};
        }
        if ($norm != 0.0) {
            {% if norm == 'l2' %}
            $norm = sqrt($norm);
            {% endif %}
            foreach ($values as $i => $value) {
                $values[$i] = $value / $norm;
            }
        }
        {% endif %}
        return $values;
    }

}
{% endblock %}

if (PHP_SAPI === 'cli' && realpath($argv[0]) === __FILE__) {
    {% filter indent(4, True) %}
    {% include 'samples' %}

    {% include 'values' %}
    {% endfilter %}

    array_shift($argv);

    {% block create %}
    // Transformer:
    ${{ instance|default('transformer') }} = new {{ class_name }}();
    {% endblock %}

    // Features of one sample (arguments) or several samples (standard input):
    foreach (readSamples($argv) as $features) {
        printValues($transformer->transform($features));
    }

}
{% endblock %}
