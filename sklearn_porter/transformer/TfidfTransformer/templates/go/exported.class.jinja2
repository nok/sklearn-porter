{% extends 'base.exported.class' %}

{% block content %}
package main

import (
	"bufio"
	"encoding/json"
	"fmt"
	"math"
	"os"
	"strconv"
	"strings"
)

{% block class %}
type {{ class_name }} struct {
	Idf []float64 `json:"idf"`
}

func (transformer {{ class_name }}) Transform(features []float64) []float64 {
	values := make([]float64, len(transformer.Idf))
	for i := range transformer.Idf {
		// Zeros remain zeros (also negative zeros) like in a sparse matrix:
		if features[i] != 0 {
			values[i] = {% if sublinear_tf %}(math.Log(features[i]) + 1.0){% else %}features[i]{% endif %} * transformer.Idf[i]
		}
	}
	{% if norm %}
	// Normalize the features, if their norm isn't zero:
	norm := 0.0
	for _, value := range values {
		norm += {% if norm == 'l1' %}math.Abs(value){% else %}float64(value*value){% endif +%}
	}
	if norm != 0 {
		{% if norm == 'l2' %}
		norm = math.Sqrt(norm)
		{% endif %}
		for i := range values {
			values[i] /= norm
		}
	}
	{% endif %}
	return values
}
{% endblock %}

{% include 'samples' %}

{% include 'values' %}

func main() {
	if len(os.Args) < 2 {
		fmt.Fprintln(os.Stderr, "You have to pass the path to the model data.")
		os.Exit(1)
	}

	// Model data:
	byteValue, err := os.ReadFile(os.Args[1])
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}

	{% block create %}
	// Transformer:
	var {{ instance|default('transformer') }} {{ class_name }}
	if err := json.Unmarshal({{ data|default('byteValue') }}, &{{ instance|default('transformer') }}); err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
	{% endblock %}

	// Features of one sample (arguments) or several samples (standard input):
	readSamples(os.Args[2:], func(features []float64) {
		printValues(transformer.Transform(features))
	})
}
{% endblock %}
