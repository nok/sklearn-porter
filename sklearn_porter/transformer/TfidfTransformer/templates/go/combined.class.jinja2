{% extends 'base.combined.class' %}

{% block content %}
package main

import (
	"bufio"
	"fmt"
	"math"
	"os"
	"strconv"
	"strings"
)

{% block class %}
type {{ class_name }} struct{}

func (transformer {{ class_name }}) Transform(features []float64) []float64 {
	values := make([]float64, {{ n_features_out }})
	// Zeros remain zeros (also negative zeros) like in a sparse matrix:
	{% for i in range(n_features) %}
	if features[{{ i }}] != 0 {
		values[{{ i }}] = {% if sublinear_tf %}(math.Log(features[{{ i }}]) + 1.0){% else %}features[{{ i }}]{% endif %} * {{ idf[i] }}
	}
	{% endfor %}
	{% if norm %}
	// Normalize the features, if their norm isn't zero:
	norm := 0.0
	for _, value := range values {
		norm += {% if norm == 'l1' %}math.Abs(value){% else %}float64(value*value){% endif +%}
	}
	if norm != 0 {
		{% if norm == 'l2' %}
		norm = math.Sqrt(norm)
		{% endif %}
		for i := range values {
			values[i] /= norm
		}
	}
	{% endif %}
	return values
}
{% endblock %}

{% include 'samples' %}

{% include 'values' %}

func main() {
	{% block create %}
	// Transformer:
	{{ instance|default('transformer') }} := {{ class_name }}{}
	{% endblock %}

	// Features of one sample (arguments) or several samples (standard input):
	readSamples(os.Args[1:], func(features []float64) {
		printValues(transformer.Transform(features))
	})
}
{% endblock %}
