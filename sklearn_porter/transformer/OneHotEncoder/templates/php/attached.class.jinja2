{% extends 'base.attached.class' %}

{% block content %}
{% block class %}
class {{ class_name }} {

    private $inputs;
    private $categories;
    private $missing;

    public function __construct($inputs, $categories, $missing) {
        $this->inputs = $inputs;
        $this->categories = $categories;
        $this->missing = $missing;
    }

    public function transform($features) {
        $values = array();
        for ($i = 0, $l = count($this->inputs); $i < $l; $i++) {
            $values[$i] = ($this->missing[$i] == 1 ? is_nan($features[$this->inputs[$i]]) : $features[$this->inputs[$i]] == $this->categories[$i]) ? 1.0 : 0.0;
        }
        return $values;
    }

}
{% endblock %}

if (PHP_SAPI === 'cli' && realpath($argv[0]) === __FILE__) {
    {% filter indent(4, True) %}
    {% include 'samples' %}

    {% include 'values' %}
    {% endfilter %}

    array_shift($argv);

    {% block create %}
    // Model data:
    {{ inputs }}
    {{ categories }}
    {{ missing }}

    // Transformer:
    ${{ instance|default('transformer') }} = new {{ class_name }}(${{ prefix }}inputs, ${{ prefix }}categories, ${{ prefix }}missing);
    {% endblock %}

    // Features of one sample (arguments) or several samples (standard input):
    foreach (readSamples($argv) as $features) {
        printValues($transformer->transform($features));
    }

}
{% endblock %}
