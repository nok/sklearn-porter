{% extends 'base.attached.class' %}

{% block content %}
{% block class %}
class {{ class_name }}

	def initialize(inputs, categories, missing)
		@inputs = inputs
		@categories = categories
		@missing = missing
	end

	def transform(features)
		Array.new(@inputs.length) { |i| (@missing[i] == 1 ? features[@inputs[i]].nan? : features[@inputs[i]] == @categories[i]) ? 1.0 : 0.0 }
	end

end
{% endblock %}

if __FILE__ == $0
	{% filter indent('\t', True) %}
	{% include 'samples' %}

	{% include 'values' %}
	{% endfilter %}

	{% block create %}
	# Model data:
	{{ inputs }}
	{{ categories }}
	{{ missing }}

	# Transformer:
	{{ instance|default('transformer') }} = {{ class_name }}.new {{ prefix }}inputs, {{ prefix }}categories, {{ prefix }}missing
	{% endblock %}

	# Features of one sample (arguments) or several samples (standard input):
	read_samples(ARGV) do |features|
		print_values transformer.transform(features)
	end
end
{% endblock %}
