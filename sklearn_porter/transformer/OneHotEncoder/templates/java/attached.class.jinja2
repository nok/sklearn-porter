{% extends 'base.attached.class' %}

{% block content %}
{% block class %}
class {{ class_name }} {

    private int[] inputs;
    private double[] categories;
    private int[] missing;

    public {{ class_name }}(int[] inputs, double[] categories, int[] missing) {
        this.inputs = inputs;
        this.categories = categories;
        this.missing = missing;
    }

    public double[] transform(double[] features) {
        double[] values = new double[this.inputs.length];
        for (int i = 0; i < this.inputs.length; i++) {
            values[i] = (this.missing[i] == 1 ? Double.isNaN(features[this.inputs[i]]) : features[this.inputs[i]] == this.categories[i]) ? 1.0 : 0.0;
        }
        return values;
    }
{% if not _blocks %}

{% include 'samples' %}

{% include 'values' %}

    public static void main(String[] args) {
        {% block create %}
        // Model data:
        {{ inputs }}
        {{ categories }}
        {{ missing }}

        // Transformer:
        {{ class_name }} {{ instance|default('transformer') }} = new {{ class_name }}({{ prefix }}inputs, {{ prefix }}categories, {{ prefix }}missing);
        {% endblock %}

        // Features of one sample (arguments) or several samples (standard input):
        for (double[] features : readSamples(args, 0)) {
            printValues(transformer.transform(features));
        }
    }
{% endif %}
}
