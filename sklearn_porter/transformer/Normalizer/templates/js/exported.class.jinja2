{% extends 'base.exported.class' %}

{% block content %}
var fs = require('fs');


{% block class %}
{% if _blocks %}
var {{ class_name }} = function(data) {
    this.data = data;
{% else %}
var {{ class_name }} = function(jsonFile) {
    this.data = JSON.parse(fs.readFileSync(jsonFile));
{% endif %}

    this.transform = function(features) {
        {% if norm == 'max' %}
        var norm = 0.0;
        for (var i = 0, l = features.length; i < l; i++) {
            norm = Math.max(norm, Math.abs(features[i]));
        }
        if (norm < {{ min_norm }}) {
            norm = 1.0;
        }
        {% else %}
        {% macro norm_sum(t) %}{% if t is number %}{% if norm == 'l1' %}Math.abs(features[{{ t }}]){% else %}features[{{ t }}] * features[{{ t }}]{% endif %}{% else %}({{ norm_sum(t[0]) }} + {{ norm_sum(t[1]) }}){% endif %}{% endmacro %}
        var norm = {% if norm == 'l2' %}Math.sqrt({{ norm_sum(norm_tree) }}){% else %}{{ norm_sum(norm_tree) }}{% endif %};
        if (norm < {{ min_norm }}) {
            norm = 1.0;
        }
        {% endif %}
        var values = new Array(features.length);
        for (var i = 0, l = features.length; i < l; i++) {
            values[i] = features[i] / norm;
        }
        return values;
    };
};
{% endblock %}

{% include 'samples' %}

{% include 'values' %}

var main = function () {
    if (process.argv.length < 3) {
        throw new Error("You have to pass the path to the model data.");
    }

    {% block create %}
    // Transformer:
    var {{ instance|default('transformer') }} = new {{ class_name }}({{ data|default('process.argv[2]') }});
    {% endblock %}

    // Features of one sample (arguments) or several samples (standard input):
    readSamples(process.argv.slice(3)).forEach(function (features) {
        printValues(transformer.transform(features));
    });
}

if (require.main === module) {
    main();
}
{% endblock %}
