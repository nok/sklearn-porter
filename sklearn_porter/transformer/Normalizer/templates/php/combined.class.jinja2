{% extends 'base.combined.class' %}

{% block content %}
{% block class %}
class {{ class_name }} {

    public function transform($features) {
        {% if norm == 'max' %}
        $norm = 0.0;
        foreach ($features as $feature) {
            $norm = max($norm, abs($feature));
        }
        if ($norm < {{ min_norm }}) {
            $norm = 1.0;
        }
        {% else %}
        {% macro norm_sum(t) %}{% if t is number %}{% if norm == 'l1' %}abs($features[{{ t }}]){% else %}$features[{{ t }}] * $features[{{ t }}]{% endif %}{% else %}({{ norm_sum(t[0]) }} + {{ norm_sum(t[1]) }}){% endif %}{% endmacro %}
        $norm = {% if norm == 'l2' %}sqrt({{ norm_sum(norm_tree) }}){% else %}{{ norm_sum(norm_tree) }}{% endif %};
        if ($norm < {{ min_norm }}) {
            $norm = 1.0;
        }
        {% endif %}
        return array(
            {% for i in range(n_features) %}
            $features[{{ i }}] / $norm,
            {% endfor %}
        );
    }

}
{% endblock %}

if (PHP_SAPI === 'cli' && realpath($argv[0]) === __FILE__) {
    {% filter indent(4, True) %}
    {% include 'samples' %}

    {% include 'values' %}
    {% endfilter %}

    array_shift($argv);

    {% block create %}
    // Transformer:
    ${{ instance|default('transformer') }} = new {{ class_name }}();
    {% endblock %}

    // Features of one sample (arguments) or several samples (standard input):
    foreach (readSamples($argv) as $features) {
        printValues($transformer->transform($features));
    }

}
{% endblock %}
