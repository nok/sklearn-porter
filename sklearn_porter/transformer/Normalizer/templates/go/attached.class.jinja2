{% extends 'base.attached.class' %}

{% block content %}
package main

import (
	"bufio"
	"fmt"
	"math"
	"os"
	"strconv"
	"strings"
)

{% block class %}
type {{ class_name }} struct{}

func (transformer {{ class_name }}) Transform(features []float64) []float64 {
	{% if norm == 'max' %}
	norm := 0.0
	for _, feature := range features {
		norm = math.Max(norm, math.Abs(feature))
	}
	if norm < {{ min_norm }} {
		norm = 1.0
	}
	{% else %}
	{% macro norm_sum(t) %}{% if t is number %}{% if norm == 'l1' %}math.Abs(features[{{ t }}]){% else %}float64(features[{{ t }}]*features[{{ t }}]){% endif %}{% else %}({{ norm_sum(t[0]) }} + {{ norm_sum(t[1]) }}){% endif %}{% endmacro %}
	norm := {% if norm == 'l2' %}math.Sqrt({{ norm_sum(norm_tree) }}){% else %}{{ norm_sum(norm_tree) }}{% endif +%}
	if norm < {{ min_norm }} {
		norm = 1.0
	}
	{% endif %}
	values := make([]float64, len(features))
	for i := range features {
		values[i] = features[i] / norm
	}
	return values
}
{% endblock %}

{% include 'samples' %}

{% include 'values' %}

func main() {
	{% block create %}
	// Transformer:
	{{ instance|default('transformer') }} := {{ class_name ~ '{' }}}
	{% endblock %}

	// Features of one sample (arguments) or several samples (standard input):
	readSamples(os.Args[1:], func(features []float64) {
		printValues(transformer.Transform(features))
	})
}
{% endblock %}
