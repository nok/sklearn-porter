{% extends 'base.combined.class' %}

{% block content %}
#include <math.h>
#include <stdio.h>
#include <stdlib.h>

{% block class %}
#define {{ prefix }}N_FEATURES {{ n_features }}
#define {{ prefix }}N_FEATURES_OUT {{ n_features_out }}


/* Write the transformed features to `values`: */
void {{ prefix }}transform(double *values, double features[{{ prefix }}N_FEATURES]) {
    {% if norm == 'max' %}
    double norm = 0.0;
    for (int i = 0; i < {{ prefix }}N_FEATURES; i++) {
        if (fabs(features[i]) > norm) {
            norm = fabs(features[i]);
        }
    }
    if (norm < {{ min_norm }}) {
        norm = 1.0;
    }
    {% else %}
    {% macro norm_sum(t) %}{% if t is number %}{% if norm == 'l1' %}fabs(features[{{ t }}]){% else %}features[{{ t }}] * features[{{ t }}]{% endif %}{% else %}({{ norm_sum(t[0]) }} + {{ norm_sum(t[1]) }}){% endif %}{% endmacro %}
    double norm = {% if norm == 'l2' %}sqrt({{ norm_sum(norm_tree) }}){% else %}{{ norm_sum(norm_tree) }}{% endif %};
    if (norm < {{ min_norm }}) {
        norm = 1.0;
    }
    {% endif %}
    {% for i in range(n_features) %}
    values[{{ i }}] = features[{{ i }}] / norm;
    {% endfor %}
}
{% endblock %}

{% include 'samples' %}

{% include 'values' %}

int main(int argc, const char *argv[]) {
    /* Features of one sample (arguments) or several samples (standard input): */
    double features[N_FEATURES];
    while (read_features(features, argc, argv, 1)) {
        double values[N_FEATURES_OUT];
        transform(values, features);
        print_values(values, N_FEATURES_OUT);
    }

    return 0;
}
{% endblock %}
