{% extends 'base.attached.class' %}

{% block content %}
{% block class %}
class {{ class_name }}

	def transform(features)
		norm = features.map(&:abs).max
		norm = 1.0 if norm < {{ min_norm }}
		Array.new(features.length) { |i| features[i] / norm }
	end

end
{% endblock %}

if __FILE__ == $0
	{% filter indent('\t', True) %}
	{% include 'samples' %}

	{% include 'values' %}
	{% endfilter %}

	{% block create %}
	# Transformer:
	{{ instance|default('transformer') }} = {{ class_name }}.new 
	{% endblock %}

	# Features of one sample (arguments) or several samples (standard input):
	read_samples(ARGV) do |features|
		print_values transformer.transform(features)
	end
end
{% endblock %}
