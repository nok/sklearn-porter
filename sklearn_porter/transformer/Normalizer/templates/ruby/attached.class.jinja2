{% extends 'base.attached.class' %}

{% block content %}
{% block class %}
class {{ class_name }}

	def transform(features)
		{% if norm == 'max' %}
		norm = features.map(&:abs).max
		norm = 1.0 if norm < {{ min_norm }}
		{% else %}
		{% macro norm_sum(t) %}{% if t is number %}{% if norm == 'l1' %}features[{{ t }}].abs{% else %}features[{{ t }}] * features[{{ t }}]{% endif %}{% else %}({{ norm_sum(t[0]) }} + {{ norm_sum(t[1]) }}){% endif %}{% endmacro %}
		norm = {% if norm == 'l2' %}Math.sqrt({{ norm_sum(norm_tree) }}){% else %}{{ norm_sum(norm_tree) }}{% endif +%}
		norm = 1.0 if norm < {{ min_norm }}
		{% endif %}
		Array.new(features.length) { |i| features[i] / norm }
	end

end
{% endblock %}

if __FILE__ == $0
	{% filter indent('\t', True) %}
	{% include 'samples' %}

	{% include 'values' %}
	{% endfilter %}

	{% block create %}
	# Transformer:
	{{ instance|default('transformer') }} = {{ class_name }}.new 
	{% endblock %}

	# Features of one sample (arguments) or several samples (standard input):
	read_samples(ARGV) do |features|
		print_values transformer.transform(features)
	end
end
{% endblock %}
