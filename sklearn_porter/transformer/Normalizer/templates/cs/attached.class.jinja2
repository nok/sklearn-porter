{% extends 'base.attached.class' %}

{% block content %}
{% block class %}
public class {{ class_name }} {

    public double[] Transform(double[] features) {
        double norm = 0.0;
        foreach (double feature in features) {
            norm = System.Math.Max(norm, System.Math.Abs(feature));
        }
        if (norm < {{ min_norm }}) {
            norm = 1.0;
        }
        double[] values = new double[features.Length];
        for (int i = 0; i < features.Length; i++) {
            values[i] = features[i] / norm;
        }
        return values;
    }
{% if not _blocks %}

{% include 'samples' %}

{% include 'values' %}


    public static void Main(string[] args) {
        {% block create %}
        // Transformer:
        {{ class_name }} {{ instance|default('transformer') }} = new {{ class_name }}();
        {% endblock %}

        // Features of one sample (arguments) or several samples (standard input):
        foreach (double[] features in ReadSamples(args, 0)) {
            PrintValues(transformer.Transform(features));
        }
    }
{% endif %}
}
