{% extends 'base.attached.class' %}

{% block content %}
{% block class %}
public class {{ class_name }} {

    public double[] Transform(double[] features) {
        {% if norm == 'max' %}
        double norm = 0.0;
        foreach (double feature in features) {
            norm = System.Math.Max(norm, System.Math.Abs(feature));
        }
        if (norm < {{ min_norm }}) {
            norm = 1.0;
        }
        {% else %}
        {% macro norm_sum(t) %}{% if t is number %}{% if norm == 'l1' %}System.Math.Abs(features[{{ t }}]){% else %}features[{{ t }}] * features[{{ t }}]{% endif %}{% else %}({{ norm_sum(t[0]) }} + {{ norm_sum(t[1]) }}){% endif %}{% endmacro %}
        double norm = {% if norm == 'l2' %}System.Math.Sqrt({{ norm_sum(norm_tree) }}){% else %}{{ norm_sum(norm_tree) }}{% endif %};
        if (norm < {{ min_norm }}) {
            norm = 1.0;
        }
        {% endif %}
        double[] values = new double[features.Length];
        for (int i = 0; i < features.Length; i++) {
            values[i] = features[i] / norm;
        }
        return values;
    }
{% if not _blocks %}

{% include 'samples' %}

{% include 'values' %}


    public static void Main(string[] args) {
        {% block create %}
        // Transformer:
        {{ class_name }} {{ instance|default('transformer') }} = new {{ class_name }}();
        {% endblock %}

        // Features of one sample (arguments) or several samples (standard input):
        foreach (double[] features in ReadSamples(args, 0)) {
            PrintValues(transformer.Transform(features));
        }
    }
{% endif %}
}
{% endblock %}
{% endblock %}
