{% extends 'base.attached.class' %}

{% block content %}
#include <math.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

{% block class %}
#define {{ prefix }}N_FEATURES {{ n_features }}
#define {{ prefix }}N_FEATURES_OUT {{ n_features_out }}
{% if n_stop_words %}
#define {{ prefix }}N_STOP_WORDS {{ n_stop_words }}
{% endif %}


{% if n_stop_words %}
{{ stop_words }}

{% endif %}
{% if n_stop_words %}
/* Whether a token is a stop word (the stop words are sorted like `strcmp`): */
int {{ prefix }}is_stop_word(const char *token) {
    int low = 0, high = {{ prefix }}N_STOP_WORDS - 1;
    while (low <= high) {
        int middle = low + (high - low) / 2;
        int comparison = strcmp(token, {{ prefix }}stop_words[middle]);
        if (comparison == 0) {
            return 1;
        }
        if (comparison < 0) {
            high = middle - 1;
        } else {
            low = middle + 1;
        }
    }
    return 0;
}

{% endif %}
/* The signed 32-bit MurmurHash3 (x86_32, seed 0) of the bytes of a term (UTF-8): */
int32_t {{ prefix }}murmurhash3(const char *term) {
    const unsigned char *data = (const unsigned char *) term;
    size_t length = strlen(term), n_blocks = length / 4;
    uint32_t h = 0, k;
    for (size_t i = 0; i < n_blocks; i++) {
        k = (uint32_t) data[4 * i] | (uint32_t) data[4 * i + 1] << 8 | (uint32_t) data[4 * i + 2] << 16 | (uint32_t) data[4 * i + 3] << 24;
        k *= 0xcc9e2d51u;
        k = (k << 15) | (k >> 17);
        k *= 0x1b873593u;
        h ^= k;
        h = (h << 13) | (h >> 19);
        h = h * 5 + 0xe6546b64u;
    }
    const unsigned char *tail = data + 4 * n_blocks;
    size_t rest = length & 3;
    k = 0;
    if (rest == 3) {
        k ^= (uint32_t) tail[2] << 16;
    }
    if (rest >= 2) {
        k ^= (uint32_t) tail[1] << 8;
    }
    if (rest >= 1) {
        k ^= tail[0];
        k *= 0xcc9e2d51u;
        k = (k << 15) | (k >> 17);
        k *= 0x1b873593u;
        h ^= k;
    }
    h ^= (uint32_t) length;
    h ^= h >> 16;
    h *= 0x85ebca6bu;
    h ^= h >> 13;
    h *= 0xc2b2ae35u;
    h ^= h >> 16;
    return (int32_t) h;
}

/* Whether a character is a word character: an ASCII letter, digit or
   underscore or a byte of a character outside of ASCII (UTF-8): */
int {{ prefix }}is_word_char(char c) {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' || (unsigned char) c >= 0x80;
}

/* Write the transformed features of the document to `values`: */
void {{ prefix }}transform(double *values, const char *document) {
    for (int i = 0; i < {{ prefix }}N_FEATURES; i++) {
        values[i] = 0.0;
    }
    size_t length = strlen(document);
    char *text = malloc(length + 1);
    char **tokens = malloc((length / 2 + 1) * sizeof(char *));
    char *term = malloc(length + 1);
    if (text == NULL || tokens == NULL || term == NULL) {
        fprintf(stderr, "Out of memory.\n");
        exit(1);
    }
    memcpy(text, document, length + 1);

    /* The tokens are the runs of two or more word characters (code points),
       which end with a null character in the text{% if n_stop_words %} (without the stop words){% endif %}: */
    int n_tokens = 0;
    size_t i = 0;
    while (i < length) {
        if (!{{ prefix }}is_word_char(text[i])) {
            i++;
            continue;
        }
        size_t start = i;
        int n_chars = 0;
        while (i < length && {{ prefix }}is_word_char(text[i])) {
            if (((unsigned char) text[i] & 0xC0) != 0x80) {
                n_chars++;
            }
            {% if lowercase %}
            if (text[i] >= 'A' && text[i] <= 'Z') {
                text[i] += 'a' - 'A';
            }
            {% endif %}
            i++;
        }
        text[i++] = '\0';
        if (n_chars >= 2{% if n_stop_words %} && !{{ prefix }}is_stop_word(text + start){% endif %}) {
            tokens[n_tokens++] = text + start;
        }
    }

    /* Hash the n-grams of the tokens (joined by spaces): */
    for (int n = {{ min_n }}; n <= {{ max_n }} && n <= n_tokens; n++) {
        for (int j = 0; j + n <= n_tokens; j++) {
            char *end = term;
            for (int k = j; k < j + n; k++) {
                if (k > j) {
                    *end++ = ' ';
                }
                size_t token_length = strlen(tokens[k]);
                memcpy(end, tokens[k], token_length);
                end += token_length;
            }
            *end = '\0';
            /* The index of a term is the absolute value of its hash modulo the number of features, the sign of the value the sign of the hash: */
            int32_t h = {{ prefix }}murmurhash3(term);
            int64_t index = (h < 0 ? -(int64_t) h : (int64_t) h) % {{ prefix }}N_FEATURES;
            values[index] {% if binary %}= 1.0{% elif alternate_sign %}+= (h >= 0 ? 1.0 : -1.0){% else %}+= 1.0{% endif %};
        }
    }
    {% if norm %}
    /* Normalize the features, if their norm isn't zero: */
    double norm = 0.0;
    for (int i = 0; i < {{ prefix }}N_FEATURES; i++) {
        norm += {% if norm == 'l1' %}fabs(values[i]){% else %}values[i] * values[i]{% endif %};
    }
    if (norm != 0.0) {
        {% if norm == 'l2' %}
        norm = sqrt(norm);
        {% endif %}
        for (int i = 0; i < {{ prefix }}N_FEATURES; i++) {
            values[i] /= norm;
        }
    }
    {% endif %}
    free(text);
    free(tokens);
    free(term);
}
{% endblock %}

{% include 'documents' %}

{% include 'values' %}

int main(int argc, const char *argv[]) {

    /* One document (arguments) or several documents (standard input): */
    double *values = malloc({{ prefix }}N_FEATURES_OUT * sizeof(double));
    char *document;
    while ((document = read_document(argc, argv, 1)) != NULL) {
        transform(values, document);
        print_values(values, N_FEATURES_OUT);
        free(document);
    }
    free(values);
    return 0;
}
{% endblock %}
