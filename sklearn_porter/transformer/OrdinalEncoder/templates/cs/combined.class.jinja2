{% extends 'base.combined.class' %}

{% block content %}
{% block class %}
public class {{ class_name }} {

    public double[] Transform(double[] features) {
        double[] values = new double[{{ n_features_out }}];
        {% for i in range(n_features) %}
        values[{{ i }}] = double.IsNaN(features[{{ i }}]) ? {{ encoded_missing_value if feature_missing[i] else unknown_value }} : {% for c in feature_categories[i] %}(features[{{ i }}] == {{ c }} ? {{ loop.index0 }}.0 : {% endfor %}{{ unknown_value }}{{ ')' * feature_categories[i]|length }};
        {% endfor %}
        return values;
    }
{% if not _blocks %}

{% include 'samples' %}

{% include 'values' %}


    public static void Main(string[] args) {
        {% block create %}
        // Transformer:
        {{ class_name }} {{ instance|default('transformer') }} = new {{ class_name }}();
        {% endblock %}

        // Features of one sample (arguments) or several samples (standard input):
        foreach (double[] features in ReadSamples(args, 0)) {
            PrintValues(transformer.Transform(features));
        }
    }
{% endif %}
}
{% endblock %}
{% endblock %}
