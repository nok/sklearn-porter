{% extends 'base.attached.class' %}

{% block content %}
{% block class %}
var {{ class_name }} = function(categories, offsets, missing) {

    this.categories = categories;
    this.offsets = offsets;
    this.missing = missing;

    this.transform = function(features) {
        var values = new Array(features.length);
        for (var i = 0, l = features.length; i < l; i++) {
            if (isNaN(features[i])) {
                values[i] = this.missing[i] === 1 ? {{ encoded_missing_value }} : {{ unknown_value }};
                continue;
            }
            values[i] = {{ unknown_value }};
            // The position of x (binary search of the sorted categories):
            var lo = this.offsets[i];
            var hi = this.offsets[i + 1];
            while (lo < hi) {
                var mid = (lo + hi) >> 1;
                if (this.categories[mid] < features[i]) {
                    lo = mid + 1;
                } else {
                    hi = mid;
                }
            }
            if (lo < this.offsets[i + 1] && this.categories[lo] === features[i]) {
                values[i] = lo - this.offsets[i];
            }
        }
        return values;
    };

};
{% endblock %}

{% include 'samples' %}

{% include 'values' %}

var main = function () {
    {% block create %}
    // Model data:
    {{ categories }}
    {{ offsets }}
    {{ missing }}

    // Transformer:
    var {{ instance|default('transformer') }} = new {{ class_name }}({{ prefix }}categories, {{ prefix }}offsets, {{ prefix }}missing);
    {% endblock %}

    // Features of one sample (arguments) or several samples (standard input):
    readSamples(process.argv.slice(2)).forEach(function (features) {
        printValues(transformer.transform(features));
    });
}

if (require.main === module) {
    main();
}
{% endblock %}
