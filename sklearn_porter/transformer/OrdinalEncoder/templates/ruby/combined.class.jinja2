{% extends 'base.combined.class' %}

{% block content %}
{% block class %}
class {{ class_name }}

	def transform(features)
		[
			{% for i in range(n_features) %}
			features[{{ i }}].nan? ? {{ encoded_missing_value if feature_missing[i] else unknown_value }} : {% for c in feature_categories[i] %}(features[{{ i }}] == {{ c }} ? {{ loop.index0 }}.0 : {% endfor %}{{ unknown_value }}{{ ')' * feature_categories[i]|length }},
			{% endfor %}
		]
	end

end
{% endblock %}

if __FILE__ == $0
	{% filter indent('\t', True) %}
	{% include 'samples' %}

	{% include 'values' %}
	{% endfilter %}

	{% block create %}
	# Transformer:
	{{ instance|default('transformer') }} = {{ class_name }}.new
	{% endblock %}

	# Features of one sample (arguments) or several samples (standard input):
	read_samples(ARGV) do |features|
		print_values transformer.transform(features)
	end
end
{% endblock %}
