{% extends 'base.exported.class' %}

{% block content %}
require 'json'


{% block class %}
class {{ class_name }}

{% if _blocks %}
	def initialize(data)
{% else %}
	def initialize(path)
		data = JSON.parse(File.read(path))
{% endif %}
		@categories = data['categories']
		@offsets = data['offsets']
		@missing = data['missing']
	end

	def transform(features)
		Array.new(features.length) do |i|
			if features[i].nan?
				@missing[i] == 1 ? {{ encoded_missing_value }} : {{ unknown_value }}
			else
				# The position of x (binary search of the sorted categories):
				j = (@offsets[i]...@offsets[i + 1]).bsearch { |k| @categories[k] >= features[i] }
				j.nil? || @categories[j] != features[i] ? {{ unknown_value }} : (j - @offsets[i]).to_f
			end
		end
	end

end
{% endblock %}

if __FILE__ == $0
	{% filter indent('\t', True) %}
	{% include 'samples' %}

	{% include 'values' %}
	{% endfilter %}

	raise "You have to pass the path to the model data." if ARGV.empty?

	# Model data:
	path = ARGV.shift

	{% block create %}
	# Transformer:
	{{ instance|default('transformer') }} = {{ class_name }}.new {{ data|default('path') }}
	{% endblock %}

	# Features of one sample (arguments) or several samples (standard input):
	read_samples(ARGV) do |features|
		print_values transformer.transform(features)
	end
end
{% endblock %}
