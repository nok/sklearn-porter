{% extends 'base.attached.class' %}

{% block content %}
{% block class %}
class {{ class_name }} {

    private double[] categories;
    private int[] offsets;
    private int[] missing;

    public {{ class_name }}(double[] categories, int[] offsets, int[] missing) {
        this.categories = categories;
        this.offsets = offsets;
        this.missing = missing;
    }

    public double[] transform(double[] features) {
        double[] values = new double[features.length];
        for (int i = 0; i < features.length; i++) {
            if (Double.isNaN(features[i])) {
                values[i] = this.missing[i] == 1 ? {{ encoded_missing_value }} : {{ unknown_value }};
                continue;
            }
            values[i] = {{ unknown_value }};
            // The position of x (binary search of the sorted categories):
            int lo = this.offsets[i];
            int hi = this.offsets[i + 1];
            while (lo < hi) {
                int mid = (lo + hi) / 2;
                if (this.categories[mid] < features[i]) {
                    lo = mid + 1;
                } else {
                    hi = mid;
                }
            }
            if (lo < this.offsets[i + 1] && this.categories[lo] == features[i]) {
                values[i] = lo - this.offsets[i];
            }
        }
        return values;
    }
{% if not _blocks %}

{% include 'samples' %}

{% include 'values' %}

    public static void main(String[] args) {
        {% block create %}
        // Model data:
        {{ categories }}
        {{ offsets }}
        {{ missing }}

        // Transformer:
        {{ class_name }} {{ instance|default('transformer') }} = new {{ class_name }}({{ prefix }}categories, {{ prefix }}offsets, {{ prefix }}missing);
        {% endblock %}

        // Features of one sample (arguments) or several samples (standard input):
        for (double[] features : readSamples(args, 0)) {
            printValues(transformer.transform(features));
        }
    }
{% endif %}
}
