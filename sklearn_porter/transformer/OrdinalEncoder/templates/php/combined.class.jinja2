{% extends 'base.combined.class' %}

{% block content %}
{% block class %}
{# A balanced tree of comparisons of x with the sorted categories (the items, with their codes as pairs or with their positions as codes): #}
{% macro search(x, items, pairs, unknown, lo, hi) %}{% if hi <= lo %}{{ unknown }}{% elif hi - lo == 1 %}({{ x }} == {{ items[lo][0] if pairs else items[lo] }} ? {{ items[lo][1] if pairs else lo ~ '.0' }} : {{ unknown }}){% else %}{% set mid = (lo + hi) // 2 %}({{ x }} < {{ items[mid][0] if pairs else items[mid] }} ? {{ search(x, items, pairs, unknown, lo, mid) }} : {{ search(x, items, pairs, unknown, mid, hi) }}){% endif %}{% endmacro %}
class {{ class_name }} {

    public function transform($features) {
        return array(
            {% for i in range(n_features) %}
            is_nan($features[{{ i }}]) ? {{ encoded_missing_value if feature_missing[i] else unknown_value }} : {{ search('$features[' ~ i ~ ']', feature_categories[i], false, unknown_value, 0, feature_categories[i]|length) }},
            {% endfor %}
        );
    }

}
{% endblock %}

if (PHP_SAPI === 'cli' && realpath($argv[0]) === __FILE__) {
    {% filter indent(4, True) %}
    {% include 'samples' %}

    {% include 'values' %}
    {% endfilter %}

    array_shift($argv);

    {% block create %}
    // Transformer:
    ${{ instance|default('transformer') }} = new {{ class_name }}();
    {% endblock %}

    // Features of one sample (arguments) or several samples (standard input):
    foreach (readSamples($argv) as $features) {
        printValues($transformer->transform($features));
    }

}
{% endblock %}
