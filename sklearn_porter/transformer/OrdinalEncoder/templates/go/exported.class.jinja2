{% extends 'base.exported.class' %}

{% block content %}
package main

import (
	"bufio"
	"encoding/json"
	"fmt"
	"math"
	"os"
	"strconv"
	"strings"
)

{% block class %}
type {{ class_name }} struct {
	Categories []float64 `json:"categories"`
	Offsets    []int `json:"offsets"`
	Missing    []int `json:"missing"`
}

func (transformer {{ class_name }}) Transform(features []float64) []float64 {
	values := make([]float64, len(features))
	for i := range features {
		if math.IsNaN(features[i]) {
			if transformer.Missing[i] == 1 {
				values[i] = {{ encoded_missing_value }}
			} else {
				values[i] = {{ unknown_value }}
			}
			continue
		}
		values[i] = {{ unknown_value }}
		// The position of x (binary search of the sorted categories):
		lo, hi := transformer.Offsets[i], transformer.Offsets[i+1]
		for lo < hi {
			mid := (lo + hi) / 2
			if transformer.Categories[mid] < features[i] {
				lo = mid + 1
			} else {
				hi = mid
			}
		}
		if lo < transformer.Offsets[i+1] && transformer.Categories[lo] == features[i] {
			values[i] = float64(lo - transformer.Offsets[i])
		}
	}
	return values
}
{% endblock %}

{% include 'samples' %}

{% include 'values' %}

func main() {
	if len(os.Args) < 2 {
		fmt.Fprintln(os.Stderr, "You have to pass the path to the model data.")
		os.Exit(1)
	}

	// Model data:
	byteValue, err := os.ReadFile(os.Args[1])
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}

	{% block create %}
	// Transformer:
	var {{ instance|default('transformer') }} {{ class_name }}
	if err := json.Unmarshal({{ data|default('byteValue') }}, &{{ instance|default('transformer') }}); err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
	{% endblock %}

	// Features of one sample (arguments) or several samples (standard input):
	readSamples(os.Args[2:], func(features []float64) {
		printValues(transformer.Transform(features))
	})
}
{% endblock %}
