{% extends 'base.attached.class' %}

{% block content %}
package main

import (
	"bufio"
	"fmt"
	"math"
	"os"
	"strconv"
	"strings"
)

{% block class %}
type {{ class_name }} struct {
	Categories []float64
	Offsets    []int
	Missing    []int
}

func (transformer {{ class_name }}) Transform(features []float64) []float64 {
	values := make([]float64, len(features))
	for i := range features {
		if math.IsNaN(features[i]) {
			if transformer.Missing[i] == 1 {
				values[i] = {{ encoded_missing_value }}
			} else {
				values[i] = {{ unknown_value }}
			}
			continue
		}
		values[i] = {{ unknown_value }}
		// The position of x (binary search of the sorted categories):
		lo, hi := transformer.Offsets[i], transformer.Offsets[i+1]
		for lo < hi {
			mid := (lo + hi) / 2
			if transformer.Categories[mid] < features[i] {
				lo = mid + 1
			} else {
				hi = mid
			}
		}
		if lo < transformer.Offsets[i+1] && transformer.Categories[lo] == features[i] {
			values[i] = float64(lo - transformer.Offsets[i])
		}
	}
	return values
}
{% endblock %}

{% include 'samples' %}

{% include 'values' %}

{% block data %}
// Model data:
{{ categories }}
{{ offsets }}
{{ missing }}
{% endblock %}

func main() {
	{% block create %}
	// Transformer:
	{{ instance|default('transformer') }} := {{ class_name ~ '{' }}{{ prefix }}categories, {{ prefix }}offsets, {{ prefix }}missing}
	{% endblock %}

	// Features of one sample (arguments) or several samples (standard input):
	readSamples(os.Args[1:], func(features []float64) {
		printValues(transformer.Transform(features))
	})
}
{% endblock %}
