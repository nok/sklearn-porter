{% extends 'base.exported.class' %}

{% block content %}
using System;
using System.Globalization;
using System.IO;
using System.Text.Json;


public class {{ class_name }} {

    private class ModelData {
        public double[] Priors { get; set; }
        public double[][] Probs { get; set; }
        public bool Binarize { get; set; }
        public double Threshold { get; set; }
    }

    private ModelData data;

    public {{ class_name }}(string file) {
        JsonSerializerOptions options = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.SnakeCaseLower };
        this.data = JsonSerializer.Deserialize<ModelData>(File.ReadAllText(file), options);
    }

    private static int FindMax(double[] nums) {
        int idx = 0;
        for (int i = 0; i < nums.Length; i++) {
            idx = nums[i] > nums[idx] ? i : idx;
        }
        return idx;
    }

    private static double LogSumExp(double[] nums) {
        double max = nums[FindMax(nums)];
        double sum = 0.0;
        for (int i = 0; i < nums.Length; i++) {
            sum += Math.Exp(nums[i] - max);
        }
        return max + Math.Log(sum);
    }

    private double[] Compute(double[] features) {
        int nClasses = this.data.Probs.Length;
        int nFeatures = this.data.Probs[0].Length;

        double[][] deltas = new double[nClasses][];
        double[] jll = new double[nClasses];

        int i, j;
        double sum;

        if (this.data.Binarize) {
            // Binarize a copy of the features with the threshold:
            features = (double[]) features.Clone();
            for (j = 0; j < nFeatures; j++) {
                features[j] = features[j] > this.data.Threshold ? 1 : 0;
            }
        }
        for (i = 0; i < nClasses; i++) {
            deltas[i] = new double[nFeatures];
            for (j = 0; j < nFeatures; j++) {
                deltas[i][j] = Math.Log(1 - Math.Exp(this.data.Probs[i][j]));
            }
        }
        for (i = 0; i < nClasses; i++) {
            jll[i] = 0.0;
        }
        for (j = 0; j < nFeatures; j++) {
            for (i = 0; i < nClasses; i++) {
                jll[i] += features[j] * (this.data.Probs[i][j] - deltas[i][j]);
            }
        }
        for (i = 0; i < nClasses; i++) {
            sum = 0.0;
            for (j = 0; j < nFeatures; j++) {
                sum += deltas[i][j];
            }
            jll[i] = jll[i] + this.data.Priors[i] + sum;
        }
        return jll;
    }

{% include 'labels' %}


    public int PredictIndex(double[] features) {
        return FindMax(this.Compute(features));
    }

    public {{ label_type }} Predict(double[] features) {
        return LABELS[this.PredictIndex(features)];
    }

    public double[] PredictProba(double[] features) {
        double[] jll = this.Compute(features);
        double sum = LogSumExp(jll);
        for (int i = 0; i < jll.Length; i++) {
            jll[i] = Math.Exp(jll[i] - sum);
        }
        return jll;
    }
