{% extends 'base.exported.class' %}

{% block content %}
require 'json'


class {{ class_name }}

	def initialize(path)
		data = JSON.parse(File.read(path))
		@priors = data['priors']
		@probs = data['probs']
		@binarize = data['binarize']
		@threshold = data['threshold']
	end

	def _find_max(nums)
		idx = 0
		for i in 0 ... nums.length
			idx = nums[i] > nums[idx] ? i : idx
		end
		idx
	end

	def _log_sum_exp(nums)
		max = nums[_find_max nums]
		sum = 0.0
		for i in 0 ... nums.length
			sum += Math.exp(nums[i] - max)
		end
		max + Math.log(sum)
	end

	def _compute(features)
		likelihoods = Array.new(@priors.length, 0.0)
		for i in 0 ... @priors.length
			sum = 0.0
			for j in 0 ... @probs[i].length
				delta = Math.log(1.0 - Math.exp(@probs[i][j]))
				feature = @binarize ? (features[j] > @threshold ? 1.0 : 0.0) : features[j]
				sum += feature * (@probs[i][j] - delta) + delta
			end
			likelihoods[i] = @priors[i] + sum
		end
		likelihoods
	end

{% include 'labels' %}

	def predict_index(features)
		_find_max _compute(features)
	end

	def predict(features)
		LABELS[predict_index features]
	end

	def predict_proba(features)
		likelihoods = _compute features
		sum = _log_sum_exp likelihoods
		likelihoods.map { |likelihood| Math.exp(likelihood - sum) }
	end

end

if __FILE__ == $0
	if ARGV.length != {{ n_features + 1 }}
		raise "You have to pass the path to the model data and {{ n_features }} features."
	end

	# Model data:
	model_data = ARGV.shift

	# Features:
	features = ARGV.collect(&:to_f)

	# Estimator:
	clf = {{ class_name }}.new model_data

	{% if is_test or to_json %}
	# Get JSON:
	prediction = clf.predict features
	probabilities = clf.predict_proba features
	puts JSON.generate({:predict => prediction, :predict_proba => probabilities})
	{% else %}
	# Get class prediction:
	prediction = clf.predict features
	puts "Predicted class: #{prediction}"

	# Get class probabilities:
	probabilities = clf.predict_proba features
	for i in 0 ... probabilities.length
		puts "Probability of class ##{i} : #{probabilities[i]}"
	end
	{% endif %}
end
{% endblock %}
