{% extends 'base.attached.class' %}

{% block content %}
package main

import (
	"bufio"
	{% if is_test or to_json %}
	"encoding/json"
	{% endif %}
	"fmt"
	"math"
	"os"
	"strconv"
	"strings"
)

type {{ class_name }} struct {
	Layers []int `json:"layers"`
	Weights [][][]float64 `json:"weights"`
	Bias [][]float64 `json:"bias"`
	HiddenActivation string `json:"hidden_activation"`
}

{% if is_test or to_json %}
type Response struct {
	Predict interface{} `json:"predict"`
}

{% endif %}
func (reg {{ class_name }}) activate(activation string, v []float64) {
	switch activation {
	case "logistic":
		for i := range v {
			v[i] = 1.0 / (1.0 + math.Exp(-v[i]))
		}
	case "relu":
		for i := range v {
			v[i] = math.Max(0, v[i])
		}
	case "tanh":
		for i := range v {
			v[i] = math.Tanh(v[i])
		}
	}
}

func (reg {{ class_name }}) feedForward(features []float64) []float64 {
	var inputs = features
	for i := 0; i < len(reg.Layers); i++ {
		var outputs = make([]float64, reg.Layers[i])
		copy(outputs, reg.Bias[i])
		for j := 0; j < len(inputs); j++ {
			input, row := inputs[j], reg.Weights[i][j]
			for k := 0; k < len(outputs); k++ {
				outputs[k] += input * row[k]
			}
		}
		if i < len(reg.Layers) - 1 {
			reg.activate(reg.HiddenActivation, outputs)
		}
		inputs = outputs
	}
	return inputs
}

func (reg {{ class_name }}) Predict(features []float64) []float64 {
{% if output_activation == 'exp' %}
	var outputs = reg.feedForward(features)
	// The output activation `exp` of the loss `poisson`:
	for i := range outputs {
		outputs[i] = math.Exp(outputs[i])
	}
	return outputs
{% else %}
	return reg.feedForward(features)
{% endif %}
}

{% include 'samples' %}

// Model data:
{{ layers }}
{{ weights }}
{{ bias }}

func main() {
	// Estimator:
	reg := {{ class_name }}{layers, weights, bias, "{{ hidden_activation }}"}

	// Features of one sample (arguments) or several samples (standard input):
	readSamples(os.Args[1:], func(features []float64) {
		{% if is_test or to_json %}
		// Get JSON:
		prediction := reg.Predict(features)
		var res []byte
		if len(prediction) == 1 {
			res, _ = json.Marshal(&Response{Predict: prediction[0]})
		} else {
			res, _ = json.Marshal(&Response{Predict: prediction})
		}
		fmt.Println(string(res))
		{% else %}
		// Get predicted values:
		prediction := reg.Predict(features)
		for i, value := range prediction {
			fmt.Printf("Predicted value #%d : %v\n", i, value)
		}
		{% endif %}
	})

}
{% endblock %}
