{% extends 'base.attached.class' %}

{% block content %}
{% if is_test or to_json %}
import java.util.Arrays;

{% endif %}
class {{ class_name }} {

    private enum Activation { IDENTITY, LOGISTIC, RELU, TANH }

    private Activation hidden;
    private int[] layers;
    private double[][][] weights;
    private double[][] bias;

    public {{ class_name }}(String hidden, int[] layers, double[][][] weights, double[][] bias) {
        this.hidden = Activation.valueOf(hidden.toUpperCase());
        this.layers = layers;
        this.weights = weights;
        this.bias = bias;
    }

    private void compute(Activation activation, double[] v) {
        int i, l = v.length;
        switch (activation) {
            case LOGISTIC:
                for (i = 0; i < l; i++) {
                    v[i] = 1. / (1. + Math.exp(-v[i]));
                }
                break;
            case RELU:
                for (i = 0; i < l; i++) {
                    v[i] = Math.max(0, v[i]);
                }
                break;
            case TANH:
                for (i = 0; i < l; i++) {
                    v[i] = Math.tanh(v[i]);
                }
                break;
            default:
                break;
        }
    }

    private double[] feedForward(double[] features) {
        double[] inputs = features;
        for (int i = 0; i < this.layers.length; i++) {
            double[] outputs = this.bias[i].clone();
            for (int j = 0; j < inputs.length; j++) {
                double input = inputs[j];
                double[] row = this.weights[i][j];
                for (int k = 0; k < outputs.length; k++) {
                    outputs[k] += input * row[k];
                }
            }
            if (i < this.layers.length - 1) {
                this.compute(this.hidden, outputs);
            }
            inputs = outputs;
        }
        return inputs;
    }

    public double[] predict(double[] features) {
{% if output_activation == 'exp' %}
        double[] outputs = this.feedForward(features);
        // The output activation `exp` of the loss `poisson`:
        for (int i = 0; i < outputs.length; i++) {
            outputs[i] = Math.exp(outputs[i]);
        }
        return outputs;
{% else %}
        return this.feedForward(features);
{% endif %}
    }

{% include 'samples' %}

    public static void main(String[] args) {
        // Model data:
        {{ layers }}
        {{ weights }}
        {{ bias }}

        // Estimator:
        {{ class_name }} reg = new {{ class_name }}("{{ hidden_activation }}", layers, weights, bias);

        // Features of one sample (arguments) or several samples (standard input):
        for (double[] features : readSamples(args, 0)) {
            {% if is_test or to_json %}
            // Get JSON:
            double[] prediction = reg.predict(features);
            String values = prediction.length == 1 ? String.valueOf(prediction[0]) : Arrays.toString(prediction);
            System.out.println("{\"predict\": " + values + "}");
            {% else %}
            // Get predicted values:
            double[] prediction = reg.predict(features);
            for (int i = 0; i < prediction.length; i++) {
                System.out.println("Predicted value #" + i + " : " + String.valueOf(prediction[i]));
            }
            {% endif %}
        }

    }
}
{% endblock %}
