{% extends 'base.exported.class' %}

{% block content %}
class {{ class_name }} {

    private $layers;
    private $weights;
    private $bias;
    private $hidden;

    public function __construct($path) {
        $data = json_decode(file_get_contents($path), true);
        $this->hidden = $data['hidden_activation'];
        $this->layers = $data['layers'];
        $this->weights = $data['weights'];
        $this->bias = $data['bias'];
    }

    private function activate($activation, $v) {
        $l = count($v);
        switch ($activation) {
            case 'logistic':
                for ($i = 0; $i < $l; $i++) {
                    $v[$i] = 1. / (1. + exp(-$v[$i]));
                }
                break;
            case 'relu':
                for ($i = 0; $i < $l; $i++) {
                    $v[$i] = max(0, $v[$i]);
                }
                break;
            case 'tanh':
                for ($i = 0; $i < $l; $i++) {
                    $v[$i] = tanh($v[$i]);
                }
                break;
        }
        return $v;
    }

    private function feedForward($features) {
        $inputs = $features;
        for ($i = 0, $il = count($this->layers); $i < $il; $i++) {
            $outputs = $this->bias[$i];
            for ($j = 0, $jl = count($inputs); $j < $jl; $j++) {
                $input = $inputs[$j];
                $row = $this->weights[$i][$j];
                for ($k = 0, $kl = count($outputs); $k < $kl; $k++) {
                    $outputs[$k] += $input * $row[$k];
                }
            }
            $inputs = $i < $il - 1 ? $this->activate($this->hidden, $outputs) : $outputs;
        }
        return $inputs;
    }

    public function predict($features) {
        $outputs = $this->feedForward($features);
{% if output_activation == 'exp' %}
        // The output activation `exp` of the loss `poisson`:
        $outputs = array_map('exp', $outputs);
{% endif %}
        if (count($outputs) == 1) {
            return $outputs[0];
        }
        return $outputs;
    }

}

{% if pipeline_classes %}
{{ pipeline_classes }}

{% endif %}
if (PHP_SAPI === 'cli' && realpath($argv[0]) === __FILE__) {
    {% filter indent(4, True) %}
    {% include 'samples' %}
    {% endfilter %}

    if (count($argv) < 2) {
        fwrite(STDERR, "You have to pass the path to the model data.\n");
        exit(1);
    }

    array_shift($argv);

    {% if pipeline_create %}
    {{ pipeline_create | indent('    ') }}

    {% endif %}
    // Model data:
    $path = array_shift($argv);

    // Estimator:
    $reg = new {{ class_name }}($path);

    // Features of one sample (arguments) or several samples (standard input):
    foreach (readSamples($argv) as $features) {
        {% if pipeline_transform %}
        {{ pipeline_transform | indent('        ') }}
        {% endif %}
        {% if is_test or to_json %}
        // Get JSON:
        $prediction = $reg->predict($features);
        fwrite(STDOUT, json_encode(array("predict" => $prediction)) . "\n");
        {% else %}
        // Get predicted values:
        $prediction = $reg->predict($features);
        if (is_array($prediction)) {
            for ($i = 0; $i < count($prediction); $i++) {
                fwrite(STDOUT, "Predicted value #" . strval($i) . " = " . strval($prediction[$i]) . "\n");
            }
        } else {
            fwrite(STDOUT, "Predicted value: " . strval($prediction) . "\n");
        }
        {% endif %}
    }

}
{% endblock %}
