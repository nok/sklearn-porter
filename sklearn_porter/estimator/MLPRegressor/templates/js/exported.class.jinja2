{% extends 'base.exported.class' %}

{% block content %}
var fs = require('fs');


var {{ class_name }} = function(jsonFile) {
    var data = JSON.parse(fs.readFileSync(jsonFile));
    this.hidden = data.hidden_activation.toUpperCase();
    this.network = new Array(data.layers.length + 1);
    for (var i = 0, l = data.layers.length; i < l; i++) {
        this.network[i + 1] = new Array(data.layers[i]).fill(0.);
    }
    this.weights = data.weights;
    this.bias = data.bias;

    var findMax = function(nums) {
        var i, l = nums.length, idx = 0;
        for (i = 0; i < l; i++) {
            idx = nums[i] > nums[idx] ? i : idx;
        }
        return idx;
    };

    var compute = function(activation, v) {
        var i, l = v.length;
        switch (activation) {
            case 'LOGISTIC':
                for (i = 0; i < l; i++) {
                    v[i] = 1. / (1. + Math.exp(-v[i]));
                }
                break;
            case 'RELU':
                for (i = 0; i < l; i++) {
                    v[i] = Math.max(0, v[i]);
                }
                break;
            case 'TANH':
                for (i = 0; i < l; i++) {
                    v[i] = Math.tanh(v[i]);
                }
                break;
            case 'SOFTMAX':
                var max = Number.NEGATIVE_INFINITY;
                for (i = 0; i < l; i++) {
                    if (v[i] > max) {
                        max = v[i];
                    }
                }
                for (i = 0; i < l; i++) {
                    v[i] = Math.exp(v[i] - max);
                }
                var sum = 0.0;
                for (i = 0; i < l; i++) {
                    sum += v[i];
                }
                for (i = 0; i < l; i++) {
                    v[i] /= sum;
                }
                break;
        }
        return v;
    };

    this.resetNetwork = function() {
        for (var i = 1, l = this.network.length - 1; i < l; i++) {
            for (var j = 0; j < this.network[i].length; j++) {
                this.network[i][j] = 0;
            }
        }
    };

    this.feedForward = function(neurons) {
        this.network[0] = neurons;
        for (var i = 0; i < this.network.length - 1; i++) {
            var inputs = this.network[i];
            var outputs = this.network[i + 1];
            for (var j = 0; j < outputs.length; j++) {
                outputs[j] = this.bias[i][j];
            }
            // Go through the weights row by row, which is faster than column by column:
            for (var l = 0; l < inputs.length; l++) {
                var row = this.weights[i][l];
                for (var j = 0; j < outputs.length; j++) {
                    outputs[j] += inputs[l] * row[j];
                }
            }
            if ((i + 1) < (this.network.length - 1)) {
                this.network[i + 1] = compute(this.hidden, this.network[i + 1]);
            }
        }
        this.resetNetwork();
        // Return a copy, the next prediction overwrites the network:
        return this.network[this.network.length - 1].slice();
    };

    this.predict = function(neurons) {
        var lastLayer = this.feedForward(neurons);
{% if output_activation == 'exp' %}
        // The output activation `exp` of the loss `poisson`:
        for (var i = 0; i < lastLayer.length; i++) {
            lastLayer[i] = Math.exp(lastLayer[i]);
        }
{% endif %}
        if (lastLayer.length === 1) {
            return lastLayer[0];
        }
        return lastLayer;
    };

};

{% include 'samples' %}

var main = function () {
    if (process.argv.length < 3) {
        throw new Error("You have to pass the path to the model data.");
    }

    // Model data:
    var json = process.argv[2];

    // Estimator:
    var reg = new {{ class_name }}(json);

    // Features of one sample (arguments) or several samples (standard input):
    readSamples(process.argv.slice(3)).forEach(function (features) {
        {% if is_test or to_json %}
        // Get JSON:
        console.log(JSON.stringify({
            "predict": reg.predict(features)
        }));
        {% else %}
        // Get class probabilities:
        var result = reg.predict(features);
        if (Array.isArray(result)) {
            for (var i = 0; i < result.length; i++) {
                console.log("Result of value #" + i + " : " + result[i]);
            }
        } else {
            console.log("Result: " + result);
        }
        {% endif %}
    });
}

if (require.main === module) {
    main();
}
{% endblock %}