{% extends 'base.exported.class' %}

{% block content %}
class {{ class_name }} {

    private $priors;
    private $probs;

    public function __construct($path) {
        $data = json_decode(file_get_contents($path), true);
        $this->priors = $data['priors'];
        $this->probs = $data['probs'];
    }

    private function findMax($nums) {
        $idx = 0;
        for ($i = 0, $l = count($nums); $i < $l; $i++) {
            $idx = $nums[$i] > $nums[$idx] ? $i : $idx;
        }
        return $idx;
    }

    private function logSumExp($nums) {
        $max = $nums[$this->findMax($nums)];
        $sum = 0.;
        for ($i = 0, $l = count($nums); $i < $l; $i++) {
            $sum += exp($nums[$i] - $max);
        }
        return $max + log($sum);
    }

    private function compute($features) {
        $likelihoods = array();
        for ($i = 0, $il = count($this->priors); $i < $il; $i++) {
            $sum = 0.;
            for ($j = 0, $jl = count($this->probs[$i]); $j < $jl; $j++) {
                $sum += $features[$j] * $this->probs[$i][$j];
            }
            $likelihoods[$i] = $sum + $this->priors[$i];
        }
        return $likelihoods;
    }

{% include 'labels' %}

    public function predictIndex($features) {
        return $this->findMax($this->compute($features));
    }

    public function predict($features) {
        return self::LABELS[$this->predictIndex($features)];
    }

    public function predictProba($features) {
        $likelihoods = $this->compute($features);
        $sum = $this->logSumExp($likelihoods);
        for ($i = 0, $l = count($likelihoods); $i < $l; $i++) {
            $likelihoods[$i] = exp($likelihoods[$i] - $sum);
        }
        return $likelihoods;
    }

}

if (PHP_SAPI === 'cli' && realpath($argv[0]) === __FILE__) {
    {% filter indent(4, True) %}
    {% include 'samples' %}
    {% endfilter %}

    if (count($argv) < 2) {
        fwrite(STDERR, "You have to pass the path to the model data.\n");
        exit(1);
    }

    array_shift($argv);

    // Model data:
    $path = array_shift($argv);

    // Estimator:
    $clf = new {{ class_name }}($path);

    // Features of one sample (arguments) or several samples (standard input):
    foreach (readSamples($argv) as $features) {
        {% if is_test or to_json %}
        // Get JSON:
        $prediction = $clf->predict($features);
        $probabilities = $clf->predictProba($features);
        fwrite(STDOUT, json_encode(array("predict" => $prediction, "predict_proba" => $probabilities)) . "\n");
        {% else %}
        // Get class prediction:
        $prediction = $clf->predict($features);
        fwrite(STDOUT, "Predicted class: " . strval($prediction) . "\n");

        // Get class probabilities:
        $probabilities = $clf->predictProba($features);
        for ($i = 0; $i < count($probabilities); $i++) {
            fwrite(STDOUT, "Probability of class #" . strval($i) . " = " . strval($probabilities[$i]) . "\n");
        }
        {% endif %}
    }

}
{% endblock %}
