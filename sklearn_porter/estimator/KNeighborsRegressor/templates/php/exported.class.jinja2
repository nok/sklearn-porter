{% extends 'base.exported.class' %}

{% block content %}
class {{ class_name }} {

    private $X;
    private $y;
    private $k;
    private $metric;
    private $power;

    public function __construct($path) {
        $data = json_decode(file_get_contents($path, true), true);
        $this->X = $data['X'];
        $this->y = $data['y'];
        $this->k = $data['k'];
        $this->metric = $data['metric'];
        $this->power = $data['power'];
    }

    // Compute the distance with the metric `minkowski`, `chebyshev`, `cosine` or `hamming`:
    private function compute($temp, $cand, $metric, $q) {
        $dist = 0.;
        $l = count($temp);
        if ($metric == 'chebyshev') {
            for ($i = 0; $i < $l; $i++) {
                $dist = max($dist, abs($temp[$i] - $cand[$i]));
            }
            return $dist;
        }
        if ($metric == 'cosine') {
            $dot = 0.; $normTemp = 0.; $normCand = 0.;
            for ($i = 0; $i < $l; $i++) {
                $dot += $temp[$i] * $cand[$i];
                $normTemp += $temp[$i] * $temp[$i];
                $normCand += $cand[$i] * $cand[$i];
            }
            // The distance to a zero vector is 1 like in scikit-learn:
            if ($normTemp == 0 || $normCand == 0) {
                return 1.;
            }
            $dist = 1. - $dot / (sqrt($normTemp) * sqrt($normCand));
            return min(max($dist, 0.), 2.);
        }
        if ($metric == 'hamming') {
            for ($i = 0; $i < $l; $i++) {
                if ($temp[$i] != $cand[$i]) {
                    $dist += 1.;
                }
            }
            return $dist / $l;
        }
        if ($q == 1) {
            for ($i = 0; $i < $l; $i++) {
                $dist += abs($temp[$i] - $cand[$i]);
            }
            return $dist;
        }
        if ($q == 2) {
            for ($i = 0; $i < $l; $i++) {
                $diff = $temp[$i] - $cand[$i];
                $dist += $diff * $diff;
            }
            return sqrt($dist);
        }
        for ($i = 0; $i < $l; $i++) {
            $dist += pow(abs($temp[$i] - $cand[$i]), $q);
        }
        return pow($dist, 1. / $q);
    }

    // Find the k nearest neighbors (index and distance) sorted by distance and
    // index (like a stable sort). A sample is only inserted if it's nearer
    // than the k-th neighbor:
    private function findNeighbors($features) {
        $neighbors = array();
        $n = 0;
        for ($i = 0; $i < count($this->X); $i++) {
            $dist = $this->compute($this->X[$i], $features, $this->metric, $this->power);
            if ($n == $this->k && !($dist < $neighbors[$this->k - 1][1])) {
                continue;
            }
            $j = $n < $this->k ? $n++ : $this->k - 1;
            while ($j > 0 && $dist < $neighbors[$j - 1][1]) {
                $neighbors[$j] = $neighbors[$j - 1];
                $j--;
            }
            $neighbors[$j] = array($i, $dist);
        }
        return $neighbors;
    }

{% if weights == 'distance' %}
    // Weight the nearest neighbors by the inverse of their distances. If some
    // neighbors have the distance 0, only they get the weight 1 (like scikit-learn):
    private function weigh($neighbors, $k) {
        $weights = array();
        $isExact = false;
        for ($i = 0; $i < $k; $i++) {
            // `fdiv` returns INF instead of an error for the distance 0:
            $weights[] = fdiv(1., $neighbors[$i][1]);
            if (is_infinite($weights[$i])) {
                $isExact = true;
            }
        }
        if ($isExact) {
            for ($i = 0; $i < $k; $i++) {
                $weights[$i] = is_infinite($weights[$i]) ? 1. : 0.;
            }
        }
        return $weights;
    }

{% endif %}
    public function predict($features) {
        $neighbors = $this->findNeighbors($features);
        $nOutputs = intdiv(count($this->y), count($this->X));
        $values = array_fill(0, $nOutputs, 0.);
{% if weights == 'distance' %}
        // The weighted mean of the targets of the nearest neighbors:
        $weights = $this->weigh($neighbors, $this->k);
        $total = 0.;
        for ($i = 0; $i < $this->k; $i++) {
            $total += $weights[$i];
        }
        for ($j = 0; $j < $nOutputs; $j++) {
            for ($i = 0; $i < $this->k; $i++) {
                $values[$j] += $this->y[$neighbors[$i][0] * $nOutputs + $j] * $weights[$i];
            }
            $values[$j] /= $total;
        }
{% else %}
        // The mean of the targets of the nearest neighbors:
        for ($j = 0; $j < $nOutputs; $j++) {
            for ($i = 0; $i < $this->k; $i++) {
                $values[$j] += $this->y[$neighbors[$i][0] * $nOutputs + $j];
            }
            $values[$j] /= $this->k;
        }
{% endif %}
        {% if is_multi_output %}
        return $values;
        {% else %}
        return $values[0];
        {% endif %}
    }

}

{% if pipeline_classes %}
{{ pipeline_classes }}

{% endif %}
if (PHP_SAPI === 'cli' && realpath($argv[0]) === __FILE__) {
    {% filter indent(4, True) %}
    {% include 'samples' %}
    {% endfilter %}

    if (count($argv) < 2) {
        fwrite(STDERR, "You have to pass the path to the model data.\n");
        exit(1);
    }

    array_shift($argv);

    {% if pipeline_create %}
    {{ pipeline_create | indent('    ') }}

    {% endif %}
    // Model data:
    $path = array_shift($argv);

    // Estimator:
    $reg = new {{ class_name }}($path);

    // Features of one sample (arguments) or several samples (standard input):
    foreach (readSamples($argv) as $features) {
        {% if pipeline_transform %}
        {{ pipeline_transform | indent('        ') }}
        {% endif %}
        {% if is_test or to_json %}
        // Get JSON:
        $prediction = $reg->predict($features);
        fwrite(STDOUT, json_encode(array("predict" => $prediction)) . "\n");
        {% else %}
        // Get predicted values:
        $prediction = $reg->predict($features);
        {% if is_multi_output %}
        for ($i = 0; $i < count($prediction); $i++) {
            fwrite(STDOUT, "Predicted value #" . strval($i) . " = " . strval($prediction[$i]) . "\n");
        }
        {% else %}
        fwrite(STDOUT, "Predicted value: " . strval($prediction) . "\n");
        {% endif %}
        {% endif %}
    }

}
{% endblock %}
