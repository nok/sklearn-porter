{% extends 'base.exported.class' %}

{% block content %}
#include <math.h>

#define N_FEATURES {{ n_features }}
#define N_OUTPUTS {{ n_outputs }}


int n_templates;
int k;
char metric[16];
double power;
double **X;
double *y;

void load(const char *path) {
    JsonValue *data = json_read(path);
    n_templates = json_get(data, "X")->length;
    X = json_doubles_2d(json_get(data, "X"));
    y = json_doubles(json_get(data, "y"));
    k = (int) json_get(data, "k")->number;
    strncpy(metric, json_get(data, "metric")->string, sizeof(metric) - 1);
    power = json_get(data, "power")->number;
    json_free(data);
}

typedef struct {
    int index;
    double dist;
} Neighbor;

/* Compute the distance with the metric `minkowski`, `chebyshev`, `cosine` or `hamming`: */
double compute(const double *temp, const double *cand, const char *metric, double q) {
    int i;
    double dist = 0.;
    double diff;
    if (strcmp(metric, "chebyshev") == 0) {
        for (i = 0; i < N_FEATURES; i++) {
            diff = fabs(temp[i] - cand[i]);
            if (diff > dist) {
                dist = diff;
            }
        }
        return dist;
    }
    if (strcmp(metric, "cosine") == 0) {
        double dot = 0.;
        double norm_temp = 0.;
        double norm_cand = 0.;
        for (i = 0; i < N_FEATURES; i++) {
            dot += temp[i] * cand[i];
            norm_temp += temp[i] * temp[i];
            norm_cand += cand[i] * cand[i];
        }
        /* The distance to a zero vector is 1 like in scikit-learn: */
        if (norm_temp == 0. || norm_cand == 0.) {
            return 1.;
        }
        dist = 1. - dot / (sqrt(norm_temp) * sqrt(norm_cand));
        return dist < 0. ? 0. : (dist > 2. ? 2. : dist);
    }
    if (strcmp(metric, "hamming") == 0) {
        for (i = 0; i < N_FEATURES; i++) {
            if (temp[i] != cand[i]) {
                dist += 1.;
            }
        }
        return dist / N_FEATURES;
    }
    for (i = 0; i < N_FEATURES; i++) {
        diff = fabs(temp[i] - cand[i]);
        if (q == 1) {
            dist += diff;
        } else if (q == 2) {
            dist += diff * diff;
        } else {
            dist += pow(diff, q);
        }
    }
    if (q == 1) {
        return dist;
    } else if (q == 2) {
        return sqrt(dist);
    }
    return pow(dist, 1. / q);
}

/* Find the k nearest neighbors sorted by distance and index (like a stable
   sort). A sample is only inserted if it's nearer than the k-th neighbor: */
void find_neighbors(Neighbor *neighbors, double features[N_FEATURES]) {
    int i, j, n = 0;
    double dist;
    for (i = 0; i < n_templates; i++) {
        dist = compute(X[i], features, metric, power);
        if (n == k && !(dist < neighbors[k - 1].dist)) {
            continue;
        }
        j = n < k ? n++ : k - 1;
        while (j > 0 && dist < neighbors[j - 1].dist) {
            neighbors[j] = neighbors[j - 1];
            j--;
        }
        neighbors[j].index = i;
        neighbors[j].dist = dist;
    }
}

{% if weights == 'distance' %}
/* Weight the nearest neighbors by the inverse of their distances. If some
   neighbors have the distance 0, only they get the weight 1 (like scikit-learn): */
double weigh(double *weights, const Neighbor *neighbors, int n_neighbors) {
    int i, is_exact = 0;
    double total = 0.;
    for (i = 0; i < n_neighbors; i++) {
        weights[i] = 1. / neighbors[i].dist;
        if (isinf(weights[i])) {
            is_exact = 1;
        }
    }
    for (i = 0; i < n_neighbors; i++) {
        if (is_exact) {
            weights[i] = isinf(weights[i]) ? 1. : 0.;
        }
        total += weights[i];
    }
    return total;
}

{% endif %}
/* Write the predicted values of all outputs to `values`: */
void predict(double *values, double features[N_FEATURES]) {
    int i, j;
    Neighbor *neighbors = malloc(k * sizeof(Neighbor));
    find_neighbors(neighbors, features);
{% if weights == 'distance' %}
    /* The weighted mean of the targets of the nearest neighbors: */
    double *weights = malloc(k * sizeof(double));
    double total = weigh(weights, neighbors, k);
    for (j = 0; j < N_OUTPUTS; j++) {
        values[j] = 0.;
        for (i = 0; i < k; i++) {
            values[j] += y[neighbors[i].index * N_OUTPUTS + j] * weights[i];
        }
        values[j] /= total;
    }
    free(weights);
{% else %}
    /* The mean of the targets of the nearest neighbors: */
    for (j = 0; j < N_OUTPUTS; j++) {
        values[j] = 0.;
        for (i = 0; i < k; i++) {
            values[j] += y[neighbors[i].index * N_OUTPUTS + j];
        }
        values[j] /= k;
    }
{% endif %}
    free(neighbors);
}

{% include 'samples' %}

int main(int argc, const char *argv[]) {
    if (argc < 2) {
        fprintf(stderr, "You have to pass the path to the model data.\n");
        return 1;
    }

    /* Model data: */
    load(argv[1]);

    /* Features of one sample (arguments) or several samples (standard input): */
    double features[N_FEATURES];
    while (read_features(features, argc, argv, 2)) {
        double prediction[N_OUTPUTS];
        predict(prediction, features);

        {% filter indent(8, True) %}
        {% include 'output' %}
        {% endfilter %}
    }

    return 0;
}
{% endblock %}
