{% extends 'base.exported.class' %}

{% block content %}
namespace {
    class {{ class_name }} {

        private $forest;

        public function __construct($path) {
            $model = json_decode(file_get_contents($path, true), true);
            $this->forest = array();
            foreach($model as $tree){
                array_push($this->forest, new {{ class_name }}\Tree(
                    $tree['lefts'], $tree['rights'],
                    $tree['thresholds'], $tree['indices'], $tree['missing_go_to_left'],
                    $tree['classes']
                ));
            }
        }

{% if is_multi_output %}
        // The classes of all outputs are concatenated, these are their numbers:
        const OUTPUT_CLASSES = [{{ output_classes | join(', ') }}];

        // Find the class with the maximum probability of each output:
        private function findMax($nums) {
            $result = [];
            foreach ($nums as $probas) {
                $idx = 0;
                for ($i = 1; $i < count($probas); $i++) {
                    $idx = $probas[$i] > $probas[$idx] ? $i : $idx;
                }
                $result[] = $idx;
            }
            return $result;
        }

        // Split the concatenated values into the values of each output:
        private function splitOutputs($nums) {
            $result = [];
            $offset = 0;
            foreach (\{{ class_name }}::OUTPUT_CLASSES as $n) {
                $result[] = array_slice($nums, $offset, $n);
                $offset += $n;
            }
            return $result;
        }
{% else %}
        private function findMax($nums) {
            $i = 0; $l = count($nums); $idx = 0;
            for (; $i < $l; $i++) {
                $idx = $nums[$i] > $nums[$idx] ? $i : $idx;
            }
            return $idx;
        }
{% endif %}


        private function compute($features) {
            $nTrees = count($this->forest);
            $nClasses = count($this->forest[0]->classes[0]);
            $probas = array_fill(0, $nClasses, 0);
            for ($i = 0; $i < $nTrees; $i++) {
                $temp = $this->forest[$i]->compute($features);
                for ($j = 0; $j < $nClasses; $j++) {
                    $probas[$j] += $temp[$j];
                }
            }
            for ($j = 0; $j < $nClasses; $j++) {
                $probas[$j] /= $nTrees;
            }
            return $probas;
        }

{% if is_multi_output %}
        public function predictProba($features) {
            return $this->splitOutputs($this->compute($features));
        }
{% else %}
        public function predictProba($features) {
            return $this->compute($features);
        }
{% endif %}

        public function predict($features) {
            return $this->findMax($this->predictProba($features));
        }

    }
}

namespace {{ class_name }} {
    class Tree {

        public $lefts;
        public $rights;
        public $thresholds;
        public $indices;
        public $missing_go_to_left;
        public $classes;

        public function __construct($lefts, $rights, $thresholds, $indices, $missing_go_to_left, $classes) {
            $this->lefts = $lefts;
            $this->rights = $rights;
            $this->thresholds = $thresholds;
            $this->indices = $indices;
            $this->missing_go_to_left = $missing_go_to_left;
            $this->classes = $classes;
        }

{% if is_multi_output %}
        // Normalize the values of each output:
        private function normVals($nums) {
            $result = [];
            $offset = 0;
            foreach (\{{ class_name }}::OUTPUT_CLASSES as $n) {
                $sum = 0.;
                for ($i = $offset; $i < $offset + $n; $i++) {
                    $sum += $nums[$i];
                }
                for ($i = $offset; $i < $offset + $n; $i++) {
                    $result[$i] = $sum == 0 ? 1. / $n : $nums[$i] / $sum;
                }
                $offset += $n;
            }
            return $result;
        }
{% else %}
        private function normVals($nums) {
            $l = count($nums);
            $result = [];
            $sum = 0.;

            for ($i = 0; $i < $l; $i++) {
                $sum += $nums[$i];
            }
            if($sum === 0) {
                for ($i = 0; $i < $l; $i++) {
                    $result[$i] = 1. / $l;
                }
            } else {
                for ($i = 0; $i < $l; $i++) {
                    $result[$i] = $nums[$i] / $sum;
                }
            }
            return $result;
        }
{% endif %}

        public function compute($features) {
            $node = (func_num_args() > 1) ? func_get_arg(1) : 0;
            while ($this->thresholds[$node] != -2) {
                if ($features[$this->indices[$node]] <= $this->thresholds[$node] || ($this->missing_go_to_left[$node] == 1 && is_nan($features[$this->indices[$node]]))) {
                    $node = $this->lefts[$node];
                } else {
                    $node = $this->rights[$node];
                }
            }
            return $this->normVals($this->classes[$node]);
        }
    }
}

namespace {
    if ($argc > 1) {
        array_shift($argv);

        // Model data:
        $path = array_shift($argv);

        // Features:
        $features = array_map(function ($value) {
            return strtolower($value) === 'nan' ? NAN : floatval($value);
        }, $argv);

        // Estimator:
        $clf = new {{ class_name }}($path);

        {% if is_test or to_json %}
        // Get JSON:
        $prediction = $clf->predict($features);
        $probabilities = $clf->predictProba($features);
        fwrite(STDOUT, json_encode(array("predict" => $prediction, "predict_proba" => $probabilities)));
        {% else %}
        // Get class prediction:
        $prediction = $clf->predict($features);
        fwrite(STDOUT, "{{ 'Predicted classes: ' if is_multi_output else 'Predicted class: #' }}" . {{ "implode(', ', $prediction)" if is_multi_output else 'strval($prediction)' }} . "\n");

        // Get class probabilities:
        $probabilities = $clf->predictProba($features);
        for ($i = 0; $i < count($probabilities); $i++) {
            fwrite(STDOUT, "{{ 'Probabilities of output #' if is_multi_output else 'Probability of class #' }}" . strval($i) . " = " . {{ "implode(', ', $probabilities[$i])" if is_multi_output else 'strval($probabilities[$i])' }} . "\n");
        }
        {% endif %}
    }
}
{% endblock %}