{% extends 'base.combined.class' %}

{% block content %}
class {{ class_name }} {

{% if is_multi_output %}
    // The classes of all outputs are concatenated, these are their numbers:
    const OUTPUT_CLASSES = [{{ output_classes | join(', ') }}];

    // Find the class with the maximum probability of each output:
    private function findMax($nums) {
        $result = [];
        foreach ($nums as $probas) {
            $idx = 0;
            for ($i = 1; $i < count($probas); $i++) {
                $idx = $probas[$i] > $probas[$idx] ? $i : $idx;
            }
            $result[] = $idx;
        }
        return $result;
    }

    // Split the concatenated values into the values of each output:
    private function splitOutputs($nums) {
        $result = [];
        $offset = 0;
        foreach (self::OUTPUT_CLASSES as $n) {
            $result[] = array_slice($nums, $offset, $n);
            $offset += $n;
        }
        return $result;
    }
{% else %}
    private function findMax($nums) {
        $idx = 0;
        for ($i = 0, $l = count($nums); $i < $l; $i++) {
            $idx = $nums[$i] > $nums[$idx] ? $i : $idx;
        }
        return $idx;
    }
{% endif %}

{% include 'labels' %}

    {{ method | indent(4) }}

}

{% if pipeline_classes %}
{{ pipeline_classes }}

{% endif %}
if (PHP_SAPI === 'cli' && realpath($argv[0]) === __FILE__) {
    {% filter indent(4, True) %}
    {% include 'samples' %}
    {% endfilter %}

    array_shift($argv);

    // Estimator:
    $clf = new {{ class_name }}();

    // Features of one sample (arguments) or several samples (standard input):
    {% if pipeline_create %}
    {{ pipeline_create | indent('    ') }}

    {% endif %}
    foreach (readSamples($argv) as $features) {
        {% if pipeline_transform %}
        {{ pipeline_transform | indent('        ') }}
        {% endif %}
        {% if is_test or to_json %}
        // Get JSON:
        $prediction = $clf->predict($features);
        $probabilities = $clf->predictProba($features);
        fwrite(STDOUT, json_encode(array("predict" => $prediction, "predict_proba" => $probabilities)) . "\n");
        {% else %}
        // Get class prediction:
        $prediction = $clf->predict($features);
        fwrite(STDOUT, "{{ 'Predicted classes: ' if is_multi_output else 'Predicted class: ' }}" . {{ "implode(', ', $prediction)" if is_multi_output else 'strval($prediction)' }} . "\n");

        // Get class probabilities:
        $probabilities = $clf->predictProba($features);
        for ($i = 0; $i < count($probabilities); $i++) {
            fwrite(STDOUT, "{{ 'Probabilities of output #' if is_multi_output else 'Probability of class #' }}" . strval($i) . " = " . {{ "implode(', ', $probabilities[$i])" if is_multi_output else 'strval($probabilities[$i])' }} . "\n");
        }
        {% endif %}
    }

}
{% endblock %}
