{% extends 'base.exported.class' %}

{% block content %}
package main

import (
	"bufio"
	"encoding/json"
	"fmt"
	"io/ioutil"
	"math"
	"os"
	"strconv"
	"strings"
)

{% include 'labels' %}

{% if is_test or to_json %}
type Response struct {
	Predict {{ '[]' if is_multi_output }}{{ label_type }} `json:"predict"`
	PredictProba {{ '[][]float64' if is_multi_output else '[]float64' }} `json:"predict_proba"`
}

{% endif %}
type {{ class_name }} struct {
	Trees []{{ class_name }}Tree
}

type {{ class_name }}Tree struct {
	Lefts []int `json:"lefts"`
	Rights []int `json:"rights"`
	Thresholds []float64 `json:"thresholds"`
	Indices []int `json:"indices"`
	MissingGoToLeft []int `json:"missing_go_to_left"`
	Classes []float64 `json:"classes"`
}
{% if has_infinite_thresholds %}

// UnmarshalJSON parses the infinite thresholds `1e999` and `-1e999`, which
// encoding/json rejects:
func (tree *{{ class_name }}Tree) UnmarshalJSON(data []byte) error {
	type plain {{ class_name }}Tree
	var aux struct {
		*plain
		Thresholds []json.Number `json:"thresholds"`
	}
	aux.plain = (*plain)(tree)
	if err := json.Unmarshal(data, &aux); err != nil {
		return err
	}
	tree.Thresholds = make([]float64, len(aux.Thresholds))
	for i, threshold := range aux.Thresholds {
		// ParseFloat returns ±Inf (and a range error) for these values:
		tree.Thresholds[i], _ = strconv.ParseFloat(string(threshold), 64)
	}
	return nil
}
{% endif %}

{% if is_multi_output %}
// The classes of all outputs are concatenated, these are their numbers:
var outputClasses = []int{ {{ output_classes | join(', ') }} }

// Find the class with the maximum probability of each output:
func (forest {{ class_name }}) FindMax(probas [][]float64) []int {
	result := make([]int, len(probas))
	for j, nums := range probas {
		for i := 1; i < len(nums); i++ {
			if nums[i] > nums[result[j]] {
				result[j] = i
			}
		}
	}
	return result
}

// Split the concatenated values into the values of each output:
func splitOutputs(nums []float64) [][]float64 {
	result := make([][]float64, len(outputClasses))
	offset := 0
	for j, n := range outputClasses {
		result[j] = nums[offset : offset+n]
		offset += n
	}
	return result
}
{% else %}
func (forest {{ class_name }}) FindMax(nums []float64) int {
	var idx = 0
	for i := 0; i < len(nums); i++ {
		if nums[i] > nums[idx] {
			idx = i
		}
	}
	return idx
}
{% endif %}

// Add the class fractions of the leaf to the probabilities:
func (tree {{ class_name }}Tree) AddProbas(features []float64, probas []float64) {
	node := 0
	for node >= 0 {
		if features[tree.Indices[node]] <= tree.Thresholds[node] || (tree.MissingGoToLeft[node] == 1 && math.IsNaN(features[tree.Indices[node]])) {
			node = tree.Lefts[node]
		} else {
			node = tree.Rights[node]
		}
	}
	start := (-node - 1) * {{ n_classes }}
	for i := 0; i < {{ n_classes }}; i++ {
		probas[i] += tree.Classes[start+i]
	}
}

func (forest {{ class_name }}) PredictIndex(features []float64) {{ '[]int' if is_multi_output else 'int' }} {
	return forest.FindMax(forest.PredictProba(features))
}

{% if is_multi_output %}
// Predict the label of each output:
func (forest {{ class_name }}) Predict(features []float64) []{{ label_type }} {
	result := make([]{{ label_type }}, len(outputClasses))
	offset := 0
	for j, idx := range forest.PredictIndex(features) {
		result[j] = labels[offset+idx]
		offset += outputClasses[j]
	}
	return result
}
{% else %}
func (forest {{ class_name }}) Predict(features []float64) {{ label_type }} {
	return labels[forest.PredictIndex(features)]
}
{% endif %}

{% if is_multi_output %}
func (forest {{ class_name }}) PredictProba(features []float64) [][]float64 {
	var nClasses = {{ n_classes }}
	var nTrees = len(forest.Trees)
	var classProbas = make([]float64, nClasses)
	for _, tree := range forest.Trees {
		tree.AddProbas(features, classProbas)
	}
	for i := 0; i < nClasses; i++ {
		classProbas[i] /= float64(nTrees)
	}
	return splitOutputs(classProbas)
}
{% else %}
func (forest {{ class_name }}) PredictProba(features []float64) []float64 {
	var nClasses = {{ n_classes }}
	var nTrees = len(forest.Trees)
	var classProbas = make([]float64, nClasses)
	for _, tree := range forest.Trees {
		tree.AddProbas(features, classProbas)
	}
	for i := 0; i < nClasses; i++ {
		classProbas[i] /= float64(nTrees)
	}
	return classProbas
}
{% endif %}

{% include 'samples' %}

{% if pipeline_classes %}
{{ pipeline_classes }}

{% endif %}
func main() {
	if len(os.Args) < 2 {
		fmt.Fprintln(os.Stderr, "You have to pass the path to the model data.")
		os.Exit(1)
	}

	{% if pipeline_create %}
	{{ pipeline_create | indent('\t') }}

	{% endif %}
	// Model data:
	jsonFile, err := os.Open(os.Args[1])
	if err != nil {
		fmt.Println(err)
	}
	defer jsonFile.Close()
	byteValue, _ := ioutil.ReadAll(jsonFile)

	// Estimator:
	var trees []{{ class_name }}Tree
{% if pipeline %}
	var pipelineModel struct {
		Estimators json.RawMessage `json:"estimators"`
	}
	json.Unmarshal(byteValue, &pipelineModel)
	byteValue = pipelineModel.Estimators
{% endif %}
	json.Unmarshal(byteValue, &trees)
	var clf {{ class_name }}
	clf.Trees = trees

	// Features of one sample (arguments) or several samples (standard input):
	readSamples(os.Args[2:], func(features []float64) {
		{% if pipeline_transform %}
		{{ pipeline_transform | indent('\t\t') }}
		{% endif %}
		{% if is_test or to_json %}
		// Get JSON:
		prediction := clf.Predict(features)
		probabilities := clf.PredictProba(features)
		res, _ := json.Marshal(&Response{Predict: prediction, PredictProba: probabilities})
		fmt.Println(string(res))
		{% else %}
		// Get class prediction:
		prediction := clf.Predict(features)
		fmt.Printf("{{ 'Predicted classes: ' if is_multi_output else 'Predicted class: ' }}%v\n", prediction)
		probabilities := clf.PredictProba(features)
		for i, probability := range probabilities {
			fmt.Printf("{{ 'Probabilities of output #' if is_multi_output else 'Probability of class #' }}%d : %f\n", i, probability)
		}
		{% endif %}
	})

}
{% endblock %}
