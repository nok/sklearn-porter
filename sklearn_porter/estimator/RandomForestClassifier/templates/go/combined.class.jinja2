{% extends 'base.combined.class' %}

{% block content %}
package main

import (
	{% if is_test or to_json %}
	"encoding/json"
	{% endif %}
	"fmt"
	{% if has_missing_go_to_left or has_infinite_thresholds %}
	"math"
	{% endif %}
	"os"
	"strconv"
)

{% include 'labels' %}

{% if is_test or to_json %}
type Response struct {
	Predict {{ '[]' if is_multi_output }}{{ label_type }} `json:"predict"`
	PredictProba {{ '[][]float64' if is_multi_output else '[]float64' }} `json:"predict_proba"`
}

{% endif %}
{% if is_multi_output %}
// The classes of all outputs are concatenated, these are their numbers:
var outputClasses = []int{ {{ output_classes | join(', ') }} }

// Find the class with the maximum probability of each output:
func findMax(probas [][]float64) []int {
	result := make([]int, len(probas))
	for j, nums := range probas {
		for i := 1; i < len(nums); i++ {
			if nums[i] > nums[result[j]] {
				result[j] = i
			}
		}
	}
	return result
}

// Split the concatenated values into the values of each output:
func splitOutputs(nums []float64) [][]float64 {
	result := make([][]float64, len(outputClasses))
	offset := 0
	for j, n := range outputClasses {
		result[j] = nums[offset : offset+n]
		offset += n
	}
	return result
}
{% else %}
func findMax(nums []float64) int {
	var idx = 0
	for i := 0; i < len(nums); i++ {
		if nums[i] > nums[idx] {
			idx = i
		}
	}
	return idx
}
{% endif %}

{% if is_multi_output %}
// Normalize the values of each output:
func normVals(nums []float64) []float64 {
	result := make([]float64, len(nums))
	offset := 0
	for _, n := range outputClasses {
		sum := 0.0
		for i := offset; i < offset+n; i++ {
			sum += nums[i]
		}
		for i := offset; i < offset+n; i++ {
			if sum == 0 {
				result[i] = 1.0 / float64(n)
			} else {
				result[i] = nums[i] / sum
			}
		}
		offset += n
	}
	return result
}
{% else %}
func normVals(nums []float64) []float64 {
	var nNums = len(nums)
	var result = make([]float64, nNums)
	var sum float64
	for i := 0; i < nNums; i++ {
		sum += nums[i]
	}
	if sum == 0 {
		for i := 0; i < nNums; i++ {
			result[i] = 1.0 / float64(nNums)
		}
	} else {
		for i := 0; i < nNums; i++ {
			result[i] = nums[i] / sum
		}
	}
	return result
}
{% endif %}

{{ method }}

func main() {

	if len(os.Args) != {{ n_features + 1 }} {
		fmt.Fprintln(os.Stderr, "You have to pass {{ n_features }} features.")
		os.Exit(1)
	}

	// Features:
	var features []float64
	for _, arg := range os.Args[1:] {
		if n, err := strconv.ParseFloat(arg, 64); err == nil {
			features = append(features, n)
		}
	}

	{% if is_test or to_json %}
	// Get JSON:
	prediction := Predict(features)
	probabilities := PredictProba(features)
	res, _ := json.Marshal(&Response{Predict: prediction, PredictProba: probabilities})
	fmt.Println(string(res))
	{% else %}
	// Get class prediction:
	prediction := Predict(features)
	fmt.Printf("{{ 'Predicted classes: ' if is_multi_output else 'Predicted class: ' }}%v\n", prediction)

	// Get class probabilities:
	probabilities := PredictProba(features)
	for i, probability := range probabilities {
		fmt.Printf("{{ 'Probabilities of output #' if is_multi_output else 'Probability of class #' }}%d : %f\n", i, probability)
	}
	{% endif %}

}
{% endblock %}
