{% extends 'base.attached.class' %}

{% block content %}
require 'json'


class {{ class_name }}

	class Tree

		def initialize(lefts, rights, thresholds, indices, missing_go_to_left, classes)
			@lefts = lefts
			@rights = rights
			@thresholds = thresholds
			@indices = indices
			@missing_go_to_left = missing_go_to_left
			@classes = classes
		end

{% if is_multi_output %}
		# Normalize the values of each output:
		def _norm_vals(nums)
			result = []
			offset = 0
			OUTPUT_CLASSES.each do |n|
				sum = nums[offset, n].sum.to_f
				for i in offset ... offset + n
					result[i] = sum == 0 ? 1.0 / n : nums[i] / sum
				end
				offset += n
			end
			result
		end
{% else %}
		def _norm_vals(nums)
			sum = nums.sum.to_f
			if sum == 0
				return Array.new(nums.length, 1.0 / nums.length)
			end
			nums.map { |num| num / sum }
		end
{% endif %}

		def compute(features)
			node = 0
			while @thresholds[node] != -2
				if features[@indices[node]] <= @thresholds[node] || (@missing_go_to_left[node] == 1 && features[@indices[node]].nan?)
					node = @lefts[node]
				else
					node = @rights[node]
				end
			end
			_norm_vals(@classes[node])
		end

	end

	def initialize(model)
		@forest = model.map do |tree|
			Tree.new(tree['lefts'], tree['rights'], tree['thresholds'], tree['indices'], tree['missing_go_to_left'], tree['classes'])
		end
	end

{% if is_multi_output %}
	# The classes of all outputs are concatenated, these are their numbers:
	OUTPUT_CLASSES = [{{ output_classes | join(', ') }}]

	# Find the class with the maximum probability of each output:
	def _find_max(nums)
		nums.map { |probas| probas.index(probas.max) }
	end

	# Split the concatenated values into the values of each output:
	def _split_outputs(nums)
		offset = 0
		OUTPUT_CLASSES.map do |n|
			probas = nums[offset, n]
			offset += n
			probas
		end
	end
{% else %}
	def _find_max(nums)
		idx = 0
		for i in 0 ... nums.length
			idx = nums[i] > nums[idx] ? i : idx
		end
		idx
	end
{% endif %}

{% if is_multi_output %}
	def predict_proba(features)
		probas = nil
		@forest.each do |tree|
			temp = tree.compute(features)
			probas = probas.nil? ? temp : probas.zip(temp).map { |a, b| a + b }
		end
		_split_outputs(probas.map { |proba| proba / @forest.length })
	end
{% else %}
	def predict_proba(features)
		probas = nil
		@forest.each do |tree|
			temp = tree.compute(features)
			probas = probas.nil? ? temp : probas.zip(temp).map { |a, b| a + b }
		end
		probas.map { |proba| proba / @forest.length }
	end
{% endif %}

	def predict(features)
		_find_max(predict_proba(features))
	end

end

if __FILE__ == $0
	if ARGV.length != {{ n_features }}
		raise "You have to pass {{ n_features }} features."
	end

	# Features:
	features = ARGV.collect { |value| value.downcase == 'nan' ? Float::NAN : value.to_f }

	# Model data:
	{{ model }}

	# Estimator:
	clf = {{ class_name }}.new model

	{% if is_test or to_json %}
	# Get JSON:
	prediction = clf.predict features
	probabilities = clf.predict_proba features
	puts JSON.generate({:predict => prediction, :predict_proba => probabilities})
	{% else %}
	# Get class prediction:
	prediction = clf.predict features
	puts "{{ 'Predicted classes: ' if is_multi_output else 'Predicted class: #' }}#{prediction}"

	# Get class probabilities:
	probabilities = clf.predict_proba features
	for i in 0 ... probabilities.length
		puts "{{ 'Probabilities of output #' if is_multi_output else 'Probability of class #' }}#{i} : #{probabilities[i]}"
	end
	{% endif %}
end
{% endblock %}
