{% extends 'base.exported.class' %}

{% block content %}
#include <math.h>

#define N_FEATURES {{ n_features }}
#define N_CLASSES {{ n_classes }}

typedef struct {
    int *lefts;
    int *rights;
    double *thresholds;
    int *indices;
    int *classes; /* shape: (n_nodes * N_CLASSES) */
} Tree;


int n_estimators;
Tree *trees;

/* Copy the class counts of all nodes to a flat array: */
int *flatten(JsonValue *classes) {
    int i, j;
    int *result = malloc(classes->length * N_CLASSES * sizeof(int));
    for (i = 0; i < classes->length; i++) {
        for (j = 0; j < N_CLASSES; j++) {
            result[i * N_CLASSES + j] = (int) classes->items[i]->items[j]->number;
        }
    }
    return result;
}

void load(const char *path) {
    JsonValue *data = json_read(path);
    n_estimators = data->length;
    trees = malloc(n_estimators * sizeof(Tree));
    for (int i = 0; i < n_estimators; i++) {
        JsonValue *tree = data->items[i];
        trees[i].lefts = json_ints(json_get(tree, "lefts"));
        trees[i].rights = json_ints(json_get(tree, "rights"));
        trees[i].thresholds = json_doubles(json_get(tree, "thresholds"));
        trees[i].indices = json_ints(json_get(tree, "indices"));
        trees[i].classes = flatten(json_get(tree, "classes"));
    }
    json_free(data);
}

int find_max(double nums[N_CLASSES]) {
    int i;
    int idx = 0;
    for (i = 0; i < N_CLASSES; i++) {
        idx = nums[i] > nums[idx] ? i : idx;
    }
    return idx;
}

void norm_vals(double *result, const int *nums) {
    int i;
    double sum = 0.;
    for (i = 0; i < N_CLASSES; i++) {
        sum += nums[i];
    }
    if (sum == 0) {
        for (i = 0; i < N_CLASSES; i++) {
            result[i] = 1. / N_CLASSES;
        }
    } else {
        for (i = 0; i < N_CLASSES; i++) {
            result[i] = nums[i] / sum;
        }
    }
}

void compute(double *result, const Tree *tree, double features[N_FEATURES]) {
    int node = 0;
    while (tree->thresholds[node] != -2) {
        if (features[tree->indices[node]] <= tree->thresholds[node]) {
            node = tree->lefts[node];
        } else {
            node = tree->rights[node];
        }
    }
    norm_vals(result, tree->classes + node * N_CLASSES);
}

void predict_proba(double *probas, double features[N_FEATURES]) {
    int i, j;
    double temp[N_CLASSES];
    for (j = 0; j < N_CLASSES; j++) {
        probas[j] = 0.;
    }
    for (i = 0; i < n_estimators; i++) {
        compute(temp, &trees[i], features);
        for (j = 0; j < N_CLASSES; j++) {
            probas[j] += temp[j];
        }
    }
    for (j = 0; j < N_CLASSES; j++) {
        probas[j] /= n_estimators;
    }
}

int predict(double features[N_FEATURES]) {
    double probas[N_CLASSES];
    predict_proba(probas, features);
    return find_max(probas);
}

int main(int argc, const char *argv[]) {

    if (argc != N_FEATURES + 2) {
        fprintf(stderr, "You have to pass the path to the model data and %d features.\n", N_FEATURES);
        return 1;
    }

    /* Model data: */
    load(argv[1]);

    /* Features: */
    double features[N_FEATURES];
    for (int i = 2; i < argc; i++) {
        features[i-2] = atof(argv[i]);
    }

    {% if is_test or to_json %}
    /* Get JSON: */
    double probabilities[N_CLASSES];
    predict_proba(probabilities, features);
    printf("{\"predict\": %d, \"predict_proba\": [", predict(features));
    for (int i = 0; i < N_CLASSES; i++) {
        printf("%.17g", probabilities[i]);
        if (i < (N_CLASSES - 1)) {
            printf(",");
        }
    }
    printf("]}");
    {% else %}
    /* Get class prediction: */
    printf("Predicted class: #%d\n", predict(features));

    /* Get class probabilities: */
    double probabilities[N_CLASSES];
    predict_proba(probabilities, features);
    for (int i = 0; i < N_CLASSES; i++) {
        printf("Probability of class #%d: %.6f\n", i, probabilities[i]);
    }
    {% endif %}

    return 0;
}
{% endblock %}
