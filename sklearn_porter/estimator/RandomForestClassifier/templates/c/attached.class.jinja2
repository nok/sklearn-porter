{% extends 'base.attached.class' %}

{% block content %}
#include <stdlib.h>
#include <stdio.h>
#include <math.h>

#define N_FEATURES {{ n_features }}
#define N_CLASSES {{ n_classes }}
{% if is_multi_output %}
#define N_OUTPUTS {{ n_outputs }}

/* The classes of all outputs are concatenated, these are their numbers: */
const int output_classes[N_OUTPUTS] = { {{ output_classes | join(', ') }} };
{% endif %}
#define N_ESTIMATORS {{ n_estimators }}

typedef struct {
    const int *lefts;
    const int *rights;
    const double *thresholds;
    const int *indices;
    const int *missing_go_to_left;
    const double *classes; /* shape: (n_leaves * N_CLASSES) */
} Tree;


{{ model }}

const Tree trees[N_ESTIMATORS] = {
{% for i in range(n_estimators) %}
    {lefts_{{ i }}, rights_{{ i }}, thresholds_{{ i }}, indices_{{ i }}, missing_go_to_left_{{ i }}, classes_{{ i }}}{% if not loop.last %},{% endif %}

{% endfor %}
};

{% if is_multi_output %}
/* Find the class with the maximum value of each output: */
void find_max(int *result, double nums[N_CLASSES]) {
    int i, j, offset = 0;
    for (j = 0; j < N_OUTPUTS; j++) {
        result[j] = 0;
        for (i = 1; i < output_classes[j]; i++) {
            if (nums[offset + i] > nums[offset + result[j]]) {
                result[j] = i;
            }
        }
        offset += output_classes[j];
    }
}
{% else %}
int find_max(double nums[N_CLASSES]) {
    int i;
    int idx = 0;
    for (i = 0; i < N_CLASSES; i++) {
        idx = nums[i] > nums[idx] ? i : idx;
    }
    return idx;
}
{% endif %}

{% if is_multi_output %}
/* Normalize the values of each output: */
void norm_vals(double *result, const double *nums) {
    int i, j, offset = 0;
    double sum;
    for (j = 0; j < N_OUTPUTS; j++) {
        sum = 0.;
        for (i = offset; i < offset + output_classes[j]; i++) {
            sum += nums[i];
        }
        for (i = offset; i < offset + output_classes[j]; i++) {
            result[i] = sum == 0 ? 1. / output_classes[j] : nums[i] / sum;
        }
        offset += output_classes[j];
    }
}
{% else %}
void norm_vals(double *result, const double *nums) {
    int i;
    double sum = 0.;
    for (i = 0; i < N_CLASSES; i++) {
        sum += nums[i];
    }
    if (sum == 0) {
        for (i = 0; i < N_CLASSES; i++) {
            result[i] = 1. / N_CLASSES;
        }
    } else {
        for (i = 0; i < N_CLASSES; i++) {
            result[i] = nums[i] / sum;
        }
    }
}
{% endif %}

void compute(double *result, const Tree *tree, double features[N_FEATURES]) {
    int node = 0;
    while (node >= 0) {
        if (features[tree->indices[node]] <= tree->thresholds[node] || (tree->missing_go_to_left[node] && isnan(features[tree->indices[node]]))) {
            node = tree->lefts[node];
        } else {
            node = tree->rights[node];
        }
    }
    norm_vals(result, tree->classes + (-node - 1) * N_CLASSES);
}

{% if is_multi_output %}
/* Predict the concatenated class probabilities of all outputs: */
void predict_proba_concatenated(double *probas, double features[N_FEATURES]) {
    int i, j;
    double temp[N_CLASSES];
    for (j = 0; j < N_CLASSES; j++) {
        probas[j] = 0.;
    }
    for (i = 0; i < N_ESTIMATORS; i++) {
        compute(temp, &trees[i], features);
        for (j = 0; j < N_CLASSES; j++) {
            probas[j] += temp[j];
        }
    }
    for (j = 0; j < N_CLASSES; j++) {
        probas[j] /= N_ESTIMATORS;
    }
}

/* Predict the class probabilities of each output: */
void predict_proba(double *result[N_OUTPUTS], double features[N_FEATURES]) {
    int i, j, offset = 0;
    double probabilities[N_CLASSES];
    predict_proba_concatenated(probabilities, features);
    for (j = 0; j < N_OUTPUTS; j++) {
        for (i = 0; i < output_classes[j]; i++) {
            result[j][i] = probabilities[offset + i];
        }
        offset += output_classes[j];
    }
}
{% else %}
void predict_proba(double *probas, double features[N_FEATURES]) {
    int i, j;
    double temp[N_CLASSES];
    for (j = 0; j < N_CLASSES; j++) {
        probas[j] = 0.;
    }
    for (i = 0; i < N_ESTIMATORS; i++) {
        compute(temp, &trees[i], features);
        for (j = 0; j < N_CLASSES; j++) {
            probas[j] += temp[j];
        }
    }
    for (j = 0; j < N_CLASSES; j++) {
        probas[j] /= N_ESTIMATORS;
    }
}
{% endif %}

{% include 'labels' %}

{% if is_multi_output %}
void predict_index(int *result, double features[N_FEATURES]) {
    double probas[N_CLASSES];
    predict_proba_concatenated(probas, features);
    find_max(result, probas);
}

/* Predict the label of each output: */
void predict(Label *result, double features[N_FEATURES]) {
    int j, offset = 0;
    int idx[N_OUTPUTS];
    predict_index(idx, features);
    for (j = 0; j < N_OUTPUTS; j++) {
        result[j] = labels[offset + idx[j]];
        offset += output_classes[j];
    }
}
{% else %}
int predict_index(double features[N_FEATURES]) {
    double probas[N_CLASSES];
    predict_proba(probas, features);
    return find_max(probas);
}

Label predict(double features[N_FEATURES]) {
    return labels[predict_index(features)];
}
{% endif %}

{% include 'samples' %}

int main(int argc, const char *argv[]) {
    /* Features of one sample (arguments) or several samples (standard input): */
    double features[N_FEATURES];
    while (read_features(features, argc, argv, 1)) {
        {% if is_multi_output %}
        Label prediction[N_OUTPUTS];
        predict(prediction, features);
        double *probabilities[N_OUTPUTS];
        for (int j = 0; j < N_OUTPUTS; j++) {
            probabilities[j] = malloc(output_classes[j] * sizeof(double));
        }
        predict_proba(probabilities, features);

        {% if is_test or to_json %}
        /* Get JSON: */
        printf("{\"predict\": [");
        for (int j = 0; j < N_OUTPUTS; j++) {
            print_label(prediction[j]);
            if (j < (N_OUTPUTS - 1)) {
                printf(",");
            }
        }
        printf("], \"predict_proba\": [");
        for (int j = 0; j < N_OUTPUTS; j++) {
            printf("[");
            for (int i = 0; i < output_classes[j]; i++) {
                printf("%.17g", probabilities[j][i]);
                if (i < (output_classes[j] - 1)) {
                    printf(",");
                }
            }
            printf(j < (N_OUTPUTS - 1) ? "]," : "]");
        }
        printf("]}\n");
        {% else %}
        /* Get the class prediction and the class probabilities of each output: */
        for (int j = 0; j < N_OUTPUTS; j++) {
            printf("Predicted class of output #%d: ", j);
            print_label(prediction[j]);
            printf("\n");
            for (int i = 0; i < output_classes[j]; i++) {
                printf("Probability of class #%d of output #%d: %.6f\n", i, j, probabilities[j][i]);
            }
        }
        {% endif %}

        for (int j = 0; j < N_OUTPUTS; j++) {
            free(probabilities[j]);
        }
        {% else %}
        {% if is_test or to_json %}
        /* Get JSON: */
        double probabilities[N_CLASSES];
        predict_proba(probabilities, features);
        printf("{\"predict\": ");
        print_label(predict(features));
        printf(", \"predict_proba\": [");
        for (int i = 0; i < N_CLASSES; i++) {
            printf("%.17g", probabilities[i]);
            if (i < (N_CLASSES - 1)) {
                printf(",");
            }
        }
        printf("]}\n");
        {% else %}
        /* Get class prediction: */
        printf("Predicted class: ");
        print_label(predict(features));
        printf("\n");

        /* Get class probabilities: */
        double probabilities[N_CLASSES];
        predict_proba(probabilities, features);
        for (int i = 0; i < N_CLASSES; i++) {
            printf("Probability of class #%d: %.6f\n", i, probabilities[i]);
        }
        {% endif %}
        {% endif %}
    }

    return 0;
}
{% endblock %}
