{% extends 'base.attached.class' %}

{% block content %}
#include <stdlib.h>
#include <stdio.h>
#include <math.h>

#define N_FEATURES {{ n_features }}
#define N_CLASSES {{ n_classes }}
#define N_ESTIMATORS {{ n_estimators }}

typedef struct {
    int *lefts;
    int *rights;
    double *thresholds;
    int *indices;
    int *classes; /* shape: (n_nodes * N_CLASSES) */
} Tree;


{{ model }}

Tree trees[N_ESTIMATORS] = {
{% for i in range(n_estimators) %}
    {lefts_{{ i }}, rights_{{ i }}, thresholds_{{ i }}, indices_{{ i }}, classes_{{ i }}}{% if not loop.last %},{% endif %}

{% endfor %}
};

int find_max(double nums[N_CLASSES]) {
    int i;
    int idx = 0;
    for (i = 0; i < N_CLASSES; i++) {
        idx = nums[i] > nums[idx] ? i : idx;
    }
    return idx;
}

void norm_vals(double *result, const int *nums) {
    int i;
    double sum = 0.;
    for (i = 0; i < N_CLASSES; i++) {
        sum += nums[i];
    }
    if (sum == 0) {
        for (i = 0; i < N_CLASSES; i++) {
            result[i] = 1. / N_CLASSES;
        }
    } else {
        for (i = 0; i < N_CLASSES; i++) {
            result[i] = nums[i] / sum;
        }
    }
}

void compute(double *result, const Tree *tree, double features[N_FEATURES]) {
    int node = 0;
    while (tree->thresholds[node] != -2) {
        if (features[tree->indices[node]] <= tree->thresholds[node]) {
            node = tree->lefts[node];
        } else {
            node = tree->rights[node];
        }
    }
    norm_vals(result, tree->classes + node * N_CLASSES);
}

void predict_proba(double *probas, double features[N_FEATURES]) {
    int i, j;
    double temp[N_CLASSES];
    for (j = 0; j < N_CLASSES; j++) {
        probas[j] = 0.;
    }
    for (i = 0; i < N_ESTIMATORS; i++) {
        compute(temp, &trees[i], features);
        for (j = 0; j < N_CLASSES; j++) {
            probas[j] += temp[j];
        }
    }
    for (j = 0; j < N_CLASSES; j++) {
        probas[j] /= N_ESTIMATORS;
    }
}

int predict(double features[N_FEATURES]) {
    double probas[N_CLASSES];
    predict_proba(probas, features);
    return find_max(probas);
}

int main(int argc, const char *argv[]) {

    if (argc != N_FEATURES + 1) {
        fprintf(stderr, "You have to pass %d features.\n", N_FEATURES);
        return 1;
    }

    /* Features: */
    double features[N_FEATURES];
    for (int i = 1; i < argc; i++) {
        features[i-1] = atof(argv[i]);
    }

    {% if is_test or to_json %}
    /* Get JSON: */
    double probabilities[N_CLASSES];
    predict_proba(probabilities, features);
    printf("{\"predict\": %d, \"predict_proba\": [", predict(features));
    for (int i = 0; i < N_CLASSES; i++) {
        printf("%.17g", probabilities[i]);
        if (i < (N_CLASSES - 1)) {
            printf(",");
        }
    }
    printf("]}");
    {% else %}
    /* Get class prediction: */
    printf("Predicted class: #%d\n", predict(features));

    /* Get class probabilities: */
    double probabilities[N_CLASSES];
    predict_proba(probabilities, features);
    for (int i = 0; i < N_CLASSES; i++) {
        printf("Probability of class #%d: %.6f\n", i, probabilities[i]);
    }
    {% endif %}

    return 0;
}
{% endblock %}
