{{ methods }}

{% if is_multi_output %}
/* Predict the concatenated class probabilities of all outputs: */
void predict_proba_concatenated(double *probas, double features[N_FEATURES]) {
    int j;
    double temp[N_CLASSES];
    for (j = 0; j < N_CLASSES; j++) {
        probas[j] = 0.;
    }
    {{ method_calls }}
    for (j = 0; j < N_CLASSES; j++) {
        probas[j] /= N_ESTIMATORS;
    }
}

/* Predict the class probabilities of each output: */
void predict_proba(double *result[N_OUTPUTS], double features[N_FEATURES]) {
    int i, j, offset = 0;
    double probabilities[N_CLASSES];
    predict_proba_concatenated(probabilities, features);
    for (j = 0; j < N_OUTPUTS; j++) {
        for (i = 0; i < output_classes[j]; i++) {
            result[j][i] = probabilities[offset + i];
        }
        offset += output_classes[j];
    }
}
{% else %}
void predict_proba(double *probas, double features[N_FEATURES]) {
    int j;
    double temp[N_CLASSES];
    for (j = 0; j < N_CLASSES; j++) {
        probas[j] = 0.;
    }
    {{ method_calls }}
    for (j = 0; j < N_CLASSES; j++) {
        probas[j] /= N_ESTIMATORS;
    }
}
{% endif %}

{% if is_multi_output %}
void predict_index(int *result, double features[N_FEATURES]) {
    double probas[N_CLASSES];
    predict_proba_concatenated(probas, features);
    find_max(result, probas);
}

/* Predict the label of each output: */
void predict(Label *result, double features[N_FEATURES]) {
    int j, offset = 0;
    int idx[N_OUTPUTS];
    predict_index(idx, features);
    for (j = 0; j < N_OUTPUTS; j++) {
        result[j] = labels[offset + idx[j]];
        offset += output_classes[j];
    }
}
{% else %}
int predict_index(double features[N_FEATURES]) {
    double probas[N_CLASSES];
    predict_proba(probas, features);
    return find_max(probas);
}

Label predict(double features[N_FEATURES]) {
    return labels[predict_index(features)];
}
{% endif %}
