private static Tree tree{{ index }}() {
    return new Tree(
        new int[] {{ '{' }}{{ lefts }}{{ '}' }},
        new int[] {{ '{' }}{{ rights }}{{ '}' }},
        new double[] {{ '{' }}{{ thresholds }}{{ '}' }},
        new int[] {{ '{' }}{{ indices }}{{ '}' }},
        new double[][] {{ '{' }}{% for c in classes %}{{ '{' }}{{ c }}{{ '}' }}{% if not loop.last %}, {% endif %}{% endfor %}{{ '}' }}
    );
}
