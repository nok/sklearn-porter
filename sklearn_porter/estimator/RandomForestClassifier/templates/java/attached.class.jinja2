{% extends 'base.attached.class' %}

{% block content %}
{% if is_test or to_json or is_multi_output %}
import java.util.Arrays;

{% endif %}
class {{ class_name }} {

    private static class Tree {
        private int[] lefts;
        private int[] rights;
        private double[] thresholds;
        private int[] indices;
        private int[] missingGoToLeft;
        private double[][] classes;

        private Tree(int[] lefts, int[] rights, double[] thresholds, int[] indices, int[] missingGoToLeft, double[][] classes) {
            this.lefts = lefts;
            this.rights = rights;
            this.thresholds = thresholds;
            this.indices = indices;
            this.missingGoToLeft = missingGoToLeft;
            this.classes = classes;
        }

        // Add the normalized values of the leaf to the probabilities:
        private void addProbas(double[] features, double[] probas) {
            int node = 0;
            while (this.thresholds[node] != -2) {
                if (features[this.indices[node]] <= this.thresholds[node] || (this.missingGoToLeft[node] == 1 && Double.isNaN(features[this.indices[node]]))) {
                    node = this.lefts[node];
                } else {
                    node = this.rights[node];
                }
            }
            addNormVals(this.classes[node], probas);
        }
    }

    private Tree[] forest;

    public {{ class_name }}(Tree[] forest) {
        this.forest = forest;
    }

{% if is_multi_output %}
    // The classes of all outputs are concatenated, these are their numbers:
    private static final int[] OUTPUT_CLASSES = { {{ output_classes | join(', ') }} };

    // Find the class with the maximum probability of each output:
    private static int[] findMax(double[][] probas) {
        int[] result = new int[probas.length];
        for (int j = 0; j < probas.length; j++) {
            for (int i = 1; i < probas[j].length; i++) {
                if (probas[j][i] > probas[j][result[j]]) {
                    result[j] = i;
                }
            }
        }
        return result;
    }
    // Split the concatenated values into the values of each output:
    private static double[][] splitOutputs(double[] nums) {
        double[][] result = new double[OUTPUT_CLASSES.length][];
        int offset = 0;
        for (int j = 0; j < OUTPUT_CLASSES.length; j++) {
            result[j] = Arrays.copyOfRange(nums, offset, offset + OUTPUT_CLASSES[j]);
            offset += OUTPUT_CLASSES[j];
        }
        return result;
    }
{% else %}
    private static int findMax(double[] nums) {
        int idx = 0;
        for (int i = 1; i < nums.length; i++) {
            idx = nums[i] > nums[idx] ? i : idx;
        }
        return idx;
    }
{% endif %}

{% if is_multi_output %}
    // Add the normalized values of each output to the probabilities:
    private static void addNormVals(double[] nums, double[] probas) {
        int offset = 0;
        for (int j = 0; j < OUTPUT_CLASSES.length; j++) {
            double sum = 0.;
            for (int i = offset; i < offset + OUTPUT_CLASSES[j]; i++) {
                sum += nums[i];
            }
            for (int i = offset; i < offset + OUTPUT_CLASSES[j]; i++) {
                probas[i] += sum == 0 ? 1. / OUTPUT_CLASSES[j] : nums[i] / sum;
            }
            offset += OUTPUT_CLASSES[j];
        }
    }
{% else %}
    // Add the normalized values to the probabilities:
    private static void addNormVals(double[] nums, double[] probas) {
        double sum = 0.;
        for (int i = 0; i < nums.length; i++) {
            sum += nums[i];
        }
        for (int i = 0; i < nums.length; i++) {
            probas[i] += sum == 0 ? 1.0 / nums.length : nums[i] / sum;
        }
    }
{% endif %}

{% if is_multi_output %}
    public double[][] predictProba(double[] features) {
        double[] probas = new double[{{ n_classes }}];
        for (Tree tree : this.forest) {
            tree.addProbas(features, probas);
        }
        for (int i = 0; i < probas.length; i++) {
            probas[i] /= this.forest.length;
        }
        return splitOutputs(probas);
    }
{% else %}
    public double[] predictProba(double[] features) {
        double[] probas = new double[{{ n_classes }}];
        for (Tree tree : this.forest) {
            tree.addProbas(features, probas);
        }
        for (int i = 0; i < probas.length; i++) {
            probas[i] /= this.forest.length;
        }
        return probas;
    }
{% endif %}

    public {{ 'int[]' if is_multi_output else 'int' }} predict(double[] features) {
        return findMax(this.predictProba(features));
    }

    // Model data:
    {{ model | indent(4) }}

    public static void main(String[] args) {
        int nFeatures = {{ n_features }};
        if (args.length != nFeatures) {
            throw new IllegalArgumentException("You have to pass " +  String.valueOf(nFeatures) + " features.");
        }

        // Features:
        double[] features = new double[args.length];
        for (int i = 0, l = args.length; i < l; i++) {
            features[i] = args[i].equalsIgnoreCase("nan") ? Double.NaN : Double.parseDouble(args[i]);
        }

        // Estimator:
        Tree[] forest = {
            {% for i in range(n_estimators) %}
            tree{{ i }}(){% if not loop.last %},{% endif %}

            {% endfor %}
        };
        {{ class_name }} clf = new {{ class_name }}(forest);

        {% if is_test or to_json %}
        // Get JSON:
        {{ 'int[]' if is_multi_output else 'int' }} prediction = clf.predict(features);
        {{ 'double[][]' if is_multi_output else 'double[]' }} probabilities = clf.predictProba(features);
        System.out.println("{\"predict\": " + {{ 'Arrays.toString(prediction)' if is_multi_output else 'String.valueOf(prediction)' }} + ", \"predict_proba\": " + String.join(",", {{ 'Arrays.deepToString(probabilities)' if is_multi_output else 'Arrays.toString(probabilities)' }}) + "}");
        {% else %}
        // Get class prediction:
        {{ 'int[]' if is_multi_output else 'int' }} prediction = clf.predict(features);
        System.out.println("{{ 'Predicted classes: ' if is_multi_output else 'Predicted class: #' }}" + {{ 'Arrays.toString(prediction)' if is_multi_output else 'String.valueOf(prediction)' }});

        // Get class probabilities:
        {{ 'double[][]' if is_multi_output else 'double[]' }} probabilities = clf.predictProba(features);
        for (int i = 0; i < probabilities.length; i++) {
            System.out.println("{{ 'Probabilities of output #' if is_multi_output else 'Probability of class #' }}" + i + " : " + {{ 'Arrays.toString(probabilities[i])' if is_multi_output else 'String.valueOf(probabilities[i])' }});
        }
        {% endif %}

    }
}
{% endblock %}
