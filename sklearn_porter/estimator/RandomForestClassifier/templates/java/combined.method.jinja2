private static double[] compute(double[] features) {
    int nClasses = {{ n_classes }};
    int nTrees = {{ n_estimators }};
    double[] probas = new double[nClasses];
    double[] temp;
    {{ method_calls }}
    for (int i = 0; i < nClasses; i++) {
        probas[i] /= nTrees;
    }
    return probas;
}

