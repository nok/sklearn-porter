{% extends 'base.exported.class' %}

{% block content %}
import com.google.gson.Gson;
import com.google.gson.annotations.SerializedName;
import com.google.gson.reflect.TypeToken;

import java.io.IOException;
import java.io.Reader;
import java.lang.reflect.Type;
import java.nio.file.Files;
import java.nio.file.Paths;
import java.util.Arrays;
import java.util.List;


class {{ class_name }} {

    private class Tree {
        private int[] lefts;
        private int[] rights;
        private double[] thresholds;
        private int[] indices;
        @SerializedName("missing_go_to_left")
        private int[] missingGoToLeft;
        private double[] classes;

        // Add the class fractions of the leaf to the probabilities:
        private void addProbas(double[] features, double[] probas) {
            int start = this.findLeaf(features) * {{ n_classes }};
            for (int i = 0; i < {{ n_classes }}; i++) {
                probas[i] += this.classes[start + i];
            }
        }

        // Find the leaf of the features and return its index:
        private int findLeaf(double[] features) {
            int node = 0;
            while (node >= 0) {
                if (features[this.indices[node]] <= this.thresholds[node] || (this.missingGoToLeft[node] == 1 && Double.isNaN(features[this.indices[node]]))) {
                    node = this.lefts[node];
                } else {
                    node = this.rights[node];
                }
            }
            return -node - 1;
        }
    }

    private List<Tree> forest;
    private int nTrees;
    private int nClasses;

    public {{ class_name }} (String file) throws IOException {
        Gson gson = new Gson();
        Type listType = new TypeToken<List<Tree>>(){}.getType();
        try (Reader reader = Files.newBufferedReader(Paths.get(file))) {
            this.forest = gson.fromJson({{ 'com.google.gson.JsonParser.parseReader(reader).getAsJsonObject().get("estimators")' if pipeline else 'reader' }}, listType);
        }
        this.nTrees = this.forest.size();
        this.nClasses = {{ n_classes }};
    }

{% if is_multi_output %}
    // The classes of all outputs are concatenated, these are their numbers:
    private static final int[] OUTPUT_CLASSES = { {{ output_classes | join(', ') }} };

    // Find the class with the maximum probability of each output:
    private static int[] findMax(double[][] probas) {
        int[] result = new int[probas.length];
        for (int j = 0; j < probas.length; j++) {
            for (int i = 1; i < probas[j].length; i++) {
                if (probas[j][i] > probas[j][result[j]]) {
                    result[j] = i;
                }
            }
        }
        return result;
    }
    // Split the concatenated values into the values of each output:
    private static double[][] splitOutputs(double[] nums) {
        double[][] result = new double[OUTPUT_CLASSES.length][];
        int offset = 0;
        for (int j = 0; j < OUTPUT_CLASSES.length; j++) {
            result[j] = Arrays.copyOfRange(nums, offset, offset + OUTPUT_CLASSES[j]);
            offset += OUTPUT_CLASSES[j];
        }
        return result;
    }
{% else %}
    private static int findMax(double[] nums) {
        int idx = 0;
        for (int i = 0; i < nums.length; i++) {
            idx = nums[i] > nums[idx] ? i : idx;
        }
        return idx;
    }
{% endif %}

    private double[] compute(double[] features) {
        double[] probas = new double[this.nClasses];
        for (int i = 0; i < this.nTrees; i++) {
            this.forest.get(i).addProbas(features, probas);
        }
        for (int j = 0; j < this.nClasses; j++) {
            probas[j] /= this.nTrees;
        }
        return probas;
    }

{% if is_multi_output %}
    public double[][] predictProba(double[] features) {
        return splitOutputs(this.compute(features));
    }
{% else %}
    public double[] predictProba(double[] features) {
        return this.compute(features);
    }
{% endif %}

{% include 'labels' %}

    public {{ 'int[]' if is_multi_output else 'int' }} predictIndex(double[] features) {
        return findMax(this.predictProba(features));
    }
{% if is_multi_output %}

    // Predict the label of each output:
    public {{ label_type }}[] predict(double[] features) {
        int[] idx = this.predictIndex(features);
        {{ label_type }}[] result = new {{ label_type }}[idx.length];
        int offset = 0;
        for (int j = 0; j < idx.length; j++) {
            result[j] = LABELS[offset + idx[j]];
            offset += OUTPUT_CLASSES[j];
        }
        return result;
    }
{% else %}

    public {{ label_type }} predict(double[] features) {
        return LABELS[this.predictIndex(features)];
    }
{% endif %}

{% include 'samples' %}

    public static void main(String[] args) throws IOException {
        if (args.length < 1 || !args[0].endsWith(".json")) {
            throw new IllegalArgumentException("You have to pass the path to the exported model data.");
        }

        {% if pipeline_create %}
        {{ pipeline_create | indent('        ') }}

        {% endif %}
        // Model data:
        String modelData = args[0];

        // Estimator:
        {{ class_name }} clf = new {{ class_name }}(modelData);

        // Features of one sample (arguments) or several samples (standard input):
        for (double[] features : readSamples(args, 1)) {
            {% if pipeline_transform %}
            {{ pipeline_transform | indent('            ') }}
            {% endif %}
            {% if is_test or to_json %}
            // Get JSON:
            {{ label_type }}{{ '[]' if is_multi_output }} prediction = clf.predict(features);
            {{ 'double[][]' if is_multi_output else 'double[]' }} probabilities = clf.predictProba(features);
            System.out.println("{\"predict\": " + toJson(prediction) + ", \"predict_proba\": " + String.join(",", {{ 'Arrays.deepToString(probabilities)' if is_multi_output else 'Arrays.toString(probabilities)' }}) + "}");
            {% else %}
            // Get class prediction:
            {{ label_type }}{{ '[]' if is_multi_output }} prediction = clf.predict(features);
            System.out.println("{{ 'Predicted classes: ' if is_multi_output else 'Predicted class: ' }}" + {{ 'Arrays.toString(prediction)' if is_multi_output else 'String.valueOf(prediction)' }});

            // Get class probabilities:
            {{ 'double[][]' if is_multi_output else 'double[]' }} probabilities = clf.predictProba(features);
            for (int i = 0; i < probabilities.length; i++) {
                System.out.print({{ 'Arrays.toString(probabilities[i])' if is_multi_output else 'String.valueOf(probabilities[i])' }});
                if (i != probabilities.length - 1) {
                    System.out.print(",");
                }
            }
            System.out.println();
            {% endif %}
        }

    }
}
