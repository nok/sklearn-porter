{% extends 'base.combined.class' %}

{% block content %}
var {{ class_name }} = function() {

{% if is_multi_output %}
    // The classes of all outputs are concatenated, these are their numbers:
    var outputClasses = [{{ output_classes | join(', ') }}];

    // Find the class with the maximum probability of each output:
    var _findMax = function(probas) {
        return probas.map(function(nums) {
            var idx = 0;
            for (var i = 1; i < nums.length; i++) {
                idx = nums[i] > nums[idx] ? i : idx;
            }
            return idx;
        });
    };
    // Split the concatenated values into the values of each output:
    var _splitOutputs = function(nums) {
        var result = [], offset = 0;
        outputClasses.forEach(function(n) {
            result.push(nums.slice(offset, offset + n));
            offset += n;
        });
        return result;
    };
{% else %}
    var _findMax = function(nums) {
        var idx = 0;
        for (var i = 0, l = nums.length; i < l; i++) {
            idx = nums[i] > nums[idx] ? i : idx;
        }
        return idx;
    };
{% endif %}

{% if is_multi_output %}
    // Normalize the values of each output:
    var _normVals = function(nums) {
        var result = [], offset = 0;
        outputClasses.forEach(function(n) {
            var i, sum = 0.;
            for (i = offset; i < offset + n; i++) {
                sum += nums[i];
            }
            for (i = offset; i < offset + n; i++) {
                result[i] = sum === 0 ? 1. / n : nums[i] / sum;
            }
            offset += n;
        });
        return result;
    };
{% else %}
    var _normVals = function(nums) {
        var i, l = nums.length;
        var result = [], sum = 0.;
        for (i = 0; i < l; i++) {
            sum += nums[i];
        }
        if(sum === 0) {
            for (i = 0; i < l; i++) {
                result[i] = 1.0 / l;
            }
        } else {
            for (i = 0; i < l; i++) {
                result[i] = nums[i] / sum;
            }
        }
        return result;
    };
{% endif %}

    var forest = [];

    {{ method }}
};

var main = function () {
    if (typeof process !== 'undefined' && typeof process.argv !== 'undefined') {
        if (process.argv.length - 2 !== {{ n_features }}) {
            var IllegalArgumentException = function(message) {
                this.message = message;
                this.name = "IllegalArgumentException";
            }
            throw new IllegalArgumentException("You have to pass {{ n_features }} features.");
        }
    }

    // Features:
    var features = process.argv.slice(2);
    for (var i = 0; i < features.length; i++) {
        features[i] = parseFloat(features[i]);
    }

    // Estimator:
    var clf = new {{ class_name }}();

    {% if is_test or to_json %}
    // Get JSON:
    console.log(JSON.stringify({
        "predict": clf.predict(features),
        "predict_proba": clf.predictProba(features)
    }));
    {% else %}
    // Get class prediction:
    var prediction = clf.predict(features);
    console.log("{{ 'Predicted classes: ' if is_multi_output else 'Predicted class: #' }}" + prediction);

    // Get class probabilities:
    var probabilities = clf.predictProba(features);
    for (var i = 0; i < probabilities.length; i++) {
        console.log("{{ 'Probabilities of output #' if is_multi_output else 'Probability of class #' }}" + i + " : " + probabilities[i]);
    }
    {% endif %}
}

if (require.main === module) {
    main();
}
{% endblock %}