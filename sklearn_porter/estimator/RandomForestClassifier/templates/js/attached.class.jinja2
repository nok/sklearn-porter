{% extends 'base.attached.class' %}

{% block content %}
var {{ class_name }} = function(modelData) {
    var that = this;

    var Tree = function(lefts, rights, thresholds, indices, missingGoToLeft, classes) {
        this.lefts = lefts;
        this.rights = rights;
        this.thresholds = thresholds;
        this.indices = indices;
        this.missingGoToLeft = missingGoToLeft;
        this.classes = classes;

{% if is_multi_output %}
        // Normalize the values of each output:
        var _normVals = function(nums) {
            var result = [], offset = 0;
            outputClasses.forEach(function(n) {
                var i, sum = 0.;
                for (i = offset; i < offset + n; i++) {
                    sum += nums[i];
                }
                for (i = offset; i < offset + n; i++) {
                    result[i] = sum === 0 ? 1. / n : nums[i] / sum;
                }
                offset += n;
            });
            return result;
        };
{% else %}
        var _normVals = function(nums) {
            var i, il = nums.length;
            var result = [], sum = 0.;
            for (i = 0; i < il; i++) {
                sum += nums[i];
            }
            if(sum === 0) {
                for (i = 0; i < il; i++) {
                    result[i] = 1.0 / il;
                }
            } else {
                for (i = 0; i < il; i++) {
                    result[i] = nums[i] / sum;
                }
            }
            return result;
        };
{% endif %}

        this._compute = function(features, node) {
            while (this.thresholds[node] !== -2) {
                if (features[this.indices[node]] <= this.thresholds[node] || (this.missingGoToLeft[node] === 1 && isNaN(features[this.indices[node]]))) {
                    node = this.lefts[node];
                } else {
                    node = this.rights[node];
                }
            }
            return _normVals(this.classes[node]);
        };
    };

    that.forest = [];

    for (var i = 0, il = modelData.length; i < il; i++) {
        that.forest.push(new Tree(
          modelData[i]['lefts'], modelData[i]['rights'],
          modelData[i]['thresholds'], modelData[i]['indices'], modelData[i]['missing_go_to_left'],
          modelData[i]['classes']
        ));
    }

{% if is_multi_output %}
    // The classes of all outputs are concatenated, these are their numbers:
    var outputClasses = [{{ output_classes | join(', ') }}];

    // Find the class with the maximum probability of each output:
    var _findMax = function(probas) {
        return probas.map(function(nums) {
            var idx = 0;
            for (var i = 1; i < nums.length; i++) {
                idx = nums[i] > nums[idx] ? i : idx;
            }
            return idx;
        });
    };
    // Split the concatenated values into the values of each output:
    var _splitOutputs = function(nums) {
        var result = [], offset = 0;
        outputClasses.forEach(function(n) {
            result.push(nums.slice(offset, offset + n));
            offset += n;
        });
        return result;
    };
{% else %}
    var _findMax = function(nums) {
        var idx = 0;
        for (var i = 0, il = nums.length; i < il; i++) {
            idx = nums[i] > nums[idx] ? i : idx;
        }
        return idx;
    };
{% endif %}

    this._compute = function(features) {
        var nTrees = that.forest.length,
            nClasses = that.forest[0].classes[0].length;
        var probas = new Array(nClasses).fill(0);
        var i, j;
        for (i = 0; i < nTrees; i++) {
            var temp = that.forest[i]._compute(features, 0);
            for (j = 0; j < nClasses; j++) {
                probas[j] += temp[j];
            }
        }
        for (j = 0; j < nClasses; j++) {
            probas[j] /= nTrees;
        }
        return probas;
    }

{% if is_multi_output %}
    this.predictProba = function(features) {
        return _splitOutputs(that._compute(features));
    };
{% else %}
    this.predictProba = function(features) {
        return that._compute(features);
    };
{% endif %}

    this.predict = function(features) {
        return _findMax(that.predictProba(features));
    };

};

var main = function () {
    if (typeof process !== 'undefined' && typeof process.argv !== 'undefined') {
        if (process.argv.length - 2 !== {{ n_features }}) {
            var IllegalArgumentException = function(message) {
                this.message = message;
                this.name = "IllegalArgumentException";
            }
            throw new IllegalArgumentException("You have to pass {{ n_features }} features.");
        }
    }

    // Features:
    var features = process.argv.slice(2);
    for (var i = 0; i < features.length; i++) {
        features[i] = parseFloat(features[i]);
    }

    // Model data:
    {{ model }}

    // Estimator:
    var clf = new {{ class_name }}(model);

    {% if is_test or to_json %}
    // Get JSON:
    console.log(JSON.stringify({
        "predict": clf.predict(features),
        "predict_proba": clf.predictProba(features)
    }));
    {% else %}
    // Get class prediction:
    var prediction = clf.predict(features);
    console.log("{{ 'Predicted classes: ' if is_multi_output else 'Predicted class: #' }}" + prediction);

    // Get class probabilities:
    var probabilities = clf.predictProba(features);
    for (var i = 0; i < probabilities.length; i++) {
        console.log("{{ 'Probabilities of output #' if is_multi_output else 'Probability of class #' }}" + i + " : " + probabilities[i]);
    }
    {% endif %}
}

if (require.main === module) {
    main();
}
{% endblock %}