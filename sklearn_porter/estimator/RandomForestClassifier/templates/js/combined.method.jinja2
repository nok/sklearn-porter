{{ methods }}

this._compute = function(features) {
    var nTrees = forest.length,
        nClasses = {{ n_classes }};
    var probas = new Array(nClasses).fill(0);
    var i, j;
    for (i = 0; i < nTrees; i++) {
        var temp = forest[i](features);
        for (j = 0; j < nClasses; j++) {
            probas[j] += temp[j];
        }
    }
    for (j = 0; j < nClasses; j++) {
        probas[j] /= nTrees;
    }
    return probas;
}

{% if is_multi_output %}
this.predictIndex = function(features) {
    return _findMax(this.predictProba(features));
};

this.predictProba = function(features) {
    return _splitOutputs(this._compute(features));
};
{% else %}
this.predictIndex = function(features) {
    return _findMax(this._compute(features));
};

this.predictProba = function(features) {
    return this._compute(features);
};
{% endif %}

{% if is_multi_output %}
// Predict the label of each output:
this.predict = function(features) {
    var offset = 0;
    return this.predictIndex(features).map(function(idx, j) {
        var label = LABELS[offset + idx];
        offset += outputClasses[j];
        return label;
    });
};
{% else %}
this.predict = function(features) {
    return LABELS[this.predictIndex(features)];
};
{% endif %}