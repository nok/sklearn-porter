private static Tree Tree{{ index }}() {
    return new Tree {
        Lefts = new int[] {{ '{' }}{{ lefts }}{{ '}' }},
        Rights = new int[] {{ '{' }}{{ rights }}{{ '}' }},
        Thresholds = new double[] {{ '{' }}{{ thresholds }}{{ '}' }},
        Indices = new int[] {{ '{' }}{{ indices }}{{ '}' }},
        MissingGoToLeft = new int[] {{ '{' }}{{ missing_go_to_left }}{{ '}' }},
        Classes = new double[] {{ '{' }}{{ classes }}{{ '}' }}
    };
}
