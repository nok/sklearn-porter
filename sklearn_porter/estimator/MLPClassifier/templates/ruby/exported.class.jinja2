{% extends 'base.exported.class' %}

{% block content %}
require 'json'


class {{ class_name }}

	def initialize(path)
		data = JSON.parse(File.read(path))
		@hidden = data['hidden_activation']
		@output = data['output_activation']
		@layers = data['layers']
		@weights = data['weights']
		@bias = data['bias']
	end

	def _find_max(nums)
		idx = 0
		for i in 0 ... nums.length
			idx = nums[i] > nums[idx] ? i : idx
		end
		idx
	end

	def _activate(activation, v)
		case activation
		when 'logistic'
			v.map { |x| 1.0 / (1.0 + Math.exp(-x)) }
		when 'relu'
			v.map { |x| x > 0 ? x : 0.0 }
		when 'tanh'
			v.map { |x| Math.tanh(x) }
		when 'softmax'
			max = v.max
			v = v.map { |x| Math.exp(x - max) }
			sum = v.sum
			v.map { |x| x / sum }
		else
			v
		end
	end

	def _feed_forward(features)
		inputs = features
		for i in 0 ... @layers.length
			outputs = @bias[i].dup
			for j in 0 ... inputs.length
				for k in 0 ... outputs.length
					outputs[k] += inputs[j] * @weights[i][j][k]
				end
			end
			activation = i < @layers.length - 1 ? @hidden : @output
			inputs = _activate(activation, outputs)
		end
		inputs
	end

{% include 'labels' %}

	def {{ 'predict' if is_multilabel else 'predict_index' }}(features)
		outputs = _feed_forward(features)
		{% if is_multilabel %}
		outputs.map { |output| output > 0.5 ? 1 : 0 }
		{% else %}
		if outputs.length == 1
			return outputs[0] > 0.5 ? 1 : 0
		end
		_find_max(outputs)
		{% endif %}
	end
{% if not is_multilabel %}

	def predict(features)
		LABELS[predict_index features]
	end
{% endif %}

	def predict_proba(features)
		outputs = _feed_forward(features)
		if outputs.length == 1
			return [1.0 - outputs[0], outputs[0]]
		end
		outputs
	end

end

if __FILE__ == $0
	{% filter indent('\t', True) %}
	{% include 'samples' %}
	{% endfilter %}

	raise "You have to pass the path to the model data." if ARGV.empty?

	# Model data:
	model_data = ARGV.shift

	# Estimator:
	clf = {{ class_name }}.new model_data

	# Features of one sample (arguments) or several samples (standard input):
	read_samples(ARGV) do |features|
		{% if is_test or to_json %}
		# Get JSON:
		prediction = clf.predict features
		probabilities = clf.predict_proba features
		puts JSON.generate({:predict => prediction, :predict_proba => probabilities})
		{% else %}
		# Get class prediction:
		prediction = clf.predict features
		puts "{{ 'Predicted labels: ' if is_multilabel else 'Predicted class: ' }}#{prediction}"

		# Get class probabilities:
		probabilities = clf.predict_proba features
		for i in 0 ... probabilities.length
			puts "Probability of class ##{i} : #{probabilities[i]}"
		end
		{% endif %}
	end
end
{% endblock %}
