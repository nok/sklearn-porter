{% extends 'base.attached.class' %}

{% block content %}
package main

import (
	"bufio"
	{% if is_test or to_json %}
	"encoding/json"
	{% endif %}
	"fmt"
	"math"
	"os"
	"strconv"
	"strings"
)

{% include 'labels' %}

type {{ class_name }} struct {
	Layers []int `json:"layers"`
	Weights [][][]float64 `json:"weights"`
	Bias [][]float64 `json:"bias"`
	HiddenActivation string `json:"hidden_activation"`
	OutputActivation string `json:"output_activation"`
}

{% if is_test or to_json %}
type Response struct {
	Predict {{ '[]int' if is_multilabel else label_type }} `json:"predict"`
	PredictProba []float64 `json:"predict_proba"`
}

{% endif %}
func (clf {{ class_name }}) findMax(nums []float64) int {
	var idx = 0
	for i := 0; i < len(nums); i++ {
		if nums[i] > nums[idx] {
			idx = i
		}
	}
	return idx
}

func (clf {{ class_name }}) activate(activation string, v []float64) {
	switch activation {
	case "logistic":
		for i := range v {
			v[i] = 1.0 / (1.0 + math.Exp(-v[i]))
		}
	case "relu":
		for i := range v {
			v[i] = math.Max(0, v[i])
		}
	case "tanh":
		for i := range v {
			v[i] = math.Tanh(v[i])
		}
	case "softmax":
		var max = v[clf.findMax(v)]
		var sum = 0.0
		for i := range v {
			v[i] = math.Exp(v[i] - max)
			sum += v[i]
		}
		for i := range v {
			v[i] /= sum
		}
	}
}

func (clf {{ class_name }}) feedForward(features []float64) []float64 {
	var inputs = features
	for i := 0; i < len(clf.Layers); i++ {
		var outputs = make([]float64, clf.Layers[i])
		copy(outputs, clf.Bias[i])
		for j := 0; j < len(inputs); j++ {
			for k := 0; k < len(outputs); k++ {
				outputs[k] += inputs[j] * clf.Weights[i][j][k]
			}
		}
		if i < len(clf.Layers) - 1 {
			clf.activate(clf.HiddenActivation, outputs)
		} else {
			clf.activate(clf.OutputActivation, outputs)
		}
		inputs = outputs
	}
	return inputs
}

func (clf {{ class_name }}) {{ 'Predict' if is_multilabel else 'PredictIndex' }}(features []float64) {{ '[]int' if is_multilabel else 'int' }} {
	var outputs = clf.feedForward(features)
	{% if is_multilabel %}
	labels := make([]int, len(outputs))
	for i := 0; i < len(outputs); i++ {
		if outputs[i] > 0.5 {
			labels[i] = 1
		}
	}
	return labels
	{% else %}
	if len(outputs) == 1 {
		if outputs[0] > 0.5 {
			return 1
		}
		return 0
	}
	return clf.findMax(outputs)
	{% endif %}
}
{% if not is_multilabel %}

func (clf {{ class_name }}) Predict(features []float64) {{ label_type }} {
	return labels[clf.PredictIndex(features)]
}
{% endif %}

func (clf {{ class_name }}) PredictProba(features []float64) []float64 {
	var outputs = clf.feedForward(features)
	if len(outputs) == 1 {
		return []float64{1.0 - outputs[0], outputs[0]}
	}
	return outputs
}

{% include 'samples' %}

func main() {
	// Model data:
	{{ layers }}
	{{ weights }}
	{{ bias }}

	// Estimator:
	clf := {{ class_name }}{layers, weights, bias, "{{ hidden_activation }}", "{{ output_activation }}"}

	// Features of one sample (arguments) or several samples (standard input):
	readSamples(os.Args[1:], func(features []float64) {
		{% if is_test or to_json %}
		// Get JSON:
		prediction := clf.Predict(features)
		probabilities := clf.PredictProba(features)
		res, _ := json.Marshal(&Response{Predict: prediction, PredictProba: probabilities})
		fmt.Println(string(res))
		{% else %}
		// Get class prediction:
		prediction := clf.Predict(features)
		fmt.Printf("{{ 'Predicted labels: ' if is_multilabel else 'Predicted class: ' }}%v\n", prediction)

		// Get class probabilities:
		probabilities := clf.PredictProba(features)
		for i, probability := range probabilities {
			fmt.Printf("Probability of class #%d : %f\n", i, probability)
		}
		{% endif %}
	})

}
{% endblock %}
