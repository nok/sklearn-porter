{% extends 'base.attached.class' %}

{% block content %}
#include <stdlib.h>
#include <stdio.h>
#include <string.h>
#include <math.h>

#define N_FEATURES {{ n_features }}
#define N_LAYERS {{ n_layers }}

enum Activation { IDENTITY, LOGISTIC, RELU, TANH, SOFTMAX };


{{ layers }}
{{ weights }}
{{ bias }}

enum Activation hidden_activation = {{ hidden_activation | upper }};
enum Activation output_activation = {{ output_activation | upper }};

int find_max(double *nums, int length) {
    int i;
    int idx = 0;
    for (i = 0; i < length; i++) {
        idx = nums[i] > nums[idx] ? i : idx;
    }
    return idx;
}

void activate(enum Activation activation, double *v, int length) {
    int i;
    double max, sum;
    switch (activation) {
        case LOGISTIC:
            for (i = 0; i < length; i++) {
                v[i] = 1. / (1. + exp(-v[i]));
            }
            break;
        case RELU:
            for (i = 0; i < length; i++) {
                v[i] = v[i] > 0 ? v[i] : 0;
            }
            break;
        case TANH:
            for (i = 0; i < length; i++) {
                v[i] = tanh(v[i]);
            }
            break;
        case SOFTMAX:
            max = v[find_max(v, length)];
            sum = 0.;
            for (i = 0; i < length; i++) {
                v[i] = exp(v[i] - max);
                sum += v[i];
            }
            for (i = 0; i < length; i++) {
                v[i] /= sum;
            }
            break;
        case IDENTITY:
            break;
    }
}

/* Compute the output layer; the caller has to free the result: */
double *feed_forward(double features[N_FEATURES]) {
    int i, j, k, n_inputs = N_FEATURES, n_outputs;
    int w_offset = 0, b_offset = 0;
    double *inputs = malloc(N_FEATURES * sizeof(double));
    double *outputs;
    memcpy(inputs, features, N_FEATURES * sizeof(double));
    for (i = 0; i < N_LAYERS; i++) {
        n_outputs = layers[i];
        outputs = malloc(n_outputs * sizeof(double));
        for (k = 0; k < n_outputs; k++) {
            outputs[k] = bias[b_offset + k];
        }
        for (j = 0; j < n_inputs; j++) {
            for (k = 0; k < n_outputs; k++) {
                outputs[k] += inputs[j] * weights[w_offset + j * n_outputs + k];
            }
        }
        activate(i < N_LAYERS - 1 ? hidden_activation : output_activation, outputs, n_outputs);
        w_offset += n_inputs * n_outputs;
        b_offset += n_outputs;
        free(inputs);
        inputs = outputs;
        n_inputs = n_outputs;
    }
    return inputs;
}

int n_classes() {
    return layers[N_LAYERS - 1] == 1 ? 2 : layers[N_LAYERS - 1];
}

{% if is_multilabel %}
/* Predict the labels, each one is 1 if its probability is greater than .5: */
void predict(int *labels, double features[N_FEATURES]) {
    int i;
    int n_outputs = layers[N_LAYERS - 1];
    double *outputs = feed_forward(features);
    for (i = 0; i < n_outputs; i++) {
        labels[i] = outputs[i] > .5 ? 1 : 0;
    }
    free(outputs);
}
{% else %}
{% include 'labels' %}

int predict_index(double features[N_FEATURES]) {
    int n_outputs = layers[N_LAYERS - 1];
    double *outputs = feed_forward(features);
    int prediction = n_outputs == 1 ? outputs[0] > .5 : find_max(outputs, n_outputs);
    free(outputs);
    return prediction;
}

Label predict(double features[N_FEATURES]) {
    return labels[predict_index(features)];
}
{% endif %}

void predict_proba(double *result, double features[N_FEATURES]) {
    int i, n_outputs = layers[N_LAYERS - 1];
    double *outputs = feed_forward(features);
    if (n_outputs == 1) {
        result[0] = 1. - outputs[0];
        result[1] = outputs[0];
    } else {
        for (i = 0; i < n_outputs; i++) {
            result[i] = outputs[i];
        }
    }
    free(outputs);
}

{% include 'samples' %}

int main(int argc, const char *argv[]) {
    /* Features of one sample (arguments) or several samples (standard input): */
    double features[N_FEATURES];
    while (read_features(features, argc, argv, 1)) {
        {% if is_test or to_json %}
        /* Get JSON: */
        double probabilities[n_classes()];
        predict_proba(probabilities, features);
        {% if is_multilabel %}
        int labels[n_classes()];
        predict(labels, features);
        printf("{\"predict\": [");
        for (int i = 0; i < n_classes(); i++) {
            printf("%d", labels[i]);
            if (i < (n_classes() - 1)) {
                printf(",");
            }
        }
        printf("], \"predict_proba\": [");
        {% else %}
        printf("{\"predict\": ");
        print_label(predict(features));
        printf(", \"predict_proba\": [");
        {% endif %}
        for (int i = 0; i < n_classes(); i++) {
            printf("%.17g", probabilities[i]);
            if (i < (n_classes() - 1)) {
                printf(",");
            }
        }
        printf("]}\n");
        {% else %}
        /* Get class prediction: */
        {% if is_multilabel %}
        int labels[n_classes()];
        predict(labels, features);
        for (int i = 0; i < n_classes(); i++) {
            printf("Predicted label #%d: %d\n", i, labels[i]);
        }
        {% else %}
        printf("Predicted class: ");
        print_label(predict(features));
        printf("\n");
        {% endif %}

        /* Get class probabilities: */
        double probabilities[n_classes()];
        predict_proba(probabilities, features);
        for (int i = 0; i < n_classes(); i++) {
            printf("Probability of class #%d: %.6f\n", i, probabilities[i]);
        }
        {% endif %}
    }

    return 0;
}
{% endblock %}
