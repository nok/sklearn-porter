    public static void Main(string[] args) {
        if (args.Length < 1 || !args[0].EndsWith(".json")) {
            throw new ArgumentException("You have to pass the path to the exported model data.");
        }

        // Estimator:
        {{ class_name }} clf = new {{ class_name }}(args[0]);

        // Features of one sample (arguments) or several samples (standard input):
        foreach (double[] features in ReadSamples(args, 1)) {
            {{ label_type }}{{ '[]' if is_multi_output }} prediction = clf.Predict(features);
            {{ 'double[][]' if is_multi_output else 'double[]' }} probabilities = clf.PredictProba(features);
            {% if is_test or to_json %}
            Console.WriteLine("{\"predict\": " + ToJson(prediction) + ", \"predict_proba\": " + ToJson(probabilities) + "}");
            {% else %}
{% if is_multi_output %}
            Console.WriteLine("Predicted classes: " + string.Join(", ", Array.ConvertAll(prediction, p => Convert.ToString(p, CultureInfo.InvariantCulture))));
            for (int i = 0; i < probabilities.Length; i++) {
                Console.WriteLine("Probabilities of output #" + i + ": " + string.Join(", ", Array.ConvertAll(probabilities[i], p => p.ToString(CultureInfo.InvariantCulture))));
            }
{% else %}
            Console.WriteLine("Predicted class: " + Convert.ToString(prediction, CultureInfo.InvariantCulture));
            for (int i = 0; i < probabilities.Length; i++) {
                Console.WriteLine("Probability of class #" + i + ": " + probabilities[i].ToString(CultureInfo.InvariantCulture));
            }
{% endif %}
            {% endif %}
        }
    }
}
