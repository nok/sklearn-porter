{% extends 'base.attached.class' %}

{% block content %}
package main

import (
  {% if is_test or to_json %}
	"encoding/json"
	{% endif %}
	"fmt"
	"os"
  "math"
	"strconv"
	"sort"
)

{% include 'labels' %}

{% if is_test or to_json %}
type response struct {
	Predict {{ '[]' if is_multi_output }}{{ label_type }} `json:"predict"`
	PredictProba {{ '[][]float64' if is_multi_output else '[]float64' }} `json:"predict_proba"`
}
{% endif %}

type {{ class_name }} struct {
	X [][]float64
	Y []int
	K int
	N int
	Metric string
	Power float64
}

type Distance struct {
	y int
	value float64
}

{% if is_multi_output %}
// The classes of all outputs are concatenated, these are their numbers:
var outputClasses = []int{ {{ output_classes | join(', ') }} }

// Find the class with the maximum probability of each output:
func (knn {{ class_name }}) FindMax(probas [][]float64) []int {
	result := make([]int, len(probas))
	for j, nums := range probas {
		for i := 1; i < len(nums); i++ {
			if nums[i] > nums[result[j]] {
				result[j] = i
			}
		}
	}
	return result
}

// Split the concatenated values into the values of each output:
func splitOutputs(nums []float64) [][]float64 {
	result := make([][]float64, len(outputClasses))
	offset := 0
	for j, n := range outputClasses {
		result[j] = nums[offset : offset+n]
		offset += n
	}
	return result
}
{% else %}
func (knn {{ class_name }}) FindMax(nums []float64) int {
	var idx = 0
	for i := 0; i < len(nums); i++ {
		if nums[i] > nums[idx] {
			idx = i
		}
	}
	return idx
}
{% endif %}

// Compute the distance with the metric `minkowski`, `chebyshev`, `cosine` or `hamming`:
func (knn {{ class_name }}) Compute(temp []float64, cand []float64, metric string, power float64) float64 {
	var dist float64 = 0
	var diff float64
	if metric == "chebyshev" {
		for i := 0; i < len(temp); i++ {
			dist = math.Max(dist, math.Abs(temp[i]-cand[i]))
		}
		return dist
	}
	if metric == "cosine" {
		var dot, normTemp, normCand float64
		for i := 0; i < len(temp); i++ {
			dot += temp[i] * cand[i]
			normTemp += temp[i] * temp[i]
			normCand += cand[i] * cand[i]
		}
		// The distance to a zero vector is 1 like in scikit-learn:
		if normTemp == 0 || normCand == 0 {
			return 1
		}
		dist = 1 - dot/(math.Sqrt(normTemp)*math.Sqrt(normCand))
		return math.Min(math.Max(dist, 0), 2)
	}
	if metric == "hamming" {
		for i := 0; i < len(temp); i++ {
			if temp[i] != cand[i] {
				dist += 1
			}
		}
		return dist / float64(len(temp))
	}
	for i := 0; i < len(temp); i++ {
		diff = math.Abs(temp[i] - cand[i])
		if power == 1 {
			dist += diff
		} else if power == 2 {
			dist += diff * diff
		} else {
			dist += math.Pow(diff, power)
		}
	}
	if power == 1 {
		return dist
	} else if power == 2 {
		return math.Sqrt(dist)
	}
	return math.Pow(dist, 1.0/power)
}

func (knn {{ class_name }}) PredictIndex(features []float64) {{ '[]int' if is_multi_output else 'int' }} {
	return knn.FindMax(knn.PredictProba(features))
}

{% if is_multi_output %}
// Predict the label of each output:
func (knn {{ class_name }}) Predict(features []float64) []{{ label_type }} {
	result := make([]{{ label_type }}, len(outputClasses))
	offset := 0
	for j, idx := range knn.PredictIndex(features) {
		result[j] = labels[offset+idx]
		offset += outputClasses[j]
	}
	return result
}
{% else %}
func (knn {{ class_name }}) Predict(features []float64) {{ label_type }} {
	return labels[knn.PredictIndex(features)]
}
{% endif %}

{% if is_multi_output %}
func (knn {{ class_name }}) PredictProba(features []float64) [][]float64 {
	var classProbas = make([]float64, knn.N)
	nSamples := len(knn.X)
	indices := make([]int, nSamples)
	dists := make([]float64, nSamples)
	for i := 0; i < nSamples; i++ {
		indices[i] = i
		dists[i] = knn.Compute(knn.X[i], features, knn.Metric, knn.Power)
	}
	sort.SliceStable(indices, func(a, b int) bool {
		return dists[indices[a]] < dists[indices[b]]
	})
	// Each neighbor votes for one class of each output:
	nOutputs := len(knn.Y) / nSamples
	for i := 0; i < knn.K; i++ {
		for j := 0; j < nOutputs; j++ {
			classProbas[knn.Y[indices[i]*nOutputs+j]] += 1
		}
	}
	for i := 0; i < knn.N; i++ {
		classProbas[i] /= float64(knn.K)
	}
	return splitOutputs(classProbas)
}
{% else %}
func (knn {{ class_name }}) PredictProba(features []float64) []float64 {
	var classProbas = make([]float64, knn.N)
	if knn.K == 1 {
		classIdx := 0
		minDist := math.Inf(0)
		for i := 0; i < len(knn.Y); i++ {
			dist := knn.Compute(knn.X[i], features, knn.Metric, knn.Power)
			if dist < minDist {
				minDist = dist
				classIdx = knn.Y[i]
			}
		}
		classProbas[classIdx] = 1
	} else {
		dists := []Distance{}
		for i := 0; i < len(knn.Y); i++ {
			dist := knn.Compute(knn.X[i], features, knn.Metric, knn.Power)
			d := Distance{knn.Y[i], dist}
			dists = append(dists, d)
		}
		sort.SliceStable(dists, func(i, j int) bool {
			return dists[i].value < dists[j].value
		})
		for i := 0; i < knn.K; i++ {
			classProbas[dists[i].y] += 1
		}
		for i := 0; i < knn.N; i++ {
			classProbas[i] = classProbas[i] / float64(knn.K)
		}
	}
	return classProbas
}
{% endif %}

func main() {

	// Features:
	var features []float64
	for _, arg := range os.Args[1:] {
		if n, err := strconv.ParseFloat(arg, 64); err == nil {
			features = append(features, n)
		}
	}

	// Model data:
	{{ X }}
	{{ y }}

	// Estimator:
	clf := {{ class_name }}{X, y, {{ k }}, {{ n }}, "{{ metric }}", {{ power }}}

	{% if is_test or to_json %}
	// Get JSON:
	prediction := clf.Predict(features)
	probabilities := clf.PredictProba(features)
	res, _ := json.Marshal(&response{Predict: prediction, PredictProba: probabilities})
	fmt.Println(string(res))
	{% else %}
	// Get class prediction:
	prediction := clf.Predict(features)
	fmt.Printf("{{ 'Predicted classes: ' if is_multi_output else 'Predicted class: ' }}%v\n", prediction)

	// Get class probabilities:
	probabilities := clf.PredictProba(features)
	for i := 0; i < len(probabilities); i++ {
		fmt.Printf("{{ 'Probabilities of output #' if is_multi_output else 'Probability of class #' }}%d : %.f\n", i, probabilities[i])
	}
	{% endif %}

}
{% endblock %}