{% extends 'base.exported.class' %}

{% block content %}
#include <math.h>

#define N_FEATURES {{ n_features }}
#define N_CLASSES {{ n_classes }}
{% if is_multi_output %}
#define N_OUTPUTS {{ n_outputs }}

/* The classes of all outputs are concatenated, these are their numbers: */
int output_classes[N_OUTPUTS] = { {{ output_classes | join(', ') }} };
{% endif %}


int n_templates;
int k;
char metric[16];
double power;
double **X;
int *y;

void load(const char *path) {
    JsonValue *data = json_read(path);
    n_templates = json_get(data, "X")->length;
    X = json_doubles_2d(json_get(data, "X"));
    y = json_ints(json_get(data, "y"));
    k = (int) json_get(data, "k")->number;
    strncpy(metric, json_get(data, "metric")->string, sizeof(metric) - 1);
    power = json_get(data, "power")->number;
    json_free(data);
}

typedef struct {
    int index;
    double dist;
} Neighbor;

{% if is_multi_output %}
/* Find the class with the maximum value of each output: */
void find_max(int *result, double nums[N_CLASSES]) {
    int i, j, offset = 0;
    for (j = 0; j < N_OUTPUTS; j++) {
        result[j] = 0;
        for (i = 1; i < output_classes[j]; i++) {
            if (nums[offset + i] > nums[offset + result[j]]) {
                result[j] = i;
            }
        }
        offset += output_classes[j];
    }
}
{% else %}
int find_max(double nums[N_CLASSES]) {
    int i;
    int idx = 0;
    for (i = 0; i < N_CLASSES; i++) {
        idx = nums[i] > nums[idx] ? i : idx;
    }
    return idx;
}
{% endif %}

/* Sort the neighbors by distance and index (stable): */
int compare(const void *a, const void *b) {
    const Neighbor *n1 = a;
    const Neighbor *n2 = b;
    if (n1->dist != n2->dist) {
        return n1->dist < n2->dist ? -1 : 1;
    }
    return n1->index - n2->index;
}

/* Compute the distance with the metric `minkowski`, `chebyshev`, `cosine` or `hamming`: */
double compute(const double *temp, const double *cand, const char *metric, double q) {
    int i;
    double dist = 0.;
    double diff;
    if (strcmp(metric, "chebyshev") == 0) {
        for (i = 0; i < N_FEATURES; i++) {
            diff = fabs(temp[i] - cand[i]);
            if (diff > dist) {
                dist = diff;
            }
        }
        return dist;
    }
    if (strcmp(metric, "cosine") == 0) {
        double dot = 0.;
        double norm_temp = 0.;
        double norm_cand = 0.;
        for (i = 0; i < N_FEATURES; i++) {
            dot += temp[i] * cand[i];
            norm_temp += temp[i] * temp[i];
            norm_cand += cand[i] * cand[i];
        }
        /* The distance to a zero vector is 1 like in scikit-learn: */
        if (norm_temp == 0. || norm_cand == 0.) {
            return 1.;
        }
        dist = 1. - dot / (sqrt(norm_temp) * sqrt(norm_cand));
        return dist < 0. ? 0. : (dist > 2. ? 2. : dist);
    }
    if (strcmp(metric, "hamming") == 0) {
        for (i = 0; i < N_FEATURES; i++) {
            if (temp[i] != cand[i]) {
                dist += 1.;
            }
        }
        return dist / N_FEATURES;
    }
    for (i = 0; i < N_FEATURES; i++) {
        diff = fabs(temp[i] - cand[i]);
        if (q == 1) {
            dist += diff;
        } else if (q == 2) {
            dist += diff * diff;
        } else {
            dist += pow(diff, q);
        }
    }
    if (q == 1) {
        return dist;
    } else if (q == 2) {
        return sqrt(dist);
    }
    return pow(dist, 1. / q);
}

{% if weights == 'distance' %}
/* Weight the nearest neighbors by the inverse of their distances. If some
   neighbors have the distance 0, only they get the weight 1 (like scikit-learn): */
double weigh(double *weights, const Neighbor *neighbors, int n_neighbors) {
    int i, is_exact = 0;
    double total = 0.;
    for (i = 0; i < n_neighbors; i++) {
        weights[i] = 1. / neighbors[i].dist;
        if (isinf(weights[i])) {
            is_exact = 1;
        }
    }
    for (i = 0; i < n_neighbors; i++) {
        if (is_exact) {
            weights[i] = isinf(weights[i]) ? 1. : 0.;
        }
        total += weights[i];
    }
    return total;
}

{% endif %}
{% if is_multi_output %}
/* Predict the concatenated class probabilities of all outputs: */
void predict_proba_concatenated(double *result, double features[N_FEATURES]) {
    int i, j;
    Neighbor *neighbors = malloc(n_templates * sizeof(Neighbor));
    for (i = 0; i < n_templates; i++) {
        neighbors[i].index = i;
        neighbors[i].dist = compute(X[i], features, metric, power);
    }
    qsort(neighbors, n_templates, sizeof(Neighbor), compare);
    for (i = 0; i < N_CLASSES; i++) {
        result[i] = 0.;
    }
{% if weights == 'distance' %}
    double *weights = malloc(k * sizeof(double));
    double total = weigh(weights, neighbors, k);
    for (i = 0; i < k; i++) {
        /* Each neighbor votes with its weight for one class of each output: */
        for (j = 0; j < N_OUTPUTS; j++) {
            result[y[neighbors[i].index * N_OUTPUTS + j]] += weights[i];
        }
    }
    for (i = 0; i < N_CLASSES; i++) {
        result[i] /= total;
    }
    free(weights);
{% else %}
    for (i = 0; i < k; i++) {
        /* Each neighbor votes for one class of each output: */
        for (j = 0; j < N_OUTPUTS; j++) {
            result[y[neighbors[i].index * N_OUTPUTS + j]] += 1.;
        }
    }
    for (i = 0; i < N_CLASSES; i++) {
        result[i] /= k;
    }
{% endif %}
    free(neighbors);
}

/* Predict the class probabilities of each output: */
void predict_proba(double *result[N_OUTPUTS], double features[N_FEATURES]) {
    int i, j, offset = 0;
    double probabilities[N_CLASSES];
    predict_proba_concatenated(probabilities, features);
    for (j = 0; j < N_OUTPUTS; j++) {
        for (i = 0; i < output_classes[j]; i++) {
            result[j][i] = probabilities[offset + i];
        }
        offset += output_classes[j];
    }
}
{% else %}
void predict_proba(double *result, double features[N_FEATURES]) {
    int i;
    Neighbor *neighbors = malloc(n_templates * sizeof(Neighbor));
    for (i = 0; i < n_templates; i++) {
        neighbors[i].index = i;
        neighbors[i].dist = compute(X[i], features, metric, power);
    }
    qsort(neighbors, n_templates, sizeof(Neighbor), compare);
    for (i = 0; i < N_CLASSES; i++) {
        result[i] = 0.;
    }
{% if weights == 'distance' %}
    double *weights = malloc(k * sizeof(double));
    double total = weigh(weights, neighbors, k);
    for (i = 0; i < k; i++) {
        result[y[neighbors[i].index]] += weights[i];
    }
    for (i = 0; i < N_CLASSES; i++) {
        result[i] /= total;
    }
    free(weights);
{% else %}
    for (i = 0; i < k; i++) {
        result[y[neighbors[i].index]] += 1.;
    }
    for (i = 0; i < N_CLASSES; i++) {
        result[i] /= k;
    }
{% endif %}
    free(neighbors);
}
{% endif %}

{% include 'labels' %}

{% if is_multi_output %}
void predict_index(int *result, double features[N_FEATURES]) {
    double probabilities[N_CLASSES];
    predict_proba_concatenated(probabilities, features);
    find_max(result, probabilities);
}

/* Predict the label of each output: */
void predict(Label *result, double features[N_FEATURES]) {
    int j, offset = 0;
    int idx[N_OUTPUTS];
    predict_index(idx, features);
    for (j = 0; j < N_OUTPUTS; j++) {
        result[j] = labels[offset + idx[j]];
        offset += output_classes[j];
    }
}
{% else %}
int predict_index(double features[N_FEATURES]) {
    double probabilities[N_CLASSES];
    predict_proba(probabilities, features);
    return find_max(probabilities);
}

Label predict(double features[N_FEATURES]) {
    return labels[predict_index(features)];
}
{% endif %}

int main(int argc, const char *argv[]) {

    if (argc != N_FEATURES + 2) {
        fprintf(stderr, "You have to pass the path to the model data and %d features.\n", N_FEATURES);
        return 1;
    }

    /* Model data: */
    load(argv[1]);

    /* Features: */
    double features[N_FEATURES];
    for (int i = 2; i < argc; i++) {
        features[i-2] = atof(argv[i]);
    }

    {% if is_multi_output %}
    Label prediction[N_OUTPUTS];
    predict(prediction, features);
    double *probabilities[N_OUTPUTS];
    for (int j = 0; j < N_OUTPUTS; j++) {
        probabilities[j] = malloc(output_classes[j] * sizeof(double));
    }
    predict_proba(probabilities, features);

    {% if is_test or to_json %}
    /* Get JSON: */
    printf("{\"predict\": [");
    for (int j = 0; j < N_OUTPUTS; j++) {
        print_label(prediction[j]);
        if (j < (N_OUTPUTS - 1)) {
            printf(",");
        }
    }
    printf("], \"predict_proba\": [");
    for (int j = 0; j < N_OUTPUTS; j++) {
        printf("[");
        for (int i = 0; i < output_classes[j]; i++) {
            printf("%.17g", probabilities[j][i]);
            if (i < (output_classes[j] - 1)) {
                printf(",");
            }
        }
        printf(j < (N_OUTPUTS - 1) ? "]," : "]");
    }
    printf("]}");
    {% else %}
    /* Get the class prediction and the class probabilities of each output: */
    for (int j = 0; j < N_OUTPUTS; j++) {
        printf("Predicted class of output #%d: ", j);
        print_label(prediction[j]);
        printf("\n");
        for (int i = 0; i < output_classes[j]; i++) {
            printf("Probability of class #%d of output #%d: %.6f\n", i, j, probabilities[j][i]);
        }
    }
    {% endif %}

    for (int j = 0; j < N_OUTPUTS; j++) {
        free(probabilities[j]);
    }
    {% else %}
    {% if is_test or to_json %}
    /* Get JSON: */
    double probabilities[N_CLASSES];
    predict_proba(probabilities, features);
    printf("{\"predict\": ");
    print_label(predict(features));
    printf(", \"predict_proba\": [");
    for (int i = 0; i < N_CLASSES; i++) {
        printf("%.17g", probabilities[i]);
        if (i < (N_CLASSES - 1)) {
            printf(",");
        }
    }
    printf("]}");
    {% else %}
    /* Get class prediction: */
    printf("Predicted class: ");
    print_label(predict(features));
    printf("\n");

    /* Get class probabilities: */
    double probabilities[N_CLASSES];
    predict_proba(probabilities, features);
    for (int i = 0; i < N_CLASSES; i++) {
        printf("Probability of class #%d: %.6f\n", i, probabilities[i]);
    }
    {% endif %}
    {% endif %}

    return 0;
}
{% endblock %}
