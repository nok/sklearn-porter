{% extends 'base.exported.class' %}

{% block content %}
#include <math.h>

#define N_FEATURES {{ n_features }}
#define N_CLASSES {{ n_classes }}


int n_templates;
int k;
char metric[16];
double power;
double **X;
int *y;

void load(const char *path) {
    JsonValue *data = json_read(path);
    n_templates = json_get(data, "y")->length;
    X = json_doubles_2d(json_get(data, "X"));
    y = json_ints(json_get(data, "y"));
    k = (int) json_get(data, "k")->number;
    strncpy(metric, json_get(data, "metric")->string, sizeof(metric) - 1);
    power = json_get(data, "power")->number;
    json_free(data);
}

typedef struct {
    int index;
    double dist;
} Neighbor;

int find_max(double nums[N_CLASSES]) {
    int i;
    int idx = 0;
    for (i = 0; i < N_CLASSES; i++) {
        idx = nums[i] > nums[idx] ? i : idx;
    }
    return idx;
}

/* Sort the neighbors by distance and index (stable): */
int compare(const void *a, const void *b) {
    const Neighbor *n1 = a;
    const Neighbor *n2 = b;
    if (n1->dist != n2->dist) {
        return n1->dist < n2->dist ? -1 : 1;
    }
    return n1->index - n2->index;
}

/* Compute the distance with the metric `minkowski`, `chebyshev`, `cosine` or `hamming`: */
double compute(const double *temp, const double *cand, const char *metric, double q) {
    int i;
    double dist = 0.;
    double diff;
    if (strcmp(metric, "chebyshev") == 0) {
        for (i = 0; i < N_FEATURES; i++) {
            diff = fabs(temp[i] - cand[i]);
            if (diff > dist) {
                dist = diff;
            }
        }
        return dist;
    }
    if (strcmp(metric, "cosine") == 0) {
        double dot = 0.;
        double norm_temp = 0.;
        double norm_cand = 0.;
        for (i = 0; i < N_FEATURES; i++) {
            dot += temp[i] * cand[i];
            norm_temp += temp[i] * temp[i];
            norm_cand += cand[i] * cand[i];
        }
        /* The distance to a zero vector is 1 like in scikit-learn: */
        if (norm_temp == 0. || norm_cand == 0.) {
            return 1.;
        }
        dist = 1. - dot / (sqrt(norm_temp) * sqrt(norm_cand));
        return dist < 0. ? 0. : (dist > 2. ? 2. : dist);
    }
    if (strcmp(metric, "hamming") == 0) {
        for (i = 0; i < N_FEATURES; i++) {
            if (temp[i] != cand[i]) {
                dist += 1.;
            }
        }
        return dist / N_FEATURES;
    }
    for (i = 0; i < N_FEATURES; i++) {
        diff = fabs(temp[i] - cand[i]);
        if (q == 1) {
            dist += diff;
        } else if (q == 2) {
            dist += diff * diff;
        } else {
            dist += pow(diff, q);
        }
    }
    if (q == 1) {
        return dist;
    } else if (q == 2) {
        return sqrt(dist);
    }
    return pow(dist, 1. / q);
}

void predict_proba(double *result, double features[N_FEATURES]) {
    int i;
    Neighbor *neighbors = malloc(n_templates * sizeof(Neighbor));
    for (i = 0; i < n_templates; i++) {
        neighbors[i].index = i;
        neighbors[i].dist = compute(X[i], features, metric, power);
    }
    qsort(neighbors, n_templates, sizeof(Neighbor), compare);
    for (i = 0; i < N_CLASSES; i++) {
        result[i] = 0.;
    }
    for (i = 0; i < k; i++) {
        result[y[neighbors[i].index]] += 1.;
    }
    for (i = 0; i < N_CLASSES; i++) {
        result[i] /= k;
    }
    free(neighbors);
}

int predict(double features[N_FEATURES]) {
    double probabilities[N_CLASSES];
    predict_proba(probabilities, features);
    return find_max(probabilities);
}

int main(int argc, const char *argv[]) {

    if (argc != N_FEATURES + 2) {
        fprintf(stderr, "You have to pass the path to the model data and %d features.\n", N_FEATURES);
        return 1;
    }

    /* Model data: */
    load(argv[1]);

    /* Features: */
    double features[N_FEATURES];
    for (int i = 2; i < argc; i++) {
        features[i-2] = atof(argv[i]);
    }

    {% if is_test or to_json %}
    /* Get JSON: */
    double probabilities[N_CLASSES];
    predict_proba(probabilities, features);
    printf("{\"predict\": %d, \"predict_proba\": [", predict(features));
    for (int i = 0; i < N_CLASSES; i++) {
        printf("%.17g", probabilities[i]);
        if (i < (N_CLASSES - 1)) {
            printf(",");
        }
    }
    printf("]}");
    {% else %}
    /* Get class prediction: */
    printf("Predicted class: #%d\n", predict(features));

    /* Get class probabilities: */
    double probabilities[N_CLASSES];
    predict_proba(probabilities, features);
    for (int i = 0; i < N_CLASSES; i++) {
        printf("Probability of class #%d: %.6f\n", i, probabilities[i]);
    }
    {% endif %}

    return 0;
}
{% endblock %}
