{% extends 'base.exported.class' %}

{% block content %}
import com.google.gson.Gson;

import java.io.IOException;
import java.io.Reader;
import java.nio.file.Files;
import java.nio.file.Paths;

import java.util.Arrays;


class {{ class_name }} {

    private class Classifier {
        private double[][] X;
        private int[] y;
        private int k;
        private int n;
        private String metric;
        private double power;
    }

    private class Neighbor {
        int index;
        double dist;

        private Neighbor(int index, double dist) {
            this.index = index;
            this.dist = dist;
        }
    }

    private Classifier clf;

    public {{ class_name }}(String file) throws IOException {
        try (Reader reader = Files.newBufferedReader(Paths.get(file))) {
            this.clf = new Gson().fromJson(reader, Classifier.class);
        }
    }

{% if is_multi_output %}
    // The classes of all outputs are concatenated, these are their numbers:
    private static final int[] OUTPUT_CLASSES = { {{ output_classes | join(', ') }} };

    // Find the class with the maximum probability of each output:
    private int[] findMax(double[][] probas) {
        int[] result = new int[probas.length];
        for (int j = 0; j < probas.length; j++) {
            for (int i = 1; i < probas[j].length; i++) {
                if (probas[j][i] > probas[j][result[j]]) {
                    result[j] = i;
                }
            }
        }
        return result;
    }
    // Split the concatenated values into the values of each output:
    private static double[][] splitOutputs(double[] nums) {
        double[][] result = new double[OUTPUT_CLASSES.length][];
        int offset = 0;
        for (int j = 0; j < OUTPUT_CLASSES.length; j++) {
            result[j] = Arrays.copyOfRange(nums, offset, offset + OUTPUT_CLASSES[j]);
            offset += OUTPUT_CLASSES[j];
        }
        return result;
    }
{% else %}
    private int findMax(double[] nums) {
        int idx = 0;
        for (int i = 1; i < nums.length; i++) {
            idx = nums[i] > nums[idx] ? i : idx;
        }
        return idx;
    }
{% endif %}

    // Compute the distance with the metric `minkowski`, `chebyshev`, `cosine` or `hamming`:
    private static double compute(double[] temp, double[] cand, String metric, double q) {
        double dist = 0.;
        double diff;
        if (metric.equals("chebyshev")) {
            for (int i = 0, l = temp.length; i < l; i++) {
                dist = Math.max(dist, Math.abs(temp[i] - cand[i]));
            }
            return dist;
        }
        if (metric.equals("cosine")) {
            double dot = 0., normTemp = 0., normCand = 0.;
            for (int i = 0, l = temp.length; i < l; i++) {
                dot += temp[i] * cand[i];
                normTemp += temp[i] * temp[i];
                normCand += cand[i] * cand[i];
            }
            // The distance to a zero vector is 1 like in scikit-learn:
            if (normTemp == 0. || normCand == 0.) {
                return 1.;
            }
            dist = 1. - dot / (Math.sqrt(normTemp) * Math.sqrt(normCand));
            return Math.min(Math.max(dist, 0.), 2.);
        }
        if (metric.equals("hamming")) {
            for (int i = 0, l = temp.length; i < l; i++) {
                if (temp[i] != cand[i]) {
                    dist += 1.;
                }
            }
            return dist / temp.length;
        }
        if (q == 1) {
            for (int i = 0, l = temp.length; i < l; i++) {
                dist += Math.abs(temp[i] - cand[i]);
            }
            return dist;
        }
        if (q == 2) {
            for (int i = 0, l = temp.length; i < l; i++) {
                diff = temp[i] - cand[i];
                dist += diff * diff;
            }
            return Math.sqrt(dist);
        }
        for (int i = 0, l = temp.length; i < l; i++) {
            dist += Math.pow(Math.abs(temp[i] - cand[i]), q);
        }
        return Math.pow(dist, 1. / q);
    }

    // Find the k nearest neighbors sorted by distance and index (like a stable
    // sort). A sample is only inserted if it's nearer than the k-th neighbor:
    private Neighbor[] findNeighbors(double[] features) {
        Neighbor[] neighbors = new Neighbor[this.clf.k];
        int n = 0;
        for (int i = 0; i < this.clf.X.length; i++) {
            double dist = {{ class_name }}.compute(this.clf.X[i], features, this.clf.metric, this.clf.power);
            if (n == this.clf.k && !(dist < neighbors[this.clf.k - 1].dist)) {
                continue;
            }
            int j = n < this.clf.k ? n++ : this.clf.k - 1;
            while (j > 0 && dist < neighbors[j - 1].dist) {
                neighbors[j] = neighbors[j - 1];
                j--;
            }
            neighbors[j] = new Neighbor(i, dist);
        }
        return neighbors;
    }

{% include 'labels' %}

    public {{ 'int[]' if is_multi_output else 'int' }} predictIndex(double[] features) {
        {{ 'double[][]' if is_multi_output else 'double[]' }} classProbas = this.predictProba(features);
        return findMax(classProbas);
    }
{% if is_multi_output %}

    // Predict the label of each output:
    public {{ label_type }}[] predict(double[] features) {
        int[] idx = this.predictIndex(features);
        {{ label_type }}[] result = new {{ label_type }}[idx.length];
        int offset = 0;
        for (int j = 0; j < idx.length; j++) {
            result[j] = LABELS[offset + idx[j]];
            offset += OUTPUT_CLASSES[j];
        }
        return result;
    }
{% else %}

    public {{ label_type }} predict(double[] features) {
        return LABELS[this.predictIndex(features)];
    }
{% endif %}

{% if weights == 'distance' %}
    // Weight the nearest neighbors by the inverse of their distances. If some
    // neighbors have the distance 0, only they get the weight 1 (like scikit-learn):
    private static double[] weigh(Neighbor[] neighbors, int k) {
        double[] weights = new double[k];
        boolean isExact = false;
        for (int i = 0; i < k; i++) {
            weights[i] = 1. / neighbors[i].dist;
            if (Double.isInfinite(weights[i])) {
                isExact = true;
            }
        }
        if (isExact) {
            for (int i = 0; i < k; i++) {
                weights[i] = Double.isInfinite(weights[i]) ? 1. : 0.;
            }
        }
        return weights;
    }

{% endif %}
{% if is_multi_output %}
    public double[][] predictProba(double[] features) {
        double[] classProbas = new double[this.clf.n];
        Neighbor[] neighbors = this.findNeighbors(features);
        int nOutputs = this.clf.y.length / this.clf.X.length;
{% if weights == 'distance' %}
        // Each neighbor votes with its weight for one class of each output:
        double[] weights = {{ class_name }}.weigh(neighbors, this.clf.k);
        double total = 0.;
        for (int i = 0; i < this.clf.k; i++) {
            total += weights[i];
            for (int j = 0; j < nOutputs; j++) {
                classProbas[this.clf.y[neighbors[i].index * nOutputs + j]] += weights[i];
            }
        }
        for (int i = 0; i < this.clf.n; i++) {
            classProbas[i] /= total;
        }
{% else %}
        // Each neighbor votes for one class of each output:
        for (Neighbor neighbor : neighbors) {
            for (int j = 0; j < nOutputs; j++) {
                classProbas[this.clf.y[neighbor.index * nOutputs + j]]++;
            }
        }
        for (int i = 0; i < this.clf.n; i++) {
            classProbas[i] /= this.clf.k;
        }
{% endif %}
        return splitOutputs(classProbas);
    }
{% else %}
    public double[] predictProba(double[] features) {
        double[] classProbas = new double[this.clf.n];
        Neighbor[] neighbors = this.findNeighbors(features);
{% if weights == 'distance' %}
        double[] weights = {{ class_name }}.weigh(neighbors, this.clf.k);
        double total = 0.;
        for (int i = 0; i < this.clf.k; i++) {
            total += weights[i];
            classProbas[this.clf.y[neighbors[i].index]] += weights[i];
        }
        for (int i = 0; i < this.clf.n; i++) {
            classProbas[i] /= total;
        }
{% else %}
        for (Neighbor neighbor : neighbors) {
            classProbas[this.clf.y[neighbor.index]]++;
        }
        for (int i = 0; i < this.clf.n; i++) {
            classProbas[i] /= this.clf.k;
        }
{% endif %}
        return classProbas;
    }
{% endif %}

{% include 'samples' %}

    public static void main(String[] args) throws IOException {
        if (args.length < 1 || !args[0].endsWith(".json")) {
            throw new IllegalArgumentException("You have to pass the path to the exported model data.");
        }

        // Model data:
        String modelData = args[0];

        // Estimator:
        {{ class_name }} clf = new {{ class_name }}(modelData);

        // Features of one sample (arguments) or several samples (standard input):
        for (double[] features : readSamples(args, 1)) {
            {% if is_test or to_json %}
            // Get JSON:
            {{ label_type }}{{ '[]' if is_multi_output }} prediction = clf.predict(features);
            {{ 'double[][]' if is_multi_output else 'double[]' }} probabilities = clf.predictProba(features);
            System.out.println("{\"predict\": " + toJson(prediction) + ", \"predict_proba\": " + String.join(",", {{ 'Arrays.deepToString(probabilities)' if is_multi_output else 'Arrays.toString(probabilities)' }}) + "}");
            {% else %}
            // Get class prediction:
            {{ label_type }}{{ '[]' if is_multi_output }} prediction = clf.predict(features);
            System.out.println("{{ 'Predicted classes: ' if is_multi_output else 'Predicted class: ' }}" + {{ 'Arrays.toString(prediction)' if is_multi_output else 'String.valueOf(prediction)' }});

            // Get class probabilities:
            {{ 'double[][]' if is_multi_output else 'double[]' }} probabilities = clf.predictProba(features);
            for (int i = 0; i < probabilities.length; i++) {
                System.out.print({{ 'Arrays.toString(probabilities[i])' if is_multi_output else 'String.valueOf(probabilities[i])' }});
                if (i != probabilities.length - 1) {
                    System.out.print(",");
                }
            }
            System.out.println();
            {% endif %}
        }

    }

}
{% endblock %}