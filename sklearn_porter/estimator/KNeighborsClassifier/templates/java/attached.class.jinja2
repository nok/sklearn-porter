{% extends 'base.attached.class' %}

{% block content %}
import java.util.Arrays;
import java.util.ArrayList;
import java.util.Collections;
import java.util.Comparator;


class {{ class_name }} {

    private double[][] X;
    private int[] y;
    private int k;
    private int n;
    private String metric;
    private double power;

    public {{ class_name }}(double[][] X, int[] y, int k, int n, String metric, double power) {
        this.X = X;
        this.y = y;
        this.k = k;
        this.n = n;
        this.metric = metric;
        this.power = power;
    }

    private static class Neighbor {
        Integer y;
        Double dist;

        public Neighbor(int y, double dist) {
            this.y = y;
            this.dist = dist;
        }
    }

{% if is_multi_output %}
    // The classes of all outputs are concatenated, these are their numbers:
    private static final int[] OUTPUT_CLASSES = { {{ output_classes | join(', ') }} };

    // Find the class with the maximum probability of each output:
    private int[] findMax(double[][] probas) {
        int[] result = new int[probas.length];
        for (int j = 0; j < probas.length; j++) {
            for (int i = 1; i < probas[j].length; i++) {
                if (probas[j][i] > probas[j][result[j]]) {
                    result[j] = i;
                }
            }
        }
        return result;
    }
    // Split the concatenated values into the values of each output:
    private static double[][] splitOutputs(double[] nums) {
        double[][] result = new double[OUTPUT_CLASSES.length][];
        int offset = 0;
        for (int j = 0; j < OUTPUT_CLASSES.length; j++) {
            result[j] = Arrays.copyOfRange(nums, offset, offset + OUTPUT_CLASSES[j]);
            offset += OUTPUT_CLASSES[j];
        }
        return result;
    }
{% else %}
    private int findMax(double[] nums) {
        int idx = 0;
        for (int i = 1; i < nums.length; i++) {
            idx = nums[i] > nums[idx] ? i : idx;
        }
        return idx;
    }
{% endif %}

    // Compute the distance with the metric `minkowski`, `chebyshev`, `cosine` or `hamming`:
    private static double compute(double[] temp, double[] cand, String metric, double q) {
        double dist = 0.;
        double diff;
        if (metric.equals("chebyshev")) {
            for (int i = 0, l = temp.length; i < l; i++) {
                dist = Math.max(dist, Math.abs(temp[i] - cand[i]));
            }
            return dist;
        }
        if (metric.equals("cosine")) {
            double dot = 0., normTemp = 0., normCand = 0.;
            for (int i = 0, l = temp.length; i < l; i++) {
                dot += temp[i] * cand[i];
                normTemp += temp[i] * temp[i];
                normCand += cand[i] * cand[i];
            }
            // The distance to a zero vector is 1 like in scikit-learn:
            if (normTemp == 0. || normCand == 0.) {
                return 1.;
            }
            dist = 1. - dot / (Math.sqrt(normTemp) * Math.sqrt(normCand));
            return Math.min(Math.max(dist, 0.), 2.);
        }
        if (metric.equals("hamming")) {
            for (int i = 0, l = temp.length; i < l; i++) {
                if (temp[i] != cand[i]) {
                    dist += 1.;
                }
            }
            return dist / temp.length;
        }
        for (int i = 0, l = temp.length; i < l; i++) {
            diff = Math.abs(temp[i] - cand[i]);
            if (q == 1) {
                dist += diff;
            } else if (q == 2) {
                dist += diff * diff;
            } else {
                dist += Math.pow(diff, q);
            }
        }
        if (q == 1) {
            return dist;
        } else if (q == 2) {
            return Math.sqrt(dist);
        }
        return Math.pow(dist, 1. / q);
    }

{% include 'labels' %}

    public {{ 'int[]' if is_multi_output else 'int' }} predictIndex(double[] features) {
        {{ 'double[][]' if is_multi_output else 'double[]' }} classProbas = this.predictProba(features);
        return findMax(classProbas);
    }
{% if is_multi_output %}

    // Predict the label of each output:
    public {{ label_type }}[] predict(double[] features) {
        int[] idx = this.predictIndex(features);
        {{ label_type }}[] result = new {{ label_type }}[idx.length];
        int offset = 0;
        for (int j = 0; j < idx.length; j++) {
            result[j] = LABELS[offset + idx[j]];
            offset += OUTPUT_CLASSES[j];
        }
        return result;
    }
{% else %}

    public {{ label_type }} predict(double[] features) {
        return LABELS[this.predictIndex(features)];
    }
{% endif %}

{% if weights == 'distance' %}
    // Weight the nearest neighbors by the inverse of their distances. If some
    // neighbors have the distance 0, only they get the weight 1 (like scikit-learn):
    private static double[] weigh(ArrayList<Neighbor> neighbors, int k) {
        double[] weights = new double[k];
        boolean isExact = false;
        for (int i = 0; i < k; i++) {
            weights[i] = 1. / neighbors.get(i).dist;
            if (Double.isInfinite(weights[i])) {
                isExact = true;
            }
        }
        if (isExact) {
            for (int i = 0; i < k; i++) {
                weights[i] = Double.isInfinite(weights[i]) ? 1. : 0.;
            }
        }
        return weights;
    }

{% endif %}
{% if is_multi_output %}
    public double[][] predictProba(double[] features) {
        double[] classProbas = new double[this.n];
        ArrayList<Neighbor> dists = new ArrayList<Neighbor>();
        for (int i = 0; i < this.X.length; i++) {
            // The neighbors store the index of the sample:
            double dist = {{ class_name }}.compute(this.X[i], features, this.metric, this.power);
            dists.add(new Neighbor(i, dist));
        }
        Collections.sort(dists, new Comparator<Neighbor>() {
            @Override
            public int compare(Neighbor n1, Neighbor n2) {
                return n1.dist.compareTo(n2.dist);
            }
        });
{% if weights == 'distance' %}
        // Each neighbor votes with its weight for one class of each output:
        int nOutputs = this.y.length / this.X.length;
        double[] weights = {{ class_name }}.weigh(dists, this.k);
        double total = 0.;
        for (int i = 0; i < this.k; i++) {
            total += weights[i];
            for (int j = 0; j < nOutputs; j++) {
                classProbas[this.y[dists.get(i).y * nOutputs + j]] += weights[i];
            }
        }
        for (int i = 0; i < this.n; i++) {
            classProbas[i] /= total;
        }
{% else %}
        // Each neighbor votes for one class of each output:
        int nOutputs = this.y.length / this.X.length;
        for (Neighbor neighbor : dists.subList(0, this.k)) {
            for (int j = 0; j < nOutputs; j++) {
                classProbas[this.y[neighbor.y * nOutputs + j]]++;
            }
        }
        for (int i = 0; i < this.n; i++) {
            classProbas[i] /= this.k;
        }
{% endif %}
        return splitOutputs(classProbas);
    }
{% else %}
    public double[] predictProba(double[] features) {
        int classIdx = 0;
        double[] classProbas = new double[this.n];
        double dist;
        if (this.k == 1) {
            double minDist = Double.POSITIVE_INFINITY;
            for (int i = 0; i < this.y.length; i++) {
                dist = {{ class_name }}.compute(this.X[i], features, this.metric, this.power);
                if (dist < minDist) {
                    minDist = dist;
                    classIdx = y[i];
                }
            }
            classProbas[classIdx] = 1;
        } else {
            ArrayList<Neighbor> dists = new ArrayList<Neighbor>();
            for (int i = 0; i < this.y.length; i++) {
                dist = {{ class_name }}.compute(this.X[i], features, this.metric, this.power);
                dists.add(new Neighbor(y[i], dist));
            }
            Collections.sort(dists, new Comparator<Neighbor>() {
                @Override
                public int compare(Neighbor n1, Neighbor n2) {
                    return n1.dist.compareTo(n2.dist);
                }
            });
{% if weights == 'distance' %}
            double[] weights = {{ class_name }}.weigh(dists, this.k);
            double total = 0.;
            for (int i = 0; i < this.k; i++) {
                total += weights[i];
                classProbas[dists.get(i).y] += weights[i];
            }
            for (int i = 0; i < this.n; i++) {
                classProbas[i] /= total;
            }
{% else %}
            for (Neighbor neighbor : dists.subList(0, this.k)) {
                classProbas[neighbor.y]++;
            }
            for (int i = 0; i < this.n; i++) {
                classProbas[i] /= this.k;
            }
{% endif %}
        }
        return classProbas;
    }
{% endif %}

{% include 'samples' %}

    public static void main(String[] args) {
        // Model data:
        {{ X }}
        {{ y }}

        // Estimator:
        {{ class_name }} clf = new {{ class_name }}(X, y, {{ k }}, {{ n }}, "{{ metric }}", {{ power }});

        // Features of one sample (arguments) or several samples (standard input):
        for (double[] features : readSamples(args, 0)) {
            {% if is_test or to_json %}
            // Get JSON:
            {{ label_type }}{{ '[]' if is_multi_output }} prediction = clf.predict(features);
            {{ 'double[][]' if is_multi_output else 'double[]' }} probabilities = clf.predictProba(features);
            System.out.println("{\"predict\": " + toJson(prediction) + ", \"predict_proba\": " + String.join(",", {{ 'Arrays.deepToString(probabilities)' if is_multi_output else 'Arrays.toString(probabilities)' }}) + "}");
            {% else %}
            // Get class prediction:
            {{ label_type }}{{ '[]' if is_multi_output }} prediction = clf.predict(features);
            System.out.println("{{ 'Predicted classes: ' if is_multi_output else 'Predicted class: ' }}" + {{ 'Arrays.toString(prediction)' if is_multi_output else 'String.valueOf(prediction)' }});

            // Get class probabilities:
            {{ 'double[][]' if is_multi_output else 'double[]' }} probabilities = clf.predictProba(features);
            for (int i = 0; i < probabilities.length; i++) {
                System.out.println("{{ 'Probabilities of output #' if is_multi_output else 'Probability of class #' }}" + i + " : " + {{ 'Arrays.toString(probabilities[i])' if is_multi_output else 'String.valueOf(probabilities[i])' }});
            }
            {% endif %}
        }

    }
}
{% endblock %}