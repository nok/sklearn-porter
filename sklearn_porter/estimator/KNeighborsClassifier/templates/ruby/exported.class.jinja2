{% extends 'base.attached.class' %}

{% block content %}
require 'json'


class {{ class_name }}

	INF = +1.0/0.0

	def initialize (path)
		@data = JSON.parse(File.read(path))

		@x = @data['X']
		@y = @data['y']
		@k = @data['k']
		@n = @data['n']
		@metric = @data['metric']
		@power = @data['power']
	end

{% if is_multi_output %}
	# The classes of all outputs are concatenated, these are their numbers:
	OUTPUT_CLASSES = [{{ output_classes | join(', ') }}]

	# Find the class with the maximum probability of each output:
	def _find_max (nums)
		nums.map { |probas| probas.index(probas.max) }
	end

	# Split the concatenated values into the values of each output:
	def _split_outputs(nums)
		offset = 0
		OUTPUT_CLASSES.map do |n|
			probas = nums[offset, n]
			offset += n
			probas
		end
	end
{% else %}
	def _find_max (nums)
		idx = 0
		for i in 0 ... nums.length
			idx = nums[i] > nums[idx] ? i : idx
		end
		idx
	end
{% endif %}

	# Compute the distance with the metric `minkowski`, `chebyshev`, `cosine` or `hamming`:
	def _compute (temp, cand, metric, q)
		if metric == 'chebyshev'
			return (0 ... temp.length).map { |i| (temp[i] - cand[i]).abs }.max
		end
		if metric == 'cosine'
			dot, norm_temp, norm_cand = 0.0, 0.0, 0.0
			for i in 0 ... temp.length
				dot += temp[i] * cand[i]
				norm_temp += temp[i] * temp[i]
				norm_cand += cand[i] * cand[i]
			end
			# The distance to a zero vector is 1 like in scikit-learn:
			return 1.0 if norm_temp == 0 || norm_cand == 0
			dist = 1.0 - dot / (Math.sqrt(norm_temp) * Math.sqrt(norm_cand))
			return [[dist, 0.0].max, 2.0].min
		end
		if metric == 'hamming'
			return (0 ... temp.length).count { |i| temp[i] != cand[i] }.to_f / temp.length
		end
		dist = 0.0
		for i in 0 ... temp.length
			diff = (temp[i] - cand[i]).abs
			if q == 1
				dist += diff
			elsif q == 2
				dist += diff * diff
			else
				dist += diff ** q
			end
		end
		if q == 1
			dist
		elsif q == 2
			Math.sqrt dist
		else
			dist ** (1.0 / q)
		end
	end

{% include 'labels' %}

	def predict_index(features)
        probas = predict_proba features
        _find_max probas
	end

{% if is_multi_output %}
	# Predict the label of each output:
	def predict(features)
		offset = 0
		predict_index(features).each_with_index.map do |idx, j|
			label = LABELS[offset + idx]
			offset += OUTPUT_CLASSES[j]
			label
		end
	end
{% else %}
	def predict(features)
		LABELS[predict_index features]
	end
{% endif %}

{% if weights == 'distance' %}
	# Weight the nearest neighbors by the inverse of their distances. If some
	# neighbors have the distance 0, only they get the weight 1 (like scikit-learn):
	def _weigh (dists)
		weights = dists.map { |dist| 1.0 / dist }
		if weights.any? { |weight| weight.infinite? }
			weights = weights.map { |weight| weight.infinite? ? 1.0 : 0.0 }
		end
		weights
	end

{% endif %}
{% if is_multi_output %}
	def predict_proba (features)
		class_probas = Array.new(@n, 0.0)
		# The neighbors are the indices of the samples sorted by their distance:
		dists = (0 ... @x.length).sort_by { |i| [_compute(@x[i], features, @metric, @power), i] }
{% if weights == 'distance' %}
		weights = _weigh(dists.first(@k).map { |i| _compute(@x[i], features, @metric, @power) })
		total = 0.0
		# Each neighbor votes with its weight for one class of each output:
		n_outputs = @y.length / @x.length
		for i in 0 ... @k
			total += weights[i]
			for j in 0 ... n_outputs
				class_probas[@y[dists[i] * n_outputs + j]] += weights[i]
			end
		end
		_split_outputs(class_probas.map { |p| p / total })
{% else %}
		# Each neighbor votes for one class of each output:
		n_outputs = @y.length / @x.length
		for i in 0 ... @k
			for j in 0 ... n_outputs
				class_probas[@y[dists[i] * n_outputs + j]] += 1
			end
		end
		_split_outputs(class_probas.map { |p| p / @k })
{% endif %}
	end
{% else %}
	def predict_proba (features)
        class_probas = Array.new(@n, 0.0)
        if @k == 1
            class_idx = 0
            min_dist = INF
            for i in 0 ... @y.length
                dist = _compute @x[i], features, @metric, @power
                if dist < min_dist
                    min_dist = dist
                    class_idx = @y[i]
                end
            end
            class_probas[class_idx] = 1
        else
            dists = []
            for i in 0 ... @y.length
                dist = _compute @x[i], features, @metric, @power
                dists.push [@y[i], dist, i]
            end
            # Sort the neighbors by distance and index (stable):
            dists.sort_by! { |neighbor| [neighbor[1], neighbor[2]] }
{% if weights == 'distance' %}
            weights = _weigh(dists.first(@k).map { |neighbor| neighbor[1] })
            total = 0.0
            for i in 0 ... @k
                total += weights[i]
                class_probas[dists[i][0]] += weights[i]
            end
            for i in 0 ... @n
                class_probas[i] /= total
            end
{% else %}
            for i in 0 ... @k
                class_probas[dists[i][0]] += 1
            end
            for i in 0 ... @n
                class_probas[i] /= @k
            end
{% endif %}
        end
        class_probas
	end
{% endif %}

end

if __FILE__ == $0
	if ARGV.length != {{ n_features + 1 }}
		raise "You have to pass the path to the model data and {{ n_features }} features."
	end

	# Model data:
	modelData = ARGV.shift

	# Features:
	features = ARGV.collect(&:to_f)

	# Estimator:
	clf = {{ class_name }}.new modelData

	{% if is_test or to_json %}
	# Get JSON:
	prediction = clf.predict features
	probabilities = clf.predict_proba features
	puts JSON.generate({:predict => prediction, :predict_proba => probabilities})
	{% else %}
	# Get class prediction:
	prediction = clf.predict features
	puts "{{ 'Predicted classes: ' if is_multi_output else 'Predicted class: ' }}#{prediction}"

	# Get class probabilities:
	probabilities = clf.predict_proba features
	for i in 0 ... probabilities.length
		puts "{{ 'Probabilities of output #' if is_multi_output else 'Probability of class #' }}#{i} : #{probabilities[i]}"
	end
	{% endif %}
end
{% endblock %}