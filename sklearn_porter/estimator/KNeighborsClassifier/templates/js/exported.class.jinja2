{% extends 'base.exported.class' %}

{% block content %}
var fs = require('fs');


var {{ class_name }} = function(jsonFile) {
    this.data = JSON.parse(fs.readFileSync(jsonFile));

    var Neighbor = function(index, dist) {
        this.index = index;
        this.dist = dist;
    };

{% if is_multi_output %}
    // The classes of all outputs are concatenated, these are their numbers:
    var outputClasses = [{{ output_classes | join(', ') }}];

    // Find the class with the maximum probability of each output:
    var _findMax = function(probas) {
        return probas.map(function(nums) {
            var idx = 0;
            for (var i = 1; i < nums.length; i++) {
                idx = nums[i] > nums[idx] ? i : idx;
            }
            return idx;
        });
    };
    // Split the concatenated values into the values of each output:
    var _splitOutputs = function(nums) {
        var result = [], offset = 0;
        outputClasses.forEach(function(n) {
            result.push(nums.slice(offset, offset + n));
            offset += n;
        });
        return result;
    };
{% else %}
    var _findMax = function(nums) {
        var idx = 0;
        for (var i = 0, l = nums.length; i < l; i++) {
            idx = nums[i] > nums[idx] ? i : idx;
        }
        return idx;
    };
{% endif %}

    // Compute the distance with the metric `minkowski`, `chebyshev`, `cosine` or `hamming`:
    var _compute = function(temp, cand, metric, q) {
        var dist = 0., diff, i, l = temp.length;
        if (metric === 'chebyshev') {
            for (i = 0; i < l; i++) {
                dist = Math.max(dist, Math.abs(temp[i] - cand[i]));
            }
            return dist;
        }
        if (metric === 'cosine') {
            var dot = 0., normTemp = 0., normCand = 0.;
            for (i = 0; i < l; i++) {
                dot += temp[i] * cand[i];
                normTemp += temp[i] * temp[i];
                normCand += cand[i] * cand[i];
            }
            // The distance to a zero vector is 1 like in scikit-learn:
            if (normTemp === 0 || normCand === 0) {
                return 1.;
            }
            dist = 1. - dot / (Math.sqrt(normTemp) * Math.sqrt(normCand));
            return Math.min(Math.max(dist, 0.), 2.);
        }
        if (metric === 'hamming') {
            for (i = 0; i < l; i++) {
                if (temp[i] !== cand[i]) {
                    dist += 1.;
                }
            }
            return dist / l;
        }
        if (q === 1) {
            for (i = 0; i < l; i++) {
                dist += Math.abs(temp[i] - cand[i]);
            }
            return dist;
        }
        if (q === 2) {
            for (i = 0; i < l; i++) {
                diff = temp[i] - cand[i];
                dist += diff * diff;
            }
            return Math.sqrt(dist);
        }
        for (i = 0; i < l; i++) {
            dist += Math.pow(Math.abs(temp[i] - cand[i]), q);
        }
        return Math.pow(dist, 1. / q);
    };

    // Find the k nearest neighbors sorted by distance and index (like a stable
    // sort). A sample is only inserted if it's nearer than the k-th neighbor:
    var _findNeighbors = function(features, X, k, metric, power) {
        var neighbors = [], i, j, dist;
        for (i = 0; i < X.length; i++) {
            dist = _compute(X[i], features, metric, power);
            if (neighbors.length === k && !(dist < neighbors[k - 1].dist)) {
                continue;
            }
            j = neighbors.length < k ? neighbors.length : k - 1;
            while (j > 0 && dist < neighbors[j - 1].dist) {
                neighbors[j] = neighbors[j - 1];
                j--;
            }
            neighbors[j] = new Neighbor(i, dist);
        }
        return neighbors;
    };

{% if weights == 'distance' %}
    // Weight the nearest neighbors by the inverse of their distances. If some
    // neighbors have the distance 0, only they get the weight 1 (like scikit-learn):
    var _weigh = function(neighbors, k) {
        var i, weights = new Array(k), isExact = false;
        for (i = 0; i < k; i++) {
            weights[i] = 1. / neighbors[i].dist;
            if (Math.abs(weights[i]) === Infinity) {
                isExact = true;
            }
        }
        if (isExact) {
            for (i = 0; i < k; i++) {
                weights[i] = Math.abs(weights[i]) === Infinity ? 1. : 0.;
            }
        }
        return weights;
    };

{% endif %}
{% if is_multi_output %}
    this.predictProba = function(features) {
        var classProbas = new Array(this.data.n).fill(0);
        var neighbors = _findNeighbors(features, this.data.X, this.data.k, this.data.metric, this.data.power);
        var i, j, nOutputs = this.data.y.length / this.data.X.length;
{% if weights == 'distance' %}
        // Each neighbor votes with its weight for one class of each output:
        var weights = _weigh(neighbors, this.data.k), total = 0.;
        for (i = 0; i < this.data.k; i++) {
            total += weights[i];
            for (j = 0; j < nOutputs; j++) {
                classProbas[this.data.y[neighbors[i].index * nOutputs + j]] += weights[i];
            }
        }
        for (i = 0; i < this.data.n; i++) {
            classProbas[i] /= total;
        }
{% else %}
        // Each neighbor votes for one class of each output:
        for (i = 0; i < this.data.k; i++) {
            for (j = 0; j < nOutputs; j++) {
                classProbas[this.data.y[neighbors[i].index * nOutputs + j]] += 1;
            }
        }
        for (i = 0; i < this.data.n; i++) {
            classProbas[i] /= this.data.k;
        }
{% endif %}
        return _splitOutputs(classProbas);
    };
{% else %}
    this.predictProba = function(features) {
        var classProbas = new Array(this.data.n).fill(0);
        var neighbors = _findNeighbors(features, this.data.X, this.data.k, this.data.metric, this.data.power);
        var i;
{% if weights == 'distance' %}
        var weights = _weigh(neighbors, this.data.k), total = 0.;
        for (i = 0; i < this.data.k; i++) {
            total += weights[i];
            classProbas[this.data.y[neighbors[i].index]] += weights[i];
        }
        for (i = 0; i < this.data.n; i++) {
            classProbas[i] /= total;
        }
{% else %}
        for (i = 0; i < this.data.k; i++) {
            classProbas[this.data.y[neighbors[i].index]] += 1;
        }
        for (i = 0; i < this.data.n; i++) {
            classProbas[i] /= this.data.k;
        }
{% endif %}
        return classProbas;
    };
{% endif %}

{% include 'labels' %}

    this.predictIndex = function(features) {
        return _findMax(this.predictProba(features));
    };

{% if is_multi_output %}
    // Predict the label of each output:
    this.predict = function(features) {
        var offset = 0;
        return this.predictIndex(features).map(function(idx, j) {
            var label = LABELS[offset + idx];
            offset += outputClasses[j];
            return label;
        });
    };
{% else %}
    this.predict = function(features) {
        return LABELS[this.predictIndex(features)];
    };
{% endif %}
};

{% include 'samples' %}

{% if pipeline_classes %}
{{ pipeline_classes }}

{% endif %}
var main = function () {
    if (process.argv.length < 3) {
        throw new Error("You have to pass the path to the model data.");
    }

    {% if pipeline_create %}
    {{ pipeline_create | indent('    ') }}

    {% endif %}
    // Model data:
    var json = process.argv[2];

    // Estimator:
    var clf = new {{ class_name }}(json);

    // Features of one sample (arguments) or several samples (standard input):
    readSamples(process.argv.slice(3)).forEach(function (features) {
        {% if pipeline_transform %}
        {{ pipeline_transform | indent('        ') }}
        {% endif %}
        {% if is_test or to_json %}
        // Get JSON:
        console.log(JSON.stringify({
            "predict": clf.predict(features),
            "predict_proba": clf.predictProba(features)
        }));
        {% else %}
        // Get class prediction:
        var prediction = clf.predict(features);
        console.log("{{ 'Predicted classes: ' if is_multi_output else 'Predicted class: ' }}" + prediction);

        // Get class probabilities:
        var probabilities = clf.predictProba(features);
        for (var i = 0; i < probabilities.length; i++) {
            console.log("{{ 'Probabilities of output #' if is_multi_output else 'Probability of class #' }}" + i + " : " + probabilities[i]);
        }
        {% endif %}
    });
}

if (require.main === module) {
    main();
}
{% endblock %}