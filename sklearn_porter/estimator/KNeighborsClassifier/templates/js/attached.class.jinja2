{% extends 'base.attached.class' %}

{% block content %}
var {{ class_name }} = function(X, y, k, n, metric, power) {

    this.X = X;
    this.y = y;
    this.k = k;
    this.n = n;
    this.metric = metric;
    this.power = power;

    var Neighbor = function(y, dist) {
        this.y = y;
        this.dist = dist;
    };

{% if is_multi_output %}
    // The classes of all outputs are concatenated, these are their numbers:
    var outputClasses = [{{ output_classes | join(', ') }}];

    // Find the class with the maximum probability of each output:
    var findMax = function(probas) {
        return probas.map(function(nums) {
            var idx = 0;
            for (var i = 1; i < nums.length; i++) {
                idx = nums[i] > nums[idx] ? i : idx;
            }
            return idx;
        });
    };
    // Split the concatenated values into the values of each output:
    var _splitOutputs = function(nums) {
        var result = [], offset = 0;
        outputClasses.forEach(function(n) {
            result.push(nums.slice(offset, offset + n));
            offset += n;
        });
        return result;
    };
{% else %}
    var findMax = function(nums) {
        var i = 0, l = nums.length, idx = 0;
        for (; i < l; i++) {
            idx = nums[i] > nums[idx] ? i : idx;
        }
        return idx;
    };
{% endif %}

    // Compute the distance with the metric `minkowski`, `chebyshev`, `cosine` or `hamming`:
    var compute = function(temp, cand, metric, q) {
        var dist = 0., diff, i, l = temp.length;
        if (metric === 'chebyshev') {
            for (i = 0; i < l; i++) {
                dist = Math.max(dist, Math.abs(temp[i] - cand[i]));
            }
            return dist;
        }
        if (metric === 'cosine') {
            var dot = 0., normTemp = 0., normCand = 0.;
            for (i = 0; i < l; i++) {
                dot += temp[i] * cand[i];
                normTemp += temp[i] * temp[i];
                normCand += cand[i] * cand[i];
            }
            // The distance to a zero vector is 1 like in scikit-learn:
            if (normTemp === 0 || normCand === 0) {
                return 1.;
            }
            dist = 1. - dot / (Math.sqrt(normTemp) * Math.sqrt(normCand));
            return Math.min(Math.max(dist, 0.), 2.);
        }
        if (metric === 'hamming') {
            for (i = 0; i < l; i++) {
                if (temp[i] !== cand[i]) {
                    dist += 1.;
                }
            }
            return dist / l;
        }
        for (i = 0; i < l; i++) {
            diff = Math.abs(temp[i] - cand[i]);
            if (q === 1) {
                dist += diff;
            } else if (q === 2) {
                dist += diff * diff;
            } else {
                dist += Math.pow(diff, q);
            }
        }
        if (q === 1) {
            return dist;
        } else if (q === 2) {
            return Math.sqrt(dist);
        }
        return Math.pow(dist, 1. / q);
    };

    this.predict = function(features) {
        var classProbas = this.predictProba(features);
        return findMax(classProbas);
    };

{% if is_multi_output %}
    this.predictProba = function(features) {
        var classProbas = new Array(this.n).fill(0);
        var i, j, dists = [];
        for (i = 0; i < this.X.length; i++) {
            // The neighbors store the index of the sample:
            dists.push(new Neighbor(i, compute(this.X[i], features, this.metric, this.power)));
        }
        dists.sort(function compare(n1, n2) {
            return n1.dist - n2.dist;
        });
        // Each neighbor votes for one class of each output:
        var nOutputs = this.y.length / this.X.length;
        for (i = 0; i < this.k; i++) {
            for (j = 0; j < nOutputs; j++) {
                classProbas[this.y[dists[i].y * nOutputs + j]] += 1;
            }
        }
        for (i = 0; i < this.n; i++) {
            classProbas[i] /= this.k;
        }
        return _splitOutputs(classProbas);
    };
{% else %}
    this.predictProba = function(features) {
        var classProbas = new Array(this.n).fill(0);
        var i, dist;
        if (this.k === 1) {
            var classIdx = 0,
                minDist = Number.POSITIVE_INFINITY;
            for (i = 0; i < this.y.length; i++) {
                dist = compute(this.X[i], features, this.metric, this.power);
                if (dist <= minDist) {
                    minDist = dist;
                    classIdx = this.y[i];
                }
            }
            classProbas[classIdx] = 1;
        } else {
            var dists = [];
            for (i = 0; i < this.y.length; i++) {
                dist = compute(this.X[i], features, this.metric, this.power);
                dists.push(new Neighbor(this.y[i], dist));
            }
            dists.sort(function compare(n1, n2) {
                return (n1.dist < n2.dist) ? -1 : 1;
            });
            for (i = 0; i < this.k; i++) {
                classProbas[dists[i].y] += 1;
            }
            for (i = 0; i < this.n; i++) {
                classProbas[i] /= this.k;
            }
        }
        return classProbas;
    };
{% endif %}

};

var main = function () {
    if (typeof process !== 'undefined' && typeof process.argv !== 'undefined') {
        if (process.argv.length - 2 !== {{ n_features }}) {
            var IllegalArgumentException = function(message) {
                this.message = message;
                this.name = "IllegalArgumentException";
            }
            throw new IllegalArgumentException("You have to pass {{ n_features }} features.");
        }
    }

    // Features:
    var features = process.argv.slice(2);
    for (var i = 0; i < features.length; i++) {
        features[i] = parseFloat(features[i]);
    }

    // Model data:
    {{ X }}
    {{ y }}

    // Estimator:
    var clf = new {{ class_name }}(X, y, {{ k }}, {{ n }}, "{{ metric }}", {{ power }});

    {% if is_test or to_json %}
    // Get JSON:
    console.log(JSON.stringify({
        "predict": clf.predict(features),
        "predict_proba": clf.predictProba(features)
    }));
    {% else %}
    // Get class prediction:
    var prediction = clf.predict(features);
    console.log("{{ 'Predicted classes: ' if is_multi_output else 'Predicted class: #' }}" + prediction);

    // Get class probabilities:
    var probabilities = clf.predictProba(features);
    for (var i = 0; i < probabilities.length; i++) {
        console.log("{{ 'Probabilities of output #' if is_multi_output else 'Probability of class #' }}" + i + " : " + probabilities[i]);
    }
    {% endif %}

}

if (require.main === module) {
    main();
}
{% endblock %}