{% extends 'base.exported.class' %}

{% block content %}
class {{ class_name }} {

    private $data;
    private $X;
    private $y;
    private $k;
    private $n;
    private $metric;
    private $power;

    public function __construct($path) {
        $this->data = json_decode(file_get_contents($path, true), true);

        $this->X = $this->data['X'];
        $this->y = $this->data['y'];
        $this->k = $this->data['k'];
        $this->n = $this->data['n'];
        $this->metric = $this->data['metric'];
        $this->power = $this->data['power'];
    }

{% if is_multi_output %}
    // The classes of all outputs are concatenated, these are their numbers:
    const OUTPUT_CLASSES = [{{ output_classes | join(', ') }}];

    // Find the class with the maximum probability of each output:
    private function findMax($nums) {
        $result = [];
        foreach ($nums as $probas) {
            $idx = 0;
            for ($i = 1; $i < count($probas); $i++) {
                $idx = $probas[$i] > $probas[$idx] ? $i : $idx;
            }
            $result[] = $idx;
        }
        return $result;
    }

    // Split the concatenated values into the values of each output:
    private function splitOutputs($nums) {
        $result = [];
        $offset = 0;
        foreach (self::OUTPUT_CLASSES as $n) {
            $result[] = array_slice($nums, $offset, $n);
            $offset += $n;
        }
        return $result;
    }
{% else %}
    private function findMax($nums) {
        $i = 0; $l = count($nums); $idx = 0;
        for (; $i < $l; $i++) {
            $idx = $nums[$i] > $nums[$idx] ? $i : $idx;
        }
        return $idx;
    }
{% endif %}

    // Compute the distance with the metric `minkowski`, `chebyshev`, `cosine` or `hamming`:
    private function compute($temp, $cand, $metric, $q) {
        $dist = 0.;
        $l = count($temp);
        if ($metric == 'chebyshev') {
            for ($i = 0; $i < $l; $i++) {
                $dist = max($dist, abs($temp[$i] - $cand[$i]));
            }
            return $dist;
        }
        if ($metric == 'cosine') {
            $dot = 0.; $normTemp = 0.; $normCand = 0.;
            for ($i = 0; $i < $l; $i++) {
                $dot += $temp[$i] * $cand[$i];
                $normTemp += $temp[$i] * $temp[$i];
                $normCand += $cand[$i] * $cand[$i];
            }
            // The distance to a zero vector is 1 like in scikit-learn:
            if ($normTemp == 0 || $normCand == 0) {
                return 1.;
            }
            $dist = 1. - $dot / (sqrt($normTemp) * sqrt($normCand));
            return min(max($dist, 0.), 2.);
        }
        if ($metric == 'hamming') {
            for ($i = 0; $i < $l; $i++) {
                if ($temp[$i] != $cand[$i]) {
                    $dist += 1.;
                }
            }
            return $dist / $l;
        }
        for ($i = 0; $i < $l; $i++) {
            $diff = abs($temp[$i] - $cand[$i]);
            if ($q == 1) {
                $dist += $diff;
            } else if ($q == 2) {
                $dist += $diff * $diff;
            } else {
                $dist += pow($diff, $q);
            }
        }
        if ($q == 1) {
            return $dist;
        } else if ($q == 2) {
            return sqrt($dist);
        }
        return pow($dist, 1. / $q);
    }

    // Find the k nearest neighbors (index and distance) sorted by distance and
    // index (like a stable sort). A sample is only inserted if it's nearer
    // than the k-th neighbor:
    private function findNeighbors($features) {
        $neighbors = array();
        $n = 0;
        for ($i = 0; $i < count($this->X); $i++) {
            $dist = $this->compute($this->X[$i], $features, $this->metric, $this->power);
            if ($n == $this->k && !($dist < $neighbors[$this->k - 1][1])) {
                continue;
            }
            $j = $n < $this->k ? $n++ : $this->k - 1;
            while ($j > 0 && $dist < $neighbors[$j - 1][1]) {
                $neighbors[$j] = $neighbors[$j - 1];
                $j--;
            }
            $neighbors[$j] = array($i, $dist);
        }
        return $neighbors;
    }

{% include 'labels' %}

    public function predictIndex($features) {
        $classProbas = $this->predictProba($features);
        return $this->findMax($classProbas);
    }

{% if is_multi_output %}
    // Predict the label of each output:
    public function predict($features) {
        $labels = array();
        $offset = 0;
        foreach ($this->predictIndex($features) as $j => $idx) {
            $labels[] = self::LABELS[$offset + $idx];
            $offset += self::OUTPUT_CLASSES[$j];
        }
        return $labels;
    }
{% else %}
    public function predict($features) {
        return self::LABELS[$this->predictIndex($features)];
    }
{% endif %}

{% if weights == 'distance' %}
    // Weight the nearest neighbors by the inverse of their distances. If some
    // neighbors have the distance 0, only they get the weight 1 (like scikit-learn):
    private function weigh($neighbors, $k) {
        $weights = array();
        $isExact = false;
        for ($i = 0; $i < $k; $i++) {
            // `fdiv` returns INF instead of an error for the distance 0:
            $weights[] = fdiv(1., $neighbors[$i][1]);
            if (is_infinite($weights[$i])) {
                $isExact = true;
            }
        }
        if ($isExact) {
            for ($i = 0; $i < $k; $i++) {
                $weights[$i] = is_infinite($weights[$i]) ? 1. : 0.;
            }
        }
        return $weights;
    }

{% endif %}
{% if is_multi_output %}
    public function predictProba($features) {
        $classProbas = array_fill(0, $this->n, 0);
        $neighbors = $this->findNeighbors($features);
        $nOutputs = intdiv(count($this->y), count($this->X));
{% if weights == 'distance' %}
        // Each neighbor votes with its weight for one class of each output:
        $weights = $this->weigh($neighbors, $this->k);
        $total = 0.;
        for ($i = 0; $i < $this->k; $i++) {
            $total += $weights[$i];
            for ($j = 0; $j < $nOutputs; $j++) {
                $classProbas[$this->y[$neighbors[$i][0] * $nOutputs + $j]] += $weights[$i];
            }
        }
        for ($i = 0; $i < $this->n; $i++) {
            $classProbas[$i] /= $total;
        }
{% else %}
        // Each neighbor votes for one class of each output:
        for ($i = 0; $i < $this->k; $i++) {
            for ($j = 0; $j < $nOutputs; $j++) {
                $classProbas[$this->y[$neighbors[$i][0] * $nOutputs + $j]] += 1;
            }
        }
        for ($i = 0; $i < $this->n; $i++) {
            $classProbas[$i] /= $this->k;
        }
{% endif %}
        return $this->splitOutputs($classProbas);
    }
{% else %}
    public function predictProba($features) {
        $classProbas = array_fill(0, $this->n, 0);
        $neighbors = $this->findNeighbors($features);
{% if weights == 'distance' %}
        $weights = $this->weigh($neighbors, $this->k);
        $total = 0.;
        for ($i = 0; $i < $this->k; $i++) {
            $total += $weights[$i];
            $classProbas[$this->y[$neighbors[$i][0]]] += $weights[$i];
        }
        for ($i = 0; $i < $this->n; $i++) {
            $classProbas[$i] /= $total;
        }
{% else %}
        for ($i = 0; $i < $this->k; $i++) {
            $classProbas[$this->y[$neighbors[$i][0]]] += 1;
        }
        for ($i = 0; $i < $this->n; $i++) {
            $classProbas[$i] /= $this->k;
        }
{% endif %}
        return $classProbas;
    }
{% endif %}

}

if (PHP_SAPI === 'cli' && realpath($argv[0]) === __FILE__) {
    {% filter indent(4, True) %}
    {% include 'samples' %}
    {% endfilter %}

    if (count($argv) < 2) {
        fwrite(STDERR, "You have to pass the path to the model data.\n");
        exit(1);
    }

    array_shift($argv);

    // Model data:
    $path = array_shift($argv);

    // Estimator:
    $clf = new {{ class_name }}($path);

    // Features of one sample (arguments) or several samples (standard input):
    foreach (readSamples($argv) as $features) {
        {% if is_test or to_json %}
        // Get JSON:
        $prediction = $clf->predict($features);
        $probabilities = $clf->predictProba($features);
        fwrite(STDOUT, json_encode(array("predict" => $prediction, "predict_proba" => $probabilities)) . "\n");
        {% else %}
        // Get class prediction:
        $prediction = $clf->predict($features);
        fwrite(STDOUT, "{{ 'Predicted classes: ' if is_multi_output else 'Predicted class: ' }}" . {{ "implode(', ', $prediction)" if is_multi_output else 'strval($prediction)' }} . "\n");

        // Get class probabilities:
        $probabilities = $clf->predictProba($features);
        for ($i = 0; $i < count($probabilities); $i++) {
            fwrite(STDOUT, "{{ 'Probabilities of output #' if is_multi_output else 'Probability of class #' }}" . strval($i) . " = " . {{ "implode(', ', $probabilities[$i])" if is_multi_output else 'strval($probabilities[$i])' }} . "\n");
        }
        {% endif %}
    }
}
{% endblock %}