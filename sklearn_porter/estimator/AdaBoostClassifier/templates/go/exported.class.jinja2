{% extends 'base.exported.class' %}

{% block content %}
package main

import (
	"encoding/json"
	"fmt"
	"math"
	"os"
	"strconv"
)

{% if is_test or to_json %}
type Response struct {
	Predict int `json:"predict"`
	PredictProba []float64 `json:"predict_proba"`
}

{% endif %}
type {{ class_name }} struct {
	Trees []{{ class_name }}Tree
}

type {{ class_name }}Tree struct {
	Lefts []int `json:"lefts"`
	Rights []int `json:"rights"`
	Thresholds []float64 `json:"thresholds"`
	Indices []int `json:"indices"`
	Classes [][]float64 `json:"classes"`
	Weight float64 `json:"weight"`
}

func findMax(nums []float64) int {
	var idx = 0
	for i := 0; i < len(nums); i++ {
		if nums[i] > nums[idx] {
			idx = i
		}
	}
	return idx
}

func (tree {{ class_name }}Tree) Compute(features []float64) int {
	var node = 0
	for tree.Thresholds[node] != -2 {
		if features[tree.Indices[node]] <= tree.Thresholds[node] {
			node = tree.Lefts[node]
		} else {
			node = tree.Rights[node]
		}
	}
	return findMax(tree.Classes[node])
}

func (forest {{ class_name }}) PredictProba(features []float64) []float64 {
	var nClasses = len(forest.Trees[0].Classes[0])
	var probas = make([]float64, nClasses)
	var sumWeights, sum float64
	// Weighted votes of all trees (SAMME):
	for _, tree := range forest.Trees {
		probas[tree.Compute(features)] += tree.Weight
		sumWeights += tree.Weight
	}
	// Softmax of the decision values, see `AdaBoostClassifier.decision_function`:
	var n = float64(nClasses)
	for i := 0; i < nClasses; i++ {
		probas[i] = math.Exp(probas[i] * n / (sumWeights * (n - 1) * (n - 1)))
		sum += probas[i]
	}
	for i := 0; i < nClasses; i++ {
		probas[i] /= sum
	}
	return probas
}

func (forest {{ class_name }}) Predict(features []float64) int {
	return findMax(forest.PredictProba(features))
}

func main() {

	if len(os.Args) != {{ n_features + 2 }} {
		fmt.Fprintln(os.Stderr, "You have to pass the path to the model data and {{ n_features }} features.")
		os.Exit(1)
	}

	// Features:
	var features []float64
	for _, arg := range os.Args[2:] {
		if n, err := strconv.ParseFloat(arg, 64); err == nil {
			features = append(features, n)
		}
	}

	// Model data:
	modelData, err := os.ReadFile(os.Args[1])
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}

	// Estimator:
	var clf {{ class_name }}
	if err := json.Unmarshal(modelData, &clf.Trees); err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}

	{% if is_test or to_json %}
	// Get JSON:
	prediction := clf.Predict(features)
	probabilities := clf.PredictProba(features)
	res, _ := json.Marshal(&Response{Predict: prediction, PredictProba: probabilities})
	fmt.Println(string(res))
	{% else %}
	// Get class prediction:
	prediction := clf.Predict(features)
	fmt.Printf("Predicted class: #%d\n", prediction)

	// Get class probabilities:
	probabilities := clf.PredictProba(features)
	for i, probability := range probabilities {
		fmt.Printf("Probability of class #%d : %f\n", i, probability)
	}
	{% endif %}

}
{% endblock %}
