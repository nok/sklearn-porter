{% extends 'base.combined.class' %}

{% block content %}
{% if is_test or to_json %}
require 'json'

{% endif %}
class {{ class_name }}

	def _find_max(nums)
		idx = 0
		for i in 0 ... nums.length
			idx = nums[i] > nums[idx] ? i : idx
		end
		idx
	end

	{{ method | indent('\t') }}

	# The labels of the classes:
	LABELS = [{{ label_values }}]

	def predict_index(features)
		_find_max(predict_proba(features))
	end

	def predict(features)
		LABELS[predict_index features]
	end

end

if __FILE__ == $0
	{% filter indent('\t', True) %}
	{% include 'samples' %}
	{% endfilter %}

	# Estimator:
	clf = {{ class_name }}.new

	# Features of one sample (arguments) or several samples (standard input):
	read_samples(ARGV) do |features|
		{% if is_test or to_json %}
		# Get JSON:
		prediction = clf.predict features
		probabilities = clf.predict_proba features
		puts JSON.generate({:predict => prediction, :predict_proba => probabilities})
		{% else %}
		# Get class prediction:
		prediction = clf.predict features
		puts "Predicted class: #{prediction}"

		# Get class probabilities:
		probabilities = clf.predict_proba features
		for i in 0 ... probabilities.length
			puts "Probability of class ##{i} : #{probabilities[i]}"
		end
		{% endif %}
	end
end
{% endblock %}
