{% extends 'base.combined.class' %}

{% block content %}
var {{ class_name }} = function() {
    var that = this;

    var _findMax = function(nums) {
        var idx = 0;
        for (var i = 0, l = nums.length; i < l; i++) {
            idx = nums[i] > nums[idx] ? i : idx;
        }
        return idx;
    };

    that.forest = [];

{% include 'labels' %}

    {{ method }}
};

{% include 'samples' %}

{% if pipeline_classes %}
{{ pipeline_classes }}

{% endif %}
var main = function () {
    // Estimator:
    var clf = new {{ class_name }}();

    // Features of one sample (arguments) or several samples (standard input):
    {% if pipeline_create %}
    {{ pipeline_create | indent('    ') }}

    {% endif %}
    readSamples(process.argv.slice(2)).forEach(function (features) {
        {% if pipeline_transform %}
        {{ pipeline_transform | indent('        ') }}
        {% endif %}
        {% if is_test or to_json %}
        // Get JSON:
        console.log(JSON.stringify({
            "predict": clf.predict(features),
            "predict_proba": clf.predictProba(features)
        }));
        {% else %}
        // Get class prediction:
        var prediction = clf.predict(features);
        console.log("Predicted class: " + prediction);

        // Get class probabilities:
        var probabilities = clf.predictProba(features);
        for (var i = 0; i < probabilities.length; i++) {
            console.log("Probability of class #" + i + " : " + probabilities[i]);
        }
        {% endif %}
    });
}

if (require.main === module) {
    main();
}
{% endblock %}