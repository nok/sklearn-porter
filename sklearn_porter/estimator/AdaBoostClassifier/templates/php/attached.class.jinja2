{% extends 'base.attached.class' %}

{% block content %}
namespace {
    class {{ class_name }} {

        private $forest;

        public function __construct($model) {
            $this->forest = array();
            foreach ($model as $tree) {
                array_push($this->forest, new {{ class_name }}\Tree(
                    $tree['lefts'], $tree['rights'],
                    $tree['thresholds'], $tree['indices'],
                    $tree['classes'], $tree['weight']
                ));
            }
        }

        public static function findMax($nums) {
            $idx = 0;
            for ($i = 0, $l = count($nums); $i < $l; $i++) {
                $idx = $nums[$i] > $nums[$idx] ? $i : $idx;
            }
            return $idx;
        }

        public function predictProba($features) {
            $nClasses = {{ n_classes }};
            $probas = array_fill(0, $nClasses, 0.);
            $sumWeights = 0.;
            $sum = 0.;
            // Weighted votes of all trees (SAMME):
            foreach ($this->forest as $tree) {
                $probas[$tree->compute($features)] += $tree->weight;
                $sumWeights += $tree->weight;
            }
            // Softmax of the decision values, see `AdaBoostClassifier.decision_function`:
            for ($i = 0; $i < $nClasses; $i++) {
                $probas[$i] = exp($probas[$i] * $nClasses / ($sumWeights * ($nClasses - 1) * ($nClasses - 1)));
                $sum += $probas[$i];
            }
            for ($i = 0; $i < $nClasses; $i++) {
                $probas[$i] /= $sum;
            }
            return $probas;
        }

        // The labels of the classes:
        const LABELS = [{{ label_values }}];

        public function predictIndex($features) {
            return self::findMax($this->predictProba($features));
        }

        public function predict($features) {
            return self::LABELS[$this->predictIndex($features)];
        }

    }
}

namespace {{ class_name }} {
    class Tree {

        public $lefts;
        public $rights;
        public $thresholds;
        public $indices;
        public $classes;
        public $weight;

        public function __construct($lefts, $rights, $thresholds, $indices, $classes, $weight) {
            $this->lefts = $lefts;
            $this->rights = $rights;
            $this->thresholds = $thresholds;
            $this->indices = $indices;
            $this->classes = $classes;
            $this->weight = $weight;
        }

        public function compute($features) {
            $node = 0;
            while ($node >= 0) {
                if ($features[$this->indices[$node]] <= $this->thresholds[$node]) {
                    $node = $this->lefts[$node];
                } else {
                    $node = $this->rights[$node];
                }
            }
            return \{{ class_name }}::findMax(array_slice($this->classes, (-$node - 1) * {{ n_classes }}, {{ n_classes }}));
        }
    }
}

namespace {
    if (PHP_SAPI === 'cli' && realpath($argv[0]) === __FILE__) {
        {% filter indent(8, True) %}
        {% include 'samples' %}
        {% endfilter %}

        array_shift($argv);

        // Model data:
        {{ model }}

        // Estimator:
        $clf = new {{ class_name }}($model);

        // Features of one sample (arguments) or several samples (standard input):
        foreach (readSamples($argv) as $features) {
            {% if is_test or to_json %}
            // Get JSON:
            $prediction = $clf->predict($features);
            $probabilities = $clf->predictProba($features);
            fwrite(STDOUT, json_encode(array("predict" => $prediction, "predict_proba" => $probabilities)) . "\n");
            {% else %}
            // Get class prediction:
            $prediction = $clf->predict($features);
            fwrite(STDOUT, "Predicted class: " . strval($prediction) . "\n");

            // Get class probabilities:
            $probabilities = $clf->predictProba($features);
            for ($i = 0; $i < count($probabilities); $i++) {
                fwrite(STDOUT, "Probability of class #" . strval($i) . " = " . strval($probabilities[$i]) . "\n");
            }
            {% endif %}
        }

    }
}
{% endblock %}
