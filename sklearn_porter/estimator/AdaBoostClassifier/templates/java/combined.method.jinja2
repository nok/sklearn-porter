public static double[] predictProba(double[] features) {
    int nClasses = {{ n_classes }};
    double[] weights = {{ '{' }}{{ weights[1:-1] }}{{ '}' }};
    double[] probas = new double[nClasses];
    double sumWeights = 0., sum = 0.;
    // Weighted votes of all trees (SAMME):
    {{ method_calls }}
    for (double weight : weights) {
        sumWeights += weight;
    }
    // Softmax of the decision values, see `AdaBoostClassifier.decision_function`:
    for (int i = 0; i < nClasses; i++) {
        probas[i] = Math.exp(probas[i] * nClasses / (sumWeights * (nClasses - 1) * (nClasses - 1)));
        sum += probas[i];
    }
    for (int i = 0; i < nClasses; i++) {
        probas[i] /= sum;
    }
    return probas;
}

public static int predict(double[] features) {
    return {{ class_name }}.findMax({{ class_name }}.predictProba(features));
}
