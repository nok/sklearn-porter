{% extends 'base.combined.class' %}

{% block content %}
{% if is_test or to_json %}
import java.util.Arrays;

{% endif %}
class {{ class_name }} {

    private static int findMax(double[] nums) {
        int idx = 0;
        for (int i = 1; i < nums.length; i++) {
            idx = nums[i] > nums[idx] ? i : idx;
        }
        return idx;
    }

{% include 'labels' %}

    {{ method }}

    public static void main(String[] args) {
        int nFeatures = {{ n_features }};
        if (args.length != nFeatures) {
            throw new IllegalArgumentException("You have to pass " +  String.valueOf(nFeatures) + " features.");
        }

        // Features:
        double[] features = new double[args.length];
        for (int i = 0, l = args.length; i < l; i++) {
            features[i] = Double.parseDouble(args[i]);
        }

        {% if is_test or to_json %}
        // Get JSON:
        {{ label_type }} prediction = {{ class_name }}.predict(features);
        double[] probabilities = {{ class_name }}.predictProba(features);
        System.out.println("{\"predict\": " + toJson(prediction) + ", \"predict_proba\": " + String.join(",", Arrays.toString(probabilities)) + "}");
        {% else %}
        // Get class prediction:
        {{ label_type }} prediction = {{ class_name }}.predict(features);
        System.out.println("Predicted class: " + prediction);

        // Get class probabilities:
        double[] probabilities = {{ class_name }}.predictProba(features);
        for (int i = 0; i < probabilities.length; i++) {
            System.out.println("Probability of class #" + i + " : " + String.valueOf(probabilities[i]));
        }
        {% endif %}
    }

}
{% endblock %}
