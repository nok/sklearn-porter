{% extends 'base.attached.class' %}

{% block content %}
{% if is_test or to_json %}
import java.util.Arrays;

{% endif %}
class {{ class_name }} {

    private static class Tree {
        private int[] lefts;
        private int[] rights;
        private double[] thresholds;
        private int[] indices;
        private double[] classes;
        private double weight;

        private Tree(int[] lefts, int[] rights, double[] thresholds, int[] indices, double[] classes, double weight) {
            this.lefts = lefts;
            this.rights = rights;
            this.thresholds = thresholds;
            this.indices = indices;
            this.classes = classes;
            this.weight = weight;
        }

        private int compute(double[] features) {
            int node = 0;
            while (node >= 0) {
                if (features[this.indices[node]] <= this.thresholds[node]) {
                    node = this.lefts[node];
                } else {
                    node = this.rights[node];
                }
            }
            // Find the class with the maximum fraction of the leaf:
            int start = (-node - 1) * {{ n_classes }};
            int idx = 0;
            for (int i = 1; i < {{ n_classes }}; i++) {
                idx = this.classes[start + i] > this.classes[start + idx] ? i : idx;
            }
            return idx;
        }
    }

    private Tree[] forest;

    public {{ class_name }}(Tree[] forest) {
        this.forest = forest;
    }

    private static int findMax(double[] nums) {
        int idx = 0;
        for (int i = 1; i < nums.length; i++) {
            idx = nums[i] > nums[idx] ? i : idx;
        }
        return idx;
    }

    public double[] predictProba(double[] features) {
        int nClasses = {{ n_classes }};
        double[] probas = new double[nClasses];
        double sumWeights = 0., sum = 0.;
        // Weighted votes of all trees (SAMME):
        for (Tree tree : this.forest) {
            probas[tree.compute(features)] += tree.weight;
            sumWeights += tree.weight;
        }
        // Softmax of the decision values, see `AdaBoostClassifier.decision_function`:
        for (int i = 0; i < nClasses; i++) {
            probas[i] = Math.exp(probas[i] * nClasses / (sumWeights * (nClasses - 1) * (nClasses - 1)));
            sum += probas[i];
        }
        for (int i = 0; i < nClasses; i++) {
            probas[i] /= sum;
        }
        return probas;
    }

{% include 'labels' %}

    public int predictIndex(double[] features) {
        return findMax(this.predictProba(features));
    }

    public {{ label_type }} predict(double[] features) {
        return LABELS[this.predictIndex(features)];
    }

    // Model data:
    {{ model | indent(4) }}

{% include 'samples' %}

    public static void main(String[] args) {
        // Estimator:
        Tree[] forest = {
            {% for i in range(n_estimators) %}
            tree{{ i }}(){% if not loop.last %},{% endif %}

            {% endfor %}
        };
        {{ class_name }} clf = new {{ class_name }}(forest);

        // Features of one sample (arguments) or several samples (standard input):
        for (double[] features : readSamples(args, 0)) {
            {% if is_test or to_json %}
            // Get JSON:
            {{ label_type }} prediction = clf.predict(features);
            double[] probabilities = clf.predictProba(features);
            System.out.println("{\"predict\": " + toJson(prediction) + ", \"predict_proba\": " + String.join(",", Arrays.toString(probabilities)) + "}");
            {% else %}
            // Get class prediction:
            {{ label_type }} prediction = clf.predict(features);
            System.out.println("Predicted class: " + prediction);

            // Get class probabilities:
            double[] probabilities = clf.predictProba(features);
            for (int i = 0; i < probabilities.length; i++) {
                System.out.println("Probability of class #" + i + " : " + String.valueOf(probabilities[i]));
            }
            {% endif %}
        }

    }
}
{% endblock %}
