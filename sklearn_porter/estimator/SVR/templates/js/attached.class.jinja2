{% extends 'base.attached.class' %}

{% block content %}
var {{ class_name }} = function(vectors, coeffs, inter, kernel, gamma, coef0, degree) {
    this.vectors = vectors;
    this.coeffs = coeffs;
    this.inter = inter;
    this.kernel = kernel.toUpperCase();
    this.gamma = gamma;
    this.coef0 = coef0;
    this.degree = degree;

{% include 'kernel' %}
};

{% include 'samples' %}

var main = function () {
    // Model data:
    {{ vectors }}
    {{ coeffs }}

    // Estimator:
    var est = new {{ class_name }}(vectors, coeffs, {{ inter }}, "{{ kernel }}", {{ gamma }}, {{ coef0 }}, {{ degree }});

    // Features of one sample (arguments) or several samples (standard input):
    readSamples(process.argv.slice(2)).forEach(function (features) {
        var prediction = est.predict(features);

        {% filter indent(8, True) %}
        {% include 'output' %}
        {% endfilter %}
    });
}

if (require.main === module) {
    main();
}
{% endblock %}
