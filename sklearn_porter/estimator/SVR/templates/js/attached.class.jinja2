{% extends 'base.attached.class' %}

{% block content %}
var {{ class_name }} = function(vectors, coeffs, inter, kernel, gamma, coef0, degree) {
    this.vectors = vectors;
    this.coeffs = coeffs;
    this.inter = inter;
    this.kernel = kernel.toUpperCase();
    this.gamma = gamma;
    this.coef0 = coef0;
    this.degree = degree;

{% include 'kernel' %}
};

{% include 'samples' %}

{% if pipeline_classes %}
{{ pipeline_classes }}

{% endif %}
// Create the estimator with the model data of this file:
var createEstimator = function () {
    // Model data:
    {{ vectors }}
    {{ coeffs }}

    return new {{ class_name }}(vectors, coeffs, {{ inter }}, "{{ kernel }}", {{ gamma }}, {{ coef0 }}, {{ degree }});
};

var main = function () {
    {% if pipeline_create %}
    {{ pipeline_create | indent('    ') }}

    {% endif %}
    // Estimator:
    var est = createEstimator();

    // Features of one sample (arguments) or several samples (standard input):
    readSamples(process.argv.slice(2)).forEach(function (features) {
        {% if pipeline_transform %}
        {{ pipeline_transform | indent('        ') }}
        {% endif %}
        var prediction = est.predict(features);

        {% filter indent(8, True) %}
        {% include 'output' %}
        {% endfilter %}
    });
}
{% endblock %}
