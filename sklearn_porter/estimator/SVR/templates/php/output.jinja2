{% if is_test or to_json %}
// Get JSON:
fwrite(STDOUT, json_encode(array("predict" => $prediction)) . "\n");
{% elif is_outlier_detector %}
// Get prediction (1: inlier, -1: outlier):
fwrite(STDOUT, "Prediction: " . strval($prediction) . " (" . ($prediction == 1 ? "inlier" : "outlier") . ")\n");
{% else %}
// Get predicted value:
fwrite(STDOUT, "Predicted value: " . strval($prediction) . "\n");
{% endif %}
