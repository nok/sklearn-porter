{% if is_test or to_json %}
# Get JSON:
puts JSON.generate({:predict => prediction})
{% elif is_outlier_detector %}
# Get prediction (1: inlier, -1: outlier):
puts "Prediction: #{prediction} (#{prediction == 1 ? 'inlier' : 'outlier'})"
{% else %}
# Get predicted value:
puts "Predicted value: #{prediction}"
{% endif %}
