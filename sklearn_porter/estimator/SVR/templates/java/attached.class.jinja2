{% extends 'base.attached.class' %}

{% block content %}
class {{ class_name }} {

    private enum Kernel { LINEAR, POLY, RBF, SIGMOID }

    private double[][] vectors;
    private double[] coeffs;
    private double inter;
    private Kernel kernel;
    private double gamma;
    private double coef0;
    private int degree;

    public {{ class_name }}(double[][] vectors, double[] coeffs, double inter, String kernel, double gamma, double coef0, int degree) {
        this.vectors = vectors;
        this.coeffs = coeffs;
        this.inter = inter;
        this.kernel = Kernel.valueOf(kernel.toUpperCase());
        this.gamma = gamma;
        this.coef0 = coef0;
        this.degree = degree;
    }

{% include 'kernel' %}

{% include 'samples' %}

    // Create the estimator with the model data of this file:
    public static {{ class_name }} create() {
        // Model data:
        {{ vectors }}
        {{ coeffs }}

        return new {{ class_name }}(vectors, coeffs, {{ inter }}, "{{ kernel }}", {{ gamma }}, {{ coef0 }}, {{ degree }});
    }

    public static void main(String[] args) {
        {% if pipeline_create %}
        {{ pipeline_create | indent('        ') }}

        {% endif %}
        // Estimator:
        {% if pipeline %}
        {{ class_name }} est = pipeline.estimator;
        {% else %}
        {{ class_name }} est = {{ class_name }}.create();
        {% endif %}

        // Features of one sample (arguments) or several samples (standard input):
        for (double[] features : readSamples(args, 0)) {
            {% if pipeline_transform %}
            {{ pipeline_transform | indent('            ') }}
            {% endif %}
            {{ 'int' if is_outlier_detector else 'double' }} prediction = est.predict(features);
            {% filter indent(12, True) %}
            {% include 'output' %}
            {% endfilter %}
        }

    }
}
{% if pipeline_classes %}

{{ pipeline_classes }}
{% endif %}
{% endblock %}
