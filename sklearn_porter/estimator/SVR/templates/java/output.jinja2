{% if is_test or to_json %}
// Get JSON:
System.out.println("{\"predict\": " + prediction + "}");
{% elif is_outlier_detector %}
// Get prediction (1: inlier, -1: outlier):
System.out.println("Prediction: " + prediction + " (" + (prediction == 1 ? "inlier" : "outlier") + ")");
{% else %}
// Get predicted value:
System.out.println("Predicted value: " + prediction);
{% endif %}
