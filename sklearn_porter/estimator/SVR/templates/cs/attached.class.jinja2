{% include 'samples' %}


    public static void Main(string[] args) {
        {% if pipeline_create %}
        {{ pipeline_create | indent('        ') }}

        {% endif %}
        // Model data:
        {{ vectors }}
        {{ coeffs }}

        // Estimator:
        {{ class_name }} est = new {{ class_name }}(vectors, coeffs, {{ inter }}, "{{ kernel }}", {{ gamma }}, {{ coef0 }}, {{ degree }});

        // Features of one sample (arguments) or several samples (standard input):
        foreach (double[] features in ReadSamples(args, 0)) {
            {% if pipeline_transform %}
            {{ pipeline_transform | indent('            ') }}
            {% endif %}
            {{ 'int' if is_outlier_detector else 'double' }} prediction = est.Predict(features);
            {% filter indent(12, True) %}
            {% include 'output' %}
            {% endfilter %}
        }
    }
}
