{% extends 'base.attached.class' %}

{% block content %}
using System;
using System.Globalization;


public class {{ class_name }} {

    private enum Kernel { Linear, Poly, Rbf, Sigmoid }

    private double[][] vectors;
    private double[] coeffs;
    private double inter;
    private Kernel kernel;
    private double gamma;
    private double coef0;
    private int degree;

    public {{ class_name }}(double[][] vectors, double[] coeffs, double inter, string kernel, double gamma, double coef0, int degree) {
        this.vectors = vectors;
        this.coeffs = coeffs;
        this.inter = inter;
        this.kernel = (Kernel) Enum.Parse(typeof(Kernel), kernel, true);
        this.gamma = gamma;
        this.coef0 = coef0;
        this.degree = degree;
    }

