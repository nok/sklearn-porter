{% if is_test or to_json %}
Console.WriteLine("{\"predict\": " + ToJson(prediction) + "}");
{% elif is_outlier_detector %}
// Get prediction (1: inlier, -1: outlier):
Console.WriteLine("Prediction: " + prediction + " (" + (prediction == 1 ? "inlier" : "outlier") + ")");
{% else %}
// Get predicted value:
Console.WriteLine("Predicted value: " + prediction.ToString(CultureInfo.InvariantCulture));
{% endif %}
