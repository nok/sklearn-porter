{% if is_multi_output %}
// The classes of all outputs are concatenated, these are their numbers:
var outputClasses = []int{ {{ output_classes | join(', ') }} }

// Find the class with the maximum value of each output:
func findMax(nums []float64) []int {
	result := make([]int, len(outputClasses))
	offset := 0
	for j, n := range outputClasses {
		for i := 1; i < n; i++ {
			if nums[offset+i] > nums[offset+result[j]] {
				result[j] = i
			}
		}
		offset += n
	}
	return result
}
{% else %}
func findMax(nums []float64) int {
	var idx = 0
	for i := 0; i < len(nums); i++ {
		if nums[i] > nums[idx] {
			idx = i
		}
	}
	return idx
}
{% endif %}

{% if is_multi_output %}
// Normalize the values of each output:
func normVals(nums []float64) [][]float64 {
	result := make([][]float64, len(outputClasses))
	offset := 0
	for j, n := range outputClasses {
		sum := 0.0
		for i := 0; i < n; i++ {
			sum += nums[offset+i]
		}
		result[j] = make([]float64, n)
		for i := 0; i < n; i++ {
			if sum == 0 {
				result[j][i] = float64(1) / float64(n)
			} else {
				result[j][i] = float64(nums[offset+i]) / float64(sum)
			}
		}
		offset += n
	}
	return result
}
{% else %}
func normVals(nums []float64) []float64 {
	var l = len(nums)
	var sum = 0.0
	for i := 0; i < l; i++ {
		sum += nums[i]
	}
	result := make([]float64, l)
	if sum == 0 {
		for i := 0; i < l; i++ {
			result[i] = float64(1) / float64(l)
		}
	} else {
		for i := 0; i < l; i++ {
			result[i] = float64(nums[i]) / float64(sum)
		}
	}
	return result
}
{% endif %}

func compute(features []float64) []float64 {
	classes := make([]float64, {{ n_classes }})
	{{ tree | indent(4, True) }}
	return classes
}

func Predict(features []float64) {{ '[]int' if is_multi_output else 'int' }} {
	return findMax(compute(features))
}

func PredictProba(features []float64) {{ '[][]float64' if is_multi_output else '[]float64' }} {
	return normVals(compute(features))
}

