{% extends 'base.exported.class' %}

{% block content %}
package main

import (
	"bufio"
	"encoding/json"
	"fmt"
	"io/ioutil"
	"math"
	"os"
	"strconv"
	"strings"
)

{% include 'labels' %}

type {{ class_name }} struct {
	Lefts []int `json:"lefts"`
	Rights []int `json:"rights"`
	Thresholds []float64 `json:"thresholds"`
	Indices []int `json:"indices"`
	MissingGoToLeft []int `json:"missing_go_to_left"`
	Classes []float64 `json:"classes"`
}
{% if has_infinite_thresholds %}

// UnmarshalJSON parses the infinite thresholds `1e999` and `-1e999`, which
// encoding/json rejects:
func (dtc *{{ class_name }}) UnmarshalJSON(data []byte) error {
	type plain {{ class_name }}
	var aux struct {
		*plain
		Thresholds []json.Number `json:"thresholds"`
	}
	aux.plain = (*plain)(dtc)
	if err := json.Unmarshal(data, &aux); err != nil {
		return err
	}
	dtc.Thresholds = make([]float64, len(aux.Thresholds))
	for i, threshold := range aux.Thresholds {
		// ParseFloat returns ±Inf (and a range error) for these values:
		dtc.Thresholds[i], _ = strconv.ParseFloat(string(threshold), 64)
	}
	return nil
}
{% endif %}

{% if is_test or to_json %}
type Response struct {
	Predict {{ '[]' if is_multi_output }}{{ label_type }} `json:"predict"`
	PredictProba {{ '[][]float64' if is_multi_output else '[]float64' }} `json:"predict_proba"`
}

{% endif %}
{% if is_multi_output %}
// The classes of all outputs are concatenated, these are their numbers:
var outputClasses = []int{ {{ output_classes | join(', ') }} }

// Find the class with the maximum value of each output:
func findMax(nums []float64) []int {
	result := make([]int, len(outputClasses))
	offset := 0
	for j, n := range outputClasses {
		for i := 1; i < n; i++ {
			if nums[offset+i] > nums[offset+result[j]] {
				result[j] = i
			}
		}
		offset += n
	}
	return result
}
{% else %}
func findMax(nums []float64) int {
	var idx = 0
	for i := 0; i < len(nums); i++ {
		if nums[i] > nums[idx] {
			idx = i
		}
	}
	return idx
}
{% endif %}

{% if is_multi_output %}
// Normalize the values of each output:
func normVals(nums []float64) [][]float64 {
	result := make([][]float64, len(outputClasses))
	offset := 0
	for j, n := range outputClasses {
		sum := 0.0
		for i := 0; i < n; i++ {
			sum += nums[offset+i]
		}
		result[j] = make([]float64, n)
		for i := 0; i < n; i++ {
			if sum == 0 {
				result[j][i] = float64(1) / float64(n)
			} else {
				result[j][i] = float64(nums[offset+i]) / float64(sum)
			}
		}
		offset += n
	}
	return result
}
{% else %}
func normVals(nums []float64) []float64 {
	var l = len(nums)
	var sum = 0.0
	for i := 0; i < l; i++ {
		sum += nums[i]
	}
	result := make([]float64, l)
	if sum == 0 {
		for i := 0; i < l; i++ {
			result[i] = float64(1) / float64(l)
		}
	} else {
		for i := 0; i < l; i++ {
			result[i] = float64(nums[i]) / float64(sum)
		}
	}
	return result
}
{% endif %}

// Find the leaf of a sample and get its class fractions:
func (dtc {{ class_name }}) compute(features []float64) []float64 {
	node := 0
	for node >= 0 {
		if features[dtc.Indices[node]] <= dtc.Thresholds[node] || (dtc.MissingGoToLeft[node] == 1 && math.IsNaN(features[dtc.Indices[node]])) {
			node = dtc.Lefts[node]
		} else {
			node = dtc.Rights[node]
		}
	}
	return dtc.Classes[(-node-1)*{{ n_classes }} : -node*{{ n_classes }}]
}

func (dtc {{ class_name }}) PredictIndex(features []float64) {{ '[]int' if is_multi_output else 'int' }} {
	return findMax(dtc.compute(features))
}

{% if is_multi_output %}
// Predict the label of each output:
func (dtc {{ class_name }}) Predict(features []float64) []{{ label_type }} {
	result := make([]{{ label_type }}, len(outputClasses))
	offset := 0
	for j, idx := range dtc.PredictIndex(features) {
		result[j] = labels[offset+idx]
		offset += outputClasses[j]
	}
	return result
}
{% else %}
func (dtc {{ class_name }}) Predict(features []float64) {{ label_type }} {
	return labels[dtc.PredictIndex(features)]
}
{% endif %}

func (dtc {{ class_name }}) PredictProba(features []float64) {{ '[][]float64' if is_multi_output else '[]float64' }} {
	return normVals(dtc.compute(features))
}

{% include 'samples' %}

func main() {
	if len(os.Args) < 2 {
		fmt.Fprintln(os.Stderr, "You have to pass the path to the model data.")
		os.Exit(1)
	}

	// Model data:
	jsonFile, err := os.Open(os.Args[1])
	if err != nil {
		fmt.Println(err)
	}
	defer jsonFile.Close()
	byteValue, _ := ioutil.ReadAll(jsonFile)

	// Estimator:
	var clf {{ class_name }}
	json.Unmarshal(byteValue, &clf)

	// Features of one sample (arguments) or several samples (standard input):
	readSamples(os.Args[2:], func(features []float64) {
		{% if is_test or to_json %}
		// Get JSON:
		prediction := clf.Predict(features)
		probabilities := clf.PredictProba(features)
		res, _ := json.Marshal(&Response{Predict: prediction, PredictProba: probabilities})
		fmt.Println(string(res))
		{% else %}
		// Get class prediction:
		prediction := clf.Predict(features)
		fmt.Printf("{{ 'Predicted classes: ' if is_multi_output else 'Predicted class: ' }}%v\n", prediction)
		probabilities := clf.PredictProba(features)
		for i, probability := range probabilities {
			fmt.Printf("{{ 'Probabilities of output #' if is_multi_output else 'Probability of class #' }}%d : %f\n", i, probability)
		}
		{% endif %}
	})

}
{% endblock %}
