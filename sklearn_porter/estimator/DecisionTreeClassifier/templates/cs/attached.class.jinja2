{% extends 'base.attached.class' %}

{% block content %}
using System;
using System.Globalization;


public class {{ class_name }} {

    private int[] lefts;
    private int[] rights;
    private double[] thresholds;
    private int[] indices;
    private int[] missingGoToLeft;
    private double[] classes;

    public {{ class_name }}(int[] lefts, int[] rights, double[] thresholds, int[] indices, int[] missingGoToLeft, double[] classes) {
        this.lefts = lefts;
        this.rights = rights;
        this.thresholds = thresholds;
        this.indices = indices;
        this.missingGoToLeft = missingGoToLeft;
        this.classes = classes;
    }

{% if is_multi_output %}
    // The classes of all outputs are concatenated, these are their numbers:
    private static readonly int[] OUTPUT_CLASSES = { {{ output_classes | join(', ') }} };

    // Find the class with the maximum value of each output:
    private static int[] FindMax(double[] nums) {
        int[] result = new int[OUTPUT_CLASSES.Length];
        int offset = 0;
        for (int j = 0; j < OUTPUT_CLASSES.Length; j++) {
            for (int i = 1; i < OUTPUT_CLASSES[j]; i++) {
                if (nums[offset + i] > nums[offset + result[j]]) {
                    result[j] = i;
                }
            }
            offset += OUTPUT_CLASSES[j];
        }
        return result;
    }
{% else %}
    private static int FindMax(double[] nums) {
        int idx = 0;
        for (int i = 0; i < nums.Length; i++) {
            idx = nums[i] > nums[idx] ? i : idx;
        }
        return idx;
    }
{% endif %}

{% if is_multi_output %}
    // Split the class fractions into the values of each output:
    private static double[][] CopyVals(double[] nums) {
        double[][] result = new double[OUTPUT_CLASSES.Length][];
        int offset = 0;
        for (int j = 0; j < OUTPUT_CLASSES.Length; j++) {
            result[j] = new double[OUTPUT_CLASSES[j]];
            for (int i = 0; i < OUTPUT_CLASSES[j]; i++) {
                result[j][i] = nums[offset + i];
            }
            offset += OUTPUT_CLASSES[j];
        }
        return result;
    }
{% else %}
    // Copy the class fractions:
    private static double[] CopyVals(double[] nums) {
        return (double[]) nums.Clone();
    }
{% endif %}

    // Find the leaf of a sample and get its class fractions:
    private double[] Compute(double[] features) {
        int node = 0;
        while (node >= 0) {
            if (features[this.indices[node]] <= this.thresholds[node] || (this.missingGoToLeft[node] == 1 && double.IsNaN(features[this.indices[node]]))) {
                node = this.lefts[node];
            } else {
                node = this.rights[node];
            }
        }
        double[] values = new double[{{ n_classes }}];
        Array.Copy(this.classes, (-node - 1) * {{ n_classes }}, values, 0, {{ n_classes }});
        return values;
    }

{% include 'labels' %}


    public {{ 'int[]' if is_multi_output else 'int' }} PredictIndex(double[] features) {
        return FindMax(Compute(features));
    }
{% if is_multi_output %}

    // Predict the label of each output:
    public {{ label_type }}[] Predict(double[] features) {
        int[] idx = PredictIndex(features);
        {{ label_type }}[] result = new {{ label_type }}[idx.Length];
        int offset = 0;
        for (int j = 0; j < idx.Length; j++) {
            result[j] = LABELS[offset + idx[j]];
            offset += OUTPUT_CLASSES[j];
        }
        return result;
    }
{% else %}

    public {{ label_type }} Predict(double[] features) {
        return LABELS[PredictIndex(features)];
    }
{% endif %}

    public {{ 'double[][]' if is_multi_output else 'double[]' }} PredictProba(double[] features) {
        return CopyVals(Compute(features));
    }
{% if is_test or to_json %}

{% include 'json' %}

{% endif %}

{% include 'samples' %}


    public static void Main(string[] args) {
        {% if pipeline_create %}
        {{ pipeline_create | indent('        ') }}

        {% endif %}
        // Model data:
        {{ lefts }}
        {{ rights }}
        {{ thresholds }}
        {{ indices }}
        {{ missing_go_to_left }}
        {{ classes }}

        // Estimator:
        {{ class_name }} clf = new {{ class_name }}(lefts, rights, thresholds, indices, missingGoToLeft, classes);

        // Features of one sample (arguments) or several samples (standard input):
        foreach (double[] features in ReadSamples(args, 0)) {
            {% if pipeline_transform %}
            {{ pipeline_transform | indent('            ') }}
            {% endif %}
            {{ label_type }}{{ '[]' if is_multi_output }} prediction = clf.Predict(features);
            {{ 'double[][]' if is_multi_output else 'double[]' }} probabilities = clf.PredictProba(features);
            {% if is_test or to_json %}
            Console.WriteLine("{\"predict\": " + ToJson(prediction) + ", \"predict_proba\": " + ToJson(probabilities) + "}");
            {% else %}
{% if is_multi_output %}
            Console.WriteLine("Predicted classes: " + string.Join(", ", Array.ConvertAll(prediction, p => Convert.ToString(p, CultureInfo.InvariantCulture))));
            for (int i = 0; i < probabilities.Length; i++) {
                Console.WriteLine("Probabilities of output #" + i + ": " + string.Join(", ", Array.ConvertAll(probabilities[i], p => p.ToString(CultureInfo.InvariantCulture))));
            }
{% else %}
            Console.WriteLine("Predicted class: " + Convert.ToString(prediction, CultureInfo.InvariantCulture));
            for (int i = 0; i < probabilities.Length; i++) {
                Console.WriteLine("Probability of class #" + i + ": " + probabilities[i].ToString(CultureInfo.InvariantCulture));
            }
{% endif %}
            {% endif %}
        }
    }
}
{% if pipeline_classes %}

{{ pipeline_classes }}
{% endif %}
{% endblock %}