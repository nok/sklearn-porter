{% extends 'base.combined.class' %}

{% block content %}
using System;
using System.Globalization;


public static class {{ class_name }} {

    private static double[] Compute(double[] features) {
        double[] classes = new double[{{ n_classes }}];
        {{ tree | indent(4, True) }}
        return classes;
    }

{% if is_multi_output %}
    // The classes of all outputs are concatenated, these are their numbers:
    private static readonly int[] OUTPUT_CLASSES = { {{ output_classes | join(', ') }} };

    // Find the class with the maximum value of each output:
    private static int[] FindMax(double[] nums) {
        int[] result = new int[OUTPUT_CLASSES.Length];
        int offset = 0;
        for (int j = 0; j < OUTPUT_CLASSES.Length; j++) {
            for (int i = 1; i < OUTPUT_CLASSES[j]; i++) {
                if (nums[offset + i] > nums[offset + result[j]]) {
                    result[j] = i;
                }
            }
            offset += OUTPUT_CLASSES[j];
        }
        return result;
    }
{% else %}
    private static int FindMax(double[] nums) {
        int idx = 0;
        for (int i = 0; i < nums.Length; i++) {
            idx = nums[i] > nums[idx] ? i : idx;
        }
        return idx;
    }
{% endif %}

{% if is_multi_output %}
    // Split the class fractions into the values of each output:
    private static double[][] CopyVals(double[] nums) {
        double[][] result = new double[OUTPUT_CLASSES.Length][];
        int offset = 0;
        for (int j = 0; j < OUTPUT_CLASSES.Length; j++) {
            result[j] = new double[OUTPUT_CLASSES[j]];
            for (int i = 0; i < OUTPUT_CLASSES[j]; i++) {
                result[j][i] = nums[offset + i];
            }
            offset += OUTPUT_CLASSES[j];
        }
        return result;
    }
{% else %}
    // Copy the class fractions:
    private static double[] CopyVals(double[] nums) {
        return (double[]) nums.Clone();
    }
{% endif %}

{% include 'labels' %}


    public static {{ 'int[]' if is_multi_output else 'int' }} PredictIndex(double[] features) {
        return FindMax(Compute(features));
    }
{% if is_multi_output %}

    // Predict the label of each output:
    public static {{ label_type }}[] Predict(double[] features) {
        int[] idx = PredictIndex(features);
        {{ label_type }}[] result = new {{ label_type }}[idx.Length];
        int offset = 0;
        for (int j = 0; j < idx.Length; j++) {
            result[j] = LABELS[offset + idx[j]];
            offset += OUTPUT_CLASSES[j];
        }
        return result;
    }
{% else %}

    public static {{ label_type }} Predict(double[] features) {
        return LABELS[PredictIndex(features)];
    }
{% endif %}

    public static {{ 'double[][]' if is_multi_output else 'double[]' }} PredictProba(double[] features) {
        return CopyVals(Compute(features));
    }
