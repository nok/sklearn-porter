{% extends 'base.attached.class' %}

{% block content %}
class {{ class_name }} {

    private $lefts;
    private $rights;
    private $thresholds;
    private $indices;
    private $missing_go_to_left;
    private $classes;

    public function __construct($lefts, $rights, $thresholds, $indices, $missing_go_to_left, $classes) {
        $this->lefts = $lefts;
        $this->rights = $rights;
        $this->thresholds = $thresholds;
        $this->indices = $indices;
        $this->missing_go_to_left = $missing_go_to_left;
        $this->classes = $classes;
    }

{% if is_multi_output %}
    // The classes of all outputs are concatenated, these are their numbers:
    const OUTPUT_CLASSES = [{{ output_classes | join(', ') }}];

    // Find the class with the maximum value of each output:
    private function findMax($nums) {
        $result = [];
        $offset = 0;
        foreach (self::OUTPUT_CLASSES as $n) {
            $idx = 0;
            for ($i = 1; $i < $n; $i++) {
                $idx = $nums[$offset + $i] > $nums[$offset + $idx] ? $i : $idx;
            }
            $result[] = $idx;
            $offset += $n;
        }
        return $result;
    }
{% else %}
    private function findMax($nums) {
        $i = 0; $l = count($nums); $idx = 0;
        for (; $i < $l; $i++) {
            $idx = $nums[$i] > $nums[$idx] ? $i : $idx;
        }
        return $idx;
    }
{% endif %}

{% if is_multi_output %}
    // Split the class fractions into the values of each output:
    private function copyVals($nums) {
        $result = [];
        $offset = 0;
        foreach (self::OUTPUT_CLASSES as $n) {
            $result[] = array_slice($nums, $offset, $n);
            $offset += $n;
        }
        return $result;
    }
{% else %}
    // Copy the class fractions:
    private function copyVals($nums) {
        return $nums;
    }
{% endif %}

{% include 'labels' %}

    // Find the leaf of a sample and get its class fractions:
    private function compute($features) {
        $node = 0;
        while ($node >= 0) {
            if ($features[$this->indices[$node]] <= $this->thresholds[$node] || ($this->missing_go_to_left[$node] == 1 && is_nan($features[$this->indices[$node]]))) {
                $node = $this->lefts[$node];
            } else {
                $node = $this->rights[$node];
            }
        }
        return array_slice($this->classes, (-$node - 1) * {{ n_classes }}, {{ n_classes }});
    }

    public function predictIndex($features) {
        return $this->findMax($this->compute($features));
    }

{% if is_multi_output %}
    // Predict the label of each output:
    public function predict($features) {
        $labels = array();
        $offset = 0;
        foreach ($this->predictIndex($features) as $j => $idx) {
            $labels[] = self::LABELS[$offset + $idx];
            $offset += self::OUTPUT_CLASSES[$j];
        }
        return $labels;
    }
{% else %}
    public function predict($features) {
        return self::LABELS[$this->predictIndex($features)];
    }
{% endif %}

    public function predictProba($features) {
        return $this->copyVals($this->compute($features));
    }

}

if (PHP_SAPI === 'cli' && realpath($argv[0]) === __FILE__) {
    {% filter indent(4, True) %}
    {% include 'samples' %}
    {% endfilter %}

    array_shift($argv);

    // Model data:
    {{ lefts }}
    {{ rights }}
    {{ thresholds }}
    {{ indices }}
    {{ missing_go_to_left }}
    {{ classes }}

    // Estimator:
    $clf = new {{ class_name }}($lefts, $rights, $thresholds, $indices, $missing_go_to_left, $classes);

    // Features of one sample (arguments) or several samples (standard input):
    foreach (readSamples($argv) as $features) {
        {% if is_test or to_json %}
        // Get JSON:
        $prediction = $clf->predict($features);
        $probabilities = $clf->predictProba($features);
        fwrite(STDOUT, json_encode(array("predict" => $prediction, "predict_proba" => $probabilities)) . "\n");
        {% else %}
        // Get class prediction:
        $prediction = $clf->predict($features);
        fwrite(STDOUT, "{{ 'Predicted classes: ' if is_multi_output else 'Predicted class: ' }}" . {{ "implode(', ', $prediction)" if is_multi_output else 'strval($prediction)' }} . "\n");

        // Get class probabilities:
        $probabilities = $clf->predictProba($features);
        for ($i = 0; $i < count($probabilities); $i++) {
            fwrite(STDOUT, "{{ 'Probabilities of output #' if is_multi_output else 'Probability of class #' }}" . strval($i) . " = " . {{ "implode(', ', $probabilities[$i])" if is_multi_output else 'strval($probabilities[$i])' }} . "\n");
        }
        {% endif %}
    }

}
{% endblock %}