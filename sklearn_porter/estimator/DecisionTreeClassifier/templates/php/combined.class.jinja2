{% extends 'base.combined.class' %}

{% block content %}
class {{ class_name }} {

{% if is_multi_output %}
    // The classes of all outputs are concatenated, these are their numbers:
    const OUTPUT_CLASSES = [{{ output_classes | join(', ') }}];

    // Find the class with the maximum value of each output:
    private static function findMax($nums) {
        $result = [];
        $offset = 0;
        foreach (self::OUTPUT_CLASSES as $n) {
            $idx = 0;
            for ($i = 1; $i < $n; $i++) {
                $idx = $nums[$offset + $i] > $nums[$offset + $idx] ? $i : $idx;
            }
            $result[] = $idx;
            $offset += $n;
        }
        return $result;
    }
{% else %}
    private static function findMax($nums) {
        $i = 0; $l = count($nums); $idx = 0;
        for (; $i < $l; $i++) {
            $idx = $nums[$i] > $nums[$idx] ? $i : $idx;
        }
        return $idx;
    }
{% endif %}

{% if is_multi_output %}
    // Split the class fractions into the values of each output:
    private static function copyVals($nums) {
        $result = [];
        $offset = 0;
        foreach (self::OUTPUT_CLASSES as $n) {
            $result[] = array_slice($nums, $offset, $n);
            $offset += $n;
        }
        return $result;
    }
{% else %}
    // Copy the class fractions:
    private static function copyVals($nums) {
        return $nums;
    }
{% endif %}

    private static function compute($features) {
        if (sizeof($features) != {{ n_features }}) { return -1; }
        $classes = array_fill(0, {{ n_classes }}, 0.);
        {{ tree | indent(4, True) }}
        return $classes;
    }

{% include 'labels' %}

    public static function predictIndex($features) {
        $classes = {{ class_name }}::compute($features);
        return {{ class_name }}::findMax($classes);
    }

{% if is_multi_output %}
    // Predict the label of each output:
    public static function predict($features) {
        $labels = array();
        $offset = 0;
        foreach (self::predictIndex($features) as $j => $idx) {
            $labels[] = self::LABELS[$offset + $idx];
            $offset += self::OUTPUT_CLASSES[$j];
        }
        return $labels;
    }
{% else %}
    public static function predict($features) {
        return self::LABELS[self::predictIndex($features)];
    }
{% endif %}

    public static function predictProba($features) {
        $classes = {{ class_name }}::compute($features);
        return {{ class_name }}::copyVals($classes);
    }

}

if (PHP_SAPI === 'cli' && realpath($argv[0]) === __FILE__) {
    {% filter indent(4, True) %}
    {% include 'samples' %}
    {% endfilter %}

    array_shift($argv);

    // Features of one sample (arguments) or several samples (standard input):
    foreach (readSamples($argv) as $features) {
        {% if is_test or to_json %}
        // Get JSON:
        $prediction = {{ class_name }}::predict($features);
        $probabilities = {{ class_name }}::predictProba($features);
        fwrite(STDOUT, json_encode(array("predict" => $prediction, "predict_proba" => $probabilities)) . "\n");
        {% else %}
        // Get class prediction:
        $prediction = {{ class_name }}::predict($features);
        fwrite(STDOUT, "{{ 'Predicted classes: ' if is_multi_output else 'Predicted class: ' }}" . {{ "implode(', ', $prediction)" if is_multi_output else 'strval($prediction)' }} . "\n");

        // Get class probabilities:
        $probabilities = {{ class_name }}::predictProba($features);
        for ($i = 0; $i < count($probabilities); $i++) {
            fwrite(STDOUT, "{{ 'Probabilities of output #' if is_multi_output else 'Probability of class #' }}" . strval($i) . " = " . {{ "implode(', ', $probabilities[$i])" if is_multi_output else 'strval($probabilities[$i])' }} . "\n");
        }
        {% endif %}
    }

}
{% endblock %}