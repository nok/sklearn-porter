{% extends 'base.attached.class' %}

{% block content %}
var {{ class_name }} = function(lefts, rights, thresholds, indices, missingGoToLeft, classes) {

    this.lefts = lefts;
    this.rights = rights;
    this.thresholds = thresholds;
    this.indices = indices;
    this.missingGoToLeft = missingGoToLeft;
    this.classes = classes;

{% if is_multi_output %}
    // The classes of all outputs are concatenated, these are their numbers:
    var outputClasses = [{{ output_classes | join(', ') }}];

    // Find the class with the maximum value of each output:
    var _findMax = function(nums) {
        var result = [], offset = 0;
        outputClasses.forEach(function(n) {
            var idx = 0;
            for (var i = 1; i < n; i++) {
                idx = nums[offset + i] > nums[offset + idx] ? i : idx;
            }
            result.push(idx);
            offset += n;
        });
        return result;
    };
{% else %}
    var _findMax = function(nums) {
        var i = 0, l = nums.length, idx = 0;
        for (; i < l; i++) {
            idx = nums[i] > nums[idx] ? i : idx;
        }
        return idx;
    };
{% endif %}

{% if is_multi_output %}
    // Split the class fractions into the values of each output:
    var _copyVals = function(nums) {
        var result = [], offset = 0;
        outputClasses.forEach(function(n) {
            result.push(nums.slice(offset, offset + n));
            offset += n;
        });
        return result;
    };
{% else %}
    // Copy the class fractions:
    var _copyVals = function(nums) {
        return nums.slice();
    };
{% endif %}

    // Find the leaf of a sample and get its class fractions:
    this._compute = function(features) {
        var node = 0;
        while (node >= 0) {
            if (features[this.indices[node]] <= this.thresholds[node] || (this.missingGoToLeft[node] === 1 && isNaN(features[this.indices[node]]))) {
                node = this.lefts[node];
            } else {
                node = this.rights[node];
            }
        }
        return this.classes.slice((-node - 1) * {{ n_classes }}, -node * {{ n_classes }});
    };

{% include 'labels' %}

    this.predictIndex = function(features) {
        return _findMax(this._compute(features));
    };

{% if is_multi_output %}
    // Predict the label of each output:
    this.predict = function(features) {
        var offset = 0;
        return this.predictIndex(features).map(function(idx, j) {
            var label = LABELS[offset + idx];
            offset += outputClasses[j];
            return label;
        });
    };
{% else %}
    this.predict = function(features) {
        return LABELS[this.predictIndex(features)];
    };
{% endif %}

    this.predictProba = function(features) {
        return _copyVals(this._compute(features));
    };

};

{% include 'samples' %}

var main = function () {
    // Model data:
    {{ lefts }}
    {{ rights }}
    {{ thresholds }}
    {{ indices }}
    {{ missing_go_to_left }}
    {{ classes }}

    // Estimator:
    var clf = new {{ class_name }}(lefts, rights, thresholds, indices, missingGoToLeft, classes);

    // Features of one sample (arguments) or several samples (standard input):
    readSamples(process.argv.slice(2)).forEach(function (features) {
        {% if is_test or to_json %}
        // Get JSON:
        console.log(JSON.stringify({
            "predict": clf.predict(features),
            "predict_proba": clf.predictProba(features)
        }));
        {% else %}
        // Get class prediction:
        var prediction = clf.predict(features);
        console.log("{{ 'Predicted classes: ' if is_multi_output else 'Predicted class: ' }}" + prediction);

        // Get class probabilities:
        var probabilities = clf.predictProba(features);
        for (var i = 0; i < probabilities.length; i++) {
            console.log("{{ 'Probabilities of output #' if is_multi_output else 'Probability of class #' }}" + i + " : " + probabilities[i]);
        }
        {% endif %}
    });
}

if (require.main === module) {
    main();
}
{% endblock %}