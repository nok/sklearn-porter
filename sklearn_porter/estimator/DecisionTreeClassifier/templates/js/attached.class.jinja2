{% extends 'base.attached.class' %}

{% block content %}
var {{ class_name }} = function(lefts, rights, thresholds, indices, missingGoToLeft, classes) {

    this.lefts = lefts;
    this.rights = rights;
    this.thresholds = thresholds;
    this.indices = indices;
    this.missingGoToLeft = missingGoToLeft;
    this.classes = classes;

{% if is_multi_output %}
    // The classes of all outputs are concatenated, these are their numbers:
    var outputClasses = [{{ output_classes | join(', ') }}];

    // Find the class with the maximum value of each output:
    var _findMax = function(nums) {
        var result = [], offset = 0;
        outputClasses.forEach(function(n) {
            var idx = 0;
            for (var i = 1; i < n; i++) {
                idx = nums[offset + i] > nums[offset + idx] ? i : idx;
            }
            result.push(idx);
            offset += n;
        });
        return result;
    };
{% else %}
    var _findMax = function(nums) {
        var i = 0, l = nums.length, idx = 0;
        for (; i < l; i++) {
            idx = nums[i] > nums[idx] ? i : idx;
        }
        return idx;
    };
{% endif %}

{% if is_multi_output %}
    // Normalize the values of each output:
    var _normVals = function(nums) {
        var result = [], offset = 0;
        outputClasses.forEach(function(n) {
            var i, sum = 0., probas = [];
            for (i = 0; i < n; i++) {
                sum += nums[offset + i];
            }
            for (i = 0; i < n; i++) {
                probas.push(sum === 0 ? 1. / n : nums[offset + i] / sum);
            }
            result.push(probas);
            offset += n;
        });
        return result;
    };
{% else %}
    var _normVals = function(nums) {
        var i, l = nums.length,
            result = [],
            sum = 0.;
        for (i = 0; i < l; i++) {
            sum += nums[i];
        }
        if(sum === 0) {
            for (i = 0; i < l; i++) {
                result[i] = 1.0 / l;
            }
        } else {
            for (i = 0; i < l; i++) {
                result[i] = nums[i] / sum;
            }
        }
        return result;
    };
{% endif %}

    this._compute = function(features, node, post) {
        node = (typeof node !== 'undefined') ? node : 0;
        if (node >= 0) {
            if (features[this.indices[node]] <= this.thresholds[node] || (this.missingGoToLeft[node] === 1 && isNaN(features[this.indices[node]]))) {
                return this._compute(features, this.lefts[node], post);
            } else {
                return this._compute(features, this.rights[node], post);
            }
        }
        return post(this.classes.slice((-node - 1) * {{ n_classes }}, -node * {{ n_classes }}));
    };

{% include 'labels' %}

    this.predictIndex = function(features, node) {
        return this._compute(features, node, _findMax);
    };

{% if is_multi_output %}
    // Predict the label of each output:
    this.predict = function(features) {
        var offset = 0;
        return this.predictIndex(features).map(function(idx, j) {
            var label = LABELS[offset + idx];
            offset += outputClasses[j];
            return label;
        });
    };
{% else %}
    this.predict = function(features) {
        return LABELS[this.predictIndex(features)];
    };
{% endif %}

    this.predictProba = function(features, node) {
        return this._compute(features, node, _normVals);
    };

};

var main = function () {
    if (typeof process !== 'undefined' && typeof process.argv !== 'undefined') {
        if (process.argv.length - 2 !== {{ n_features }}) {
            var IllegalArgumentException = function(message) {
                this.message = message;
                this.name = "IllegalArgumentException";
            }
            throw new IllegalArgumentException("You have to pass {{ n_features }} features.");
        }
    }

    // Features:
    var features = process.argv.slice(2);
    for (var i = 0; i < features.length; i++) {
        features[i] = parseFloat(features[i]);
    }

    // Model data:
    {{ lefts }}
    {{ rights }}
    {{ thresholds }}
    {{ indices }}
    {{ missing_go_to_left }}
    {{ classes }}

    // Estimator:
    var clf = new {{ class_name }}(lefts, rights, thresholds, indices, missingGoToLeft, classes);

    {% if is_test or to_json %}
    // Get JSON:
    console.log(JSON.stringify({
        "predict": clf.predict(features),
        "predict_proba": clf.predictProba(features)
    }));
    {% else %}
    // Get class prediction:
    var prediction = clf.predict(features);
    console.log("{{ 'Predicted classes: ' if is_multi_output else 'Predicted class: ' }}" + prediction);

    // Get class probabilities:
    var probabilities = clf.predictProba(features);
    for (var i = 0; i < probabilities.length; i++) {
        console.log("{{ 'Probabilities of output #' if is_multi_output else 'Probability of class #' }}" + i + " : " + probabilities[i]);
    }
    {% endif %}
}

if (require.main === module) {
    main();
}
{% endblock %}