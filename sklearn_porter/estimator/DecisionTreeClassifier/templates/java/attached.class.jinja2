{% extends 'base.attached.class' %}

{% block content %}
{% if is_test or to_json or is_multi_output %}
import java.util.Arrays;

{% endif %}
class {{ class_name }} {

    private int[] lefts;
    private int[] rights;
    private double[] thresholds;
    private int[] indices;
    private double[][] classes;

    public {{ class_name }}(int[] lefts, int[] rights, double[] thresholds, int[] indices, double[][] classes) {
        this.lefts = lefts;
        this.rights = rights;
        this.thresholds = thresholds;
        this.indices = indices;
        this.classes = classes;
    }

{% if is_multi_output %}
    // The classes of all outputs are concatenated, these are their numbers:
    private static final int[] OUTPUT_CLASSES = { {{ output_classes | join(', ') }} };

    // Find the class with the maximum value of each output:
    private int[] findMax(double[] nums) {
        int[] result = new int[OUTPUT_CLASSES.length];
        int offset = 0;
        for (int j = 0; j < OUTPUT_CLASSES.length; j++) {
            for (int i = 1; i < OUTPUT_CLASSES[j]; i++) {
                if (nums[offset + i] > nums[offset + result[j]]) {
                    result[j] = i;
                }
            }
            offset += OUTPUT_CLASSES[j];
        }
        return result;
    }
{% else %}
    private int findMax(double[] nums) {
        int i = 0, l = nums.length, idx = 0;
        for (i = 0; i < l; i++) {
            idx = nums[i] > nums[idx] ? i : idx;
        }
        return idx;
    }
{% endif %}

{% if is_multi_output %}
    // Normalize the values of each output:
    private double[][] normVals(double[] nums) {
        double[][] result = new double[OUTPUT_CLASSES.length][];
        int offset = 0;
        for (int j = 0; j < OUTPUT_CLASSES.length; j++) {
            double sum = 0.;
            for (int i = 0; i < OUTPUT_CLASSES[j]; i++) {
                sum += nums[offset + i];
            }
            result[j] = new double[OUTPUT_CLASSES[j]];
            for (int i = 0; i < OUTPUT_CLASSES[j]; i++) {
                result[j][i] = sum == 0 ? 1. / OUTPUT_CLASSES[j] : nums[offset + i] / sum;
            }
            offset += OUTPUT_CLASSES[j];
        }
        return result;
    }
{% else %}
    private double[] normVals(double[] nums) {
        int i = 0, l = nums.length;
        double[] result = new double[l];
        double sum = 0.;
        for (i = 0; i < l; i++) {
            sum += nums[i];
        }
        if(sum == 0) {
            for (i = 0; i < l; i++) {
                result[i] = 1.0 / nums.length;
            }
        } else {
            for (i = 0; i < l; i++) {
                result[i] = nums[i] / sum;
            }
        }
        return result;
    }
{% endif %}

    private {{ 'int[]' if is_multi_output else 'int' }} predict(double[] features, int node) {
        if (this.thresholds[node] != -2) {
            if (features[this.indices[node]] <= this.thresholds[node]) {
                return predict(features, this.lefts[node]);
            } else {
                return predict(features, this.rights[node]);
            }
        }
        return findMax(this.classes[node]);
    }

    public {{ 'int[]' if is_multi_output else 'int' }} predict(double[] features) {
        return this.predict(features, 0);
    }

    private {{ 'double[][]' if is_multi_output else 'double[]' }} predictProba(double[] features, int node) {
        if (this.thresholds[node] != -2) {
            if (features[this.indices[node]] <= this.thresholds[node]) {
                return this.predictProba(features, this.lefts[node]);
            } else {
                return this.predictProba(features, this.rights[node]);
            }
        }
        return normVals(this.classes[node]);
    }

    public {{ 'double[][]' if is_multi_output else 'double[]' }} predictProba (double[] features) {
        return this.predictProba(features, 0);
    }

    public static void main(String[] args) {
        int nFeatures = {{ n_features }};
        if (args.length != nFeatures) {
            throw new IllegalArgumentException("You have to pass " +  String.valueOf(nFeatures) + " features.");
        }

        // Features:
        double[] features = new double[args.length];
        for (int i = 0, l = args.length; i < l; i++) {
            features[i] = Double.parseDouble(args[i]);
        }

        // Model data:
        {{ lefts }}
        {{ rights }}
        {{ thresholds }}
        {{ indices }}
        {{ classes }}

        // Estimator:
        {{ class_name }} clf = new {{ class_name }}(lefts, rights, thresholds, indices, classes);

        {% if is_test or to_json %}
        // Get JSON:
        {{ 'int[]' if is_multi_output else 'int' }} prediction = clf.predict(features);
        {{ 'double[][]' if is_multi_output else 'double[]' }} probabilities = clf.predictProba(features);
        System.out.println("{\"predict\": " + {{ 'Arrays.toString(prediction)' if is_multi_output else 'String.valueOf(prediction)' }} + ", \"predict_proba\": " + String.join(",", {{ 'Arrays.deepToString(probabilities)' if is_multi_output else 'Arrays.toString(probabilities)' }}) + "}");
        {% else %}
        // Get class prediction:
        {{ 'int[]' if is_multi_output else 'int' }} prediction = clf.predict(features);
        System.out.println("{{ 'Predicted classes: ' if is_multi_output else 'Predicted class: #' }}" + {{ 'Arrays.toString(prediction)' if is_multi_output else 'String.valueOf(prediction)' }});

        // Get class probabilities:
        {{ 'double[][]' if is_multi_output else 'double[]' }} probabilities = clf.predictProba(features);
        for (int i = 0; i < probabilities.length; i++) {
            System.out.println("{{ 'Probabilities of output #' if is_multi_output else 'Probability of class #' }}" + i + " : " + {{ 'Arrays.toString(probabilities[i])' if is_multi_output else 'String.valueOf(probabilities[i])' }});
        }
		    {% endif %}

    }
}
{% endblock %}