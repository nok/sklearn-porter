{% extends 'base.attached.class' %}

{% block content %}
import java.util.Arrays;


class {{ class_name }} {

    private int[] lefts;
    private int[] rights;
    private double[] thresholds;
    private int[] indices;
    private int[] missingGoToLeft;
    private double[] classes;

    public {{ class_name }}(int[] lefts, int[] rights, double[] thresholds, int[] indices, int[] missingGoToLeft, double[] classes) {
        this.lefts = lefts;
        this.rights = rights;
        this.thresholds = thresholds;
        this.indices = indices;
        this.missingGoToLeft = missingGoToLeft;
        this.classes = classes;
    }

{% if is_multi_output %}
    // The classes of all outputs are concatenated, these are their numbers:
    private static final int[] OUTPUT_CLASSES = { {{ output_classes | join(', ') }} };

    // Find the class with the maximum value of each output:
    private int[] findMax(double[] nums) {
        int[] result = new int[OUTPUT_CLASSES.length];
        int offset = 0;
        for (int j = 0; j < OUTPUT_CLASSES.length; j++) {
            for (int i = 1; i < OUTPUT_CLASSES[j]; i++) {
                if (nums[offset + i] > nums[offset + result[j]]) {
                    result[j] = i;
                }
            }
            offset += OUTPUT_CLASSES[j];
        }
        return result;
    }
{% else %}
    private int findMax(double[] nums) {
        int i = 0, l = nums.length, idx = 0;
        for (i = 0; i < l; i++) {
            idx = nums[i] > nums[idx] ? i : idx;
        }
        return idx;
    }
{% endif %}

{% if is_multi_output %}
    // Split the class fractions into the values of each output:
    private double[][] copyVals(double[] nums) {
        double[][] result = new double[OUTPUT_CLASSES.length][];
        int offset = 0;
        for (int j = 0; j < OUTPUT_CLASSES.length; j++) {
            result[j] = new double[OUTPUT_CLASSES[j]];
            for (int i = 0; i < OUTPUT_CLASSES[j]; i++) {
                result[j][i] = nums[offset + i];
            }
            offset += OUTPUT_CLASSES[j];
        }
        return result;
    }
{% else %}
    // Copy the class fractions:
    private double[] copyVals(double[] nums) {
        return nums.clone();
    }
{% endif %}

    // Find the leaf of a sample and get its class fractions:
    private double[] compute(double[] features) {
        int node = 0;
        while (node >= 0) {
            if (features[this.indices[node]] <= this.thresholds[node] || (this.missingGoToLeft[node] == 1 && Double.isNaN(features[this.indices[node]]))) {
                node = this.lefts[node];
            } else {
                node = this.rights[node];
            }
        }
        return Arrays.copyOfRange(this.classes, (-node - 1) * {{ n_classes }}, -node * {{ n_classes }});
    }

{% include 'labels' %}

    public {{ 'int[]' if is_multi_output else 'int' }} predictIndex(double[] features) {
        return findMax(this.compute(features));
    }
{% if is_multi_output %}

    // Predict the label of each output:
    public {{ label_type }}[] predict(double[] features) {
        int[] idx = this.predictIndex(features);
        {{ label_type }}[] result = new {{ label_type }}[idx.length];
        int offset = 0;
        for (int j = 0; j < idx.length; j++) {
            result[j] = LABELS[offset + idx[j]];
            offset += OUTPUT_CLASSES[j];
        }
        return result;
    }
{% else %}

    public {{ label_type }} predict(double[] features) {
        return LABELS[this.predictIndex(features)];
    }
{% endif %}

    public {{ 'double[][]' if is_multi_output else 'double[]' }} predictProba(double[] features) {
        return copyVals(this.compute(features));
    }

{% include 'samples' %}

    public static void main(String[] args) {
        // Model data:
        {{ lefts }}
        {{ rights }}
        {{ thresholds }}
        {{ indices }}
        {{ missing_go_to_left }}
        {{ classes }}

        // Estimator:
        {{ class_name }} clf = new {{ class_name }}(lefts, rights, thresholds, indices, missingGoToLeft, classes);

        // Features of one sample (arguments) or several samples (standard input):
        for (double[] features : readSamples(args, 0)) {
            {% if is_test or to_json %}
            // Get JSON:
            {{ label_type }}{{ '[]' if is_multi_output }} prediction = clf.predict(features);
            {{ 'double[][]' if is_multi_output else 'double[]' }} probabilities = clf.predictProba(features);
            System.out.println("{\"predict\": " + toJson(prediction) + ", \"predict_proba\": " + String.join(",", {{ 'Arrays.deepToString(probabilities)' if is_multi_output else 'Arrays.toString(probabilities)' }}) + "}");
            {% else %}
            // Get class prediction:
            {{ label_type }}{{ '[]' if is_multi_output }} prediction = clf.predict(features);
            System.out.println("{{ 'Predicted classes: ' if is_multi_output else 'Predicted class: ' }}" + {{ 'Arrays.toString(prediction)' if is_multi_output else 'String.valueOf(prediction)' }});

            // Get class probabilities:
            {{ 'double[][]' if is_multi_output else 'double[]' }} probabilities = clf.predictProba(features);
            for (int i = 0; i < probabilities.length; i++) {
                System.out.println("{{ 'Probabilities of output #' if is_multi_output else 'Probability of class #' }}" + i + " : " + {{ 'Arrays.toString(probabilities[i])' if is_multi_output else 'String.valueOf(probabilities[i])' }});
            }
            {% endif %}
        }

    }
}
{% endblock %}