{% extends 'base.exported.class' %}

{% block content %}
import com.google.gson.Gson;
import com.google.gson.annotations.SerializedName;

import java.io.IOException;
import java.io.Reader;
import java.nio.file.Files;
import java.nio.file.Paths;
import java.util.Arrays;

class {{ class_name }} {

    private class Tree {
        private int[] lefts;
        private int[] rights;
        private double[] thresholds;
        private int[] indices;
        @SerializedName("missing_go_to_left")
        private int[] missingGoToLeft;
        private double[] classes;
    }
    private Tree tree;

    public {{ class_name }}(String file) throws IOException {
        try (Reader reader = Files.newBufferedReader(Paths.get(file))) {
            this.tree = new Gson().fromJson(reader, Tree.class);
        }
    }

{% if is_multi_output %}
    // The classes of all outputs are concatenated, these are their numbers:
    private static final int[] OUTPUT_CLASSES = { {{ output_classes | join(', ') }} };

    // Find the class with the maximum value of each output:
    private int[] findMax(double[] nums) {
        int[] result = new int[OUTPUT_CLASSES.length];
        int offset = 0;
        for (int j = 0; j < OUTPUT_CLASSES.length; j++) {
            for (int i = 1; i < OUTPUT_CLASSES[j]; i++) {
                if (nums[offset + i] > nums[offset + result[j]]) {
                    result[j] = i;
                }
            }
            offset += OUTPUT_CLASSES[j];
        }
        return result;
    }
{% else %}
    private int findMax(double[] nums) {
        int idx = 0;
        for (int i = 0; i < nums.length; i++) {
            idx = nums[i] > nums[idx] ? i : idx;
        }
        return idx;
    }
{% endif %}

{% if is_multi_output %}
    // Normalize the values of each output:
    private double[][] normVals(double[] nums) {
        double[][] result = new double[OUTPUT_CLASSES.length][];
        int offset = 0;
        for (int j = 0; j < OUTPUT_CLASSES.length; j++) {
            double sum = 0.;
            for (int i = 0; i < OUTPUT_CLASSES[j]; i++) {
                sum += nums[offset + i];
            }
            result[j] = new double[OUTPUT_CLASSES[j]];
            for (int i = 0; i < OUTPUT_CLASSES[j]; i++) {
                result[j][i] = sum == 0 ? 1. / OUTPUT_CLASSES[j] : nums[offset + i] / sum;
            }
            offset += OUTPUT_CLASSES[j];
        }
        return result;
    }
{% else %}
    private double[] normVals(double[] nums) {
        int i = 0, l = nums.length;
        double[] result = new double[l];
        double sum = 0.;
        for (i = 0; i < l; i++) {
            sum += nums[i];
        }
        if(sum == 0) {
            for (i = 0; i < l; i++) {
                result[i] = 1.0 / nums.length;
            }
        } else {
            for (i = 0; i < l; i++) {
                result[i] = nums[i] / sum;
            }
        }
        return result;
    }
{% endif %}

    private {{ 'int[]' if is_multi_output else 'int' }} predictIndex(double[] features, int node) {
        if (node >= 0) {
            if (features[this.tree.indices[node]] <= this.tree.thresholds[node] || (this.tree.missingGoToLeft[node] == 1 && Double.isNaN(features[this.tree.indices[node]]))) {
                return predictIndex(features, this.tree.lefts[node]);
            } else {
                return predictIndex(features, this.tree.rights[node]);
            }
        }
        return findMax(Arrays.copyOfRange(this.tree.classes, (-node - 1) * {{ n_classes }}, -node * {{ n_classes }}));
    }

{% include 'labels' %}

    public {{ 'int[]' if is_multi_output else 'int' }} predictIndex(double[] features) {
        return this.predictIndex(features, 0);
    }
{% if is_multi_output %}

    // Predict the label of each output:
    public {{ label_type }}[] predict(double[] features) {
        int[] idx = this.predictIndex(features);
        {{ label_type }}[] result = new {{ label_type }}[idx.length];
        int offset = 0;
        for (int j = 0; j < idx.length; j++) {
            result[j] = LABELS[offset + idx[j]];
            offset += OUTPUT_CLASSES[j];
        }
        return result;
    }
{% else %}

    public {{ label_type }} predict(double[] features) {
        return LABELS[this.predictIndex(features)];
    }
{% endif %}

    private {{ 'double[][]' if is_multi_output else 'double[]' }} predictProba(double[] features, int node) {
        if (node >= 0) {
            if (features[this.tree.indices[node]] <= this.tree.thresholds[node] || (this.tree.missingGoToLeft[node] == 1 && Double.isNaN(features[this.tree.indices[node]]))) {
                return predictProba(features, this.tree.lefts[node]);
            } else {
                return predictProba(features, this.tree.rights[node]);
            }
        }
        return normVals(Arrays.copyOfRange(this.tree.classes, (-node - 1) * {{ n_classes }}, -node * {{ n_classes }}));
    }

    public {{ 'double[][]' if is_multi_output else 'double[]' }} predictProba (double[] features) {
        return this.predictProba(features, 0);
    }

    public static void main(String[] args) throws IOException {
        int nFeatures = {{ n_features }};
        if (args.length != (nFeatures + 1) || !args[0].endsWith(".json")) {
            throw new IllegalArgumentException("You have to pass the path to the exported model data and " +  String.valueOf(nFeatures) + " features.");
        }

        // Features:
        double[] features = new double[args.length-1];
        for (int i = 1, l = args.length; i < l; i++) {
            features[i - 1] = args[i].equalsIgnoreCase("nan") ? Double.NaN : Double.parseDouble(args[i]);
        }

        // Model data:
        String modelData = args[0];

        // Estimator:
        {{ class_name }} clf = new {{ class_name }}(modelData);

        {% if is_test or to_json %}
        // Get JSON:
        {{ label_type }}{{ '[]' if is_multi_output }} prediction = clf.predict(features);
        {{ 'double[][]' if is_multi_output else 'double[]' }} probabilities = clf.predictProba(features);
        System.out.println("{\"predict\": " + toJson(prediction) + ", \"predict_proba\": " + String.join(",", {{ 'Arrays.deepToString(probabilities)' if is_multi_output else 'Arrays.toString(probabilities)' }}) + "}");
        {% else %}
        // Get class prediction:
        {{ label_type }}{{ '[]' if is_multi_output }} prediction = clf.predict(features);
        System.out.println("{{ 'Predicted classes: ' if is_multi_output else 'Predicted class: ' }}" + {{ 'Arrays.toString(prediction)' if is_multi_output else 'String.valueOf(prediction)' }});

        // Get class probabilities:
        {{ 'double[][]' if is_multi_output else 'double[]' }} probabilities = clf.predictProba(features);
        for (int i = 0; i < probabilities.length; i++) {
            System.out.print({{ 'Arrays.toString(probabilities[i])' if is_multi_output else 'String.valueOf(probabilities[i])' }});
            if (i != probabilities.length - 1) {
                System.out.print(",");
            }
        }
        {% endif %}

    }
}
{% endblock %}