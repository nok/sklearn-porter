{% extends 'base.attached.class' %}

{% block content %}
#include <stdlib.h>
#include <stdio.h>
#include <math.h>

#define N_FEATURES {{ n_features }}
#define N_CLASSES {{ n_classes }}
{% if is_multi_output %}
#define N_OUTPUTS {{ n_outputs }}

/* The classes of all outputs are concatenated, these are their numbers: */
int output_classes[N_OUTPUTS] = { {{ output_classes | join(', ') }} };
{% endif %}


{{ lefts }}
{{ rights }}
{{ thresholds }}
{{ indices }}
{{ classes }}

{% if is_multi_output %}
/* Find the class with the maximum value of each output: */
void find_max(int *result, int nums[N_CLASSES]) {
    int i, j, offset = 0;
    for (j = 0; j < N_OUTPUTS; j++) {
        result[j] = 0;
        for (i = 1; i < output_classes[j]; i++) {
            if (nums[offset + i] > nums[offset + result[j]]) {
                result[j] = i;
            }
        }
        offset += output_classes[j];
    }
}
{% else %}
int find_max(int nums[N_CLASSES]) {
    int i;
    int idx = 0;
    for (i = 0; i < N_CLASSES; i++) {
        idx = nums[i] > nums[idx] ? i : idx;
    }
    return idx;
}
{% endif %}

{% if is_multi_output %}
/* Normalize the values of each output: */
void norm_vals(double **result, int nums[N_CLASSES]) {
    int i, j, offset = 0;
    double sum;
    for (j = 0; j < N_OUTPUTS; j++) {
        sum = 0.;
        for (i = 0; i < output_classes[j]; i++) {
            sum += nums[offset + i];
        }
        for (i = 0; i < output_classes[j]; i++) {
            result[j][i] = sum == 0 ? 1. / output_classes[j] : nums[offset + i] / sum;
        }
        offset += output_classes[j];
    }
}
{% else %}
void norm_vals(double *result, int nums[N_CLASSES]) {
    int i;
    double sum = 0.;
    for (i = 0; i < N_CLASSES; i++) {
        sum += nums[i];
    }
    if(sum == 0) {
        for (i = 0; i < N_CLASSES; i++) {
            result[i] = 1. / N_CLASSES;
        }
    } else {
        for (i = 0; i < N_CLASSES; i++) {
            result[i] = nums[i] / sum;
        }
    }
}
{% endif %}

{% if is_multi_output %}
void predict(int *result, double features[N_FEATURES], int node) {
    if (thresholds[node] != -2) {
        if (features[indices[node]] <= thresholds[node]) {
            predict(result, features, lefts[node]);
            return;
        } else {
            predict(result, features, rights[node]);
            return;
        }
    }
    find_max(result, classes[node]);
}
{% else %}
int predict(double features[N_FEATURES], int node) {
    if (thresholds[node] != -2) {
        if (features[indices[node]] <= thresholds[node]) {
            return predict(features, lefts[node]);
        } else {
            return predict(features, rights[node]);
        }
    }
    return find_max(classes[node]);
}
{% endif %}

void predict_proba({{ 'double **result' if is_multi_output else 'double *result' }}, double features[N_FEATURES], int node) {
    if (thresholds[node] != -2) {
        if (features[indices[node]] <= thresholds[node]) {
            predict_proba(result, features, lefts[node]);
        } else {
            predict_proba(result, features, rights[node]);
        }
    } else {
        norm_vals(result, classes[node]);
    }
}

int main(int argc, const char *argv[]) {

    /* Features: */
    double features[argc-1];
    for (int i = 1; i < argc; i++) {
        features[i-1] = atof(argv[i]);
    }

    {% if is_multi_output %}
    int prediction[N_OUTPUTS];
    predict(prediction, features, 0);
    double *probabilities[N_OUTPUTS];
    for (int j = 0; j < N_OUTPUTS; j++) {
        probabilities[j] = malloc(output_classes[j] * sizeof(double));
    }
    predict_proba(probabilities, features, 0);

    {% if is_test or to_json %}
    /* Get JSON: */
    printf("{\"predict\": [");
    for (int j = 0; j < N_OUTPUTS; j++) {
        printf("%d", prediction[j]);
        if (j < (N_OUTPUTS - 1)) {
            printf(",");
        }
    }
    printf("], \"predict_proba\": [");
    for (int j = 0; j < N_OUTPUTS; j++) {
        printf("[");
        for (int i = 0; i < output_classes[j]; i++) {
            printf("%.17g", probabilities[j][i]);
            if (i < (output_classes[j] - 1)) {
                printf(",");
            }
        }
        printf(j < (N_OUTPUTS - 1) ? "]," : "]");
    }
    printf("]}");
    {% else %}
    /* Get the class prediction and the class probabilities of each output: */
    for (int j = 0; j < N_OUTPUTS; j++) {
        printf("Predicted class of output #%d: #%d\n", j, prediction[j]);
        for (int i = 0; i < output_classes[j]; i++) {
            printf("Probability of class #%d of output #%d: %.6f\n", i, j, probabilities[j][i]);
        }
    }
    {% endif %}

    for (int j = 0; j < N_OUTPUTS; j++) {
        free(probabilities[j]);
    }
    {% else %}
    {% if is_test or to_json %}
    /* Get JSON: */
    double probabilities[N_CLASSES];
    predict_proba(probabilities, features, 0);
    printf("{\"predict\": %d, \"predict_proba\": [", predict(features, 0));
    for (int i = 0; i < N_CLASSES; i++) {
        printf("%.6f", probabilities[i]);
        if (i < (N_CLASSES - 1)) {
            printf(",");
        }
    }
    printf("]}");
    {% else %}
    /* Get class prediction: */
    printf("Predicted class: #%d\n", predict(features, 0));

    /* Get class probabilities: */
    double probabilities[N_CLASSES];
    predict_proba(probabilities, features, 0);
    for (int i = 0; i < N_CLASSES; i++) {
        printf("Probability of class #%d: %.6f\n", i, probabilities[i]);
    }
    {% endif %}
    {% endif %}

    return 0;
}
{% endblock %}