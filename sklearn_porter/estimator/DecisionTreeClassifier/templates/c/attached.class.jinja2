{% extends 'base.attached.class' %}

{% block content %}
#include <stdlib.h>
#include <stdio.h>
#include <math.h>

#define N_FEATURES {{ n_features }}
#define N_CLASSES {{ n_classes }}
{% if is_multi_output %}
#define N_OUTPUTS {{ n_outputs }}

/* The classes of all outputs are concatenated, these are their numbers: */
const int output_classes[N_OUTPUTS] = { {{ output_classes | join(', ') }} };
{% endif %}


{{ lefts }}
{{ rights }}
{{ thresholds }}
{{ indices }}
{{ missing_go_to_left }}
{{ classes }}

{% if is_multi_output %}
/* Find the class with the maximum value of each output: */
void find_max(int *result, const double nums[N_CLASSES]) {
    int i, j, offset = 0;
    for (j = 0; j < N_OUTPUTS; j++) {
        result[j] = 0;
        for (i = 1; i < output_classes[j]; i++) {
            if (nums[offset + i] > nums[offset + result[j]]) {
                result[j] = i;
            }
        }
        offset += output_classes[j];
    }
}
{% else %}
int find_max(const double nums[N_CLASSES]) {
    int i;
    int idx = 0;
    for (i = 0; i < N_CLASSES; i++) {
        idx = nums[i] > nums[idx] ? i : idx;
    }
    return idx;
}
{% endif %}

{% if is_multi_output %}
/* Split the class fractions into the values of each output: */
void copy_vals(double **result, const double nums[N_CLASSES]) {
    int i, j, offset = 0;
    for (j = 0; j < N_OUTPUTS; j++) {
        for (i = 0; i < output_classes[j]; i++) {
            result[j][i] = nums[offset + i];
        }
        offset += output_classes[j];
    }
}
{% else %}
/* Copy the class fractions: */
void copy_vals(double *result, const double nums[N_CLASSES]) {
    int i;
    for (i = 0; i < N_CLASSES; i++) {
        result[i] = nums[i];
    }
}
{% endif %}

{% include 'labels' %}

/* Find the leaf of a sample and get its class fractions: */
const double *compute(double features[N_FEATURES]) {
    int node = 0;
    while (node >= 0) {
        if (features[indices[node]] <= thresholds[node] || (missing_go_to_left[node] && isnan(features[indices[node]]))) {
            node = lefts[node];
        } else {
            node = rights[node];
        }
    }
    return &classes[(-node - 1) * N_CLASSES];
}

{% if is_multi_output %}
void predict_index(int *result, double features[N_FEATURES]) {
    find_max(result, compute(features));
}

/* Predict the label of each output: */
void predict(Label *result, double features[N_FEATURES]) {
    int j, offset = 0;
    int idx[N_OUTPUTS];
    predict_index(idx, features);
    for (j = 0; j < N_OUTPUTS; j++) {
        result[j] = labels[offset + idx[j]];
        offset += output_classes[j];
    }
}
{% else %}
int predict_index(double features[N_FEATURES]) {
    return find_max(compute(features));
}

Label predict(double features[N_FEATURES]) {
    return labels[predict_index(features)];
}
{% endif %}

void predict_proba({{ 'double **result' if is_multi_output else 'double *result' }}, double features[N_FEATURES]) {
    copy_vals(result, compute(features));
}

{% include 'samples' %}

{% if pipeline_classes %}
{{ pipeline_classes }}

{% endif %}
int main(int argc, const char *argv[]) {
    /* Features of one sample (arguments) or several samples (standard input): */
    double features[N_FEATURES];
    {% if pipeline_create %}
    {{ pipeline_create | indent('    ') }}

    {% endif %}
    while (read_features(features, argc, argv, 1)) {
        {% if pipeline_transform %}
        {{ pipeline_transform | indent('        ') }}
        {% endif %}
        {% if is_multi_output %}
        Label prediction[N_OUTPUTS];
        predict(prediction, features);
        double *probabilities[N_OUTPUTS];
        for (int j = 0; j < N_OUTPUTS; j++) {
            probabilities[j] = malloc(output_classes[j] * sizeof(double));
        }
        predict_proba(probabilities, features);

        {% if is_test or to_json %}
        /* Get JSON: */
        printf("{\"predict\": [");
        for (int j = 0; j < N_OUTPUTS; j++) {
            print_label(prediction[j]);
            if (j < (N_OUTPUTS - 1)) {
                printf(",");
            }
        }
        printf("], \"predict_proba\": [");
        for (int j = 0; j < N_OUTPUTS; j++) {
            printf("[");
            for (int i = 0; i < output_classes[j]; i++) {
                printf("%.17g", probabilities[j][i]);
                if (i < (output_classes[j] - 1)) {
                    printf(",");
                }
            }
            printf(j < (N_OUTPUTS - 1) ? "]," : "]");
        }
        printf("]}\n");
        {% else %}
        /* Get the class prediction and the class probabilities of each output: */
        for (int j = 0; j < N_OUTPUTS; j++) {
            printf("Predicted class of output #%d: ", j);
            print_label(prediction[j]);
            printf("\n");
            for (int i = 0; i < output_classes[j]; i++) {
                printf("Probability of class #%d of output #%d: %.6f\n", i, j, probabilities[j][i]);
            }
        }
        {% endif %}

        for (int j = 0; j < N_OUTPUTS; j++) {
            free(probabilities[j]);
        }
        {% else %}
        {% if is_test or to_json %}
        /* Get JSON: */
        double probabilities[N_CLASSES];
        predict_proba(probabilities, features);
        printf("{\"predict\": ");
        print_label(predict(features));
        printf(", \"predict_proba\": [");
        for (int i = 0; i < N_CLASSES; i++) {
            printf("%.17g", probabilities[i]);
            if (i < (N_CLASSES - 1)) {
                printf(",");
            }
        }
        printf("]}\n");
        {% else %}
        /* Get class prediction: */
        printf("Predicted class: ");
        print_label(predict(features));
        printf("\n");

        /* Get class probabilities: */
        double probabilities[N_CLASSES];
        predict_proba(probabilities, features);
        for (int i = 0; i < N_CLASSES; i++) {
            printf("Probability of class #%d: %.6f\n", i, probabilities[i]);
        }
        {% endif %}
        {% endif %}
    }

    return 0;
}
{% endblock %}