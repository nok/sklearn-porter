{% extends 'base.exported.class' %}

{% block content %}
#include <math.h>

#define N_FEATURES {{ n_features }}
#define N_CLASSES {{ n_classes }}
{% if is_multi_output %}
#define N_OUTPUTS {{ n_outputs }}

/* The classes of all outputs are concatenated, these are their numbers: */
int output_classes[N_OUTPUTS] = { {{ output_classes | join(', ') }} };
{% endif %}


int *lefts;
int *rights;
double *thresholds;
int *indices;
int *missing_go_to_left;
double *classes;

void load(const char *path) {
    JsonValue *data = json_read(path);
    lefts = json_ints(json_get(data, "lefts"));
    rights = json_ints(json_get(data, "rights"));
    thresholds = json_doubles(json_get(data, "thresholds"));
    indices = json_ints(json_get(data, "indices"));
    missing_go_to_left = json_ints(json_get(data, "missing_go_to_left"));
    classes = json_doubles(json_get(data, "classes"));
    json_free(data);
}

{% if is_multi_output %}
/* Find the class with the maximum value of each output: */
void find_max(int *result, double nums[N_CLASSES]) {
    int i, j, offset = 0;
    for (j = 0; j < N_OUTPUTS; j++) {
        result[j] = 0;
        for (i = 1; i < output_classes[j]; i++) {
            if (nums[offset + i] > nums[offset + result[j]]) {
                result[j] = i;
            }
        }
        offset += output_classes[j];
    }
}
{% else %}
int find_max(double nums[N_CLASSES]) {
    int i;
    int idx = 0;
    for (i = 0; i < N_CLASSES; i++) {
        idx = nums[i] > nums[idx] ? i : idx;
    }
    return idx;
}
{% endif %}

{% if is_multi_output %}
/* Normalize the values of each output: */
void norm_vals(double **result, double nums[N_CLASSES]) {
    int i, j, offset = 0;
    double sum;
    for (j = 0; j < N_OUTPUTS; j++) {
        sum = 0.;
        for (i = 0; i < output_classes[j]; i++) {
            sum += nums[offset + i];
        }
        for (i = 0; i < output_classes[j]; i++) {
            result[j][i] = sum == 0 ? 1. / output_classes[j] : nums[offset + i] / sum;
        }
        offset += output_classes[j];
    }
}
{% else %}
void norm_vals(double *result, double nums[N_CLASSES]) {
    int i;
    double sum = 0.;
    for (i = 0; i < N_CLASSES; i++) {
        sum += nums[i];
    }
    if(sum == 0) {
        for (i = 0; i < N_CLASSES; i++) {
            result[i] = 1. / N_CLASSES;
        }
    } else {
        for (i = 0; i < N_CLASSES; i++) {
            result[i] = nums[i] / sum;
        }
    }
}
{% endif %}

{% include 'labels' %}

{% if is_multi_output %}
void predict_index(int *result, double features[N_FEATURES], int node) {
    if (node >= 0) {
        if (features[indices[node]] <= thresholds[node] || (missing_go_to_left[node] && isnan(features[indices[node]]))) {
            predict_index(result, features, lefts[node]);
            return;
        } else {
            predict_index(result, features, rights[node]);
            return;
        }
    }
    find_max(result, &classes[(-node - 1) * N_CLASSES]);
}

/* Predict the label of each output: */
void predict(Label *result, double features[N_FEATURES]) {
    int j, offset = 0;
    int idx[N_OUTPUTS];
    predict_index(idx, features, 0);
    for (j = 0; j < N_OUTPUTS; j++) {
        result[j] = labels[offset + idx[j]];
        offset += output_classes[j];
    }
}
{% else %}
int predict_index(double features[N_FEATURES], int node) {
    if (node >= 0) {
        if (features[indices[node]] <= thresholds[node] || (missing_go_to_left[node] && isnan(features[indices[node]]))) {
            return predict_index(features, lefts[node]);
        } else {
            return predict_index(features, rights[node]);
        }
    }
    return find_max(&classes[(-node - 1) * N_CLASSES]);
}

Label predict(double features[N_FEATURES]) {
    return labels[predict_index(features, 0)];
}
{% endif %}

void predict_proba({{ 'double **result' if is_multi_output else 'double *result' }}, double features[N_FEATURES], int node) {
    if (node >= 0) {
        if (features[indices[node]] <= thresholds[node] || (missing_go_to_left[node] && isnan(features[indices[node]]))) {
            predict_proba(result, features, lefts[node]);
        } else {
            predict_proba(result, features, rights[node]);
        }
    } else {
        norm_vals(result, &classes[(-node - 1) * N_CLASSES]);
    }
}

{% include 'samples' %}

int main(int argc, const char *argv[]) {
    if (argc < 2) {
        fprintf(stderr, "You have to pass the path to the model data.\n");
        return 1;
    }

    /* Model data: */
    load(argv[1]);

    /* Features of one sample (arguments) or several samples (standard input): */
    double features[N_FEATURES];
    while (read_features(features, argc, argv, 2)) {
        {% if is_multi_output %}
        Label prediction[N_OUTPUTS];
        predict(prediction, features);
        double *probabilities[N_OUTPUTS];
        for (int j = 0; j < N_OUTPUTS; j++) {
            probabilities[j] = malloc(output_classes[j] * sizeof(double));
        }
        predict_proba(probabilities, features, 0);

        {% if is_test or to_json %}
        /* Get JSON: */
        printf("{\"predict\": [");
        for (int j = 0; j < N_OUTPUTS; j++) {
            print_label(prediction[j]);
            if (j < (N_OUTPUTS - 1)) {
                printf(",");
            }
        }
        printf("], \"predict_proba\": [");
        for (int j = 0; j < N_OUTPUTS; j++) {
            printf("[");
            for (int i = 0; i < output_classes[j]; i++) {
                printf("%.17g", probabilities[j][i]);
                if (i < (output_classes[j] - 1)) {
                    printf(",");
                }
            }
            printf(j < (N_OUTPUTS - 1) ? "]," : "]");
        }
        printf("]}\n");
        {% else %}
        /* Get the class prediction and the class probabilities of each output: */
        for (int j = 0; j < N_OUTPUTS; j++) {
            printf("Predicted class of output #%d: ", j);
            print_label(prediction[j]);
            printf("\n");
            for (int i = 0; i < output_classes[j]; i++) {
                printf("Probability of class #%d of output #%d: %.6f\n", i, j, probabilities[j][i]);
            }
        }
        {% endif %}

        for (int j = 0; j < N_OUTPUTS; j++) {
            free(probabilities[j]);
        }
        {% else %}
        {% if is_test or to_json %}
        /* Get JSON: */
        double probabilities[N_CLASSES];
        predict_proba(probabilities, features, 0);
        printf("{\"predict\": ");
        print_label(predict(features));
        printf(", \"predict_proba\": [");
        for (int i = 0; i < N_CLASSES; i++) {
            printf("%.6f", probabilities[i]);
            if (i < (N_CLASSES - 1)) {
                printf(",");
            }
        }
        printf("]}\n");
        {% else %}
        /* Get class prediction: */
        printf("Predicted class: ");
        print_label(predict(features));
        printf("\n");

        /* Get class probabilities: */
        double probabilities[N_CLASSES];
        predict_proba(probabilities, features, 0);
        for (int i = 0; i < N_CLASSES; i++) {
            printf("Probability of class #%d: %.6f\n", i, probabilities[i]);
        }
        {% endif %}
        {% endif %}
    }

    return 0;
}
{% endblock %}
