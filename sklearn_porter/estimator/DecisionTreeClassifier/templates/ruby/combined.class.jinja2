{% extends 'base.combined.class' %}

{% block content %}
{% if is_test or to_json %}
require 'json'


{% endif %}
class {{ class_name }}

{% if is_multi_output %}
	# The classes of all outputs are concatenated, these are their numbers:
	OUTPUT_CLASSES = [{{ output_classes | join(', ') }}]

	# Find the class with the maximum value of each output:
	def self._find_max(nums)
		offset = 0
		OUTPUT_CLASSES.map do |n|
			idx = 0
			for i in 1 ... n
				idx = i if nums[offset + i] > nums[offset + idx]
			end
			offset += n
			idx
		end
	end
{% else %}
	def self._find_max(nums)
		idx = 0
		for i in 0 ... nums.length
			idx = nums[i] > nums[idx] ? i : idx
		end
		idx
	end
{% endif %}

{% if is_multi_output %}
	# Split the class fractions into the values of each output:
	def self._copy_vals(nums)
		offset = 0
		OUTPUT_CLASSES.map do |n|
			probas = nums[offset, n].map(&:to_f)
			offset += n
			probas
		end
	end
{% else %}
	# Copy the class fractions:
	def self._copy_vals(nums)
		nums.map(&:to_f)
	end
{% endif %}

	def self._compute(features)
		classes = Array.new({{ n_classes }}, 0.0)
		{{ tree | indent('\t', True) }}
		classes
	end

{% include 'labels' %}

	def self.predict_index(features)
		self._find_max self._compute features
	end

{% if is_multi_output %}
	# Predict the label of each output:
	def self.predict(features)
		offset = 0
		predict_index(features).each_with_index.map do |idx, j|
			label = LABELS[offset + idx]
			offset += OUTPUT_CLASSES[j]
			label
		end
	end
{% else %}
	def self.predict(features)
		LABELS[predict_index features]
	end
{% endif %}

	def self.predict_proba(features)
		self._copy_vals self._compute features
	end

end

if __FILE__ == $0
	{% filter indent('\t', True) %}
	{% include 'samples' %}
	{% endfilter %}

	# Features of one sample (arguments) or several samples (standard input):
	read_samples(ARGV) do |features|
		{% if is_test or to_json %}
		# Get JSON:
		prediction = {{ class_name }}.predict features
		probabilities = {{ class_name }}.predict_proba features
		puts JSON.generate({:predict => prediction, :predict_proba => probabilities})
		{% else %}
		# Get class prediction:
		prediction = {{ class_name }}.predict features
		puts "{{ 'Predicted classes: ' if is_multi_output else 'Predicted class: ' }}#{prediction}"

		# Get class probabilities:
		probabilities = {{ class_name }}.predict_proba features
		for i in 0 ... probabilities.length
			puts "{{ 'Probabilities of output #' if is_multi_output else 'Probability of class #' }}#{i} : #{probabilities[i]}"
		end
		{% endif %}
	end
end
{% endblock %}