{% extends 'base.attached.class' %}

{% block content %}
require 'json'


class {{ class_name }}

	def initialize(path)
		@data = JSON.parse(File.read(path))

		@lefts = @data['lefts']
		@rights = @data['rights']
		@thresholds = @data['thresholds']
		@indices = @data['indices']
		@missing_go_to_left = @data['missing_go_to_left']
		@classes = @data['classes']
	end

{% if is_multi_output %}
	# The classes of all outputs are concatenated, these are their numbers:
	OUTPUT_CLASSES = [{{ output_classes | join(', ') }}]

	# Find the class with the maximum value of each output:
	def _find_max(nums)
		offset = 0
		OUTPUT_CLASSES.map do |n|
			idx = 0
			for i in 1 ... n
				idx = i if nums[offset + i] > nums[offset + idx]
			end
			offset += n
			idx
		end
	end
{% else %}
	def _find_max(nums)
		idx = 0
		for i in 0 ... nums.length
			idx = nums[i] > nums[idx] ? i : idx
		end
		idx
	end
{% endif %}

{% if is_multi_output %}
	# Split the class fractions into the values of each output:
	def _copy_vals(nums)
		offset = 0
		OUTPUT_CLASSES.map do |n|
			probas = nums[offset, n].map(&:to_f)
			offset += n
			probas
		end
	end
{% else %}
	# Copy the class fractions:
	def _copy_vals(nums)
		nums.map(&:to_f)
	end
{% endif %}

	# Find the leaf of a sample and get its class fractions:
	def _compute(features)
		node = 0
		while node >= 0
			if features[@indices[node]] <= @thresholds[node] || (@missing_go_to_left[node] == 1 && features[@indices[node]].nan?)
				node = @lefts[node]
			else
				node = @rights[node]
			end
		end
		@classes[(-node - 1) * {{ n_classes }}, {{ n_classes }}]
	end

{% include 'labels' %}

	def predict_index(features)
		_find_max _compute(features)
	end

{% if is_multi_output %}
	# Predict the label of each output:
	def predict(features)
		offset = 0
		predict_index(features).each_with_index.map do |idx, j|
			label = LABELS[offset + idx]
			offset += OUTPUT_CLASSES[j]
			label
		end
	end
{% else %}
	def predict(features)
		LABELS[predict_index features]
	end
{% endif %}

	def predict_proba(features)
		_copy_vals _compute(features)
	end

end

if __FILE__ == $0
	{% filter indent('\t', True) %}
	{% include 'samples' %}
	{% endfilter %}

	raise "You have to pass the path to the model data." if ARGV.empty?

	# Model data:
	modelData = ARGV.shift

	# Estimator:
	clf = {{ class_name }}.new modelData

	# Features of one sample (arguments) or several samples (standard input):
	read_samples(ARGV) do |features|
		{% if is_test or to_json %}
		# Get JSON:
		prediction = clf.predict features
		probabilities = clf.predict_proba features
		puts JSON.generate({:predict => prediction, :predict_proba => probabilities})
		{% else %}
		# Get class prediction:
		prediction = clf.predict features
		puts "{{ 'Predicted classes: ' if is_multi_output else 'Predicted class: ' }}#{prediction}"

		# Get class probabilities:
		probabilities = clf.predict_proba features
		for i in 0 ... probabilities.length
			puts "{{ 'Probabilities of output #' if is_multi_output else 'Probability of class #' }}#{i} : #{probabilities[i]}"
		end
		{% endif %}
	end
end
{% endblock %}