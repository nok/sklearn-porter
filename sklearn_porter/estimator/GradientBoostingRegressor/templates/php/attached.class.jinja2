{% extends 'base.attached.class' %}

{% block content %}
class {{ class_name }} {

    {% filter indent(4, True) %}
    {% include 'forest' %}
    {% endfilter %}


    // Add the values of all trees to the initial prediction:
    public function predict($features) {
        $value = $this->inits[0];
        foreach ($this->forest as $tree) {
            $value += self::compute($tree, $features);
        }
        return {{ 'exp($value)' if is_log_link else '$value' }};
    }

}

{% if pipeline_classes %}
{{ pipeline_classes }}

{% endif %}
if (PHP_SAPI === 'cli' && realpath($argv[0]) === __FILE__) {
    {% filter indent(4, True) %}
    {% include 'samples' %}
    {% endfilter %}


    array_shift($argv);

    {% if pipeline_create %}
    {{ pipeline_create | indent('    ') }}

    {% endif %}
    // Model data:
    {{ model }}

    // Estimator:
    $reg = new {{ class_name }}($model, array({{ inits }}));

    // Features of one sample (arguments) or several samples (standard input):
    foreach (readSamples($argv) as $features) {
        {% if pipeline_transform %}
        {{ pipeline_transform | indent('        ') }}
        {% endif %}
        $prediction = $reg->predict($features);

        {% filter indent(8, True) %}
        {% include 'output' %}
        {% endfilter %}
    }

}
{% endblock %}
