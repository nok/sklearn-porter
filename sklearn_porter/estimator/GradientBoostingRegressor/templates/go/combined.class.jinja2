{% extends 'base.combined.class' %}

{% block content %}
package main

import (
	"bufio"
	{% if is_test or to_json %}
	"encoding/json"
	{% endif %}
	"fmt"
	{% if has_missing_go_to_left or has_infinite_thresholds or is_log_link %}
	"math"
	{% endif %}
	"os"
	"strconv"
	"strings"
)

{% if is_test or to_json %}
type Response struct {
	Predict float64 `json:"predict"`
}

{% endif %}
{{ trees }}

var inits = []float64{ {{- inits -}} }

// Add the values of all trees to the initial prediction:
func Predict(features []float64) float64 {
	value := inits[0]
	{% for i in range(n_estimators) %}
	value += compute{{ i }}(features)[0]
	{% endfor %}
	return {{ 'math.Exp(value)' if is_log_link else 'value' }}
}

{% include 'samples' %}

{% if pipeline_classes %}
{{ pipeline_classes }}

{% endif %}
func main() {
	// Features of one sample (arguments) or several samples (standard input):
	{% if pipeline_create %}
	{{ pipeline_create | indent('\t') }}

	{% endif %}
	readSamples(os.Args[1:], func(features []float64) {
		{% if pipeline_transform %}
		{{ pipeline_transform | indent('\t\t') }}
		{% endif %}
		prediction := Predict(features)

		{% filter indent('\t\t', True) %}
		{% include 'output' %}
		{% endfilter %}
	})

}
{% endblock %}
