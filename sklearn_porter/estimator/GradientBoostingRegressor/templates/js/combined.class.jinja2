{% extends 'base.combined.class' %}

{% block content %}
var {{ class_name }} = function() {

    var forest = [];

    {{ trees | indent(4) }}

    var inits = [{{ inits }}];

    // Add the values of all trees to the initial prediction:
    this.predict = function(features) {
        var value = inits[0];
        for (var i = 0; i < forest.length; i++) {
            value += forest[i](features)[0];
        }
        return {{ 'Math.exp(value)' if is_log_link else 'value' }};
    };

};

{% include 'samples' %}

var main = function () {
    // Estimator:
    var reg = new {{ class_name }}();

    // Features of one sample (arguments) or several samples (standard input):
    readSamples(process.argv.slice(2)).forEach(function (features) {
        {% filter indent(8, True) %}
        {% include 'output' %}
        {% endfilter %}
    });
}

if (require.main === module) {
    main();
}
{% endblock %}
