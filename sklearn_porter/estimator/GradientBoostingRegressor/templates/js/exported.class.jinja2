var {{ class_name }} = function(jsonFile) {
    var modelData = JSON.parse(fs.readFileSync(jsonFile));
    var estimators = modelData['estimators'],
        inits = modelData['inits'];

    {% filter indent(4, True) %}
    {% include 'forest' %}
    {% endfilter %}


    // Add the values of all trees to the initial prediction:
    this.predict = function(features) {
        var value = inits[0];
        for (var i = 0; i < forest.length; i++) {
            value += forest[i].compute(features);
        }
        return value;
    };

};

