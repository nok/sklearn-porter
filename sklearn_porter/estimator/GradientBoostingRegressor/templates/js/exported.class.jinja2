{% extends 'base.exported.class' %}

{% block content %}
var {{ class_name }} = function(data) {
    var modelData = readModelData(data);
    var estimators = modelData['estimators'],
        inits = modelData['inits'];

    {% filter indent(4, True) %}
    {% include 'forest' %}
    {% endfilter %}


    // Add the values of all trees to the initial prediction:
    this.predict = function(features) {
        var value = inits[0];
        for (var i = 0; i < forest.length; i++) {
            value += forest[i].compute(features);
        }
        return {{ 'Math.exp(value)' if is_log_link else 'value' }};
    };

};

{% include 'samples' %}

{% if pipeline_classes %}
{{ pipeline_classes }}

{% endif %}
var main = function () {
    if (process.argv.length < 3) {
        throw new Error("You have to pass the path to the model data.");
    }

    {% if pipeline_create %}
    {{ pipeline_create | indent('    ') }}

    {% endif %}
    // Model data:
    var json = process.argv[2];

    // Estimator:
    var reg = new {{ class_name }}(json);

    // Features of one sample (arguments) or several samples (standard input):
    readSamples(process.argv.slice(3)).forEach(function (features) {
        {% if pipeline_transform %}
        {{ pipeline_transform | indent('        ') }}
        {% endif %}
        {% filter indent(8, True) %}
        {% include 'output' %}
        {% endfilter %}
    });
}
{% endblock %}
