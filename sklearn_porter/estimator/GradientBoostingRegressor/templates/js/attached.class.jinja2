{% extends 'base.attached.class' %}

{% block content %}
var {{ class_name }} = function(estimators, inits) {

    {% filter indent(4, True) %}
    {% include 'forest' %}
    {% endfilter %}


    // Add the values of all trees to the initial prediction:
    this.predict = function(features) {
        var value = inits[0];
        for (var i = 0; i < forest.length; i++) {
            value += forest[i].compute(features);
        }
        return value;
    };

};

{% include 'samples' %}

var main = function () {
    // Model data:
    {{ model }}
    var inits = [{{ inits }}];

    // Estimator:
    var reg = new {{ class_name }}(model, inits);

    // Features of one sample (arguments) or several samples (standard input):
    readSamples(process.argv.slice(2)).forEach(function (features) {
        {% filter indent(8, True) %}
        {% include 'output' %}
        {% endfilter %}
    });
}

if (require.main === module) {
    main();
}
{% endblock %}
