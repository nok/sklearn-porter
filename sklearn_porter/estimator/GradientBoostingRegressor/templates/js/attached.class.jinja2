{% extends 'base.attached.class' %}

{% block content %}
var {{ class_name }} = function(estimators, inits) {

    {% filter indent(4, True) %}
    {% include 'forest' %}
    {% endfilter %}


    // Add the values of all trees to the initial prediction:
    this.predict = function(features) {
        var value = inits[0];
        for (var i = 0; i < forest.length; i++) {
            value += forest[i].compute(features);
        }
        return {{ 'Math.exp(value)' if is_log_link else 'value' }};
    };

};

{% include 'samples' %}

{% if pipeline_classes %}
{{ pipeline_classes }}

{% endif %}
// Create the estimator with the model data of this file:
var createEstimator = function () {
    // Model data:
    {{ model }}
    var inits = [{{ inits }}];

    return new {{ class_name }}(model, inits);
};

var main = function () {
    {% if pipeline_create %}
    {{ pipeline_create | indent('    ') }}

    {% endif %}
    // Estimator:
    var reg = createEstimator();

    // Features of one sample (arguments) or several samples (standard input):
    readSamples(process.argv.slice(2)).forEach(function (features) {
        {% if pipeline_transform %}
        {{ pipeline_transform | indent('        ') }}
        {% endif %}
        {% filter indent(8, True) %}
        {% include 'output' %}
        {% endfilter %}
    });
}
{% endblock %}
