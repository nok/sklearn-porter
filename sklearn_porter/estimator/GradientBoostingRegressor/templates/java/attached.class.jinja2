{% extends 'base.attached.class' %}

{% block content %}
class {{ class_name }} {

    {% filter indent(4, True) %}
    {% include 'forest' %}


    {% include 'predict' %}
    {% endfilter %}


    // Model data:
    {{ model | indent(4) }}

{% include 'samples' %}

    public static void main(String[] args) {
        // Estimator:
        Tree[] forest = {
            {% for i in range(n_estimators) %}
            tree{{ i }}(){% if not loop.last %},{% endif %}

            {% endfor %}
        };
        {{ class_name }} reg = new {{ class_name }}(forest, new double[] {{ '{' }}{{ inits }}{{ '}' }});

        // Features of one sample (arguments) or several samples (standard input):
        {% if pipeline_create %}
        {{ pipeline_create | indent('        ') }}

        {% endif %}
        for (double[] features : readSamples(args, 0)) {
            {% if pipeline_transform %}
            {{ pipeline_transform | indent('            ') }}
            {% endif %}
            double prediction = reg.predict(features);

            {% filter indent(12, True) %}
            {% include 'output' %}
            {% endfilter %}
        }

    }
}
{% if pipeline_classes %}

{{ pipeline_classes }}
{% endif %}
{% endblock %}
