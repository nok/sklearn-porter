{% extends 'base.combined.class' %}

{% block content %}
using System;
using System.Globalization;


public static class {{ class_name }} {

    {{ trees | indent(4) }}

    private static readonly double[] INITS = {{ '{' }}{{ inits }}{{ '}' }};

    // Add the values of all trees to the initial prediction:
    public static double Predict(double[] features) {
        double value = INITS[0];
        {% for i in range(n_estimators) %}
        value += Compute{{ i }}(features)[0];
        {% endfor %}
        return {{ 'Math.Exp(value)' if is_log_link else 'value' }};
    }
{% if is_test or to_json %}

{% include 'json' %}

{% endif %}

{% include 'samples' %}


    public static void Main(string[] args) {
        // Features of one sample (arguments) or several samples (standard input):
        {% if pipeline_create %}
        {{ pipeline_create | indent('        ') }}

        {% endif %}
        foreach (double[] features in ReadSamples(args, 0)) {
            {% if pipeline_transform %}
            {{ pipeline_transform | indent('            ') }}
            {% endif %}
            double prediction = {{ class_name }}.Predict(features);
            {% filter indent(12, True) %}
            {% include 'output' %}
            {% endfilter %}
        }
    }
}
{% if pipeline_classes %}

{{ pipeline_classes }}
{% endif %}
{% endblock %}