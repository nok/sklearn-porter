{% extends 'base.combined.class' %}

{% block content %}
{% if is_test or to_json %}
require 'json'


{% endif %}
class {{ class_name }}

	{{ trees | indent('\t') }}

	# Average the predicted values of all trees:
	def self.predict(features)
		values = Array.new({{ n_outputs }}, 0.0)
		{% for i in range(n_estimators) %}
		temp = self.compute_{{ i }}(features)
		for j in 0 ... values.length
			values[j] += temp[j]
		end
		{% endfor %}
		for j in 0 ... values.length
			values[j] /= {{ n_estimators }}
		end
		if values.length == 1
			return values[0]
		end
		values
	end

end

if __FILE__ == $0
	{% filter indent('\t', True) %}
	{% include 'samples' %}
	{% endfilter %}

	# Features of one sample (arguments) or several samples (standard input):
	read_samples(ARGV) do |features|
		prediction = {{ class_name }}.predict features

		{% filter indent('\t\t', True) %}
		{% include 'output' %}
		{% endfilter %}
	end
end
{% endblock %}
