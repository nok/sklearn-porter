{% extends 'base.exported.class' %}

{% block content %}
require 'json'


class {{ class_name }}

	{% filter indent('\t', True) %}
	{% include 'forest' %}
	{% endfilter %}

end

{% if pipeline_classes %}
{{ pipeline_classes }}

{% endif %}
if __FILE__ == $0
	{% filter indent('\t', True) %}
	{% include 'samples' %}
	{% endfilter %}

	raise "You have to pass the path to the model data." if ARGV.empty?

	{% if pipeline_create %}
	{{ pipeline_create | indent('\t') }}

	{% endif %}
	# Model data:
	model = JSON.parse(File.read(ARGV.shift)){{ "['estimators']" if pipeline }}

	# Estimator:
	reg = {{ class_name }}.new model

	# Features of one sample (arguments) or several samples (standard input):
	read_samples(ARGV) do |features|
		{% if pipeline_transform %}
		{{ pipeline_transform | indent('\t\t') }}
		{% endif %}
		prediction = reg.predict features

		{% filter indent('\t\t', True) %}
		{% include 'output' %}
		{% endfilter %}
	end
end
{% endblock %}
