{% extends 'base.exported.class' %}

{% block content %}
require 'json'


class {{ class_name }}

	{% filter indent('\t', True) %}
	{% include 'forest' %}
	{% endfilter %}

end

if __FILE__ == $0
	if ARGV.length != {{ n_features + 1 }}
		raise "You have to pass the path to the model data and {{ n_features }} features."
	end

	# Model data:
	model = JSON.parse(File.read(ARGV.shift))

	# Features:
	features = ARGV.collect { |value| value.downcase == 'nan' ? Float::NAN : value.to_f }

	# Estimator:
	reg = {{ class_name }}.new model
	prediction = reg.predict features

	{% filter indent('\t', True) %}
	{% include 'output' %}
	{% endfilter %}
end
{% endblock %}
