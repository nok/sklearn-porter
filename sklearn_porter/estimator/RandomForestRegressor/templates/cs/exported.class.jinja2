{% extends 'base.exported.class' %}

{% block content %}
using System;
using System.Globalization;
using System.IO;
using System.Text.Json;


public class {{ class_name }} {

    {% filter indent(4, True) %}
    {% include 'forest' %}
    {% endfilter %}


    public {{ class_name }}(string file) {
        JsonSerializerOptions options = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.SnakeCaseLower };
        this.forest = JsonSerializer.Deserialize<Tree[]>({{ 'System.Text.Json.JsonDocument.Parse(File.ReadAllText(file)).RootElement.GetProperty("estimators")' if pipeline else 'File.ReadAllText(file)' }}, options);
    }
{% if to_json %}

{% include 'json' %}

{% endif %}

{% include 'samples' %}


    // Load the estimator with the model data of a JSON file:
    public static {{ class_name }} Load(string path) {
        return new {{ class_name }}(path);
    }

#if !SKLEARN_PORTER_NO_MAIN
    public static void Main(string[] args) {
        if (args.Length < 1 || !args[0].EndsWith(".json")) {
            throw new ArgumentException("You have to pass the path to the exported model data.");
        }

        {% if pipeline_create %}
        {{ pipeline_create | indent('        ') }}

        {% endif %}
        // Estimator:
        {% if pipeline %}
        {{ class_name }} reg = pipeline.Estimator;
        {% else %}
        {{ class_name }} reg = {{ class_name }}.Load(args[0]);
        {% endif %}

        // Features of one sample (arguments) or several samples (standard input):
        foreach (double[] features in ReadSamples(args, 1)) {
            {% if pipeline_transform %}
            {{ pipeline_transform | indent('            ') }}
            {% endif %}
            double[] prediction = reg.Predict(features);
            {% filter indent(12, True) %}
            {% include 'output' %}
            {% endfilter %}
        }
    }
#endif
}
{% if pipeline_classes %}

{{ pipeline_classes }}
{% endif %}
{% endblock %}