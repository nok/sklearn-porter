{% extends 'base.combined.class' %}

{% block content %}
using System;
using System.Globalization;


public static class {{ class_name }} {

    {{ trees | indent(4) }}

    // Average the predicted values of all trees:
    public static double[] Predict(double[] features) {
        double[] values = new double[{{ n_outputs }}];
        double[] temp;
        {% for i in range(n_estimators) %}
        temp = Compute{{ i }}(features);
        for (int j = 0; j < values.Length; j++) {
            values[j] += temp[j];
        }
        {% endfor %}
        for (int j = 0; j < values.Length; j++) {
            values[j] /= {{ n_estimators }};
        }
        return values;
    }
{% if is_test or to_json %}

{% include 'json' %}

{% endif %}

{% include 'samples' %}


    public static void Main(string[] args) {
        // Features of one sample (arguments) or several samples (standard input):
        {% if pipeline_create %}
        {{ pipeline_create | indent('        ') }}

        {% endif %}
        foreach (double[] features in ReadSamples(args, 0)) {
            {% if pipeline_transform %}
            {{ pipeline_transform | indent('            ') }}
            {% endif %}
            double[] prediction = {{ class_name }}.Predict(features);
            {% filter indent(12, True) %}
            {% include 'output' %}
            {% endfilter %}
        }
    }
}
