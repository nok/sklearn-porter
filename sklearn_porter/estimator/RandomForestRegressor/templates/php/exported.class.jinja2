{% extends 'base.exported.class' %}

{% block content %}
class {{ class_name }} {

    {% filter indent(4, True) %}
    {% include 'forest' %}
    {% endfilter %}

}

if ($argc > 1) {

    array_shift($argv);

    // Model data:
    $path = array_shift($argv);
    $model = json_decode(file_get_contents($path), true);

    // Features:
    $features = array_map('floatval', $argv);
    if (count($features) != {{ n_features }}) {
        fwrite(STDERR, "You have to pass the path to the model data and {{ n_features }} features.\n");
        exit(1);
    }

    // Estimator:
    $reg = new {{ class_name }}($model);
    $prediction = $reg->predict($features);

    {% filter indent(4, True) %}
    {% include 'output' %}
    {% endfilter %}

}
{% endblock %}
