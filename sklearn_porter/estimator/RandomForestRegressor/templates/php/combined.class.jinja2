{% extends 'base.combined.class' %}

{% block content %}
class {{ class_name }} {

    {{ trees | indent(4) }}

    // Average the predicted values of all trees:
    public static function predict($features) {
        $values = array_fill(0, {{ n_outputs }}, 0.);
        {% for i in range(n_estimators) %}
        $temp = self::compute_{{ i }}($features);
        for ($j = 0; $j < {{ n_outputs }}; $j++) {
            $values[$j] += $temp[$j];
        }
        {% endfor %}
        for ($j = 0; $j < {{ n_outputs }}; $j++) {
            $values[$j] /= {{ n_estimators }};
        }
        if (count($values) == 1) {
            return $values[0];
        }
        return $values;
    }

}

if (PHP_SAPI === 'cli' && realpath($argv[0]) === __FILE__) {
    {% filter indent(4, True) %}
    {% include 'samples' %}
    {% endfilter %}

    array_shift($argv);

    // Features of one sample (arguments) or several samples (standard input):
    foreach (readSamples($argv) as $features) {
        $prediction = {{ class_name }}::predict($features);

        {% filter indent(8, True) %}
        {% include 'output' %}
        {% endfilter %}
    }

}
{% endblock %}
