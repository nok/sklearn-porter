{% extends 'base.combined.class' %}

{% block content %}
package main

import (
	"bufio"
	{% if is_test or to_json %}
	"encoding/json"
	{% endif %}
	"fmt"
	{% if has_missing_go_to_left or has_infinite_thresholds %}
	"math"
	{% endif %}
	"os"
	"strconv"
	"strings"
)

{% if is_test or to_json %}
type Response struct {
	Predict interface{} `json:"predict"`
}

{% endif %}
{{ trees }}

// Average the predicted values of all trees:
func Predict(features []float64) []float64 {
	values := make([]float64, {{ n_outputs }})
	var temp []float64
	{% for i in range(n_estimators) %}
	temp = compute{{ i }}(features)
	for j := range values {
		values[j] += temp[j]
	}
	{% endfor %}
	for j := range values {
		values[j] /= {{ n_estimators }}
	}
	return values
}

{% include 'samples' %}

{% if pipeline_classes %}
{{ pipeline_classes }}

{% endif %}
func main() {
	// Features of one sample (arguments) or several samples (standard input):
	{% if pipeline_create %}
	{{ pipeline_create | indent('\t') }}

	{% endif %}
	readSamples(os.Args[1:], func(features []float64) {
		{% if pipeline_transform %}
		{{ pipeline_transform | indent('\t\t') }}
		{% endif %}
		prediction := Predict(features)

		{% filter indent('\t\t', True) %}
		{% include 'output' %}
		{% endfilter %}
	})

}
{% endblock %}
