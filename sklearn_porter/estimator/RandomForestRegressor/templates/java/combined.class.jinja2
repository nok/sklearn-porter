{% extends 'base.combined.class' %}

{% block content %}
{% if is_test or to_json %}
import java.util.Arrays;

{% endif %}
class {{ class_name }} {

    {{ trees | indent(4) }}

    // Average the predicted values of all trees:
    public static double[] predict(double[] features) {
        double[] values = new double[{{ n_outputs }}];
        double[] temp;
        {% for i in range(n_estimators) %}
        temp = compute_{{ i }}(features);
        for (int j = 0; j < values.length; j++) {
            values[j] += temp[j];
        }
        {% endfor %}
        for (int j = 0; j < values.length; j++) {
            values[j] /= {{ n_estimators }};
        }
        return values;
    }

    public static void main(String[] args) {
        int nFeatures = {{ n_features }};
        if (args.length != nFeatures) {
            throw new IllegalArgumentException("You have to pass " +  String.valueOf(nFeatures) + " features.");
        }

        // Features:
        double[] features = new double[args.length];
        for (int i = 0, l = args.length; i < l; i++) {
            features[i] = Double.parseDouble(args[i]);
        }

        double[] prediction = {{ class_name }}.predict(features);

        {% filter indent(8, True) %}
        {% include 'output' %}
        {% endfilter %}

    }
}
{% endblock %}
