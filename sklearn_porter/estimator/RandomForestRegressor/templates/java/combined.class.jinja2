{% extends 'base.combined.class' %}

{% block content %}
{% if is_test or to_json %}
import java.util.Arrays;

{% endif %}
class {{ class_name }} {

    {{ trees | indent(4) }}

    // Average the predicted values of all trees:
    public static double[] predict(double[] features) {
        double[] values = new double[{{ n_outputs }}];
        double[] temp;
        {% for i in range(n_estimators) %}
        temp = compute_{{ i }}(features);
        for (int j = 0; j < values.length; j++) {
            values[j] += temp[j];
        }
        {% endfor %}
        for (int j = 0; j < values.length; j++) {
            values[j] /= {{ n_estimators }};
        }
        return values;
    }

{% include 'samples' %}

    public static void main(String[] args) {
        // Features of one sample (arguments) or several samples (standard input):
        for (double[] features : readSamples(args, 0)) {
            double[] prediction = {{ class_name }}.predict(features);

            {% filter indent(12, True) %}
            {% include 'output' %}
            {% endfilter %}
        }

    }
}
{% endblock %}
