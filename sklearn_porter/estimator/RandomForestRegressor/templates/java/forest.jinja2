private static class Tree {
    private int[] lefts;
    private int[] rights;
    private double[] thresholds;
    private int[] indices;
    private int[] missingGoToLeft;
    private double[] values;

    private Tree(int[] lefts, int[] rights, double[] thresholds, int[] indices, int[] missingGoToLeft, double[] values) {
        this.lefts = lefts;
        this.rights = rights;
        this.thresholds = thresholds;
        this.indices = indices;
        this.missingGoToLeft = missingGoToLeft;
        this.values = values;
    }

    // Find the leaf and add its predicted values to the values:
    private void addValues(double[] features, double[] values) {
        int node = 0;
        while (node >= 0) {
            if (features[this.indices[node]] <= this.thresholds[node] || (this.missingGoToLeft[node] == 1 && Double.isNaN(features[this.indices[node]]))) {
                node = this.lefts[node];
            } else {
                node = this.rights[node];
            }
        }
        int start = (-node - 1) * {{ n_outputs }};
        for (int j = 0; j < values.length; j++) {
            values[j] += this.values[start + j];
        }
    }
}

private Tree[] forest;

public {{ class_name }}(Tree[] forest) {
    this.forest = forest;
}

// Average the predicted values of all trees:
public double[] predict(double[] features) {
    double[] values = new double[{{ n_outputs }}];
    for (Tree tree : this.forest) {
        tree.addValues(features, values);
    }
    for (int j = 0; j < values.length; j++) {
        values[j] /= this.forest.length;
    }
    return values;
}
