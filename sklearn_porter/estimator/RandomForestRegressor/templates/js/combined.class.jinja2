{% extends 'base.combined.class' %}

{% block content %}
var {{ class_name }} = function() {

    var forest = [];

    {{ trees | indent(4) }}

    // Average the predicted values of all trees:
    this.predict = function(features) {
        var nTrees = forest.length,
            nOutputs = {{ n_outputs }};
        var values = new Array(nOutputs).fill(0);
        var i, j;
        for (i = 0; i < nTrees; i++) {
            var temp = forest[i](features);
            for (j = 0; j < nOutputs; j++) {
                values[j] += temp[j];
            }
        }
        for (j = 0; j < nOutputs; j++) {
            values[j] /= nTrees;
        }
        if (nOutputs === 1) {
            return values[0];
        }
        return values;
    };

};

{% include 'samples' %}

var main = function () {
    // Estimator:
    var reg = new {{ class_name }}();

    // Features of one sample (arguments) or several samples (standard input):
    readSamples(process.argv.slice(2)).forEach(function (features) {
        {% if is_test or to_json %}
        // Get JSON:
        console.log(JSON.stringify({
            "predict": reg.predict(features)
        }));
        {% else %}
        // Get prediction:
        var result = reg.predict(features);
        if (Array.isArray(result)) {
            for (var i = 0; i < result.length; i++) {
                console.log("Result of value #" + i + " : " + result[i]);
            }
        } else {
            console.log("Result: " + result);
        }
        {% endif %}
    });
}

if (require.main === module) {
    main();
}
{% endblock %}
