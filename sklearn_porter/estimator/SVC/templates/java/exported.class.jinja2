{% block content %}
import com.google.gson.Gson;

import java.io.IOException;
import java.io.Reader;
import java.nio.file.Files;
import java.nio.file.Paths;


class {{ class_name }} {

    private enum Kernel { LINEAR, POLY, RBF, SIGMOID }
    private class Classifier {
        private int nClasses;
        private double[][] vectors;
        private double[][] coeffs;
        private double[] inters;
        private int[] weights;
        private String kernel;
        private Kernel kkernel;
        private double gamma;
        private double coef0;
        private double degree;
    }

    private Classifier clf;

    public {{ class_name }}(String file) throws IOException {
        try (Reader reader = Files.newBufferedReader(Paths.get(file))) {
            this.clf = new Gson().fromJson(reader, Classifier.class);
        }
        this.clf.nClasses = this.clf.weights.length;
        this.clf.kkernel = Kernel.valueOf(this.clf.kernel.toUpperCase());
    }

{% include 'labels' %}

    // The power with an integer exponent (by repeated squaring) like libsvm:
    private static double powi(double base, int times) {
        double tmp = base, ret = 1.;
        for (int t = times; t > 0; t /= 2) {
            if (t % 2 == 1) {
                ret *= tmp;
            }
            tmp = tmp * tmp;
        }
        return ret;
    }

    public int predictIndex(double[] features) {
        double[] kernels = new double[this.clf.vectors.length];
        double kernel;
        switch (this.clf.kkernel) {
            case LINEAR:
                // <x,x'>
                for (int i = 0; i < this.clf.vectors.length; i++) {
                    kernel = 0.;
                    for (int j = 0; j < this.clf.vectors[i].length; j++) {
                        kernel += this.clf.vectors[i][j] * features[j];
                    }
                    kernels[i] = kernel;
                }
                break;
            case POLY:
                // (y<x,x'>+r)^d
                for (int i = 0; i < this.clf.vectors.length; i++) {
                    kernel = 0.;
                    for (int j = 0; j < this.clf.vectors[i].length; j++) {
                        kernel += this.clf.vectors[i][j] * features[j];
                    }
                    kernels[i] = powi((this.clf.gamma * kernel) + this.clf.coef0, (int) this.clf.degree);
                }
                break;
            case RBF:
                // exp(-y|x-x'|^2)
                for (int i = 0; i < this.clf.vectors.length; i++) {
                    kernel = 0.;
                    for (int j = 0; j < this.clf.vectors[i].length; j++) {
                        double diff = this.clf.vectors[i][j] - features[j];
                        kernel += diff * diff;
                    }
                    kernels[i] = Math.exp(-this.clf.gamma * kernel);
                }
                break;
            case SIGMOID:
                // tanh(y<x,x'>+r)
                for (int i = 0; i < this.clf.vectors.length; i++) {
                    kernel = 0.;
                    for (int j = 0; j < this.clf.vectors[i].length; j++) {
                        kernel += this.clf.vectors[i][j] * features[j];
                    }
                    kernels[i] = Math.tanh((this.clf.gamma * kernel) + this.clf.coef0);
                }
                break;
        }

        int[] starts = new int[this.clf.weights.length];
        for (int i = 0; i < this.clf.weights.length; i++) {
            if (i != 0) {
                int start = 0;
                for (int j = 0; j < i; j++) {
                    start += this.clf.weights[j];
                }
                starts[i] = start;
            } else {
                starts[0] = 0;
            }
        }

        int[] ends = new int[this.clf.weights.length];
        for (int i = 0; i < this.clf.weights.length; i++) {
            ends[i] = this.clf.weights[i] + starts[i];
        }

        if (this.clf.nClasses == 2) {
            for (int i = 0; i < kernels.length; i++) {
                kernels[i] = -kernels[i];
            }
            double decision = 0.;
            for (int k = starts[0]; k < ends[0]; k++) {
                decision += kernels[k] * this.clf.coeffs[0][k];
            }
            for (int k = starts[1]; k < ends[1]; k++) {
                decision += kernels[k] * this.clf.coeffs[0][k];
            }
            decision += this.clf.inters[0];
            if (decision > 0) {
                return 0;
            }
            return 1;
        }

        double[] decisions = new double[this.clf.inters.length];
        for (int i = 0, d = 0, l = this.clf.weights.length; i < l; i++) {
            for (int j = i + 1; j < l; j++) {
                double tmp = 0.;
                for (int k = starts[i]; k < ends[i]; k++) {
                    tmp += this.clf.coeffs[j - 1][k] * kernels[k];
                }
                for (int k = starts[j]; k < ends[j]; k++) {
                    tmp += this.clf.coeffs[i][k] * kernels[k];
                }
                decisions[d] = tmp + this.clf.inters[d];
                d++;
            }
        }

        int[] votes = new int[this.clf.inters.length];
        for (int i = 0, d = 0, l = this.clf.weights.length; i < l; i++) {
            for (int j = i + 1; j < l; j++) {
                votes[d] = decisions[d] > 0 ? i : j;
                d++;
            }
        }

        int[] amounts = new int[this.clf.nClasses];
        for (int i = 0, l = votes.length; i < l; i++) {
            amounts[votes[i]] += 1;
        }

        int classVal = -1, classIdx = -1;
        for (int i = 0, l = amounts.length; i < l; i++) {
            if (amounts[i] > classVal) {
                classVal = amounts[i];
                classIdx = i;
            }
        }
        return classIdx;
    }

    public {{ label_type }} predict(double[] features) {
        return LABELS[this.predictIndex(features)];
    }

{% include 'samples' %}

    public static void main(String[] args) throws IOException {
        if (args.length < 1 || !args[0].endsWith(".json")) {
            throw new IllegalArgumentException("You have to pass the path to the exported model data.");
        }

        // Model data:
        String modelData = args[0];

        // Estimator:
        {{ class_name }} clf = new {{ class_name }}(modelData);

        // Features of one sample (arguments) or several samples (standard input):
        for (double[] features : readSamples(args, 1)) {
            {% if is_test or to_json %}
            // Get JSON:
            {{ label_type }} prediction = clf.predict(features);
            System.out.println("{\"predict\": " + toJson(prediction) + "}");
            {% else %}
            // Get class prediction:
            {{ label_type }} prediction = clf.predict(features);
            System.out.println("Predicted class: " + prediction);
            {% endif %}
        }

    }
}
