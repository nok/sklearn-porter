using System;
using System.Globalization;


public class {{ class_name }} {

    private enum Kernel { Linear, Poly, Rbf, Sigmoid }

    private double[][] vectors;
    private double[][] coeffs;
    private double[] inters;
    private int[] weights;
    private Kernel kernel;
    private double gamma;
    private double coef0;
    private double degree;

    public {{ class_name }}(double[][] vectors, double[][] coeffs, double[] inters, int[] weights, string kernel, double gamma, double coef0, double degree) {
        this.vectors = vectors;
        this.coeffs = coeffs;
        this.inters = inters;
        this.weights = weights;
        this.kernel = (Kernel) Enum.Parse(typeof(Kernel), kernel, true);
        this.gamma = gamma;
        this.coef0 = coef0;
        this.degree = degree;
    }

{% include 'labels' %}


    // The power with an integer exponent (by repeated squaring) like libsvm:
    private static double Powi(double b, int times) {
        double tmp = b, ret = 1.0;
        for (int t = times; t > 0; t /= 2) {
            if (t % 2 == 1) {
                ret *= tmp;
            }
            tmp = tmp * tmp;
        }
        return ret;
    }

    public int PredictIndex(double[] features) {
        double[] kernels = new double[this.vectors.Length];
        double kernel;
        switch (this.kernel) {
            case Kernel.Linear:
                // <x,x'>
                for (int i = 0; i < this.vectors.Length; i++) {
                    kernel = 0.0;
                    for (int j = 0; j < this.vectors[i].Length; j++) {
                        kernel += this.vectors[i][j] * features[j];
                    }
                    kernels[i] = kernel;
                }
                break;
            case Kernel.Poly:
                // (y<x,x'>+r)^d
                for (int i = 0; i < this.vectors.Length; i++) {
                    kernel = 0.0;
                    for (int j = 0; j < this.vectors[i].Length; j++) {
                        kernel += this.vectors[i][j] * features[j];
                    }
                    kernels[i] = Powi((this.gamma * kernel) + this.coef0, (int) this.degree);
                }
                break;
            case Kernel.Rbf:
                // exp(-y|x-x'|^2)
                for (int i = 0; i < this.vectors.Length; i++) {
                    kernel = 0.0;
                    for (int j = 0; j < this.vectors[i].Length; j++) {
                        kernel += Math.Pow(this.vectors[i][j] - features[j], 2);
                    }
                    kernels[i] = Math.Exp(-this.gamma * kernel);
                }
                break;
            case Kernel.Sigmoid:
                // tanh(y<x,x'>+r)
                for (int i = 0; i < this.vectors.Length; i++) {
                    kernel = 0.0;
                    for (int j = 0; j < this.vectors[i].Length; j++) {
                        kernel += this.vectors[i][j] * features[j];
                    }
                    kernels[i] = Math.Tanh((this.gamma * kernel) + this.coef0);
                }
                break;
        }

        int[] starts = new int[this.weights.Length];
        for (int i = 0; i < this.weights.Length; i++) {
            if (i != 0) {
                int start = 0;
                for (int j = 0; j < i; j++) {
                    start += this.weights[j];
                }
                starts[i] = start;
            } else {
                starts[0] = 0;
            }
        }

        int[] ends = new int[this.weights.Length];
        for (int i = 0; i < this.weights.Length; i++) {
            ends[i] = this.weights[i] + starts[i];
        }

        if (this.weights.Length == 2) {
            for (int i = 0; i < kernels.Length; i++) {
                kernels[i] = -kernels[i];
            }
            double decision = 0.0;
            for (int k = starts[0]; k < ends[0]; k++) {
                decision += kernels[k] * this.coeffs[0][k];
            }
            for (int k = starts[1]; k < ends[1]; k++) {
                decision += kernels[k] * this.coeffs[0][k];
            }
            decision += this.inters[0];
            if (decision > 0) {
                return 0;
            }
            return 1;
        }

        double[] decisions = new double[this.inters.Length];
        for (int i = 0, d = 0, l = this.weights.Length; i < l; i++) {
            for (int j = i + 1; j < l; j++) {
                double tmp = 0.0;
                for (int k = starts[i]; k < ends[i]; k++) {
                    tmp += this.coeffs[j - 1][k] * kernels[k];
                }
                for (int k = starts[j]; k < ends[j]; k++) {
                    tmp += this.coeffs[i][k] * kernels[k];
                }
                decisions[d] = tmp + this.inters[d];
                d++;
            }
        }

        int[] votes = new int[this.inters.Length];
        for (int i = 0, d = 0, l = this.weights.Length; i < l; i++) {
            for (int j = i + 1; j < l; j++) {
                votes[d] = decisions[d] > 0 ? i : j;
                d++;
            }
        }

        int[] amounts = new int[this.weights.Length];
        for (int i = 0; i < votes.Length; i++) {
            amounts[votes[i]] += 1;
        }

        int classVal = -1, classIdx = -1;
        for (int i = 0; i < amounts.Length; i++) {
            if (amounts[i] > classVal) {
                classVal = amounts[i];
                classIdx = i;
            }
        }
        return classIdx;
    }

    public {{ label_type }} Predict(double[] features) {
        return LABELS[this.PredictIndex(features)];
    }
