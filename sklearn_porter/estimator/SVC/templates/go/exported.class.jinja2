func main() {
	if len(os.Args) < 2 {
		fmt.Fprintln(os.Stderr, "You have to pass the path to the model data.")
		os.Exit(1)
	}

	{% if pipeline_create %}
	{{ pipeline_create | indent('\t') }}

	{% endif %}
	// Model data:
	jsonFile, err := os.Open(os.Args[1])
	if err != nil {
		fmt.Println(err)
	}
	defer jsonFile.Close()
	byteValue, _ := ioutil.ReadAll(jsonFile)

	// Estimator:
	var clf {{ class_name }}
	json.Unmarshal(byteValue, &clf)

	// Features of one sample (arguments) or several samples (standard input):
	readSamples(os.Args[2:], func(features []float64) {
		{% if pipeline_transform %}
		{{ pipeline_transform | indent('\t\t') }}
		{% endif %}
		{% if is_test or to_json %}
		// Get JSON:
		prediction := clf.Predict(features)
		res, _ := json.Marshal(&Response{Predict: prediction})
		fmt.Println(string(res))
		{% else %}
		// Get class prediction:
		prediction := clf.Predict(features)
		fmt.Printf("Predicted class: %v\n", prediction)
		{% endif %}
	})

}
