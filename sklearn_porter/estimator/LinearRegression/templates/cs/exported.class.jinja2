{% extends 'base.exported.class' %}

{% block content %}
using System;
using System.Globalization;
using System.IO;
using System.Text.Json;


public class {{ class_name }} {

    private class ModelData {
        public double[][] Coeffs { get; set; }
        public double[] Inters { get; set; }
    }

    private ModelData data;

    public {{ class_name }}(string file) {
        JsonSerializerOptions options = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.SnakeCaseLower };
        this.data = JsonSerializer.Deserialize<ModelData>(File.ReadAllText(file), options);
    }

    public double[] Predict(double[] features) {
        double[] values = new double[this.data.Inters.Length];
        for (int i = 0; i < this.data.Inters.Length; i++) {
            for (int j = 0; j < this.data.Coeffs[i].Length; j++) {
                values[i] += this.data.Coeffs[i][j] * features[j];
            }
            values[i] += this.data.Inters[i];
        }
        return values;
    }
{% if to_json %}

{% include 'json' %}

{% endif %}

{% include 'samples' %}


    // Load the estimator with the model data of a JSON file:
    public static {{ class_name }} Load(string path) {
        return new {{ class_name }}(path);
    }

#if !SKLEARN_PORTER_NO_MAIN
    public static void Main(string[] args) {
        if (args.Length < 1 || !args[0].EndsWith(".json")) {
            throw new ArgumentException("You have to pass the path to the exported model data.");
        }

        {% if pipeline_create %}
        {{ pipeline_create | indent('        ') }}

        {% endif %}
        // Estimator:
        {% if pipeline %}
        {{ class_name }} reg = pipeline.Estimator;
        {% else %}
        {{ class_name }} reg = {{ class_name }}.Load(args[0]);
        {% endif %}

        // Features of one sample (arguments) or several samples (standard input):
        foreach (double[] features in ReadSamples(args, 1)) {
            {% if pipeline_transform %}
            {{ pipeline_transform | indent('            ') }}
            {% endif %}
            double[] prediction = reg.Predict(features);
            {% if to_json %}
            Console.WriteLine("{\"predict\": " + ToJson({{ 'prediction' if is_multi_output else 'prediction[0]' }}) + "}");
            {% else %}
            for (int i = 0; i < prediction.Length; i++) {
                Console.WriteLine("Predicted value #" + i + ": " + prediction[i].ToString(CultureInfo.InvariantCulture));
            }
            {% endif %}
        }
    }
#endif
}
