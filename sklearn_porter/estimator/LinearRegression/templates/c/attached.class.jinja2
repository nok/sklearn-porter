{% extends 'base.attached.class' %}

{% block content %}
#include <stdlib.h>
#include <stdio.h>

#define N_FEATURES {{ n_features }}
#define N_OUTPUTS {{ n_outputs }}


{{ coeffs }}
{{ inters }}

/* Write the predicted values to `values`: */
void predict(double *values, double features[N_FEATURES]) {
    int i, j;
    for (i = 0; i < N_OUTPUTS; i++) {
        values[i] = 0.;
        for (j = 0; j < N_FEATURES; j++) {
            values[i] += coeffs[i][j] * features[j];
        }
        values[i] += inters[i];
    }
}

{% include 'samples' %}

int main(int argc, const char *argv[]) {
    /* Features of one sample (arguments) or several samples (standard input): */
    double features[N_FEATURES];
    while (read_features(features, argc, argv, 1)) {
        double prediction[N_OUTPUTS];
        predict(prediction, features);

        {% if is_test or to_json %}
        /* Get JSON: */
        {% if is_multi_output %}
        printf("{\"predict\": [");
        for (int i = 0; i < N_OUTPUTS; i++) {
            printf("%.17g", prediction[i]);
            if (i < (N_OUTPUTS - 1)) {
                printf(",");
            }
        }
        printf("]}\n");
        {% else %}
        printf("{\"predict\": %.17g}\n", prediction[0]);
        {% endif %}
        {% else %}
        /* Get predicted values: */
        for (int i = 0; i < N_OUTPUTS; i++) {
            printf("Predicted value #%d: %.17g\n", i, prediction[i]);
        }
        {% endif %}
    }

    return 0;
}
{% endblock %}
