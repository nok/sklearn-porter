{% extends 'base.combined.class' %}

{% block content %}
#include <stdlib.h>
#include <stdio.h>

#define N_FEATURES {{ n_features }}
#define N_OUTPUTS {{ n_outputs }}


/* Write the predicted values to `values`: */
void predict(double *values, double features[N_FEATURES]) {
    {% for coeffs_row in coeffs %}
    {% set i = loop.index0 %}
    values[{{ i }}] =
        {% for coeff in coeffs_row %}
        {{ coeff }} * features[{{ loop.index0 }}] +
        {% endfor %}
        {{ inters[i] }};
    {% endfor %}
}

int main(int argc, const char *argv[]) {

    if (argc != N_FEATURES + 1) {
        fprintf(stderr, "You have to pass %d features.\n", N_FEATURES);
        return 1;
    }

    /* Features: */
    double features[N_FEATURES];
    for (int i = 1; i < argc; i++) {
        features[i-1] = atof(argv[i]);
    }

    double prediction[N_OUTPUTS];
    predict(prediction, features);

    {% if is_test or to_json %}
    /* Get JSON: */
    {% if is_multi_output %}
    printf("{\"predict\": [");
    for (int i = 0; i < N_OUTPUTS; i++) {
        printf("%.17g", prediction[i]);
        if (i < (N_OUTPUTS - 1)) {
            printf(",");
        }
    }
    printf("]}");
    {% else %}
    printf("{\"predict\": %.17g}", prediction[0]);
    {% endif %}
    {% else %}
    /* Get predicted values: */
    for (int i = 0; i < N_OUTPUTS; i++) {
        printf("Predicted value #%d: %.17g\n", i, prediction[i]);
    }
    {% endif %}

    return 0;
}
{% endblock %}
