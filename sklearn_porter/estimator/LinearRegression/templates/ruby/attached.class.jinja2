{% extends 'base.attached.class' %}

{% block content %}
{% if is_test or to_json %}
require 'json'

{% endif %}
class {{ class_name }}

	def initialize(coeffs, inters)
		@coeffs = coeffs
		@inters = inters
	end

	def predict(features)
		values = Array.new(@inters.length, 0.0)
		for i in 0 ... @inters.length
			for j in 0 ... @coeffs[i].length
				values[i] += @coeffs[i][j] * features[j]
			end
			values[i] += @inters[i]
		end
		{% if is_multi_output %}
		values
		{% else %}
		values[0]
		{% endif %}
	end

end

{% if pipeline_classes %}
{{ pipeline_classes }}

{% endif %}
if __FILE__ == $0
	{% filter indent('\t', True) %}
	{% include 'samples' %}
	{% endfilter %}

	{% if pipeline_create %}
	{{ pipeline_create | indent('\t') }}

	{% endif %}
	# Model data:
	{{ coeffs }}
	{{ inters }}

	# Estimator:
	reg = {{ class_name }}.new coeffs, inters

	# Features of one sample (arguments) or several samples (standard input):
	read_samples(ARGV) do |features|
		{% if pipeline_transform %}
		{{ pipeline_transform | indent('\t\t') }}
		{% endif %}
		{% if is_test or to_json %}
		# Get JSON:
		prediction = reg.predict features
		puts JSON.generate({:predict => prediction})
		{% else %}
		# Get predicted values:
		prediction = reg.predict features
		Array(prediction).each_with_index do |value, i|
			puts "Predicted value ##{i} : #{value}"
		end
		{% endif %}
	end
end
{% endblock %}
