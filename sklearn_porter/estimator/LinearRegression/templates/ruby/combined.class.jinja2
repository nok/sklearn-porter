{% extends 'base.combined.class' %}

{% block content %}
{% if is_test or to_json %}
require 'json'

{% endif %}
class {{ class_name }}

	def self.predict(features)
		values = Array.new({{ n_outputs }}, 0.0)
		{% for coeffs_row in coeffs %}
		{% set i = loop.index0 %}
		values[{{ i }}] =
			{% for coeff in coeffs_row %}
			{{ coeff }} * features[{{ loop.index0 }}] +
			{% endfor %}
			{{ inters[i] }}
		{% endfor %}
		{% if is_multi_output %}
		values
		{% else %}
		values[0]
		{% endif %}
	end

end

{% if pipeline_classes %}
{{ pipeline_classes }}

{% endif %}
if __FILE__ == $0
	{% filter indent('\t', True) %}
	{% include 'samples' %}
	{% endfilter %}

	# Features of one sample (arguments) or several samples (standard input):
	{% if pipeline_create %}
	{{ pipeline_create | indent('\t') }}

	{% endif %}
	read_samples(ARGV) do |features|
		{% if pipeline_transform %}
		{{ pipeline_transform | indent('\t\t') }}
		{% endif %}
		{% if is_test or to_json %}
		# Get JSON:
		prediction = {{ class_name }}.predict features
		puts JSON.generate({:predict => prediction})
		{% else %}
		# Get predicted values:
		prediction = {{ class_name }}.predict features
		Array(prediction).each_with_index do |value, i|
			puts "Predicted value ##{i} : #{value}"
		end
		{% endif %}
	end
end
{% endblock %}
