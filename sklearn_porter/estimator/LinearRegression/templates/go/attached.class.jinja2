{% extends 'base.attached.class' %}

{% block content %}
package main

import (
	"bufio"
	{% if is_test or to_json %}
	"encoding/json"
	{% endif %}
	"fmt"
	"os"
	"strconv"
	"strings"
)

type {{ class_name }} struct {
	Coeffs [][]float64
	Inters []float64
}

{% if is_test or to_json %}
type Response struct {
	Predict interface{} `json:"predict"`
}

{% endif %}
func (reg {{ class_name }}) Predict(features []float64) []float64 {
	values := make([]float64, len(reg.Inters))
	for i := 0; i < len(reg.Inters); i++ {
		for j := 0; j < len(reg.Coeffs[i]); j++ {
			values[i] += reg.Coeffs[i][j] * features[j]
		}
		values[i] += reg.Inters[i]
	}
	return values
}

{% include 'samples' %}

// Model data:
{{ coeffs }}
{{ inters }}

{% if pipeline_classes %}
{{ pipeline_classes }}

{% endif %}
func main() {
	// Estimator:
	reg := {{ class_name }}{coeffs, inters}

	// Features of one sample (arguments) or several samples (standard input):
	{% if pipeline_create %}
	{{ pipeline_create | indent('\t') }}

	{% endif %}
	readSamples(os.Args[1:], func(features []float64) {
		{% if pipeline_transform %}
		{{ pipeline_transform | indent('\t\t') }}
		{% endif %}
		{% if is_test or to_json %}
		// Get JSON:
		prediction := reg.Predict(features)
		{% if is_multi_output %}
		res, _ := json.Marshal(&Response{Predict: prediction})
		{% else %}
		res, _ := json.Marshal(&Response{Predict: prediction[0]})
		{% endif %}
		fmt.Println(string(res))
		{% else %}
		// Get predicted values:
		prediction := reg.Predict(features)
		for i, value := range prediction {
			fmt.Printf("Predicted value #%d : %v\n", i, value)
		}
		{% endif %}
	})

}
{% endblock %}
