{% extends 'base.exported.class' %}

{% block content %}
package main

import (
	"bufio"
	"encoding/json"
	"fmt"
	"os"
	"strconv"
	"strings"
)

type {{ class_name }} struct {
	Coeffs [][]float64 `json:"coeffs"`
	Inters []float64 `json:"inters"`
}

{% if to_json %}
type Response struct {
	Predict interface{} `json:"predict"`
}

{% endif %}
func (reg {{ class_name }}) Predict(features []float64) []float64 {
	values := make([]float64, len(reg.Inters))
	for i := 0; i < len(reg.Inters); i++ {
		for j := 0; j < len(reg.Coeffs[i]); j++ {
			values[i] += reg.Coeffs[i][j] * features[j]
		}
		values[i] += reg.Inters[i]
	}
	return values
}

{% include 'samples' %}

{% if pipeline_classes %}
{{ pipeline_classes }}

{% endif %}
// Load the estimator with the model data of a JSON file:
func Load{{ class_name }}(path string) ({{ class_name }}, error) {
	// Model data:
	byteValue, err := os.ReadFile(path)
	if err != nil {
		return {{ class_name }}{}, err
	}

	// Estimator:
	var reg {{ class_name }}
	if err := json.Unmarshal(byteValue, &reg); err != nil {
		return {{ class_name }}{}, err
	}

	return reg, nil
}

func main() {
	if len(os.Args) < 2 {
		fmt.Fprintln(os.Stderr, "You have to pass the path to the model data.")
		os.Exit(1)
	}

	{% if pipeline_create %}
	{{ pipeline_create | indent('\t') }}

	{% endif %}
	// Estimator:
	{% if pipeline %}
	reg := pipeline.Estimator
	{% else %}
	reg, err := Load{{ class_name }}(os.Args[1])
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
	{% endif %}

	// Features of one sample (arguments) or several samples (standard input):
	readSamples(os.Args[2:], func(features []float64) {
		{% if pipeline_transform %}
		{{ pipeline_transform | indent('\t\t') }}
		{% endif %}
		{% if to_json %}
		// Get JSON:
		prediction := reg.Predict(features)
		{% if is_multi_output %}
		res, _ := json.Marshal(&Response{Predict: prediction})
		{% else %}
		res, _ := json.Marshal(&Response{Predict: prediction[0]})
		{% endif %}
		fmt.Println(string(res))
		{% else %}
		// Get predicted values:
		prediction := reg.Predict(features)
		for i, value := range prediction {
			fmt.Printf("Predicted value #%d : %v\n", i, value)
		}
		{% endif %}
	})

}
{% endblock %}
