{% extends 'base.attached.class' %}

{% block content %}
var {{ class_name }} = function(coeffs, inters) {

    this.coeffs = coeffs;
    this.inters = inters;

    this.predict = function(features) {
        var values = new Array(this.inters.length);
        for (var i = 0, il = this.inters.length; i < il; i++) {
            values[i] = 0.;
            for (var j = 0, jl = this.coeffs[i].length; j < jl; j++) {
                values[i] += this.coeffs[i][j] * features[j];
            }
            values[i] += this.inters[i];
        }
        {% if is_multi_output %}
        return values;
        {% else %}
        return values[0];
        {% endif %}
    };

};

{% include 'samples' %}

var main = function () {
    // Model data:
    {{ coeffs }}
    {{ inters }}

    // Estimator:
    var reg = new {{ class_name }}(coeffs, inters);

    // Features of one sample (arguments) or several samples (standard input):
    readSamples(process.argv.slice(2)).forEach(function (features) {
        {% if is_test or to_json %}
        // Get JSON:
        console.log(JSON.stringify({
            "predict": reg.predict(features)
        }));
        {% else %}
        // Get predicted values:
        var result = reg.predict(features);
        {% if is_multi_output %}
        for (var i = 0; i < result.length; i++) {
            console.log("Predicted value #" + i + ": " + result[i]);
        }
        {% else %}
        console.log("Predicted value: " + result);
        {% endif %}
        {% endif %}
    });
}

if (require.main === module) {
    main();
}
{% endblock %}
