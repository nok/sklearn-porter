{% extends 'base.combined.class' %}

{% block content %}
var {{ class_name }} = function() {

    this.predict = function(features) {
        var values = new Array({{ n_outputs }});
        {% for coeffs_row in coeffs %}
        {% set i = loop.index0 %}
        values[{{ i }}] =
            {% for coeff in coeffs_row %}
            {{ coeff }} * features[{{ loop.index0 }}] +
            {% endfor %}
            {{ inters[i] }};
        {% endfor %}
        {% if is_multi_output %}
        return values;
        {% else %}
        return values[0];
        {% endif %}
    };

};

var main = function () {
    if (typeof process !== 'undefined' && typeof process.argv !== 'undefined') {
        if (process.argv.length - 2 !== {{ n_features }}) {
            var IllegalArgumentException = function(message) {
                this.message = message;
                this.name = "IllegalArgumentException";
            }
            throw new IllegalArgumentException("You have to pass {{ n_features }} features.");
        }
    }

    // Features:
    var features = process.argv.slice(2);
    for (var i = 0; i < features.length; i++) {
        features[i] = parseFloat(features[i]);
    }

    // Estimator:
    var reg = new {{ class_name }}();

    {% if is_test or to_json %}
    // Get JSON:
    console.log(JSON.stringify({
        "predict": reg.predict(features)
    }));
    {% else %}
    // Get predicted values:
    var result = reg.predict(features);
    {% if is_multi_output %}
    for (var i = 0; i < result.length; i++) {
        console.log("Predicted value #" + i + ": " + result[i]);
    }
    {% else %}
    console.log("Predicted value: " + result);
    {% endif %}
    {% endif %}
}

if (require.main === module) {
    main();
}
{% endblock %}
