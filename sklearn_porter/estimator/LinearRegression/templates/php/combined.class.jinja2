{% extends 'base.combined.class' %}

{% block content %}
class {{ class_name }} {

    public static function predict($features) {
        $values = array();
        {% for coeffs_row in coeffs %}
        {% set i = loop.index0 %}
        $values[{{ i }}] =
            {% for coeff in coeffs_row %}
            {{ coeff }} * $features[{{ loop.index0 }}] +
            {% endfor %}
            {{ inters[i] }};
        {% endfor %}
        {% if is_multi_output %}
        return $values;
        {% else %}
        return $values[0];
        {% endif %}
    }

}

if ($argc > 1) {

    // Features:
    array_shift($argv);
    $features = array_map('floatval', $argv);
    if (count($features) != {{ n_features }}) {
        fwrite(STDERR, "You have to pass {{ n_features }} features.\n");
        exit(1);
    }

    {% if is_test or to_json %}
    // Get JSON:
    $prediction = {{ class_name }}::predict($features);
    fwrite(STDOUT, json_encode(array("predict" => $prediction)));
    {% else %}
    // Get predicted values:
    $prediction = {{ class_name }}::predict($features);
    {% if is_multi_output %}
    for ($i = 0; $i < count($prediction); $i++) {
        fwrite(STDOUT, "Predicted value #" . strval($i) . " = " . strval($prediction[$i]) . "\n");
    }
    {% else %}
    fwrite(STDOUT, "Predicted value: " . strval($prediction) . "\n");
    {% endif %}
    {% endif %}

}
{% endblock %}
