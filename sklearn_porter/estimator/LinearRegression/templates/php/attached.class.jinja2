{% extends 'base.attached.class' %}

{% block content %}
class {{ class_name }} {

    private $coeffs;
    private $inters;

    public function __construct($coeffs, $inters) {
        $this->coeffs = $coeffs;
        $this->inters = $inters;
    }

    public function predict($features) {
        $values = array();
        for ($i = 0, $il = count($this->inters); $i < $il; $i++) {
            $values[$i] = 0.;
            for ($j = 0, $jl = count($this->coeffs[$i]); $j < $jl; $j++) {
                $values[$i] += $this->coeffs[$i][$j] * $features[$j];
            }
            $values[$i] += $this->inters[$i];
        }
        {% if is_multi_output %}
        return $values;
        {% else %}
        return $values[0];
        {% endif %}
    }

}

{% if pipeline_classes %}
{{ pipeline_classes }}

{% endif %}
if (PHP_SAPI === 'cli' && realpath($argv[0]) === __FILE__) {
    {% filter indent(4, True) %}
    {% include 'samples' %}
    {% endfilter %}

    array_shift($argv);

    {% if pipeline_create %}
    {{ pipeline_create | indent('    ') }}

    {% endif %}
    // Model data:
    {{ coeffs }}
    {{ inters }}

    // Estimator:
    $reg = new {{ class_name }}($coeffs, $inters);

    // Features of one sample (arguments) or several samples (standard input):
    foreach (readSamples($argv) as $features) {
        {% if pipeline_transform %}
        {{ pipeline_transform | indent('        ') }}
        {% endif %}
        {% if is_test or to_json %}
        // Get JSON:
        $prediction = $reg->predict($features);
        fwrite(STDOUT, json_encode(array("predict" => $prediction)) . "\n");
        {% else %}
        // Get predicted values:
        $prediction = $reg->predict($features);
        {% if is_multi_output %}
        for ($i = 0; $i < count($prediction); $i++) {
            fwrite(STDOUT, "Predicted value #" . strval($i) . " = " . strval($prediction[$i]) . "\n");
        }
        {% else %}
        fwrite(STDOUT, "Predicted value: " . strval($prediction) . "\n");
        {% endif %}
        {% endif %}
    }

}
{% endblock %}
