{% extends 'base.combined.class' %}

{% block content %}
{% if (is_test or to_json) and is_multi_output %}
import java.util.Arrays;


{% endif %}
class {{ class_name }} {

    public static double[] predict(double[] features) {
        double[] values = new double[{{ n_outputs }}];
        {% for coeffs_row in coeffs %}
        {% set i = loop.index0 %}
        values[{{ i }}] =
            {% for coeff in coeffs_row %}
            {{ coeff }} * features[{{ loop.index0 }}] +
            {% endfor %}
            {{ inters[i] }};
        {% endfor %}
        return values;
    }

{% include 'samples' %}

    public static void main(String[] args) {
        // Features of one sample (arguments) or several samples (standard input):
        {% if pipeline_create %}
        {{ pipeline_create | indent('        ') }}

        {% endif %}
        for (double[] features : readSamples(args, 0)) {
            {% if pipeline_transform %}
            {{ pipeline_transform | indent('            ') }}
            {% endif %}
            {% if is_test or to_json %}
            // Get JSON:
            double[] prediction = {{ class_name }}.predict(features);
            {% if is_multi_output %}
            System.out.println("{\"predict\": " + Arrays.toString(prediction) + "}");
            {% else %}
            System.out.println("{\"predict\": " + String.valueOf(prediction[0]) + "}");
            {% endif %}
            {% else %}
            // Get predicted values:
            double[] prediction = {{ class_name }}.predict(features);
            for (int i = 0; i < prediction.length; i++) {
                System.out.println("Predicted value #" + i + " : " + String.valueOf(prediction[i]));
            }
            {% endif %}
        }

    }
}
{% if pipeline_classes %}

{{ pipeline_classes }}
{% endif %}
{% endblock %}
