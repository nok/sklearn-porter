{% extends 'base.combined.class' %}

{% block content %}
var {{ class_name }} = function() {

    var forest = [];

    {{ trees | indent(4) }}

    var inits = [{{ inits }}];

    // Add the values of the trees of all stages to the initial raw predictions:
    var decisionFunction = function(features) {
        var raw = inits.slice();
        for (var i = 0; i < forest.length; i += raw.length) {
            for (var k = 0; k < raw.length; k++) {
                raw[k] += forest[i + k](features)[0];
            }
        }
        return raw;
    };

{% include 'labels' %}

    {% filter indent(4, True) %}
    {% include 'methods' %}
    {% endfilter %}


};

{% include 'samples' %}

{% if pipeline_classes %}
{{ pipeline_classes }}

{% endif %}
var main = function () {
    // Estimator:
    var clf = new {{ class_name }}();

    // Features of one sample (arguments) or several samples (standard input):
    {% if pipeline_create %}
    {{ pipeline_create | indent('    ') }}

    {% endif %}
    readSamples(process.argv.slice(2)).forEach(function (features) {
        {% if pipeline_transform %}
        {{ pipeline_transform | indent('        ') }}
        {% endif %}
        {% filter indent(8, True) %}
        {% include 'output' %}
        {% endfilter %}
    });
}

if (require.main === module) {
    main();
}
