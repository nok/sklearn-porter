{% extends 'base.attached.class' %}

{% block content %}
using System;
using System.Globalization;


public class {{ class_name }} {

    {% filter indent(4, True) %}
    {% include 'forest' %}


    {% include 'decision' %}
    {% endfilter %}


{% include 'labels' %}


    {% filter indent(4, True) %}
    {% include 'methods' %}
    {% endfilter %}


    public {{ class_name }}() {
        this.forest = new Tree[] {
            {% for i in range(n_estimators) %}
            Tree{{ i }}(){% if not loop.last %},{% endif %}

            {% endfor %}
        };
        this.inits = new double[] {{ '{' }}{{ inits }}{{ '}' }};
    }

    // Model data:
    {{ model | indent(4) }}
{% if is_test or to_json %}

{% include 'json' %}

{% endif %}

{% include 'samples' %}


    public static void Main(string[] args) {
        // Estimator:
        {{ class_name }} clf = new {{ class_name }}();

        // Features of one sample (arguments) or several samples (standard input):
        foreach (double[] features in ReadSamples(args, 0)) {
            {% filter indent(12, True) %}
            {% include 'output' %}
            {% endfilter %}
        }
    }
}
{% endblock %}