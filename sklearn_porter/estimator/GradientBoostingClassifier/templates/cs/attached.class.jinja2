{% extends 'base.attached.class' %}

{% block content %}
using System;
using System.Globalization;


public class {{ class_name }} {

    {% filter indent(4, True) %}
    {% include 'forest' %}


    {% include 'decision' %}
    {% endfilter %}


{% include 'labels' %}


    {% filter indent(4, True) %}
    {% include 'methods' %}
    {% endfilter %}


    public {{ class_name }}() {
        this.forest = new Tree[] {
            {% for i in range(n_estimators) %}
            Tree{{ i }}(){% if not loop.last %},{% endif %}

            {% endfor %}
        };
        this.inits = new double[] {{ '{' }}{{ inits }}{{ '}' }};
    }

    // Model data:
    {{ model | indent(4) }}
{% if to_json %}

{% include 'json' %}

{% endif %}

{% include 'samples' %}


    // Create the estimator with the model data of this file:
    public static {{ class_name }} Create() {
        return new {{ class_name }}();
    }

#if !SKLEARN_PORTER_NO_MAIN
    public static void Main(string[] args) {
        {% if pipeline_create %}
        {{ pipeline_create | indent('        ') }}

        {% endif %}
        // Estimator:
        {% if pipeline %}
        {{ class_name }} clf = pipeline.Estimator;
        {% else %}
        {{ class_name }} clf = {{ class_name }}.Create();
        {% endif %}

        // Features of one sample (arguments) or several samples (standard input):
        foreach (double[] features in ReadSamples(args, 0)) {
            {% if pipeline_transform %}
            {{ pipeline_transform | indent('            ') }}
            {% endif %}
            {% filter indent(12, True) %}
            {% include 'output' %}
            {% endfilter %}
        }
    }
#endif
}
{% if pipeline_classes %}

{{ pipeline_classes }}
{% endif %}
{% endblock %}