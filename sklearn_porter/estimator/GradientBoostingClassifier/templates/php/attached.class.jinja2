{% extends 'base.attached.class' %}

{% block content %}
class {{ class_name }} {

    {% filter indent(4, True) %}
    {% include 'forest' %}


    {% include 'decision' %}
    {% endfilter %}


{% include 'labels' %}

    {% filter indent(4, True) %}
    {% include 'methods' %}
    {% endfilter %}


    // Create the estimator with the model data of this file:
    public static function create() {
        // Model data:
        {{ model }}

        return new {{ class_name }}($model, array({{ inits }}));
    }
}

{% if pipeline_classes %}
{{ pipeline_classes }}

{% endif %}
if (PHP_SAPI === 'cli' && realpath($argv[0]) === __FILE__) {
    {% filter indent(4, True) %}
    {% include 'samples' %}
    {% endfilter %}


    array_shift($argv);

    {% if pipeline_create %}
    {{ pipeline_create | indent('    ') }}

    {% endif %}
    // Estimator:
    {% if pipeline %}
    $clf = $pipeline->estimator;
    {% else %}
    $clf = {{ class_name }}::create();
    {% endif %}

    // Features of one sample (arguments) or several samples (standard input):
    foreach (readSamples($argv) as $features) {
        {% if pipeline_transform %}
        {{ pipeline_transform | indent('        ') }}
        {% endif %}
        {% filter indent(8, True) %}
        {% include 'output' %}
        {% endfilter %}
    }

}
{% endblock %}
