{% extends 'base.exported.class' %}

{% block content %}
require 'json'


class {{ class_name }}

	{% filter indent('\t', True) %}
	{% include 'forest' %}


	{% include 'decision' %}
	{% endfilter %}


{% include 'labels' %}

	{% filter indent('\t', True) %}
	{% include 'methods' %}
	{% endfilter %}


	# Load the estimator with the model data of a JSON file:
	def self.load(path)
		# Model data:
		model = JSON.parse(File.read(path))

		{{ class_name }}.new model['estimators'], model['inits']
	end
end

{% if pipeline_classes %}
{{ pipeline_classes }}

{% endif %}
if __FILE__ == $0
	{% filter indent('\t', True) %}
	{% include 'samples' %}
	{% endfilter %}


	raise "You have to pass the path to the model data." if ARGV.empty?

	{% if pipeline_create %}
	{{ pipeline_create | indent('\t') }}

	{% endif %}
	# Estimator:
	clf = {{ class_name }}.load(ARGV.shift)

	# Features of one sample (arguments) or several samples (standard input):
	read_samples(ARGV) do |features|
		{% if pipeline_transform %}
		{{ pipeline_transform | indent('\t\t') }}
		{% endif %}
		{% filter indent('\t\t', True) %}
		{% include 'output' %}
		{% endfilter %}
	end
end
{% endblock %}
