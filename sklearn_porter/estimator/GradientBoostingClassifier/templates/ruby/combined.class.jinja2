{% extends 'base.combined.class' %}

{% block content %}
{% if is_test or to_json %}
require 'json'


{% endif %}
class {{ class_name }}

	{{ trees | indent('\t') }}

	INITS = [{{ inits }}]

	# Add the values of the trees of all stages to the initial raw predictions:
	def _decision_function(features)
		raw = INITS.dup
		{% for i in range(n_estimators) %}
		raw[{{ i % n_trees_per_stage }}] += {{ class_name }}.compute_{{ i }}(features)[0]
		{% endfor %}
		raw
	end

{% include 'labels' %}

	{% filter indent('\t', True) %}
	{% include 'methods' %}
	{% endfilter %}


end

{% if pipeline_classes %}
{{ pipeline_classes }}

{% endif %}
if __FILE__ == $0
	{% filter indent('\t', True) %}
	{% include 'samples' %}
	{% endfilter %}


	# Estimator:
	clf = {{ class_name }}.new

	# Features of one sample (arguments) or several samples (standard input):
	{% if pipeline_create %}
	{{ pipeline_create | indent('\t') }}

	{% endif %}
	read_samples(ARGV) do |features|
		{% if pipeline_transform %}
		{{ pipeline_transform | indent('\t\t') }}
		{% endif %}
		{% filter indent('\t\t', True) %}
		{% include 'output' %}
		{% endfilter %}
	end
end
{% endblock %}
