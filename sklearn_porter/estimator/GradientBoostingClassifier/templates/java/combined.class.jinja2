{% extends 'base.combined.class' %}

{% block content %}
{% if is_test or to_json %}
import java.util.Arrays;

{% endif %}
class {{ class_name }} {

    {{ trees | indent(4) }}

    private static final double[] INITS = {{ '{' }}{{ inits }}{{ '}' }};

    // Add the values of the trees of all stages to the initial raw predictions:
    private double[] decisionFunction(double[] features) {
        double[] raw = INITS.clone();
        {% for i in range(n_estimators) %}
        raw[{{ i % n_trees_per_stage }}] += compute_{{ i }}(features)[0];
        {% endfor %}
        return raw;
    }

{% include 'labels' %}

    {% filter indent(4, True) %}
    {% include 'methods' %}
    {% endfilter %}


{% include 'samples' %}

    public static void main(String[] args) {
        // Estimator:
        {{ class_name }} clf = new {{ class_name }}();

        // Features of one sample (arguments) or several samples (standard input):
        for (double[] features : readSamples(args, 0)) {
            {% filter indent(12, True) %}
            {% include 'output' %}
            {% endfilter %}
        }

    }
}
{% endblock %}
