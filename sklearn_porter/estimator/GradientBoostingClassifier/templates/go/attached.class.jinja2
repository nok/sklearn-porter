{% extends 'base.attached.class' %}

{% block content %}
package main

import (
	"bufio"
	"encoding/json"
	"fmt"
	"math"
	"os"
	"strconv"
	"strings"
)

{% include 'labels' %}

{% if to_json %}
type Response struct {
	Predict {{ label_type }} `json:"predict"`
	PredictProba []float64 `json:"predict_proba"`
}

{% endif %}
{% include 'forest' %}


{% include 'decision' %}


{% include 'methods' %}


{% include 'samples' %}

// Model data:
{{ model }}

{% if pipeline_classes %}
{{ pipeline_classes }}

{% endif %}
// Create the estimator with the model data of this file:
func New{{ class_name }}() {{ class_name }} {
	clf := {{ class_name }}{Inits: []float64{ {{- inits -}} }}
	if err := json.Unmarshal([]byte(model), &clf.Trees); err != nil {
		panic(err)
	}

	return clf
}

func main() {
	{% if pipeline_create %}
	{{ pipeline_create | indent('\t') }}

	{% endif %}
	// Estimator:
	{% if pipeline %}
	clf := pipeline.Estimator
	{% else %}
	clf := New{{ class_name }}()
	{% endif %}

	// Features of one sample (arguments) or several samples (standard input):
	readSamples(os.Args[1:], func(features []float64) {
		{% if pipeline_transform %}
		{{ pipeline_transform | indent('\t\t') }}
		{% endif %}
		{% filter indent('\t\t', True) %}
		{% include 'output' %}
		{% endfilter %}
	})

}
{% endblock %}
