{% extends 'base.combined.class' %}

{% block content %}
package main

import (
	"bufio"
	{% if is_test or to_json %}
	"encoding/json"
	{% endif %}
	"fmt"
	"math"
	"os"
	"strconv"
	"strings"
)

{% include 'labels' %}

{% if is_test or to_json %}
type Response struct {
	Predict {{ label_type }} `json:"predict"`
	PredictProba []float64 `json:"predict_proba"`
}

{% endif %}
{{ trees }}

type {{ class_name }} struct {
	Inits []float64
}

// Add the values of the trees of all stages to the initial raw predictions:
func (clf {{ class_name }}) decisionFunction(features []float64) []float64 {
	raw := make([]float64, len(clf.Inits))
	copy(raw, clf.Inits)
	{% for i in range(n_estimators) %}
	raw[{{ i % n_trees_per_stage }}] += compute{{ i }}(features)[0]
	{% endfor %}
	return raw
}

{% include 'methods' %}


{% include 'samples' %}

{% if pipeline_classes %}
{{ pipeline_classes }}

{% endif %}
func main() {
	// Estimator:
	clf := {{ class_name }}{Inits: []float64{ {{- inits -}} }}

	// Features of one sample (arguments) or several samples (standard input):
	{% if pipeline_create %}
	{{ pipeline_create | indent('\t') }}

	{% endif %}
	readSamples(os.Args[1:], func(features []float64) {
		{% if pipeline_transform %}
		{{ pipeline_transform | indent('\t\t') }}
		{% endif %}
		{% filter indent('\t\t', True) %}
		{% include 'output' %}
		{% endfilter %}
	})

}
{% endblock %}
