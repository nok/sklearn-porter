{% include 'labels' %}


/* Compute the probabilities of the classes from the raw predictions: */
void predict_proba(double *probas, double features[N_FEATURES]) {
    double raw[N_TREES];
    decision_function(raw, features);
    {% if is_binary %}
    double proba = 1. / (1. + exp(-{% if is_exponential %}2. * {% endif %}raw[0]));
    probas[0] = 1. - proba;
    probas[1] = proba;
    {% else %}
    double max = raw[0], sum = 0.;
    for (int k = 1; k < N_CLASSES; k++) {
        max = raw[k] > max ? raw[k] : max;
    }
    for (int k = 0; k < N_CLASSES; k++) {
        probas[k] = exp(raw[k] - max);
        sum += probas[k];
    }
    for (int k = 0; k < N_CLASSES; k++) {
        probas[k] /= sum;
    }
    {% endif %}
}

int predict_index(double features[N_FEATURES]) {
    double raw[N_TREES];
    decision_function(raw, features);
    {% if is_binary %}
    return raw[0] >= 0 ? 1 : 0;
    {% else %}
    int idx = 0;
    for (int k = 1; k < N_CLASSES; k++) {
        idx = raw[k] > raw[idx] ? k : idx;
    }
    return idx;
    {% endif %}
}

Label predict(double features[N_FEATURES]) {
    return labels[predict_index(features)];
}
