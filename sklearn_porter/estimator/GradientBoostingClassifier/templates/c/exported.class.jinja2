{% extends 'base.exported.class' %}

{% block content %}
#include <math.h>

#define N_FEATURES {{ n_features }}
#define N_CLASSES {{ n_classes }}
#define N_TREES {{ n_trees_per_stage }} /* the number of trees per stage */

{% include 'tree' %}


int n_estimators;
Tree *trees;
double *inits;

void load(const char *path) {
    JsonValue *data = json_read(path);
    JsonValue *estimators = json_get(data, "estimators");
    n_estimators = estimators->length;
    trees = malloc(n_estimators * sizeof(Tree));
    for (int i = 0; i < n_estimators; i++) {
        JsonValue *tree = estimators->items[i];
        trees[i].lefts = json_ints(json_get(tree, "lefts"));
        trees[i].rights = json_ints(json_get(tree, "rights"));
        trees[i].thresholds = json_doubles(json_get(tree, "thresholds"));
        trees[i].indices = json_ints(json_get(tree, "indices"));
        trees[i].missing_go_to_left = json_ints(json_get(tree, "missing_go_to_left"));
        trees[i].values = json_doubles(json_get(tree, "values"));
    }
    inits = json_doubles(json_get(data, "inits"));
    json_free(data);
}

{% include 'compute' %}


/* Add the values of the trees of all stages to the initial raw predictions: */
void decision_function(double *raw, double features[N_FEATURES]) {
    for (int k = 0; k < N_TREES; k++) {
        raw[k] = inits[k];
    }
    for (int i = 0; i < n_estimators; i += N_TREES) {
        for (int k = 0; k < N_TREES; k++) {
            raw[k] += compute(&trees[i + k], features);
        }
    }
}

{% include 'methods' %}


{% include 'samples' %}

{% if pipeline_classes %}
{{ pipeline_classes }}

{% endif %}
int main(int argc, const char *argv[]) {
    if (argc < 2) {
        fprintf(stderr, "You have to pass the path to the model data.\n");
        return 1;
    }

    {% if pipeline_create %}
    {{ pipeline_create | indent('    ') }}

    {% endif %}
    /* Model data: */
    load(argv[1]);

    /* Features of one sample (arguments) or several samples (standard input): */
    double features[N_FEATURES];
    while (read_features(features, argc, argv, 2)) {
        {% if pipeline_transform %}
        {{ pipeline_transform | indent('        ') }}
        {% endif %}
        {% filter indent(8, True) %}
        {% include 'output' %}
        {% endfilter %}
    }

    return 0;
}
{% endblock %}
