{% extends 'base.exported.class' %}

{% block content %}
require 'json'


class {{ class_name }}

	def initialize(path)
		data = JSON.parse(File.read(path))
		@coeffs = data['coeffs']
		@inters = data['inters']
	end

	def decision_function(features)
		decisions = Array.new(@inters.length, 0.0)
		for i in 0 ... @inters.length
			for j in 0 ... @coeffs[i].length
				decisions[i] += @coeffs[i][j] * features[j]
			end
			decisions[i] += @inters[i]
		end
		decisions
	end

	def predict(features)
		decisions = decision_function features
		{% if is_multilabel %}
decisions.map { |decision| decision > 0 ? 1 : 0 }
		{% elif is_binary %}
		decisions[0] > 0 ? 1 : 0
		{% else %}
		class_idx = 0
		for i in 1 ... decisions.length
			class_idx = i if decisions[i] > decisions[class_idx]
		end
		class_idx
		{% endif %}
	end
	{% if with_proba %}

	def predict_proba(features)
		decisions = decision_function features
		{% if is_binary %}
		prob = 1.0 / (1.0 + Math.exp(-decisions[0]))
		[1.0 - prob, prob]
		{% else %}
		max = decisions.max
		decisions = decisions.map { |decision| Math.exp(decision - max) }
		sum = decisions.sum
		decisions.map { |decision| decision / sum }
		{% endif %}
	end
	{% endif %}

end

if __FILE__ == $0
	if ARGV.length != {{ n_features + 1 }}
		raise "You have to pass the path to the model data and {{ n_features }} features."
	end

	# Model data:
	modelData = ARGV.shift

	# Features:
	features = ARGV.collect(&:to_f)

	# Estimator:
	clf = {{ class_name }}.new modelData

	{% if is_test or to_json %}
	# Get JSON:
	prediction = clf.predict features
	{% if with_proba %}
	probabilities = clf.predict_proba features
	puts JSON.generate({:predict => prediction, :predict_proba => probabilities})
	{% else %}
	puts JSON.generate({:predict => prediction})
	{% endif %}
	{% else %}
	# Get class prediction:
	prediction = clf.predict features
	puts "{{ 'Predicted labels: ' if is_multilabel else 'Predicted class: #' }}#{prediction}"
	{% if with_proba %}

	# Get class probabilities:
	probabilities = clf.predict_proba features
	for i in 0 ... probabilities.length
		puts "Probability of class ##{i} : #{probabilities[i]}"
	end
	{% endif %}
	{% endif %}
end
{% endblock %}
