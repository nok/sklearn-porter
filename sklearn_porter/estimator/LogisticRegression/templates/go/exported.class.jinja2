{% extends 'base.exported.class' %}

{% block content %}
package main

import (
	"bufio"
	"encoding/json"
	"fmt"
	{% if with_proba %}
	"math"
	{% endif %}
	"os"
	"strconv"
	"strings"
)

{% include 'labels' %}

type {{ class_name }} struct {
	Coeffs [][]float64 `json:"coeffs"`
	Inters []float64 `json:"inters"`
}

{% if is_test or to_json %}
type Response struct {
	Predict {{ '[]int' if is_multilabel else label_type }} `json:"predict"`
	{% if with_proba %}
	PredictProba []float64 `json:"predict_proba"`
	{% endif %}
}

{% endif %}
func (clf {{ class_name }}) DecisionFunction(features []float64) []float64 {
	decisions := make([]float64, len(clf.Inters))
	for i := 0; i < len(clf.Inters); i++ {
		for j := 0; j < len(clf.Coeffs[i]); j++ {
			decisions[i] += clf.Coeffs[i][j] * features[j]
		}
		decisions[i] += clf.Inters[i]
	}
	return decisions
}

func (clf {{ class_name }}) {{ 'Predict' if is_multilabel else 'PredictIndex' }}(features []float64) {{ '[]int' if is_multilabel else 'int' }} {
	decisions := clf.DecisionFunction(features)
	{% if is_multilabel %}
	labels := make([]int, len(decisions))
	for i := 0; i < len(decisions); i++ {
		if decisions[i] > 0 {
			labels[i] = 1
		}
	}
	return labels
	{% elif is_binary %}
	if decisions[0] > 0 {
		return 1
	}
	return 0
	{% else %}
	classIdx := 0
	for i := 1; i < len(decisions); i++ {
		if decisions[i] > decisions[classIdx] {
			classIdx = i
		}
	}
	return classIdx
	{% endif %}
}
{% if not is_multilabel %}

func (clf {{ class_name }}) Predict(features []float64) {{ label_type }} {
	return labels[clf.PredictIndex(features)]
}
{% endif %}
{% if with_proba %}

func (clf {{ class_name }}) PredictProba(features []float64) []float64 {
	decisions := clf.DecisionFunction(features)
	{% if is_binary %}
	prob := 1.0 / (1.0 + math.Exp(-decisions[0]))
	return []float64{1.0 - prob, prob}
	{% else %}
	max, sum := decisions[0], 0.0
	for i := 1; i < len(decisions); i++ {
		if decisions[i] > max {
			max = decisions[i]
		}
	}
	for i := 0; i < len(decisions); i++ {
		decisions[i] = math.Exp(decisions[i] - max)
		sum += decisions[i]
	}
	for i := 0; i < len(decisions); i++ {
		decisions[i] /= sum
	}
	return decisions
	{% endif %}
}
{% endif %}

{% include 'samples' %}

func main() {
	if len(os.Args) < 2 {
		fmt.Fprintln(os.Stderr, "You have to pass the path to the model data.")
		os.Exit(1)
	}

	// Model data:
	byteValue, err := os.ReadFile(os.Args[1])
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}

	// Estimator:
	var clf {{ class_name }}
	json.Unmarshal(byteValue, &clf)

	// Features of one sample (arguments) or several samples (standard input):
	readSamples(os.Args[2:], func(features []float64) {
		{% if is_test or to_json %}
		// Get JSON:
		res, _ := json.Marshal(&Response{
			Predict: clf.Predict(features),
			{% if with_proba %}
			PredictProba: clf.PredictProba(features),
			{% endif %}
		})
		fmt.Println(string(res))
		{% else %}
		// Get class prediction:
		prediction := clf.Predict(features)
		fmt.Printf("{{ 'Predicted labels: ' if is_multilabel else 'Predicted class: ' }}%v\n", prediction)
		{% if with_proba %}

		// Get class probabilities:
		probabilities := clf.PredictProba(features)
		for i, probability := range probabilities {
			fmt.Printf("Probability of class #%d : %f\n", i, probability)
		}
		{% endif %}
		{% endif %}
	})

}
{% endblock %}
