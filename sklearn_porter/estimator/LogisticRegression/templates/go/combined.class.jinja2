{% extends 'base.combined.class' %}

{% block content %}
package main

import (
	"bufio"
	{% if is_test or to_json %}
	"encoding/json"
	{% endif %}
	"fmt"
	{% if with_proba %}
	"math"
	{% endif %}
	"os"
	"strconv"
	"strings"
)

{% include 'labels' %}

{% if is_test or to_json %}
type Response struct {
	Predict {{ '[]int' if is_multilabel else label_type }} `json:"predict"`
	{% if with_proba %}
	PredictProba []float64 `json:"predict_proba"`
	{% endif %}
}

{% endif %}
func DecisionFunction(features []float64) []float64 {
	decisions := make([]float64, {{ n_decisions }})
	{% for coeffs_row in coeffs %}
	{% set i = loop.index0 %}
	decisions[{{ i }}] =
		{% for coeff in coeffs_row %}
		{{ coeff }} * features[{{ loop.index0 }}] +
		{% endfor %}
		{{ inters[i] }}
	{% endfor %}
	return decisions
}

func {{ 'Predict' if is_multilabel else 'PredictIndex' }}(features []float64) {{ '[]int' if is_multilabel else 'int' }} {
	decisions := DecisionFunction(features)
	{% if is_multilabel %}
	labels := make([]int, len(decisions))
	for i := 0; i < len(decisions); i++ {
		if decisions[i] > 0 {
			labels[i] = 1
		}
	}
	return labels
	{% elif is_binary %}
	if decisions[0] > 0 {
		return 1
	}
	return 0
	{% else %}
	classIdx := 0
	for i := 1; i < len(decisions); i++ {
		if decisions[i] > decisions[classIdx] {
			classIdx = i
		}
	}
	return classIdx
	{% endif %}
}
{% if not is_multilabel %}

func Predict(features []float64) {{ label_type }} {
	return labels[PredictIndex(features)]
}
{% endif %}
{% if with_proba %}

func PredictProba(features []float64) []float64 {
	decisions := DecisionFunction(features)
	{% if is_binary %}
	prob := 1.0 / (1.0 + math.Exp(-decisions[0]))
	return []float64{1.0 - prob, prob}
	{% else %}
	max, sum := decisions[0], 0.0
	for i := 1; i < len(decisions); i++ {
		if decisions[i] > max {
			max = decisions[i]
		}
	}
	for i := 0; i < len(decisions); i++ {
		decisions[i] = math.Exp(decisions[i] - max)
		sum += decisions[i]
	}
	for i := 0; i < len(decisions); i++ {
		decisions[i] /= sum
	}
	return decisions
	{% endif %}
}
{% endif %}

{% include 'samples' %}

{% if pipeline_classes %}
{{ pipeline_classes }}

{% endif %}
func main() {
	// Features of one sample (arguments) or several samples (standard input):
	{% if pipeline_create %}
	{{ pipeline_create | indent('\t') }}

	{% endif %}
	readSamples(os.Args[1:], func(features []float64) {
		{% if pipeline_transform %}
		{{ pipeline_transform | indent('\t\t') }}
		{% endif %}
		{% if is_test or to_json %}
		// Get JSON:
		res, _ := json.Marshal(&Response{
			Predict: Predict(features),
			{% if with_proba %}
			PredictProba: PredictProba(features),
			{% endif %}
		})
		fmt.Println(string(res))
		{% else %}
		// Get class prediction:
		prediction := Predict(features)
		fmt.Printf("{{ 'Predicted labels: ' if is_multilabel else 'Predicted class: ' }}%v\n", prediction)
		{% if with_proba %}

		// Get class probabilities:
		probabilities := PredictProba(features)
		for i, probability := range probabilities {
			fmt.Printf("Probability of class #%d : %f\n", i, probability)
		}
		{% endif %}
		{% endif %}
	})

}
{% endblock %}
