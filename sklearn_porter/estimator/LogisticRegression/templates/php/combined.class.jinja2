{% extends 'base.combined.class' %}

{% block content %}
class {{ class_name }} {

    public static function decisionFunction($features) {
        $decisions = array();
        {% for coeffs_row in coeffs %}
        {% set i = loop.index0 %}
        $decisions[{{ i }}] =
            {% for coeff in coeffs_row %}
            {{ coeff }} * $features[{{ loop.index0 }}] +
            {% endfor %}
            {{ inters[i] }};
        {% endfor %}
        return $decisions;
    }

{% include 'labels' %}

    public static function {{ 'predict' if is_multilabel else 'predictIndex' }}($features) {
        $decisions = {{ class_name }}::decisionFunction($features);
        {% if is_multilabel %}
return array_map(function ($decision) {
            return $decision > 0 ? 1 : 0;
        }, $decisions);
        {% elif is_binary %}
        return $decisions[0] > 0 ? 1 : 0;
        {% else %}
        $classIdx = 0;
        for ($i = 1, $l = count($decisions); $i < $l; $i++) {
            if ($decisions[$i] > $decisions[$classIdx]) {
                $classIdx = $i;
            }
        }
        return $classIdx;
        {% endif %}
    }
{% if not is_multilabel %}

    public static function predict($features) {
        return self::LABELS[self::predictIndex($features)];
    }
{% endif %}
    {% if with_proba %}

    public static function predictProba($features) {
        $decisions = {{ class_name }}::decisionFunction($features);
        {% if is_binary %}
        $prob = 1. / (1. + exp(-$decisions[0]));
        return array(1. - $prob, $prob);
        {% else %}
        $max = max($decisions);
        $sum = 0.;
        for ($i = 0, $l = count($decisions); $i < $l; $i++) {
            $decisions[$i] = exp($decisions[$i] - $max);
            $sum += $decisions[$i];
        }
        for ($i = 0, $l = count($decisions); $i < $l; $i++) {
            $decisions[$i] /= $sum;
        }
        return $decisions;
        {% endif %}
    }
    {% endif %}

}

{% if pipeline_classes %}
{{ pipeline_classes }}

{% endif %}
if (PHP_SAPI === 'cli' && realpath($argv[0]) === __FILE__) {
    {% filter indent(4, True) %}
    {% include 'samples' %}
    {% endfilter %}

    array_shift($argv);

    // Features of one sample (arguments) or several samples (standard input):
    {% if pipeline_create %}
    {{ pipeline_create | indent('    ') }}

    {% endif %}
    foreach (readSamples($argv) as $features) {
        {% if pipeline_transform %}
        {{ pipeline_transform | indent('        ') }}
        {% endif %}
        {% if is_test or to_json %}
        // Get JSON:
        $prediction = {{ class_name }}::predict($features);
        {% if with_proba %}
        $probabilities = {{ class_name }}::predictProba($features);
        fwrite(STDOUT, json_encode(array("predict" => $prediction, "predict_proba" => $probabilities)) . "\n");
        {% else %}
        fwrite(STDOUT, json_encode(array("predict" => $prediction)) . "\n");
        {% endif %}
        {% else %}
        // Get class prediction:
        $prediction = {{ class_name }}::predict($features);
        fwrite(STDOUT, "{{ 'Predicted labels: ' if is_multilabel else 'Predicted class: ' }}" . {{ "implode(', ', $prediction)" if is_multilabel else 'strval($prediction)' }} . "\n");
        {% if with_proba %}

        // Get class probabilities:
        $probabilities = {{ class_name }}::predictProba($features);
        for ($i = 0; $i < count($probabilities); $i++) {
            fwrite(STDOUT, "Probability of class #" . strval($i) . " = " . strval($probabilities[$i]) . "\n");
        }
        {% endif %}
        {% endif %}
    }

}
{% endblock %}
