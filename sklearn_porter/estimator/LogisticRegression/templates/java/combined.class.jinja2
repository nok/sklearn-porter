{% extends 'base.combined.class' %}

{% block content %}
{% if ((is_test or to_json) and with_proba) or is_multilabel %}
import java.util.Arrays;


{% endif %}
class {{ class_name }} {

    public static double[] decisionFunction(double[] features) {
        double[] decisions = new double[{{ n_decisions }}];
        {% for coeffs_row in coeffs %}
        {% set i = loop.index0 %}
        decisions[{{ i }}] =
            {% for coeff in coeffs_row %}
            {{ coeff }} * features[{{ loop.index0 }}] +
            {% endfor %}
            {{ inters[i] }};
        {% endfor %}
        return decisions;
    }

{% include 'labels' %}

    public static {{ 'int[]' if is_multilabel else 'int' }} {{ 'predict' if is_multilabel else 'predictIndex' }}(double[] features) {
        double[] decisions = decisionFunction(features);
        {% if is_multilabel %}
int[] labels = new int[decisions.length];
        for (int i = 0, l = decisions.length; i < l; i++) {
            labels[i] = decisions[i] > 0 ? 1 : 0;
        }
        return labels;
        {% elif is_binary %}
        return decisions[0] > 0 ? 1 : 0;
        {% else %}
        int classIdx = 0;
        for (int i = 1, l = decisions.length; i < l; i++) {
            if (decisions[i] > decisions[classIdx]) {
                classIdx = i;
            }
        }
        return classIdx;
        {% endif %}
    }
{% if not is_multilabel %}

    public static {{ label_type }} predict(double[] features) {
        return LABELS[predictIndex(features)];
    }
{% endif %}
    {% if with_proba %}

    public static double[] predictProba(double[] features) {
        double[] decisions = decisionFunction(features);
        {% if is_binary %}
        double prob = 1. / (1. + Math.exp(-decisions[0]));
        return new double[] {1. - prob, prob};
        {% else %}
        double max = decisions[0], sum = 0.;
        for (int i = 1, l = decisions.length; i < l; i++) {
            max = Math.max(max, decisions[i]);
        }
        for (int i = 0, l = decisions.length; i < l; i++) {
            decisions[i] = Math.exp(decisions[i] - max);
            sum += decisions[i];
        }
        for (int i = 0, l = decisions.length; i < l; i++) {
            decisions[i] /= sum;
        }
        return decisions;
        {% endif %}
    }
    {% endif %}

{% include 'samples' %}

    public static void main(String[] args) {
        // Features of one sample (arguments) or several samples (standard input):
        {% if pipeline_create %}
        {{ pipeline_create | indent('        ') }}

        {% endif %}
        for (double[] features : readSamples(args, 0)) {
            {% if pipeline_transform %}
            {{ pipeline_transform | indent('            ') }}
            {% endif %}
            {% if is_test or to_json %}
            // Get JSON:
            {{ 'int[]' if is_multilabel else label_type }} prediction = {{ class_name }}.predict(features);
            {% if with_proba %}
            double[] probabilities = {{ class_name }}.predictProba(features);
            System.out.println("{\"predict\": " + {{ 'Arrays.toString(prediction)' if is_multilabel else 'toJson(prediction)' }} + ", \"predict_proba\": " + Arrays.toString(probabilities) + "}");
            {% else %}
            System.out.println("{\"predict\": " + {{ 'Arrays.toString(prediction)' if is_multilabel else 'toJson(prediction)' }} + "}");
            {% endif %}
            {% else %}
            // Get class prediction:
            {{ 'int[]' if is_multilabel else label_type }} prediction = {{ class_name }}.predict(features);
            System.out.println("{{ 'Predicted labels: ' if is_multilabel else 'Predicted class: ' }}" + {{ 'Arrays.toString(prediction)' if is_multilabel else 'String.valueOf(prediction)' }});
            {% if with_proba %}

            // Get class probabilities:
            double[] probabilities = {{ class_name }}.predictProba(features);
            for (int i = 0; i < probabilities.length; i++) {
                System.out.println("Probability of class #" + i + " : " + String.valueOf(probabilities[i]));
            }
            {% endif %}
            {% endif %}
        }

    }
}
{% if pipeline_classes %}

{{ pipeline_classes }}
{% endif %}
{% endblock %}
