{% extends 'base.attached.class' %}

{% block content %}
{% if is_test or to_json %}
import java.util.Arrays;


{% endif %}
class {{ class_name }} {

    private double[] priors;
    private double[] norms;
    private double[][] sigmas;
    private double[][] thetas;

    public {{ class_name }}(double[] priors, double[] norms, double[][] sigmas, double[][] thetas) {
        this.priors = priors;
        this.norms = norms;
        this.sigmas = sigmas;
        this.thetas = thetas;
    }

    private int findMax(double[] nums) {
        int i = 0, l = nums.length, idx = 0;
        for (i = 0; i < l; i++) {
            idx = nums[i] > nums[idx] ? i : idx;
        }
        return idx;
    }

    private double logSumExp(double[] nums) {
        double max = nums[findMax(nums)];
        double sum = 0.;
        for (int i = 0 , il = nums.length; i < il; i++) {
            sum += Math.exp(nums[i] - max);
        }
        return max + Math.log(sum);
    }

    private double[] compute(double[] features) {
        double[] likelihoods = new double[this.sigmas.length];
        for (int i = 0, il = this.sigmas.length; i < il; i++) {
            double sum = 0.;
            for (int j = 0, jl = this.sigmas[0].length; j < jl; j++) {
                double diff = features[j] - this.thetas[i][j];
                sum += diff * diff / this.sigmas[i][j];
            }
            likelihoods[i] = Math.log(this.priors[i]) + (this.norms[i] - 0.5 * sum);
        }
        return likelihoods;
    }

{% include 'labels' %}

    public int predictIndex(double[] features) {
        return findMax(compute(features));
    }

    public {{ label_type }} predict(double[] features) {
        return LABELS[this.predictIndex(features)];
    }

    public double[] predictProba(double[] features) {
        double[] jll = compute(features);
        double sum = logSumExp(jll);
        for (int i = 0, il = jll.length; i < il; i++) {
            jll[i] = Math.exp(jll[i] - sum);
        }
        return jll;
    }

{% include 'samples' %}

    public static void main(String[] args) {
        // Model data:
        {{ priors }}
        {{ norms }}
        {{ sigmas }}
        {{ thetas }}

        // Estimator:
        {{ class_name }} clf = new {{ class_name }}(priors, norms, sigmas, thetas);

        // Features of one sample (arguments) or several samples (standard input):
        for (double[] features : readSamples(args, 0)) {
            {% if is_test or to_json %}
            // Get JSON:
            {{ label_type }} prediction = clf.predict(features);
            double[] probabilities = clf.predictProba(features);
            System.out.println("{\"predict\": " + toJson(prediction) + ", \"predict_proba\": " + String.join(",", Arrays.toString(probabilities)) + "}");
            {% else %}
            // Get class prediction:
            {{ label_type }} prediction = clf.predict(features);
            System.out.println("Predicted class: " + prediction);

            // Get class probabilities:
            double[] probabilities = clf.predictProba(features);
            for (int i = 0; i < probabilities.length; i++) {
                System.out.println("Probability of class #" + i + " : " + String.valueOf(probabilities[i]));
            }
            {% endif %}
        }

    }
}
{% endblock %}