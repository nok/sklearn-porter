{% extends 'base.attached.class' %}

{% block content %}
var {{ class_name }} = function(priors, norms, sigmas, thetas) {

    this.priors = priors;
    this.norms = norms;
    this.sigmas = sigmas;
    this.thetas = thetas;

    var _findMax = function(nums) {
        var i = 0, l = nums.length, idx = 0;
        for (; i < l; i++) {
            idx = nums[i] > nums[idx] ? i : idx;
        }
        return idx;
    };

    var _logSumExp = function(nums) {
        var i, l = nums.length;
        var max = Math.max(...nums);
        var sum = 0.;
        for (i = 0; i < l; i++) {
            sum += Math.exp(nums[i] - max);
        }
        return max + Math.log(sum);
    };

    var _compute = function(features, priors, norms, sigmas, thetas) {
        var i, il, j, jl, sum, diff,
            likelihoods = new Array(sigmas.length);
        for (i = 0, il = sigmas.length; i < il; i++) {
            sum = 0.;
            for (j = 0, jl = sigmas[0].length; j < jl; j++) {
                diff = features[j] - thetas[i][j];
                sum += diff * diff / sigmas[i][j];
            }
            likelihoods[i] = Math.log(priors[i]) + (norms[i] - 0.5 * sum);
        }
        return likelihoods;
    };

{% include 'labels' %}

    this.predictIndex = function(features) {
        return _findMax(_compute(features, this.priors, this.norms, this.sigmas, this.thetas));
    };

    this.predict = function(features) {
        return LABELS[this.predictIndex(features)];
    };

    this.predictProba = function(features) {
        var jll = _compute(features, this.priors, this.norms, this.sigmas, this.thetas);
        var sum = _logSumExp(jll);
        for (i = 0; i < jll.length; i++) {
            jll[i] = Math.exp(jll[i] - sum);
        }
        return jll;
    };

};

{% include 'samples' %}

{% if pipeline_classes %}
{{ pipeline_classes }}

{% endif %}
var main = function () {
    {% if pipeline_create %}
    {{ pipeline_create | indent('    ') }}

    {% endif %}
    // Model data:
    {{ priors }}
    {{ norms }}
    {{ sigmas }}
    {{ thetas }}

    // Estimator:
    var clf = new {{ class_name }}(priors, norms, sigmas, thetas);

    // Features of one sample (arguments) or several samples (standard input):
    readSamples(process.argv.slice(2)).forEach(function (features) {
        {% if pipeline_transform %}
        {{ pipeline_transform | indent('        ') }}
        {% endif %}
        {% if is_test or to_json %}
        // Get JSON:
        console.log(JSON.stringify({
            "predict": clf.predict(features),
            "predict_proba": clf.predictProba(features)
        }));
        {% else %}
        // Get class prediction:
        var prediction = clf.predict(features);
        console.log("Predicted class: " + prediction);

        // Get class probabilities:
        var probabilities = clf.predictProba(features);
        for (var i = 0; i < probabilities.length; i++) {
            console.log("Probability of class #" + i + " : " + probabilities[i]);
        }
        {% endif %}
    });
}

if (require.main === module) {
    main();
}
{% endblock %}