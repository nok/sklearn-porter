{% extends 'base.attached.class' %}

{% block content %}
#include <stdlib.h>
#include <stdio.h>
#include <math.h>

#define N_FEATURES {{ n_features }}
#define N_CLASSES {{ n_classes }}
#define PI 3.14159265358979323846


{{ priors }}
{{ sigmas }}
{{ thetas }}

int find_max(double nums[N_CLASSES]) {
    int i;
    int idx = 0;
    for (i = 0; i < N_CLASSES; i++) {
        idx = nums[i] > nums[idx] ? i : idx;
    }
    return idx;
}

double log_sum_exp(double nums[N_CLASSES]) {
    int i;
    double max = nums[find_max(nums)];
    double sum = 0.;
    for (i = 0; i < N_CLASSES; i++) {
        sum += exp(nums[i] - max);
    }
    return max + log(sum);
}

void compute(double *likelihoods, double features[N_FEATURES]) {
    int i, j;
    double sum, nij;
    for (i = 0; i < N_CLASSES; i++) {
        sum = 0.;
        for (j = 0; j < N_FEATURES; j++) {
            sum += log(2. * PI * sigmas[i][j]);
        }
        nij = -0.5 * sum;
        sum = 0.;
        for (j = 0; j < N_FEATURES; j++) {
            sum += pow(features[j] - thetas[i][j], 2.) / sigmas[i][j];
        }
        nij -= 0.5 * sum;
        likelihoods[i] = log(priors[i]) + nij;
    }
}

{% include 'labels' %}

int predict_index(double features[N_FEATURES]) {
    double likelihoods[N_CLASSES];
    compute(likelihoods, features);
    return find_max(likelihoods);
}

Label predict(double features[N_FEATURES]) {
    return labels[predict_index(features)];
}

void predict_proba(double *result, double features[N_FEATURES]) {
    int i;
    compute(result, features);
    double sum = log_sum_exp(result);
    for (i = 0; i < N_CLASSES; i++) {
        result[i] = exp(result[i] - sum);
    }
}

{% include 'samples' %}

int main(int argc, const char *argv[]) {
    /* Features of one sample (arguments) or several samples (standard input): */
    double features[N_FEATURES];
    while (read_features(features, argc, argv, 1)) {
        {% if is_test or to_json %}
        /* Get JSON: */
        double probabilities[N_CLASSES];
        predict_proba(probabilities, features);
        printf("{\"predict\": ");
        print_label(predict(features));
        printf(", \"predict_proba\": [");
        for (int i = 0; i < N_CLASSES; i++) {
            printf("%.17g", probabilities[i]);
            if (i < (N_CLASSES - 1)) {
                printf(",");
            }
        }
        printf("]}\n");
        {% else %}
        /* Get class prediction: */
        printf("Predicted class: ");
        print_label(predict(features));
        printf("\n");

        /* Get class probabilities: */
        double probabilities[N_CLASSES];
        predict_proba(probabilities, features);
        for (int i = 0; i < N_CLASSES; i++) {
            printf("Probability of class #%d: %.6f\n", i, probabilities[i]);
        }
        {% endif %}
    }

    return 0;
}
{% endblock %}
