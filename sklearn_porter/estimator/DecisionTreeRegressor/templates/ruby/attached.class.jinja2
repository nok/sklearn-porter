{% extends 'base.attached.class' %}

{% block content %}
{% if is_test or to_json %}
require 'json'


{% endif %}
class {{ class_name }}

	def initialize(lefts, rights, thresholds, indices, missing_go_to_left, values)
		@lefts = lefts
		@rights = rights
		@thresholds = thresholds
		@indices = indices
		@missing_go_to_left = missing_go_to_left
		@values = values
	end

	# Find the leaf and return its predicted values:
	def predict(features)
		node = 0
		while @lefts[node] != -1
			if features[@indices[node]] <= @thresholds[node] || (@missing_go_to_left[node] == 1 && features[@indices[node]].nan?)
				node = @lefts[node]
			else
				node = @rights[node]
			end
		end
		values = @values[node]
		if values.length == 1
			return values[0]
		end
		values.dup
	end

end

if __FILE__ == $0
	if ARGV.length != {{ n_features }}
		raise "You have to pass {{ n_features }} features."
	end

	# Features:
	features = ARGV.collect { |value| value.downcase == 'nan' ? Float::NAN : value.to_f }

	# Model data:
	{{ lefts }}
	{{ rights }}
	{{ thresholds }}
	{{ indices }}
	{{ missing_go_to_left }}
	{{ values }}

	# Estimator:
	reg = {{ class_name }}.new lefts, rights, thresholds, indices, missing_go_to_left, values

	{% if is_test or to_json %}
	# Get JSON:
	prediction = reg.predict features
	puts JSON.generate({:predict => prediction})
	{% else %}
	# Get predicted values:
	prediction = reg.predict features
	Array(prediction).each_with_index do |value, i|
		puts "Predicted value ##{i} : #{value}"
	end
	{% endif %}
end
{% endblock %}
