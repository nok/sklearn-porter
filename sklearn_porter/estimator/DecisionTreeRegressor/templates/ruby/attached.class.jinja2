{% extends 'base.attached.class' %}

{% block content %}
{% if is_test or to_json %}
require 'json'


{% endif %}
class {{ class_name }}

	def initialize(lefts, rights, thresholds, indices, missing_go_to_left, values)
		@lefts = lefts
		@rights = rights
		@thresholds = thresholds
		@indices = indices
		@missing_go_to_left = missing_go_to_left
		@values = values
	end

	# Find the leaf and return its predicted values:
	def predict(features)
		node = 0
		while node >= 0
			if features[@indices[node]] <= @thresholds[node] || (@missing_go_to_left[node] == 1 && features[@indices[node]].nan?)
				node = @lefts[node]
			else
				node = @rights[node]
			end
		end
		values = @values[(-node - 1) * {{ n_outputs }}, {{ n_outputs }}]
		if values.length == 1
			return values[0]
		end
		values
	end

end

{% if pipeline_classes %}
{{ pipeline_classes }}

{% endif %}
if __FILE__ == $0
	{% filter indent('\t', True) %}
	{% include 'samples' %}
	{% endfilter %}

	{% if pipeline_create %}
	{{ pipeline_create | indent('\t') }}

	{% endif %}
	# Model data:
	{{ lefts }}
	{{ rights }}
	{{ thresholds }}
	{{ indices }}
	{{ missing_go_to_left }}
	{{ values }}

	# Estimator:
	reg = {{ class_name }}.new lefts, rights, thresholds, indices, missing_go_to_left, values

	# Features of one sample (arguments) or several samples (standard input):
	read_samples(ARGV) do |features|
		{% if pipeline_transform %}
		{{ pipeline_transform | indent('\t\t') }}
		{% endif %}
		{% if is_test or to_json %}
		# Get JSON:
		prediction = reg.predict features
		puts JSON.generate({:predict => prediction})
		{% else %}
		# Get predicted values:
		prediction = reg.predict features
		Array(prediction).each_with_index do |value, i|
			puts "Predicted value ##{i} : #{value}"
		end
		{% endif %}
	end
end
{% endblock %}
