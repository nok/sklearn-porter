{% extends 'base.exported.class' %}

{% block content %}
require 'json'


class {{ class_name }}

	def initialize(path)
		data = JSON.parse(File.read(path))
		@lefts = data['lefts']
		@rights = data['rights']
		@thresholds = data['thresholds']
		@indices = data['indices']
		@missing_go_to_left = data['missing_go_to_left']
		@values = data['values']
	end

	# Find the leaf and return its predicted values:
	def predict(features)
		node = 0
		while node >= 0
			if features[@indices[node]] <= @thresholds[node] || (@missing_go_to_left[node] == 1 && features[@indices[node]].nan?)
				node = @lefts[node]
			else
				node = @rights[node]
			end
		end
		values = @values[(-node - 1) * {{ n_outputs }}, {{ n_outputs }}]
		if values.length == 1
			return values[0]
		end
		values
	end

end

if __FILE__ == $0
	{% filter indent('\t', True) %}
	{% include 'samples' %}
	{% endfilter %}

	raise "You have to pass the path to the model data." if ARGV.empty?

	# Model data:
	model_data = ARGV.shift

	# Estimator:
	reg = {{ class_name }}.new model_data

	# Features of one sample (arguments) or several samples (standard input):
	read_samples(ARGV) do |features|
		{% if is_test or to_json %}
		# Get JSON:
		prediction = reg.predict features
		puts JSON.generate({:predict => prediction})
		{% else %}
		# Get predicted values:
		prediction = reg.predict features
		Array(prediction).each_with_index do |value, i|
			puts "Predicted value ##{i} : #{value}"
		end
		{% endif %}
	end
end
{% endblock %}
