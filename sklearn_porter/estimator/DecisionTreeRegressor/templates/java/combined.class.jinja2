{% extends 'base.combined.class' %}

{% block content %}
{% if is_test or to_json %}
import java.util.Arrays;

{% endif %}
class {{ class_name }} {

    // Return the predicted values:
    public static double[] predict(double[] features) {
        double[] values = new double[{{ n_outputs }}];
        {{ tree | indent(4, True) }}
        return values;
    }

    public static void main(String[] args) {
        int nFeatures = {{ n_features }};
        if (args.length != nFeatures) {
            throw new IllegalArgumentException("You have to pass " +  String.valueOf(nFeatures) + " features.");
        }

        // Features:
        double[] features = new double[args.length];
        for (int i = 0, l = args.length; i < l; i++) {
            features[i] = args[i].equalsIgnoreCase("nan") ? Double.NaN : Double.parseDouble(args[i]);
        }

        {% if is_test or to_json %}
        // Get JSON:
        double[] prediction = {{ class_name }}.predict(features);
        String result = prediction.length == 1 ? String.valueOf(prediction[0]) : Arrays.toString(prediction);
        System.out.println("{\"predict\": " + result + "}");
        {% else %}
        // Get predicted values:
        double[] prediction = {{ class_name }}.predict(features);
        for (int i = 0; i < prediction.length; i++) {
            System.out.println("Predicted value #" + i + " : " + String.valueOf(prediction[i]));
        }
        {% endif %}

    }
}
{% endblock %}
