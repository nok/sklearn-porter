{% extends 'base.exported.class' %}

{% block content %}
import com.google.gson.Gson;
import com.google.gson.annotations.SerializedName;

import java.io.IOException;
import java.io.Reader;
import java.nio.file.Files;
import java.nio.file.Paths;
import java.util.Arrays;

class {{ class_name }} {

    private class Tree {
        private int[] lefts;
        private int[] rights;
        private double[] thresholds;
        private int[] indices;
        @SerializedName("missing_go_to_left")
        private int[] missingGoToLeft;
        private double[] values;
    }
    private Tree tree;

    public {{ class_name }}(String file) throws IOException {
        try (Reader reader = Files.newBufferedReader(Paths.get(file))) {
            this.tree = new Gson().fromJson(reader, Tree.class);
        }
    }

    // Find the leaf and return its predicted values:
    public double[] predict(double[] features) {
        int node = 0;
        while (node >= 0) {
            if (features[this.tree.indices[node]] <= this.tree.thresholds[node] || (this.tree.missingGoToLeft[node] == 1 && Double.isNaN(features[this.tree.indices[node]]))) {
                node = this.tree.lefts[node];
            } else {
                node = this.tree.rights[node];
            }
        }
        return Arrays.copyOfRange(this.tree.values, (-node - 1) * {{ n_outputs }}, -node * {{ n_outputs }});
    }

{% include 'samples' %}

    public static void main(String[] args) throws IOException {
        if (args.length < 1 || !args[0].endsWith(".json")) {
            throw new IllegalArgumentException("You have to pass the path to the exported model data.");
        }

        {% if pipeline_create %}
        {{ pipeline_create | indent('        ') }}

        {% endif %}
        // Model data:
        String modelData = args[0];

        // Estimator:
        {{ class_name }} reg = new {{ class_name }}(modelData);

        // Features of one sample (arguments) or several samples (standard input):
        for (double[] features : readSamples(args, 1)) {
            {% if pipeline_transform %}
            {{ pipeline_transform | indent('            ') }}
            {% endif %}
            {% if is_test or to_json %}
            // Get JSON:
            double[] prediction = reg.predict(features);
            String result = prediction.length == 1 ? String.valueOf(prediction[0]) : Arrays.toString(prediction);
            System.out.println("{\"predict\": " + result + "}");
            {% else %}
            // Get predicted values:
            double[] prediction = reg.predict(features);
            for (int i = 0; i < prediction.length; i++) {
                System.out.println("Predicted value #" + i + " : " + String.valueOf(prediction[i]));
            }
            {% endif %}
        }

    }
}
