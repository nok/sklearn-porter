{% extends 'base.exported.class' %}

{% block content %}
class {{ class_name }} {

    private $lefts;
    private $rights;
    private $thresholds;
    private $indices;
    private $missing_go_to_left;
    private $values;

    public function __construct($path) {
        $data = json_decode(file_get_contents($path), true);
        $this->lefts = $data['lefts'];
        $this->rights = $data['rights'];
        $this->thresholds = $data['thresholds'];
        $this->indices = $data['indices'];
        $this->missing_go_to_left = $data['missing_go_to_left'];
        $this->values = $data['values'];
    }

    // Find the leaf and return its predicted values:
    public function predict($features) {
        $node = 0;
        while ($node >= 0) {
            if ($features[$this->indices[$node]] <= $this->thresholds[$node] || ($this->missing_go_to_left[$node] == 1 && is_nan($features[$this->indices[$node]]))) {
                $node = $this->lefts[$node];
            } else {
                $node = $this->rights[$node];
            }
        }
        $values = array_slice($this->values, (-$node - 1) * {{ n_outputs }}, {{ n_outputs }});
        if (count($values) == 1) {
            return $values[0];
        }
        return $values;
    }

}

{% if pipeline_classes %}
{{ pipeline_classes }}

{% endif %}
if (PHP_SAPI === 'cli' && realpath($argv[0]) === __FILE__) {
    {% filter indent(4, True) %}
    {% include 'samples' %}
    {% endfilter %}

    if (count($argv) < 2) {
        fwrite(STDERR, "You have to pass the path to the model data.\n");
        exit(1);
    }

    array_shift($argv);

    {% if pipeline_create %}
    {{ pipeline_create | indent('    ') }}

    {% endif %}
    // Model data:
    $path = array_shift($argv);

    // Estimator:
    $reg = new {{ class_name }}($path);

    // Features of one sample (arguments) or several samples (standard input):
    foreach (readSamples($argv) as $features) {
        {% if pipeline_transform %}
        {{ pipeline_transform | indent('        ') }}
        {% endif %}
        {% if is_test or to_json %}
        // Get JSON:
        $prediction = $reg->predict($features);
        fwrite(STDOUT, json_encode(array("predict" => $prediction)) . "\n");
        {% else %}
        // Get predicted values:
        $prediction = $reg->predict($features);
        if (is_array($prediction)) {
            for ($i = 0; $i < count($prediction); $i++) {
                fwrite(STDOUT, "Predicted value #" . strval($i) . " = " . strval($prediction[$i]) . "\n");
            }
        } else {
            fwrite(STDOUT, "Predicted value: " . strval($prediction) . "\n");
        }
        {% endif %}
    }

}
{% endblock %}
