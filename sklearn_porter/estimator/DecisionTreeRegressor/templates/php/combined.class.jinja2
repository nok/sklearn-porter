{% extends 'base.combined.class' %}

{% block content %}
class {{ class_name }} {

    // Return the predicted values:
    public static function predict($features) {
        $values = array_fill(0, {{ n_outputs }}, 0.);
        {{ tree | indent(4, True) }}
        if (count($values) == 1) {
            return $values[0];
        }
        return $values;
    }

}

{% if pipeline_classes %}
{{ pipeline_classes }}

{% endif %}
if (PHP_SAPI === 'cli' && realpath($argv[0]) === __FILE__) {
    {% filter indent(4, True) %}
    {% include 'samples' %}
    {% endfilter %}

    array_shift($argv);

    // Features of one sample (arguments) or several samples (standard input):
    {% if pipeline_create %}
    {{ pipeline_create | indent('    ') }}

    {% endif %}
    foreach (readSamples($argv) as $features) {
        {% if pipeline_transform %}
        {{ pipeline_transform | indent('        ') }}
        {% endif %}
        {% if is_test or to_json %}
        // Get JSON:
        $prediction = {{ class_name }}::predict($features);
        fwrite(STDOUT, json_encode(array("predict" => $prediction)) . "\n");
        {% else %}
        // Get predicted values:
        $prediction = {{ class_name }}::predict($features);
        if (is_array($prediction)) {
            for ($i = 0; $i < count($prediction); $i++) {
                fwrite(STDOUT, "Predicted value #" . strval($i) . " = " . strval($prediction[$i]) . "\n");
            }
        } else {
            fwrite(STDOUT, "Predicted value: " . strval($prediction) . "\n");
        }
        {% endif %}
    }

}
{% endblock %}
