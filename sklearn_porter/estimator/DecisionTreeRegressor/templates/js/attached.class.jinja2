{% extends 'base.attached.class' %}

{% block content %}
var {{ class_name }} = function(lefts, rights, thresholds, indices, missingGoToLeft, values) {

    this.lefts = lefts;
    this.rights = rights;
    this.thresholds = thresholds;
    this.indices = indices;
    this.missingGoToLeft = missingGoToLeft;
    this.values = values;

    this.predict = function(features) {
        var node = 0;
        while (node >= 0) {
            if (features[this.indices[node]] <= this.thresholds[node] || (this.missingGoToLeft[node] === 1 && isNaN(features[this.indices[node]]))) {
                node = this.lefts[node];
            } else {
                node = this.rights[node];
            }
        }
        var values = this.values.slice((-node - 1) * {{ n_outputs }}, -node * {{ n_outputs }});
        if (values.length === 1) {
            return values[0];
        }
        return values;
    };

};

{% include 'samples' %}

var main = function () {
    // Model data:
    {{ lefts }}
    {{ rights }}
    {{ thresholds }}
    {{ indices }}
    {{ missing_go_to_left }}
    {{ values }}

    // Estimator:
    var reg = new {{ class_name }}(lefts, rights, thresholds, indices, missingGoToLeft, values);

    // Features of one sample (arguments) or several samples (standard input):
    readSamples(process.argv.slice(2)).forEach(function (features) {
        {% if is_test or to_json %}
        // Get JSON:
        console.log(JSON.stringify({
            "predict": reg.predict(features)
        }));
        {% else %}
        // Get prediction:
        var result = reg.predict(features);
        if (Array.isArray(result)) {
            for (var i = 0; i < result.length; i++) {
                console.log("Result of value #" + i + " : " + result[i]);
            }
        } else {
            console.log("Result: " + result);
        }
        {% endif %}
    });
}

if (require.main === module) {
    main();
}
{% endblock %}
