{% extends 'base.combined.class' %}

{% block content %}
var {{ class_name }} = function() {

    this.predict = function(features) {
        var values = new Array({{ n_outputs }}).fill(0);
        {{ tree | indent(4, True) }}
        if (values.length === 1) {
            return values[0];
        }
        return values;
    };

};

{% include 'samples' %}

var main = function () {
    // Estimator:
    var reg = new {{ class_name }}();

    // Features of one sample (arguments) or several samples (standard input):
    readSamples(process.argv.slice(2)).forEach(function (features) {
        {% if is_test or to_json %}
        // Get JSON:
        console.log(JSON.stringify({
            "predict": reg.predict(features)
        }));
        {% else %}
        // Get prediction:
        var result = reg.predict(features);
        if (Array.isArray(result)) {
            for (var i = 0; i < result.length; i++) {
                console.log("Result of value #" + i + " : " + result[i]);
            }
        } else {
            console.log("Result: " + result);
        }
        {% endif %}
    });
}

if (require.main === module) {
    main();
}
{% endblock %}
