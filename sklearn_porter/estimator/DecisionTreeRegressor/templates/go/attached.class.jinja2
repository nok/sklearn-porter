{% extends 'base.attached.class' %}

{% block content %}
package main

import (
	"bufio"
	{% if is_test or to_json %}
	"encoding/json"
	{% endif %}
	"fmt"
	"math"
	"os"
	"strconv"
	"strings"
)
{% if is_test or to_json %}
type response struct {
	Predict interface{} `json:"predict"`
}
{% endif %}

type {{ class_name }} struct {
	Lefts []int
	Rights []int
	Thresholds []float64
	Indices []int
	MissingGoToLeft []int
	Values []float64
}

// Find the leaf and return its predicted values:
func (reg {{ class_name }}) Predict(features []float64) []float64 {
	node := 0
	for node >= 0 {
		if features[reg.Indices[node]] <= reg.Thresholds[node] || (reg.MissingGoToLeft[node] == 1 && math.IsNaN(features[reg.Indices[node]])) {
			node = reg.Lefts[node]
		} else {
			node = reg.Rights[node]
		}
	}
	return reg.Values[(-node-1)*{{ n_outputs }} : -node*{{ n_outputs }}]
}

{% include 'samples' %}

// Model data:
{{ lefts }}
{{ rights }}
{{ thresholds }}
{{ indices }}
{{ missing_go_to_left }}
{{ values }}

{% if pipeline_classes %}
{{ pipeline_classes }}

{% endif %}
func main() {
	// Estimator:
	reg := {{ class_name }}{lefts, rights, thresholds, indices, missingGoToLeft, values}

	// Features of one sample (arguments) or several samples (standard input):
	{% if pipeline_create %}
	{{ pipeline_create | indent('\t') }}

	{% endif %}
	readSamples(os.Args[1:], func(features []float64) {
		{% if pipeline_transform %}
		{{ pipeline_transform | indent('\t\t') }}
		{% endif %}
		{% if is_test or to_json %}
		// Get JSON:
		prediction := reg.Predict(features)
		var res []byte
		if len(prediction) == 1 {
			res, _ = json.Marshal(&response{Predict: prediction[0]})
		} else {
			res, _ = json.Marshal(&response{Predict: prediction})
		}
		fmt.Println(string(res))
		{% else %}
		// Get predicted values:
		prediction := reg.Predict(features)
		for i, value := range prediction {
			fmt.Printf("Predicted value #%d : %v\n", i, value)
		}
		{% endif %}
	})

}
{% endblock %}
