{% extends 'base.exported.class' %}

{% block content %}
package main

import (
	"encoding/json"
	"fmt"
	"math"
	"os"
	"strconv"
)

type {{ class_name }} struct {
	Lefts []int `json:"lefts"`
	Rights []int `json:"rights"`
	Thresholds []float64 `json:"thresholds"`
	Indices []int `json:"indices"`
	MissingGoToLeft []int `json:"missing_go_to_left"`
	Values []float64 `json:"values"`
}
{% if has_infinite_thresholds %}

// UnmarshalJSON parses the infinite thresholds `1e999` and `-1e999`, which
// encoding/json rejects:
func (reg *{{ class_name }}) UnmarshalJSON(data []byte) error {
	type plain {{ class_name }}
	var aux struct {
		*plain
		Thresholds []json.Number `json:"thresholds"`
	}
	aux.plain = (*plain)(reg)
	if err := json.Unmarshal(data, &aux); err != nil {
		return err
	}
	reg.Thresholds = make([]float64, len(aux.Thresholds))
	for i, threshold := range aux.Thresholds {
		// ParseFloat returns ±Inf (and a range error) for these values:
		reg.Thresholds[i], _ = strconv.ParseFloat(string(threshold), 64)
	}
	return nil
}
{% endif %}

{% if is_test or to_json %}
type Response struct {
	Predict interface{} `json:"predict"`
}

{% endif %}
// Find the leaf and return its predicted values:
func (reg {{ class_name }}) Predict(features []float64) []float64 {
	node := 0
	for node >= 0 {
		if features[reg.Indices[node]] <= reg.Thresholds[node] || (reg.MissingGoToLeft[node] == 1 && math.IsNaN(features[reg.Indices[node]])) {
			node = reg.Lefts[node]
		} else {
			node = reg.Rights[node]
		}
	}
	return reg.Values[(-node-1)*{{ n_outputs }} : -node*{{ n_outputs }}]
}

func main() {

	if len(os.Args) != {{ n_features + 2 }} {
		fmt.Fprintln(os.Stderr, "You have to pass the path to the model data and {{ n_features }} features.")
		os.Exit(1)
	}

	// Features:
	var features []float64
	for _, arg := range os.Args[2:] {
		if n, err := strconv.ParseFloat(arg, 64); err == nil {
			features = append(features, n)
		}
	}

	// Model data:
	modelData, err := os.ReadFile(os.Args[1])
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}

	// Estimator:
	var reg {{ class_name }}
	if err := json.Unmarshal(modelData, &reg); err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}

	{% if is_test or to_json %}
	// Get JSON:
	prediction := reg.Predict(features)
	var res []byte
	if len(prediction) == 1 {
		res, _ = json.Marshal(&Response{Predict: prediction[0]})
	} else {
		res, _ = json.Marshal(&Response{Predict: prediction})
	}
	fmt.Println(string(res))
	{% else %}
	// Get predicted values:
	prediction := reg.Predict(features)
	for i, value := range prediction {
		fmt.Printf("Predicted value #%d : %v\n", i, value)
	}
	{% endif %}

}
{% endblock %}
