{% extends 'base.attached.class' %}

{% block content %}
#include <stdlib.h>
#include <stdio.h>
#include <math.h>

#define N_FEATURES {{ n_features }}
#define N_OUTPUTS {{ n_outputs }}


{{ lefts }}
{{ rights }}
{{ thresholds }}
{{ indices }}
{{ missing_go_to_left }}
{{ values }}

/* Find the leaf and return its predicted values: */
const double *predict(double features[N_FEATURES]) {
    int node = 0;
    while (node >= 0) {
        if (features[indices[node]] <= thresholds[node] || (missing_go_to_left[node] && isnan(features[indices[node]]))) {
            node = lefts[node];
        } else {
            node = rights[node];
        }
    }
    return &values[(-node - 1) * N_OUTPUTS];
}

{% include 'samples' %}

int main(int argc, const char *argv[]) {
    /* Features of one sample (arguments) or several samples (standard input): */
    double features[N_FEATURES];
    while (read_features(features, argc, argv, 1)) {
        const double *prediction = predict(features);

        {% if is_test or to_json %}
        /* Get JSON: */
        if (N_OUTPUTS == 1) {
            printf("{\"predict\": %.17g}\n", prediction[0]);
        } else {
            printf("{\"predict\": [");
            for (int i = 0; i < N_OUTPUTS; i++) {
                printf("%.17g", prediction[i]);
                if (i < (N_OUTPUTS - 1)) {
                    printf(",");
                }
            }
            printf("]}\n");
        }
        {% else %}
        /* Get predicted values: */
        for (int i = 0; i < N_OUTPUTS; i++) {
            printf("Predicted value #%d: %.17g\n", i, prediction[i]);
        }
        {% endif %}
    }

    return 0;
}
{% endblock %}
