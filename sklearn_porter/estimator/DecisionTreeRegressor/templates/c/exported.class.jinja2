{% extends 'base.exported.class' %}

{% block content %}
#include <math.h>

#define N_FEATURES {{ n_features }}
#define N_OUTPUTS {{ n_outputs }}


int *lefts;
int *rights;
double *thresholds;
int *indices;
int *missing_go_to_left;
double *values;

void load(const char *path) {
    JsonValue *data = json_read(path);
    lefts = json_ints(json_get(data, "lefts"));
    rights = json_ints(json_get(data, "rights"));
    thresholds = json_doubles(json_get(data, "thresholds"));
    indices = json_ints(json_get(data, "indices"));
    missing_go_to_left = json_ints(json_get(data, "missing_go_to_left"));
    values = json_doubles(json_get(data, "values"));
    json_free(data);
}

/* Find the leaf and return its predicted values: */
double *predict(double features[N_FEATURES]) {
    int node = 0;
    while (node >= 0) {
        if (features[indices[node]] <= thresholds[node] || (missing_go_to_left[node] && isnan(features[indices[node]]))) {
            node = lefts[node];
        } else {
            node = rights[node];
        }
    }
    return &values[(-node - 1) * N_OUTPUTS];
}

{% include 'samples' %}

int main(int argc, const char *argv[]) {
    if (argc < 2) {
        fprintf(stderr, "You have to pass the path to the model data.\n");
        return 1;
    }

    /* Model data: */
    load(argv[1]);

    /* Features of one sample (arguments) or several samples (standard input): */
    double features[N_FEATURES];
    while (read_features(features, argc, argv, 2)) {
        double *prediction = predict(features);

        {% if is_test or to_json %}
        /* Get JSON: */
        if (N_OUTPUTS == 1) {
            printf("{\"predict\": %.17g}\n", prediction[0]);
        } else {
            printf("{\"predict\": [");
            for (int i = 0; i < N_OUTPUTS; i++) {
                printf("%.17g", prediction[i]);
                if (i < (N_OUTPUTS - 1)) {
                    printf(",");
                }
            }
            printf("]}\n");
        }
        {% else %}
        /* Get predicted values: */
        for (int i = 0; i < N_OUTPUTS; i++) {
            printf("Predicted value #%d: %.17g\n", i, prediction[i]);
        }
        {% endif %}
    }

    return 0;
}
{% endblock %}
