{% extends 'base.attached.class' %}

{% block content %}
var {{ class_name }} = function(estimators, denominator, offset) {

    {% filter indent(4, True) %}
    {% include 'forest' %}
    {% endfilter %}


};

{% include 'samples' %}

{% if pipeline_classes %}
{{ pipeline_classes }}

{% endif %}
// Create the estimator with the model data of this file:
var createEstimator = function () {
    // Model data:
    {{ model }}
    var denominator = {{ denominator }};
    var offset = {{ offset }};

    return new {{ class_name }}(model, denominator, offset);
};

var main = function () {
    {% if pipeline_create %}
    {{ pipeline_create | indent('    ') }}

    {% endif %}
    // Estimator:
    var clf = createEstimator();

    // Features of one sample (arguments) or several samples (standard input):
    readSamples(process.argv.slice(2)).forEach(function (features) {
        {% if pipeline_transform %}
        {{ pipeline_transform | indent('        ') }}
        {% endif %}
        var prediction = clf.predict(features);

        {% filter indent(8, True) %}
        {% include 'output' %}
        {% endfilter %}
    });
}
{% endblock %}
