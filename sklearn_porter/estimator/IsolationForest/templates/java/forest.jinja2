private static class Tree {
    private int[] lefts;
    private int[] rights;
    private double[] thresholds;
    private int[] indices;
    private int[] missingGoToLeft;
    private double[] values;

    private Tree(int[] lefts, int[] rights, double[] thresholds, int[] indices, int[] missingGoToLeft, double[] values) {
        this.lefts = lefts;
        this.rights = rights;
        this.thresholds = thresholds;
        this.indices = indices;
        this.missingGoToLeft = missingGoToLeft;
        this.values = values;
    }

    // Find the leaf and return its path length:
    private double compute(double[] features) {
        int node = 0;
        while (node >= 0) {
            if (features[this.indices[node]] <= this.thresholds[node] || (this.missingGoToLeft[node] == 1 && Double.isNaN(features[this.indices[node]]))) {
                node = this.lefts[node];
            } else {
                node = this.rights[node];
            }
        }
        return this.values[-node - 1];
    }
}

private Tree[] forest;
private double denominator;
private double offset;

public {{ class_name }}(Tree[] forest, double denominator, double offset) {
    this.forest = forest;
    this.denominator = denominator;
    this.offset = offset;
}

// The score of a sample depends on its path lengths in all trees:
private double scoreSamples(double[] features) {
    double pathLength = 0.;
    for (Tree tree : this.forest) {
        pathLength += tree.compute(features);
    }
    return -Math.pow(2., -(pathLength / this.denominator));
}

// A sample is an outlier (-1), if its score is lower than the offset,
// otherwise an inlier (1):
public int predict(double[] features) {
    return this.scoreSamples(features) - this.offset < 0 ? -1 : 1;
}
