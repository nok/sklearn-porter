{% extends 'base.attached.class' %}

{% block content %}
require 'json'


class {{ class_name }}

	{% filter indent('\t', True) %}
	{% include 'forest' %}
	{% endfilter %}

	# Create the estimator with the model data of this file:
	def self.create
		# Model data:
		{{ model }}

		{{ class_name }}.new model, {{ denominator }}, {{ offset }}
	end
end

{% if pipeline_classes %}
{{ pipeline_classes }}

{% endif %}
if __FILE__ == $0
	{% filter indent('\t', True) %}
	{% include 'samples' %}
	{% endfilter %}

	{% if pipeline_create %}
	{{ pipeline_create | indent('\t') }}

	{% endif %}
	# Estimator:
	clf = {{ class_name }}.create

	# Features of one sample (arguments) or several samples (standard input):
	read_samples(ARGV) do |features|
		{% if pipeline_transform %}
		{{ pipeline_transform | indent('\t\t') }}
		{% endif %}
		prediction = clf.predict features

		{% filter indent('\t\t', True) %}
		{% include 'output' %}
		{% endfilter %}
	end
end
{% endblock %}
