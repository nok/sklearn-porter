{% extends 'base.attached.class' %}

{% block content %}
package main

import (
	"bufio"
	"encoding/json"
	"fmt"
	"math"
	"os"
	"strconv"
	"strings"
)

{% if to_json %}
type Response struct {
	Predict int `json:"predict"`
}

{% endif %}
{% include 'forest' %}


{% include 'samples' %}

// Model data:
{{ model }}

{% if pipeline_classes %}
{{ pipeline_classes }}

{% endif %}
// Create the estimator with the model data of this file:
func New{{ class_name }}() {{ class_name }} {
	reg := {{ class_name }}{Denominator: {{ denominator }}, Offset: {{ offset }}}
	if err := json.Unmarshal([]byte(model), &reg.Trees); err != nil {
		panic(err)
	}

	return reg
}

func main() {
	{% if pipeline_create %}
	{{ pipeline_create | indent('\t') }}

	{% endif %}
	// Estimator:
	{% if pipeline %}
	reg := pipeline.Estimator
	{% else %}
	reg := New{{ class_name }}()
	{% endif %}

	// Features of one sample (arguments) or several samples (standard input):
	readSamples(os.Args[1:], func(features []float64) {
		{% if pipeline_transform %}
		{{ pipeline_transform | indent('\t\t') }}
		{% endif %}
		prediction := reg.Predict(features)

		{% filter indent('\t\t', True) %}
		{% include 'output' %}
		{% endfilter %}
	})

}
{% endblock %}
