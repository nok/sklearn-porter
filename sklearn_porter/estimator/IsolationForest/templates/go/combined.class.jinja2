{% extends 'base.combined.class' %}

{% block content %}
package main

import (
	"bufio"
	{% if is_test or to_json %}
	"encoding/json"
	{% endif %}
	"fmt"
	"math"
	"os"
	"strconv"
	"strings"
)

{% if is_test or to_json %}
type Response struct {
	Predict int `json:"predict"`
}

{% endif %}
{{ trees }}

const denominator = {{ denominator }}
const offset = {{ offset }}

// The score of a sample depends on its path lengths in all trees:
func scoreSamples(features []float64) float64 {
	pathLength := 0.0
	{% for i in range(n_estimators) %}
	pathLength += compute{{ i }}(features)[0]
	{% endfor %}
	return -math.Pow(2, -(pathLength / denominator))
}

// A sample is an outlier (-1), if its score is lower than the offset,
// otherwise an inlier (1):
func Predict(features []float64) int {
	if scoreSamples(features)-offset < 0 {
		return -1
	}
	return 1
}

{% include 'samples' %}

func main() {
	// Features of one sample (arguments) or several samples (standard input):
	readSamples(os.Args[1:], func(features []float64) {
		prediction := Predict(features)

		{% filter indent('\t\t', True) %}
		{% include 'output' %}
		{% endfilter %}
	})

}
{% endblock %}
