{% extends 'base.attached.class' %}

{% block content %}
class {{ class_name }} {

    private $coeffs;
    private $inters;

    public function __construct($coeffs, $inters) {
        $this->coeffs = $coeffs;
        $this->inters = $inters;
    }

{% include 'labels' %}

    {% if is_binary %}
    public function predictIndex($features) {
        $prob = 0.;
        for ($i = 0, $il = count($this->coeffs); $i < $il; $i++) {
            $prob += $this->coeffs[$i] * $features[$i];
        }
        if ($prob + $this->inters > 0) {
            return 1;
        }
        return 0;
    }
    {% else %}
    public function predictIndex($features) {
        $classIdx = -1;
        $classVal = null;
        for ($i = 0, $il = count($this->inters); $i < $il; $i++) {
            $prob = 0.;
            for ($j = 0, $jl = count($this->coeffs[0]); $j < $jl; $j++) {
                $prob += $this->coeffs[$i][$j] * $features[$j];
            }
            if (is_null($classVal) || $prob + $this->inters[$i] > $classVal) {
                $classVal = $prob + $this->inters[$i];
                $classIdx = $i;
            }
        }
        return $classIdx;
    }
    {% endif %}

    public function predict($features) {
        return self::LABELS[$this->predictIndex($features)];
    }

}

{% if pipeline_classes %}
{{ pipeline_classes }}

{% endif %}
if (PHP_SAPI === 'cli' && realpath($argv[0]) === __FILE__) {
    {% filter indent(4, True) %}
    {% include 'samples' %}
    {% endfilter %}

    array_shift($argv);

    {% if pipeline_create %}
    {{ pipeline_create | indent('    ') }}

    {% endif %}
    // Model data:
    {{ coeffs }}
    {{ inters }}

    // Estimator:
    $clf = new {{ class_name }}($coeffs, $inters);

    // Features of one sample (arguments) or several samples (standard input):
    foreach (readSamples($argv) as $features) {
        {% if pipeline_transform %}
        {{ pipeline_transform | indent('        ') }}
        {% endif %}
        {% if is_test or to_json %}
        // Get JSON:
        $prediction = $clf->predict($features);
        fwrite(STDOUT, json_encode(array("predict" => $prediction)) . "\n");
        {% else %}
        // Get class prediction:
        $prediction = $clf->predict($features);
        fwrite(STDOUT, "Predicted class: " . strval($prediction) . "\n");
        {% endif %}
    }

}
{% endblock %}