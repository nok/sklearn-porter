{% extends 'base.attached.class' %}

{% block content %}
using System;
using System.Globalization;


public class {{ class_name }} {

    {% if is_binary %}
    private double[] coeffs;
    private double inters;

    public {{ class_name }}(double[] coeffs, double inters) {
        this.coeffs = coeffs;
        this.inters = inters;
    }
    {% else %}
    private double[][] coeffs;
    private double[] inters;

    public {{ class_name }}(double[][] coeffs, double[] inters) {
        this.coeffs = coeffs;
        this.inters = inters;
    }
    {% endif %}

{% include 'labels' %}


    {% if is_binary %}
    public int PredictIndex(double[] features) {
        double prob = 0.0;
        for (int i = 0; i < this.coeffs.Length; i++) {
            prob += this.coeffs[i] * features[i];
        }
        if (prob + this.inters > 0) {
            return 1;
        }
        return 0;
    }
    {% else %}
    public int PredictIndex(double[] features) {
        int classIdx = 0;
        double classVal = double.NegativeInfinity;
        for (int i = 0; i < this.inters.Length; i++) {
            double prob = 0.0;
            for (int j = 0; j < this.coeffs[0].Length; j++) {
                prob += this.coeffs[i][j] * features[j];
            }
            if (prob + this.inters[i] > classVal) {
                classVal = prob + this.inters[i];
                classIdx = i;
            }
        }
        return classIdx;
    }
    {% endif %}

    public {{ label_type }} Predict(double[] features) {
        return LABELS[this.PredictIndex(features)];
    }
{% if to_json %}

{% include 'json' %}

{% endif %}

{% include 'samples' %}


    // Create the estimator with the model data of this file:
    public static {{ class_name }} Create() {
        // Model data:
        {{ coeffs }}
        {{ inters }}

        return new {{ class_name }}(coeffs, inters);
    }

#if !SKLEARN_PORTER_NO_MAIN
    public static void Main(string[] args) {
        {% if pipeline_create %}
        {{ pipeline_create | indent('        ') }}

        {% endif %}
        // Estimator:
        {% if pipeline %}
        {{ class_name }} clf = pipeline.Estimator;
        {% else %}
        {{ class_name }} clf = {{ class_name }}.Create();
        {% endif %}

        // Features of one sample (arguments) or several samples (standard input):
        foreach (double[] features in ReadSamples(args, 0)) {
            {% if pipeline_transform %}
            {{ pipeline_transform | indent('            ') }}
            {% endif %}
            {{ label_type }} prediction = clf.Predict(features);
            {% if to_json %}
            Console.WriteLine("{\"predict\": " + ToJson(prediction) + "}");
            {% else %}
            Console.WriteLine("Predicted class: " + Convert.ToString(prediction, CultureInfo.InvariantCulture));
            {% endif %}
        }
    }
#endif
}
{% if pipeline_classes %}

{{ pipeline_classes }}
{% endif %}
{% endblock %}