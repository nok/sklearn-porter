{% extends 'base.attached.class' %}

{% block content %}
var {{ class_name }} = function(coeffs, inters) {

    this.coeffs = coeffs;
    this.inters = inters;

{% include 'labels' %}

    {% if is_binary %}
    this.predictIndex = function(features) {
        var prob = 0.;
        for (var i = 0, il = this.coeffs.length; i < il; i++) {
            prob += this.coeffs[i] * features[i];
        }
        if (prob + this.inters > 0) {
            return 1;
        }
        return 0;
    };
    {% else %}
    this.predictIndex = function(features) {
        var classIdx = 0,
            classVal = Number.NEGATIVE_INFINITY,
            prob = 0.;
        for (var i = 0, il = this.inters.length; i < il; i++) {
            prob = 0.;
            for (var j = 0, jl = this.coeffs[0].length; j < jl; j++) {
                prob += this.coeffs[i][j] * features[j];
            }
            if (prob + this.inters[i] > classVal) {
                classVal = prob + this.inters[i];
                classIdx = i;
            }
        }
        return classIdx;
    };
    {% endif %}

    this.predict = function(features) {
        return LABELS[this.predictIndex(features)];
    };

};

{% include 'samples' %}

{% if pipeline_classes %}
{{ pipeline_classes }}

{% endif %}
var main = function () {
    {% if pipeline_create %}
    {{ pipeline_create | indent('    ') }}

    {% endif %}
    // Model data:
    {{ coeffs }}
    {{ inters }}

    // Estimator:
    var clf = new {{ class_name }}(coeffs, inters);

    // Features of one sample (arguments) or several samples (standard input):
    readSamples(process.argv.slice(2)).forEach(function (features) {
        {% if pipeline_transform %}
        {{ pipeline_transform | indent('        ') }}
        {% endif %}
        {% if is_test or to_json %}
        // Get JSON:
        console.log(JSON.stringify({
            "predict": clf.predict(features)
        }));
        {% else %}
        // Get class prediction:
        var prediction = clf.predict(features);
        console.log("Predicted class: " + prediction);
        {% endif %}
    });
}

if (require.main === module) {
    main();
}
{% endblock %}