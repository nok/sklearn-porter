{% extends 'base.attached.class' %}

{% block content %}
package main

{% if is_binary %}
import (
	"bufio"
	{% if is_test or to_json %}
	"encoding/json"
	{% endif %}
	"fmt"
	"os"
	"strconv"
	"strings"
)

type {{ class_name }} struct {
	Coeffs []float64
	Inters float64
}
{% else %}
import (
	"bufio"
	{% if is_test or to_json %}
	"encoding/json"
	{% endif %}
	"fmt"
	"math"
	"os"
	"strconv"
	"strings"
)

type {{ class_name }} struct {
	Coeffs [][]float64
	Inters []float64
}
{% endif %}

{% include 'labels' %}

{% if is_test or to_json %}
type Response struct {
	Predict {{ label_type }} `json:"predict"`
}
{% endif %}

{% if is_binary %}
func (svc {{ class_name }}) PredictIndex(features []float64) int {
	var prob float64
	for i := 0; i < len(svc.Coeffs); i++ {
		prob = prob + svc.Coeffs[i] * features[i]
	}
	if (prob + svc.Inters) > 0 {
		return 1
	}
	return 0
}
{% else %}
func (svc {{ class_name }}) PredictIndex(features []float64) int {
	classIdx := 0
	classVal := math.Inf(-1)
	outerCount, innerCount := len(svc.Coeffs), len(svc.Coeffs[0])
	for i := 0; i < outerCount; i++ {
		var prob float64
		for j := 0; j < innerCount; j++ {
			prob = prob + svc.Coeffs[i][j] * features[j]
		}
		if prob + svc.Inters[i] > classVal {
			classVal = prob + svc.Inters[i]
			classIdx = i
		}
	}
	return classIdx
}
{% endif %}

func (svc {{ class_name }}) Predict(features []float64) {{ label_type }} {
	return labels[svc.PredictIndex(features)]
}

{% include 'samples' %}

// Model data:
{{ coeffs }}
{{ inters }}

{% if pipeline_classes %}
{{ pipeline_classes }}

{% endif %}
func main() {
	// Estimator:
	clf := {{ class_name }}{coeffs, inters}

	// Features of one sample (arguments) or several samples (standard input):
	{% if pipeline_create %}
	{{ pipeline_create | indent('\t') }}

	{% endif %}
	readSamples(os.Args[1:], func(features []float64) {
		{% if pipeline_transform %}
		{{ pipeline_transform | indent('\t\t') }}
		{% endif %}
		{% if is_test or to_json %}
		// Get JSON:
		prediction := clf.Predict(features)
		res, _ := json.Marshal(&Response{Predict: prediction})
		fmt.Println(string(res))
		{% else %}
		// Get class prediction:
		prediction := clf.Predict(features)
		fmt.Printf("Predicted class: %v\n", prediction)
		{% endif %}
	})

}
{% endblock %}
