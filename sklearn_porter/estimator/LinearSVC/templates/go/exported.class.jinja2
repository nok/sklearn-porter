{% extends 'base.exported.class' %}

{% block content %}
package main

{% if is_binary %}
import (
	"bufio"
	"encoding/json"
	"fmt"
  "io/ioutil"
	"os"
	"strconv"
	"strings"
)

type {{ class_name }} struct {
	Coeffs []float64 `json:"coeffs"`
	Inters float64 `json:"inters"`
}
{% else %}
import (
	"bufio"
	"encoding/json"
	"fmt"
	"io/ioutil"
	"math"
	"os"
	"strconv"
	"strings"
)

type {{ class_name }} struct {
	Coeffs [][]float64 `json:"coeffs"`
	Inters []float64 `json:"inters"`
}
{% endif %}

{% include 'labels' %}

{% if is_test or to_json %}
type Response struct {
	Predict {{ label_type }} `json:"predict"`
}
{% endif %}

{% if is_binary %}
func (svc {{ class_name }}) PredictIndex(features []float64) int {
	var prob float64
	for i := 0; i < len(svc.Coeffs); i++ {
		prob = prob + svc.Coeffs[i] * features[i]
	}
	if (prob + svc.Inters) > 0 {
		return 1
	}
	return 0
}
{% else %}
func (svc {{ class_name }}) PredictIndex(features []float64) int {
	classIdx := 0
	classVal := math.Inf(-1)
	outerCount, innerCount := len(svc.Coeffs), len(svc.Coeffs[0])
	for i := 0; i < outerCount; i++ {
		var prob float64
		for j := 0; j < innerCount; j++ {
			prob = prob + svc.Coeffs[i][j] * features[j]
		}
		if prob + svc.Inters[i] > classVal {
			classVal = prob + svc.Inters[i]
			classIdx = i
		}
	}
	return classIdx
}
{% endif %}

func (svc {{ class_name }}) Predict(features []float64) {{ label_type }} {
	return labels[svc.PredictIndex(features)]
}

{% include 'samples' %}

func main() {
	if len(os.Args) < 2 {
		fmt.Fprintln(os.Stderr, "You have to pass the path to the model data.")
		os.Exit(1)
	}

	// Model data:
	jsonFile, err := os.Open(os.Args[1])
	if err != nil {
		fmt.Println(err)
	}
	defer jsonFile.Close()
	byteValue, _ := ioutil.ReadAll(jsonFile)

	// Estimator:
	var clf {{ class_name }}
	json.Unmarshal(byteValue, &clf)

	// Features of one sample (arguments) or several samples (standard input):
	readSamples(os.Args[2:], func(features []float64) {
		{% if is_test or to_json %}
		// Get JSON:
		prediction := clf.Predict(features)
		res, _ := json.Marshal(&Response{Predict: prediction})
		fmt.Println(string(res))
		{% else %}
		// Get class prediction:
		prediction := clf.Predict(features)
		fmt.Printf("Predicted class: %v\n", prediction)
		{% endif %}
	})

}
{% endblock %}
